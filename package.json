{
  "name": "gents-desktop-workspace",
  "private": true,
  "version": "0.13.0",
  "description": "npm workspaces for Gents desktop reusable packages",
  "workspaces": [
    "packages/*",
    "apps/gents-desktop",
    "apps/fixture-host",
    "apps/review-demo"
  ],
  "scripts": {
    "build:packages": "npm run build --if-present -w @source-inc/gents-desktop-tokens -w @source-inc/gents-desktop-client -w @source-inc/gents-desktop-ui -w @source-inc/gents-desktop-chat -w @source-inc/gents-desktop-fleet -w @source-inc/gents-desktop-operations",
    "test:packages": "npm run test --if-present -w @source-inc/gents-desktop-client -w @source-inc/gents-desktop-ui -w @source-inc/gents-desktop-chat -w @source-inc/gents-desktop-fleet -w @source-inc/gents-desktop-operations",
    "check:package-boundaries": "node scripts/check-desktop-package-boundaries.mjs",
    "pack:packages": "./scripts/pack-desktop-packages.sh",
    "test:triage": "node --test scripts/triage-hygiene/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
