FROM rust:1.96-bullseye

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        clang \
        cmake \
        libclang-dev \
        protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

# Preserve the Bullseye glibc floor while selecting the repository's compiler.
COPY rust-toolchain.toml /opt/gents-build-toolchain/rust-toolchain.toml
RUN cd /opt/gents-build-toolchain \
    && rustup toolchain install --no-self-update \
    && gents_toolchain="$(rustup show active-toolchain)" \
    && rustup default "${gents_toolchain%% *}" \
    && rustup target add wasm32-unknown-unknown
