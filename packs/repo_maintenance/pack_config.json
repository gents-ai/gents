  "tools": [
    {
      "tools_id": "maintenance-execute-skip-tools",
      "display_name": "Zero-finding skip: execution ledger only",
      "built_ins": {
        "enable_context_budget": true
      },
      "datastore": {
        "enable_defra_query": true,
        "defra_query_collections": [
          "MaintenanceWorkPackage",
          "MaintenanceExecutionResult"
        ],
        "datastore_tool_surface_ids": [
          "maintenance-execute-writes",
          "maintenance-publish-writes"
        ]
      }
    },
    {
      "tools_id": "maintenance-execute-tools",
      "display_name": "Execute an ordered maintenance commit series in one worktree",
