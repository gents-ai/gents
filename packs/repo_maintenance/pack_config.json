{
  "agent_principal": {},
  "agent_behaviors": [
    {
      "behavior_id": "maintenance-execute",
      "display_name": "Isolated maintenance executor",
      "description": "Creates one branch worktree, performs its bounded cleanup, and records validation.",
      "context_id": "maintenance-execute-context",
      "inference_profile_id": "maintenance-scan-profile"
    },
    {
      "behavior_id": "maintenance-execute-skip",
      "display_name": "Zero-finding maintenance skip",
      "description": "Records skipped execution without creating a workspace.",
      "context_id": "maintenance-execute-skip-context",
      "inference_profile_id": "maintenance-profile"
    },
    {
      "behavior_id": "maintenance-integrate",
      "display_name": "Typed maintenance integrator",
      "description": "Inspects the sealed workspace; the host applies the sealed diff.",
      "context_id": "maintenance-integrate-context",
      "inference_profile_id": "maintenance-profile"
    },
    {
      "behavior_id": "maintenance-publish",
      "display_name": "Maintenance PR reviewer and publisher",
      "description": "Reviews the assembled commit series, opens one PR, and drives it toward green.",
      "context_id": "maintenance-publish-context",
      "inference_profile_id": "maintenance-profile"
    },
    {
      "behavior_id": "maintenance-recon",
      "display_name": "Maintenance reconnaissance",
      "description": "Partitions a repository maintenance into a closed set of areas.",
      "context_id": "maintenance-recon-context",
      "inference_profile_id": "maintenance-recon-profile"
    },
    {
      "behavior_id": "maintenance-scan",
      "display_name": "Maintenance area scanner",
      "description": "Inspects one repository area and records findings.",
      "context_id": "maintenance-scan-context",
      "inference_profile_id": "maintenance-scan-profile"
    },
    {
      "behavior_id": "maintenance-triage",
      "display_name": "Maintenance triage",
      "description": "Ranks verified findings and writes the final report.",
      "context_id": "maintenance-triage-context",
      "inference_profile_id": "maintenance-profile"
    },
    {
      "behavior_id": "maintenance-verify",
      "display_name": "Adversarial maintenance verification",
      "description": "Refutes or confirms every candidate against freshly read code.",
      "context_id": "maintenance-verify-context",
      "inference_profile_id": "maintenance-verify-profile"
    }
  ],
