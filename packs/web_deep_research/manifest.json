      "install_command": "./scripts/stack install-mcp"
    }
  ],
  "schemas": [
    "schemas/research_job.graphql",
    "schemas/research_plan.graphql",
    "schemas/research_assignment.graphql",
    "schemas/research_investigation.graphql",
    "schemas/research_source.graphql",
    "schemas/research_claim.graphql",
    "schemas/research_evidence.graphql",
    "schemas/research_claim_verdict.graphql",
    "schemas/research_draft.graphql",
    "schemas/research_result.graphql"
  ],
  "config": "pack_config.json"
}
