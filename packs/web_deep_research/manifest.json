{
  "manifest_version": 1,
  "name": "web_deep_research",
  "version": "1.1.0",
  "description": "Bounded four-stage web research with OSS retrieval-quality and typed evidence handoffs.",
  "authors": [
    "gents-ai contributors"
  ],
  "tags": [
    "graph"
  ],
  "kind": "graph",
  "assets": [
    "README.md",
    "pack_config.json",
    "agent_behaviors/research_plan/system_prompt.md",
    "agent_behaviors/research_investigate/system_prompt.md",
    "agent_behaviors/research_adjudicate/system_prompt.md",
    "agent_behaviors/research_report/system_prompt.md",
    "tasks/research_plan_task/prompt.md",
    "tasks/research_investigate_task/prompt.md",
    "tasks/research_adjudicate_task/prompt.md",
    "tasks/research_report_task/prompt.md",
    "schemas/research_job.graphql",
    "schemas/research_plan.graphql",
    "schemas/research_assignment.graphql",
    "schemas/research_investigation.graphql",
    "schemas/research_source.graphql",
    "schemas/research_claim.graphql",
    "schemas/research_evidence.graphql",
    "schemas/research_claim_verdict.graphql",
    "schemas/research_draft.graphql",
    "schemas/research_result.graphql"
  ],
  "dependencies": [],
  "compiler_version": "graph-intent-v3",
  "external_dependencies": [
    {
      "service_id": "web-research-mcp",
