{
  "case_id": "single-disk-warning",
  "split": "train",
  "reducer": "weighted_mean",
  "stages": [
    {
      "stage_id": "report",
      "prompt": "Monitoring input for correlation c-01-a.\n\nNightly capacity sweep on archive-02. Disk usage on the /var filesystem has climbed to 88% of capacity and is still rising.\n\nRecord the conditions this message describes, following your standing\ninstructions. Every finding you take from this input carries correlation\nc-01-a.",
      "deadline_secs": 600,
      "capture": [
        {
          "kind": "documents",
          "name": "items",
          "collection": "MailboxItem",
          "filter": {
            "requester_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "title",
            "summary",
            "payload",
            "status"
          ]
        }
      ],
      "checks": [
        {
          "check": "mailbox_item_count",
          "params": {
            "count": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "payload_well_formed",
          "params": {
            "version": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "finding_pairs_unique",
          "params": {},
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "finding_count",
          "params": {
            "count": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "findings_match",
          "params": {
            "matchers": [
              {
                "correlation": "c-01-a",
                "state": "open",
                "keywords_all": [
                  "disk",
                  "88"
                ]
              }
            ],
            "exact": true
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "mailbox_text_excludes",
          "params": {
            "keywords": [
              "inode"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}
