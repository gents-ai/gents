{
  "case_id": "recovery-partial-clearance",
  "split": "validation",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "report",
      "prompt": "Monitoring input for correlation c-10-a.\n\nOps line, catalog-cluster: the shard rebalance has not advanced past 3 of 12 shards since it started six hours ago, and audit-writer is failing every flush it attempts.\n\nRecord the conditions this message describes, following your standing\ninstructions. Every finding you take from this input carries correlation\nc-10-a.",
      "deadline_secs": 600,
      "capture": [
        {
          "kind": "documents",
          "name": "items",
          "collection": "MailboxItem",
          "filter": {
            "requester_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "title",
            "summary",
            "payload",
            "status"
          ]
        }
      ],
      "checks": [
        {
          "check": "mailbox_item_count",
          "params": {
            "count": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "payload_well_formed",
          "params": {
            "version": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "finding_pairs_unique",
          "params": {},
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "finding_count",
          "params": {
            "count": 2
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "finding_state_counts",
          "params": {
            "open": 2,
            "resolved": 0
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "findings_match",
          "params": {
            "matchers": [
              {
                "correlation": "c-10-a",
                "state": "open",
                "keywords_all": [
                  "rebalance",
                  "shard"
                ]
              },
              {
                "correlation": "c-10-a",
                "state": "open",
                "keywords_all": [
                  "audit",
                  "failing"
                ]
              }
            ],
            "exact": true
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "mailbox_text_excludes",
          "params": {
            "keywords": [
              "socket"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
