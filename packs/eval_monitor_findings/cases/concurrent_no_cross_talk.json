{
  "case_id": "concurrent-no-cross-talk",
  "split": "held_out",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "input_a",
      "prompt": "Monitoring input for correlation c-14-a.\n\napi-gateway on rack r4 is returning 502 responses on purchase calls. worker-pool sits on the same rack.\n\nRecord the conditions this message describes, following your standing\ninstructions. Every finding you take from this input carries correlation\nc-14-a.",
      "deadline_secs": 600,
      "capture": [
        {
          "kind": "documents",
          "name": "items",
          "collection": "MailboxItem",
          "filter": {
            "requester_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "title",
            "summary",
            "payload",
            "status"
          ]
        }
      ],
      "checks": [
        {
          "check": "mailbox_item_count",
          "params": {
            "count": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "payload_well_formed",
          "params": {
            "version": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "finding_pairs_unique",
          "params": {},
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "finding_count",
          "params": {
            "count": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "findings_match",
          "params": {
            "matchers": [
              {
                "correlation": "c-14-a",
                "state": "open",
                "keywords_all": [
                  "api",
                  "502"
                ]
              }
            ],
            "exact": true
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "mailbox_text_excludes",
          "params": {
            "keywords": [
              "worker-pool"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
