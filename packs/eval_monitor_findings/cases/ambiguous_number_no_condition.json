{
  "case_id": "ambiguous-number-no-condition",
  "split": "validation",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "report",
      "prompt": "Monitoring input for correlation c-16-a.\n\narchive-nas-3 disk_used_percent=91\n\nRecord the conditions this message describes, following your standing\ninstructions. Every finding you take from this input carries correlation\nc-16-a.",
      "deadline_secs": 600,
      "capture": [
        {
          "kind": "documents",
          "name": "items",
          "collection": "MailboxItem",
          "filter": {
            "requester_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "title",
            "summary",
            "payload",
            "status"
          ]
        }
      ],
      "checks": [
        {
          "check": "payload_well_formed",
          "params": {
            "version": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "finding_pairs_unique",
          "params": {},
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "finding_count",
          "params": {
            "count": 0
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "findings_match",
          "params": {
            "matchers": [],
            "exact": true
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}
