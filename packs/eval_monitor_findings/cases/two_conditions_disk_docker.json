{
  "case_id": "two-conditions-disk-docker",
  "split": "train",
  "reducer": "weighted_mean",
  "stages": [
    {
      "stage_id": "report",
      "prompt": "Monitoring input for correlation c-02-a.\n\nmedia-origin-2: /srv crossed 76% overnight and has not come back down. docker status=unavailable.\n\nRecord the conditions this message describes, following your standing\ninstructions. Every finding you take from this input carries correlation\nc-02-a.",
      "deadline_secs": 600,
      "capture": [
        {
          "kind": "documents",
          "name": "items",
          "collection": "MailboxItem",
          "filter": {
            "requester_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "title",
            "summary",
            "payload",
            "status"
          ]
        }
      ],
      "checks": [
        {
          "check": "mailbox_item_count",
          "params": {
            "count": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "payload_well_formed",
          "params": {
            "version": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "finding_pairs_unique",
          "params": {},
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "finding_count",
          "params": {
            "count": 2
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "findings_match",
          "params": {
            "matchers": [
              {
                "correlation": "c-02-a",
                "state": "open",
                "keywords_all": [
                  "srv",
                  "76"
                ]
              },
              {
                "correlation": "c-02-a",
                "state": "open",
                "keywords_all": [
                  "docker",
                  "unavailable"
                ]
              }
            ],
            "exact": true
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "mailbox_text_excludes",
          "params": {
            "keywords": [
              "memory"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}
