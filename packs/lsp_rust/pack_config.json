{
  "agent_principal": {},
  "agent_behaviors": [
    {
      "behavior_id": "lsp-coder",
      "display_name": "LSP rust-analyzer coder",
      "context_id": "lsp-coder-context",
      "inference_profile_id": "gents:inference-slot:coder"
    }
  ],
  "contexts": [
    {
      "context_id": "lsp-coder-context",
      "display_name": "LSP rust-analyzer coder",
      "system_prompt": "./agent_behaviors/lsp_coder/system_prompt.md",
      "tools_id": "lsp-readonly"
    }
  ],
  "tools": [
    {
      "tools_id": "lsp-readonly",
      "display_name": "ReadOnly files + lsp (bash off)",
      "host": {
        "root": "${GENTS_LSP_WORKSPACE:-.}",
        "files": {
          "mode": "ReadOnly"
        }
      },
      "integrations": {
        "lsp": {
          "config": "{\"servers\":{\"rust-analyzer\":{\"warmup_timeout_ms\":60000,\"workspace_ready_timings\":{\"initial\":45000},\"settings\":{\"rust-analyzer\":{\"checkOnSave\":false}}}}}"
        }
      }
    }
  ],
  "tasks": [
    {
      "task_id": "lsp-hover-task",
      "display_name": "lsp-hover-task",
      "behavior_id": "lsp-coder",
      "prompt_template": "./tasks/lsp_hover_task/prompt.md"
    }
  ],
  "event_sources": [
    {
      "event_source_id": "lsp-hover",
      "display_name": "lsp-hover",
      "source_collection": "LspDemoJob",
      "event_kind": "created"
    }
  ],
  "triggers": [
    {
      "trigger_id": "lsp-hover",
      "display_name": "lsp-hover",
      "task_id": "lsp-hover-task",
      "source": {
        "kind": "event",
        "event_source_id": "lsp-hover"
      },
      "concurrency": "parallel"
    }
  ]
}
