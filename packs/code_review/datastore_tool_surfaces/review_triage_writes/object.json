        {"name": "run_id", "required": false, "fill": "correlation"},
        {"name": "high_priority_count", "required": true},
        {"name": "confirmed_count", "required": true},
        {"name": "refuted_count", "required": true},
        {"name": "summary", "required": true}
      ]
    }
  ]
