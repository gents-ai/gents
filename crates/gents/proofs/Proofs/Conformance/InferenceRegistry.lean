theorem all_cases_replay : cases.all (fun c => replay initial c.actions == c.expected) = true := by
  native_decide

def natOptionJson : Option Nat → String
  | none => "null"
  | some n => toString n

def configJson (d : Desired) : String :=
  "{\"key\":" ++ toString d.config.key ++ ",\"generation\":" ++ toString d.config.generation
  ++ ",\"capacity\":" ++ toString d.config.capacity ++ ",\"available\":" ++ toString d.config.available
  ++ ",\"name\":" ++ jsonString d.name ++ ",\"catalog\":" ++ jsonString d.catalog ++ "}"

def actionJson : Action → String
  | .reconcile d => "{\"kind\":\"reconcile\",\"desired\":" ++ (d.map configJson).getD "null" ++ "}"
  | .acquire => "{\"kind\":\"acquire\"}"
  | .release gen returned => "{\"kind\":\"release\",\"generation\":" ++ toString gen
      ++ ",\"returned_permit\":" ++ toString returned ++ "}"

def observationJson (o : Observation) : String :=
  "{\"pending_generation\":" ++ natOptionJson o.pendingGeneration
  ++ ",\"controller_generation\":" ++ natOptionJson o.controllerGeneration
  ++ ",\"capacity\":" ++ toString o.capacity ++ ",\"in_flight\":" ++ toString o.inFlight
  ++ ",\"permits\":" ++ toString o.permits ++ ",\"is_open\":" ++ toString o.isOpen ++ "}"

def casesJson : String := jsonArray (cases.map fun c =>
  "{\"name\":" ++ jsonString c.name ++ ",\"actions\":" ++ jsonArray (c.actions.map actionJson)
  ++ ",\"expected\":" ++ jsonArray (c.expected.map observationJson) ++ "}")

end Conformance.InferenceRegistry
