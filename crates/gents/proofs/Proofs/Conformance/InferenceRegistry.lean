import Proofs.InferenceCall.Registry
import Proofs.Conformance.ContractTypes

namespace Conformance.InferenceRegistry
open InferenceCall.Registry
open Conformance.Contracts

/-- Metadata labels are intentionally projected out of resource identity. -/
structure Desired where
  config : Config
  name : String
  catalog : String
  deriving DecidableEq, Repr

inductive Action where
  | reconcile (desired : Option Desired)
  | acquire
  | release (generation : Nat) (returnedPermit : Bool)
  deriving DecidableEq, Repr

structure Observation where
  pendingGeneration : Option Nat
  controllerGeneration : Option Nat
  capacity : Nat
  inFlight : Nat
  permits : Nat
  isOpen : Bool
  deriving DecidableEq, Repr

def observe (s : State) : Observation :=
  ⟨(if !s.isOpen && s.controller.isSome then (availableDesired s.desired).map (·.generation) else none), s.controller.map (·.config.generation),
    (s.controller.map (·.config.capacity)).getD 0,
    (s.controller.map (·.inFlight)).getD 0,
    (s.controller.map (·.permits)).getD 0, s.isOpen⟩

def step (s : State) : Action → State
  | .reconcile d => InferenceCall.Registry.reconcile s (d.map (·.config))
  | .acquire => (InferenceCall.Registry.acquire s).getD s
  | .release generation returned => InferenceCall.Registry.release s generation returned

def replay (s : State) : List Action → List Observation
  | [] => []
  | action :: rest => let post := step s action; observe post :: replay post rest

structure Case where
  name : String
  actions : List Action
  expected : List Observation
  deriving DecidableEq, Repr

def initial : State := ⟨none, none, false⟩

