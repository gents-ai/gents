    {
      "kind": "read",
      "tool_name": "read_report_research_evidence",
      "collection": "WebResearchEvidence",
      "description": "Load normalized claim-to-source joins for citation placement.",
      "fields": ["evidence_id", "claim_id", "source_id", "relationship", "locator", "supporting_excerpt", "verified_quote_used", "notes"],
      "filter_fields": [{"name": "run_id", "required": false, "fill": "correlation"}]
    },
    {
      "kind": "read",
      "tool_name": "read_report_claim_verdict",
      "collection": "WebResearchClaimVerdict",
