{
  "case_id": "invoice-approval-hub",
  "split": "train",
  "reducer": "all",
  "fixtures": {
    "schemas": [
      "type VendorBill { billNo: String vendor: String amount: Float status: String }",
      "type AuditFlag { billNo: String note: String }"
    ],
    "documents": [
      {
        "collection": "VendorBill",
        "document": {
          "billNo": "INV-10",
          "vendor": "Cedar Mill",
          "amount": 1200.0,
          "status": "approved"
        }
      },
      {
        "collection": "VendorBill",
        "document": {
          "billNo": "INV-11",
          "vendor": "North Rail",
          "amount": 6400.0,
          "status": "review"
        }
      }
    ]
  },
  "stages": [
    {
      "stage_id": "build",
      "prompt": "Set up an AP Auditor agent that automatically files an AuditFlag only for new VendorBill rows at or over 5000. Build and lint an Invoice Hub page showing a donut chart by status, summary cards, and a form to enter a bill.",
      "capture": [
        {
          "kind": "documents",
          "name": "pages",
          "collection": "Page",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "page_id",
            "display_name",
            "module",
            "css",
            "data",
            "enabled"
          ]
        },
        {
          "kind": "documents",
          "name": "surfaces",
          "collection": "DatastoreToolSurface",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "surface_id": {
              "_ne": "engineer-mailbox"
            }
          },
          "fields": [
            "surface_id",
            "display_name",
            "entries",
            "enabled"
          ]
        },
        {
          "kind": "documents",
          "name": "worker",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "enabled": {
              "_eq": true
            },
            "display_name": {
              "_ilike": "%ap auditor%"
            }
          },
          "fields": [
            "agent_did",
            "display_name"
          ]
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "pages",
                "min": 1,
                "max": 1
              },
              {
                "capture": "surfaces",
                "min": 1
              },
              {
                "capture": "worker",
                "min": 1,
                "max": 1
              }
            ],
            "rows": [
              {
                "capture": "pages",
                "key": "display_name",
                "id": "Invoice Hub",
                "expect": [
                  {
                    "field": "enabled",
                    "equals": true
                  },
                  {
                    "field": "module",
                    "matches": "\\bDonutChart\\b"
                  },
                  {
                    "field": "module",
                    "matches": "\\bCard\\b"
                  },
                  {
                    "field": "module",
                    "matches": "\\buseQuery\\b"
                  },
                  {
                    "field": "module",
                    "matches": "\\buseWrite\\b"
                  },
                  {
                    "field": "module",
                    "matches": "\\bamount\\b"
                  },
                  {
                    "field": "data",
                    "matches": "\"surface\"\\s*:\\s*\"[^\"]+\""
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "surfaces",
            "min_rows": 1,
            "expect": [
              {
                "field": "entries",
                "matches": "\"collection\"\\s*:\\s*\"(VendorBill|AuditFlag)\""
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "tool_result_matches",
          "params": {
            "expect": [
              {
                "field": "admitted",
                "equals": true
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "small_bill",
      "seed": {
        "collection": "VendorBill",
        "document": {
          "billNo": "INV-20",
          "vendor": "Paper Co",
          "amount": 450.0,
          "status": "pending"
        }
      },
      "deadline_secs": 180,
      "capture": [],
      "checks": []
    },
    {
      "stage_id": "large_bill",
      "seed": {
        "collection": "VendorBill",
        "document": {
          "billNo": "INV-21",
          "vendor": "Heavy Crane",
          "amount": 7200.0,
          "status": "pending"
        }
      },
      "deadline_secs": 300,
      "settle": true,
      "capture": [
        {
          "kind": "documents",
          "name": "small_flags",
          "collection": "AuditFlag",
          "filter": {
            "billNo": {
              "_eq": "INV-20"
            }
          },
          "fields": [
            "billNo",
            "note"
          ]
        },
        {
          "kind": "documents",
          "name": "large_flags",
          "collection": "AuditFlag",
          "filter": {
            "billNo": {
              "_eq": "INV-21"
            }
          },
          "fields": [
            "billNo",
            "note"
          ]
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "small_flags",
                "min": 0,
                "max": 0
              },
              {
                "capture": "large_flags",
                "min": 1
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}
