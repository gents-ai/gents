{
  "case_id": "dock-cargo-control",
  "split": "validation",
  "reducer": "all",
  "fixtures": {
    "schemas": [
      "type CargoLot { lot: String origin: String weight: Float }",
      "type CustomsHold { lot: String reason: String }"
    ],
    "documents": [
      {
        "collection": "CargoLot",
        "document": {
          "lot": "L-10",
          "origin": "Antwerp",
          "weight": 1400.0
        }
      }
    ]
  },
  "stages": [
    {
      "stage_id": "build",
      "prompt": "Set up a Customs Officer agent that files a CustomsHold only when a new CargoLot exceeds 2000 weight. Build and lint a Cargo Control page showing KPI stats, a bar chart of lot weights, and an intake form.",
      "capture": [
        {
          "kind": "documents",
          "name": "pages",
          "collection": "Page",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "page_id",
            "display_name",
            "module",
            "css",
            "data",
            "enabled"
          ]
        },
        {
          "kind": "documents",
          "name": "surfaces",
          "collection": "DatastoreToolSurface",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "surface_id": {
              "_ne": "engineer-mailbox"
            }
          },
          "fields": [
            "surface_id",
            "display_name",
            "entries",
            "enabled"
          ]
        },
        {
          "kind": "documents",
          "name": "worker",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "enabled": {
              "_eq": true
            },
            "display_name": {
              "_ilike": "%customs officer%"
            }
          },
          "fields": [
            "agent_did",
            "display_name"
          ]
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "pages",
                "min": 1,
                "max": 1
              },
              {
                "capture": "surfaces",
                "min": 1
              },
              {
                "capture": "worker",
                "min": 1,
                "max": 1
              }
            ],
            "rows": [
              {
                "capture": "pages",
                "key": "display_name",
                "id": "Cargo Control",
                "expect": [
                  {
                    "field": "enabled",
                    "equals": true
                  },
                  {
                    "field": "module",
                    "matches": "\\bStat\\b"
                  },
                  {
                    "field": "module",
                    "matches": "\\bBarChart\\b"
                  },
                  {
                    "field": "module",
                    "matches": "\\buseQuery\\b"
                  },
                  {
                    "field": "module",
                    "matches": "\\buseWrite\\b"
                  },
                  {
                    "field": "module",
                    "matches": "\\bweight\\b"
                  },
                  {
                    "field": "data",
                    "matches": "\"surface\"\\s*:\\s*\"[^\"]+\""
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "surfaces",
            "min_rows": 1,
            "expect": [
              {
                "field": "entries",
                "matches": "\"collection\"\\s*:\\s*\"(CargoLot|CustomsHold)\""
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "tool_result_matches",
          "params": {
            "expect": [
              {
                "field": "admitted",
                "equals": true
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "light_lot",
      "seed": {
        "collection": "CargoLot",
        "document": {
          "lot": "L-21",
          "origin": "Cork",
          "weight": 850.0
        }
      },
      "deadline_secs": 180,
      "capture": [],
      "checks": []
    },
    {
      "stage_id": "heavy_lot",
      "seed": {
        "collection": "CargoLot",
        "document": {
          "lot": "L-22",
          "origin": "Busan",
          "weight": 3400.0
        }
      },
      "deadline_secs": 300,
      "settle": true,
      "capture": [
        {
          "kind": "documents",
          "name": "light_holds",
          "collection": "CustomsHold",
          "filter": {
            "lot": {
              "_eq": "L-21"
            }
          },
          "fields": [
            "lot",
            "reason"
          ]
        },
        {
          "kind": "documents",
          "name": "heavy_holds",
          "collection": "CustomsHold",
          "filter": {
            "lot": {
              "_eq": "L-22"
            }
          },
          "fields": [
            "lot",
            "reason"
          ]
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "light_holds",
                "min": 0,
                "max": 0
              },
              {
                "capture": "heavy_holds",
                "min": 1
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}
