{
  "case_id": "dock-cargo-control",
  "split": "validation",
  "reducer": "all",
  "fixtures": {
    "schemas": [
      "type CargoLot { lot: String origin: String weight: Float }",
      "type CustomsHold { lot: String reason: String }",
      "type DockEscalation { lot: String owner: String }"
    ],
    "documents": [
      {
        "collection": "CargoLot",
        "document": {
          "lot": "L-10",
          "origin": "Antwerp",
          "weight": 1400
        }
      }
    ]
  },
  "stages": [
    {
      "stage_id": "build",
      "prompt": "Set up a two-agent chain: Customs Officer wakes only when a new CargoLot strictly exceeds 2000 weight to file a CustomsHold, and Dock Supervisor wakes on each new CustomsHold to add a DockEscalation. Build and lint a \"Cargo Control\" page with KPI stats, a bar chart, and a lot form.",
      "capture": [
        {
          "kind": "documents",
          "name": "pages",
          "collection": "Page",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "page_id",
            "display_name",
            "module",
            "css",
            "data",
            "enabled"
          ]
        },
        {
          "kind": "documents",
          "name": "surfaces",
          "collection": "DatastoreToolSurface",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "surface_id": {
              "_ne": "engineer-mailbox"
            }
          },
          "fields": [
            "surface_id",
            "node_did",
            "display_name",
            "entries",
            "enabled"
          ]
        },
        {
          "kind": "documents",
          "name": "officer",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "enabled": {
              "_eq": true
            },
            "display_name": {
              "_ilike": "%customs officer%"
            }
          },
          "fields": [
            "agent_did",
            "display_name"
          ]
        },
        {
          "kind": "documents",
          "name": "supervisor",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "enabled": {
              "_eq": true
            },
            "display_name": {
              "_ilike": "%dock supervisor%"
            }
          },
          "fields": [
            "agent_did",
            "display_name"
          ]
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "pages",
                "min": 1,
                "max": 1
              },
              {
                "capture": "surfaces",
                "min": 1
              },
              {
                "capture": "officer",
                "min": 1,
                "max": 1
              },
              {
                "capture": "supervisor",
                "min": 1,
                "max": 1
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "pages",
            "min_rows": 1,
            "max_rows": 1,
            "expect": [
              {
                "field": "enabled",
                "equals": true
              },
              {
                "field": "display_name",
                "fallback_field": "page_id",
                "matches": "(?i)cargo[- ]?control"
              },
              {
                "field": "module",
                "matches": "\\b(?:jsx|jsxs|createElement)\\("
              },
              {
                "field": "module",
                "matches": "\\bPLUGIN_PAGE_AREA\\b|['\"]plugin\\.pages['\"]"
              },
              {
                "field": "module",
                "matches": "\\buseQuery\\("
              },
              {
                "field": "module",
                "matches": "\\buseWrite\\("
              },
              {
                "field": "module",
                "matches": "\\b(Stat|Card)\\b"
              },
              {
                "field": "module",
                "matches": "\\bBarChart\\b"
              },
              {
                "field": "module",
                "matches": "\\bweight\\b"
              },
              {
                "field": "module",
                "matches": "\\breason\\b"
              },
              {
                "field": "data",
                "matches": "(?s)\"surface\"\\s*:\\s*\"[^\"]+\".*\"surface\"\\s*:\\s*\"[^\"]+\""
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "tool_result_matches",
          "params": {
            "expect": [
              {
                "field": "admitted",
                "equals": true
              },
              {
                "field": "findings",
                "equals": []
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "boundary_lot",
      "seed": {
        "collection": "CargoLot",
        "document": {
          "lot": "L-21",
          "origin": "Cork",
          "weight": 2000
        }
      },
      "expect_fire": false,
      "deadline_secs": 180,
      "capture": [
        {
          "kind": "runs",
          "name": "runs",
          "of_seed": true
        }
      ],
      "checks": [
        {
          "check": "captured_rows_count",
          "params": {
            "name": "runs",
            "min": 0,
            "max": 0
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "heavy_lot",
      "seed": {
        "collection": "CargoLot",
        "document": {
          "lot": "L-22",
          "origin": "Busan",
          "weight": 3400
        }
      },
      "deadline_secs": 300,
      "settle": true,
      "capture": [
        {
          "kind": "documents",
          "name": "role_agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_did",
            "display_name"
          ]
        },
        {
          "kind": "documents",
          "name": "officer_runs",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "role_agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^customs[ -]?officer$"
                  },
                  "field": "agent_did"
                }
              }
            },
            "purpose": {
              "_eq": "normal"
            },
            "lifecycle_state": {
              "_eq": "completed"
            },
            "caused_by_trigger_id": {
              "_ne": null
            }
          },
          "fields": [
            "request_id",
            "agent_did",
            "session_id",
            "lifecycle_state",
            "caused_by_trigger_id",
            "caused_by_parent_request_id"
          ]
        },
        {
          "kind": "documents",
          "name": "supervisor_runs",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "role_agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^dock[ -]?supervisor$"
                  },
                  "field": "agent_did"
                }
              }
            },
            "purpose": {
              "_eq": "normal"
            },
            "lifecycle_state": {
              "_eq": "completed"
            },
            "caused_by_trigger_id": {
              "_ne": null
            }
          },
          "fields": [
            "request_id",
            "agent_did",
            "session_id",
            "lifecycle_state",
            "caused_by_trigger_id",
            "caused_by_parent_request_id"
          ]
        },
        {
          "kind": "documents",
          "name": "light_holds",
          "collection": "CustomsHold",
          "filter": {
            "lot": {
              "_eq": "L-21"
            }
          },
          "fields": [
            "lot",
            "reason"
          ]
        },
        {
          "kind": "documents",
          "name": "heavy_holds",
          "collection": "CustomsHold",
          "filter": {
            "lot": {
              "_eq": "L-22"
            }
          },
          "fields": [
            "lot",
            "reason"
          ]
        },
        {
          "kind": "documents",
          "name": "heavy_escalations",
          "collection": "DockEscalation",
          "filter": {
            "lot": {
              "_eq": "L-22"
            }
          },
          "fields": [
            "lot",
            "owner"
          ]
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "officer_runs",
                "min": 1,
                "max": 1
              },
              {
                "capture": "supervisor_runs",
                "min": 1,
                "max": 1
              },
              {
                "capture": "light_holds",
                "min": 0,
                "max": 0
              },
              {
                "capture": "heavy_holds",
                "min": 1,
                "max": 1
              },
              {
                "capture": "heavy_escalations",
                "min": 1,
                "max": 1
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}
