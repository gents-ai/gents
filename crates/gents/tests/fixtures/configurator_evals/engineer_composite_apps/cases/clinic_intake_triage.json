{
  "case_id": "clinic-intake-triage",
  "split": "train",
  "reducer": "all",
  "fixtures": {
    "schemas": [
      "type IntakeForm { visit: String patient: String acuity: String }",
      "type TriageNote { visit: String lane: String }"
    ],
    "documents": [
      {
        "collection": "IntakeForm",
        "document": {
          "visit": "V-10",
          "patient": "Samira",
          "acuity": "routine"
        }
      }
    ]
  },
  "stages": [
    {
      "stage_id": "build",
      "prompt": "Create a Triage Nurse agent woken automatically on each new IntakeForm to add a TriageNote with lane urgent when acuity is urgent and standard otherwise. Build and lint a \"Clinic Triage\" page with tabs, acuity badges, a dialog intake form, and toast feedback.",
      "capture": [
        {
          "kind": "documents",
          "name": "pages",
          "collection": "Page",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "page_id",
            "display_name",
            "module",
            "css",
            "data",
            "enabled"
          ]
        },
        {
          "kind": "documents",
          "name": "surfaces",
          "collection": "DatastoreToolSurface",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "surface_id": {
              "_ne": "engineer-mailbox"
            }
          },
          "fields": [
            "surface_id",
            "node_did",
            "display_name",
            "entries",
            "enabled"
          ]
        },
        {
          "kind": "documents",
          "name": "worker",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "enabled": {
              "_eq": true
            },
            "display_name": {
              "_ilike": "%triage nurse%"
            }
          },
          "fields": [
            "agent_did",
            "display_name"
          ]
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "pages",
                "min": 1,
                "max": 1
              },
              {
                "capture": "surfaces",
                "min": 1
              },
              {
                "capture": "worker",
                "min": 1,
                "max": 1
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "pages",
            "min_rows": 1,
            "max_rows": 1,
            "expect": [
              {
                "field": "enabled",
                "equals": true
              },
              {
                "field": "display_name",
                "fallback_field": "page_id",
                "matches": "(?i)clinic[- ]?triage"
              },
              {
                "field": "module",
                "matches": "\\b(?:jsx|jsxs|createElement)\\("
              },
              {
                "field": "module",
                "matches": "\\bPLUGIN_PAGE_AREA\\b|['\"]plugin\\.pages['\"]"
              },
              {
                "field": "module",
                "matches": "\\buseQuery\\("
              },
              {
                "field": "module",
                "matches": "\\buseWrite\\("
              },
              {
                "field": "module",
                "matches": "\\bTabs\\b"
              },
              {
                "field": "module",
                "matches": "\\bBadge\\b"
              },
              {
                "field": "module",
                "matches": "\\bDialog\\b"
              },
              {
                "field": "module",
                "matches": "\\btoast\\b"
              },
              {
                "field": "module",
                "matches": "\\bacuity\\b"
              },
              {
                "field": "module",
                "matches": "\\blane\\b"
              },
              {
                "field": "data",
                "matches": "(?s)\"surface\"\\s*:\\s*\"[^\"]+\".*\"surface\"\\s*:\\s*\"[^\"]+\""
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "tool_result_matches",
          "params": {
            "expect": [
              {
                "field": "admitted",
                "equals": true
              },
              {
                "field": "findings",
                "equals": []
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "urgent_arrival",
      "seed": {
        "collection": "IntakeForm",
        "document": {
          "visit": "V-42",
          "patient": "Tomas",
          "acuity": "urgent"
        }
      },
      "deadline_secs": 300,
      "settle": true,
      "capture": [
        {
          "kind": "runs",
          "name": "seed_runs",
          "of_seed": true
        },
        {
          "kind": "documents",
          "name": "worker_runs",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_ne": "gents:agent-slot:engineer"
            },
            "purpose": {
              "_eq": "normal"
            },
            "lifecycle_state": {
              "_eq": "completed"
            },
            "caused_by_trigger_id": {
              "_ne": null
            }
          },
          "fields": [
            "request_id",
            "agent_did",
            "session_id",
            "lifecycle_state",
            "caused_by_trigger_id"
          ]
        },
        {
          "kind": "documents",
          "name": "triage_urgent",
          "collection": "TriageNote",
          "filter": {
            "visit": {
              "_eq": "V-42"
            }
          },
          "fields": [
            "visit",
            "lane"
          ]
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "seed_runs",
                "min": 1,
                "max": 1
              },
              {
                "capture": "worker_runs",
                "min": 1,
                "max": 1
              },
              {
                "capture": "triage_urgent",
                "min": 1,
                "max": 1
              }
            ],
            "rows": [
              {
                "capture": "triage_urgent",
                "key": "visit",
                "id": "V-42",
                "expect": [
                  {
                    "field": "lane",
                    "matches": "(?i)urgent"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "routine_arrival",
      "seed": {
        "collection": "IntakeForm",
        "document": {
          "visit": "V-43",
          "patient": "Lina",
          "acuity": "routine"
        }
      },
      "deadline_secs": 300,
      "settle": true,
      "capture": [
        {
          "kind": "runs",
          "name": "seed_runs",
          "of_seed": true
        },
        {
          "kind": "documents",
          "name": "triage_routine",
          "collection": "TriageNote",
          "filter": {
            "visit": {
              "_eq": "V-43"
            }
          },
          "fields": [
            "visit",
            "lane"
          ]
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "seed_runs",
                "min": 1,
                "max": 1
              },
              {
                "capture": "triage_routine",
                "min": 1,
                "max": 1
              }
            ],
            "rows": [
              {
                "capture": "triage_routine",
                "key": "visit",
                "id": "V-43",
                "expect": [
                  {
                    "field": "lane",
                    "matches": "(?i)standard"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}
