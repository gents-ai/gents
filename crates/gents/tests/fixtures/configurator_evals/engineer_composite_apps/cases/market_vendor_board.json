{
  "case_id": "market-vendor-board",
  "split": "train",
  "reducer": "all",
  "fixtures": {
    "schemas": [
      "type MarketStall { stall: String vendor: String zone: String fee: Float }",
      "type StallCheckin { stall: String present: Boolean }"
    ],
    "documents": [
      {
        "collection": "MarketStall",
        "document": {
          "stall": "S-14",
          "vendor": "Alder Honey",
          "zone": "east",
          "fee": 45.0
        }
      },
      {
        "collection": "MarketStall",
        "document": {
          "stall": "S-22",
          "vendor": "Briar Bread",
          "zone": "west",
          "fee": 60.0
        }
      }
    ]
  },
  "stages": [
    {
      "stage_id": "build",
      "prompt": "Set up a Market Steward agent that records StallCheckin entries. Build and lint a Market Board page organized in a grid of stats, a bar chart of fees by zone, a vendor search input, and a live table.",
      "capture": [
        {
          "kind": "documents",
          "name": "pages",
          "collection": "Page",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "page_id",
            "display_name",
            "module",
            "css",
            "data",
            "enabled"
          ]
        },
        {
          "kind": "documents",
          "name": "surfaces",
          "collection": "DatastoreToolSurface",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "surface_id": {
              "_ne": "engineer-mailbox"
            }
          },
          "fields": [
            "surface_id",
            "display_name",
            "entries",
            "enabled"
          ]
        },
        {
          "kind": "documents",
          "name": "worker",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "enabled": {
              "_eq": true
            },
            "display_name": {
              "_ilike": "%market steward%"
            }
          },
          "fields": [
            "agent_did",
            "display_name"
          ]
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "pages",
                "min": 1,
                "max": 1
              },
              {
                "capture": "surfaces",
                "min": 1
              },
              {
                "capture": "worker",
                "min": 1,
                "max": 1
              }
            ],
            "rows": [
              {
                "capture": "pages",
                "key": "display_name",
                "id": "Market Board",
                "expect": [
                  {
                    "field": "enabled",
                    "equals": true
                  },
                  {
                    "field": "module",
                    "matches": "\\bGrid\\b"
                  },
                  {
                    "field": "module",
                    "matches": "\\bStat\\b"
                  },
                  {
                    "field": "module",
                    "matches": "\\bBarChart\\b"
                  },
                  {
                    "field": "module",
                    "matches": "\\bInput\\b"
                  },
                  {
                    "field": "module",
                    "matches": "\\bTable\\b"
                  },
                  {
                    "field": "module",
                    "matches": "\\buseQuery\\b"
                  },
                  {
                    "field": "data",
                    "matches": "\"surface\"\\s*:\\s*\"[^\"]+\""
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "surfaces",
            "min_rows": 1,
            "expect": [
              {
                "field": "entries",
                "matches": "\"collection\"\\s*:\\s*\"(MarketStall|StallCheckin)\""
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "tool_result_matches",
          "params": {
            "expect": [
              {
                "field": "admitted",
                "equals": true
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "exercise",
      "settle": true,
      "prompt": "Have the Market Steward check in stall S-14 as present.",
      "capture": [
        {
          "kind": "documents",
          "name": "worker_runs",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_ne": "gents:agent-slot:engineer"
            },
            "purpose": {
              "_eq": "normal"
            },
            "lifecycle_state": {
              "_eq": "completed"
            }
          },
          "fields": [
            "request_id",
            "agent_did",
            "session_id",
            "lifecycle_state",
            "caused_by_trigger_id"
          ]
        },
        {
          "kind": "documents",
          "name": "checkins",
          "collection": "StallCheckin",
          "filter": {
            "stall": {
              "_eq": "S-14"
            }
          },
          "fields": [
            "stall",
            "present"
          ]
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "worker_runs",
                "min": 1
              },
              {
                "capture": "checkins",
                "min": 1
              }
            ],
            "rows": [
              {
                "capture": "checkins",
                "key": "stall",
                "id": "S-14",
                "expect": [
                  {
                    "field": "present",
                    "equals": true
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}
