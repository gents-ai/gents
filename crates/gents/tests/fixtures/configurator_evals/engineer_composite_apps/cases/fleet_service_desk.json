{
  "case_id": "fleet-service-desk",
  "split": "train",
  "reducer": "all",
  "fixtures": {
    "schemas": [
      "type FleetOrder { unit: String issue: String severity: String }",
      "type FleetNote { unit: String summary: String }"
    ],
    "documents": [
      {
        "collection": "FleetOrder",
        "document": {
          "unit": "VAN-12",
          "issue": "brake pad wear",
          "severity": "high"
        }
      }
    ]
  },
  "stages": [
    {
      "stage_id": "build",
      "prompt": "Set up a Fleet Dispatcher agent woken automatically on each new FleetOrder to add a FleetNote. Build and lint a \"Fleet Service\" page with themed CSS, KPI stats, an orders table, and a form to log an order.",
      "capture": [
        {
          "kind": "documents",
          "name": "pages",
          "collection": "Page",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "page_id",
            "display_name",
            "module",
            "css",
            "data",
            "enabled"
          ]
        },
        {
          "kind": "documents",
          "name": "surfaces",
          "collection": "DatastoreToolSurface",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "surface_id": {
              "_ne": "engineer-mailbox"
            }
          },
          "fields": [
            "surface_id",
            "node_did",
            "display_name",
            "entries",
            "enabled"
          ]
        },
        {
          "kind": "documents",
          "name": "worker",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "enabled": {
              "_eq": true
            },
            "display_name": {
              "_ilike": "%fleet dispatcher%"
            }
          },
          "fields": [
            "agent_did",
            "display_name"
          ]
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "pages",
                "min": 1,
                "max": 1
              },
              {
                "capture": "surfaces",
                "min": 1
              },
              {
                "capture": "worker",
                "min": 1,
                "max": 1
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "pages",
            "min_rows": 1,
            "max_rows": 1,
            "expect": [
              {
                "field": "enabled",
                "equals": true
              },
              {
                "field": "display_name",
                "fallback_field": "page_id",
                "matches": "(?i)fleet[- ]?service"
              },
              {
                "field": "module",
                "matches": "\\b(?:jsx|jsxs|createElement)\\("
              },
              {
                "field": "module",
                "matches": "\\bPLUGIN_PAGE_AREA\\b|['\"]plugin\\.pages['\"]"
              },
              {
                "field": "module",
                "matches": "\\buseQuery\\("
              },
              {
                "field": "module",
                "matches": "\\buseWrite\\("
              },
              {
                "field": "module",
                "matches": "\\b(Stat|Card)\\b"
              },
              {
                "field": "module",
                "matches": "\\bTable\\b"
              },
              {
                "field": "module",
                "matches": "\\bunit\\b"
              },
              {
                "field": "module",
                "matches": "\\bsummary\\b"
              },
              {
                "field": "data",
                "matches": "(?s)\"surface\"\\s*:\\s*\"[^\"]+\".*\"surface\"\\s*:\\s*\"[^\"]+\""
              },
              {
                "field": "css",
                "matches": "var\\(--"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "tool_result_matches",
          "params": {
            "expect": [
              {
                "field": "admitted",
                "equals": true
              },
              {
                "field": "findings",
                "equals": []
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "new_order",
      "seed": {
        "collection": "FleetOrder",
        "document": {
          "unit": "TRK-44",
          "issue": "coolant leak",
          "severity": "critical"
        }
      },
      "deadline_secs": 300,
      "settle": true,
      "capture": [
        {
          "kind": "runs",
          "name": "seed_runs",
          "of_seed": true
        },
        {
          "kind": "documents",
          "name": "worker_runs",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_ne": "gents:agent-slot:engineer"
            },
            "purpose": {
              "_eq": "normal"
            },
            "lifecycle_state": {
              "_eq": "completed"
            },
            "caused_by_trigger_id": {
              "_ne": null
            }
          },
          "fields": [
            "request_id",
            "agent_did",
            "session_id",
            "lifecycle_state",
            "caused_by_trigger_id"
          ]
        },
        {
          "kind": "documents",
          "name": "notes",
          "collection": "FleetNote",
          "filter": {
            "unit": {
              "_eq": "TRK-44"
            }
          },
          "fields": [
            "unit",
            "summary"
          ]
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "seed_runs",
                "min": 1,
                "max": 1
              },
              {
                "capture": "worker_runs",
                "min": 1,
                "max": 1
              },
              {
                "capture": "notes",
                "min": 1,
                "max": 1
              }
            ],
            "rows": [
              {
                "capture": "notes",
                "key": "unit",
                "id": "TRK-44",
                "expect": [
                  {
                    "field": "summary",
                    "matches": "(?i)coolant|leak|TRK-44|critical"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "evolve",
      "prompt": "Add a priority text field to FleetNote, update Fleet Dispatcher so it wakes only when a new FleetOrder has severity critical, and add a line chart plus an empty state to the \"Fleet Service\" page while keeping its themed CSS and relinting.",
      "capture": [
        {
          "kind": "schema",
          "name": "schema",
          "collections": [
            "FleetNote"
          ]
        },
        {
          "kind": "documents",
          "name": "pages",
          "collection": "Page",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "page_id",
            "display_name",
            "module",
            "css",
            "data",
            "enabled"
          ]
        },
        {
          "kind": "documents",
          "name": "worker",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "enabled": {
              "_eq": true
            },
            "display_name": {
              "_ilike": "%fleet dispatcher%"
            }
          },
          "fields": [
            "agent_did",
            "display_name"
          ]
        }
      ],
      "checks": [
        {
          "check": "schema_matches",
          "params": {
            "name": "schema",
            "sdl": "type FleetNote { unit: String summary: String priority: String }"
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "pages",
                "min": 1,
                "max": 1
              },
              {
                "capture": "worker",
                "min": 1,
                "max": 1
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "pages",
            "min_rows": 1,
            "max_rows": 1,
            "expect": [
              {
                "field": "enabled",
                "equals": true
              },
              {
                "field": "display_name",
                "fallback_field": "page_id",
                "matches": "(?i)fleet[- ]?service"
              },
              {
                "field": "module",
                "matches": "\\b(?:jsx|jsxs|createElement)\\("
              },
              {
                "field": "module",
                "matches": "\\bPLUGIN_PAGE_AREA\\b|['\"]plugin\\.pages['\"]"
              },
              {
                "field": "module",
                "matches": "\\buseQuery\\("
              },
              {
                "field": "module",
                "matches": "\\buseWrite\\("
              },
              {
                "field": "module",
                "matches": "\\bLineChart\\b"
              },
              {
                "field": "module",
                "matches": "\\b(EmptyState|LoadingState)\\b"
              },
              {
                "field": "module",
                "matches": "\\bTable\\b"
              },
              {
                "field": "module",
                "matches": "\\bpriority\\b"
              },
              {
                "field": "data",
                "matches": "(?s)\"surface\"\\s*:\\s*\"[^\"]+\".*\"surface\"\\s*:\\s*\"[^\"]+\""
              },
              {
                "field": "css",
                "matches": "var\\(--"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "tool_result_matches",
          "params": {
            "expect": [
              {
                "field": "admitted",
                "equals": true
              },
              {
                "field": "findings",
                "equals": []
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "low_severity_skip",
      "seed": {
        "collection": "FleetOrder",
        "document": {
          "unit": "VAN-88",
          "issue": "wiper blade",
          "severity": "low"
        }
      },
      "expect_fire": false,
      "deadline_secs": 180,
      "capture": [
        {
          "kind": "runs",
          "name": "runs",
          "of_seed": true
        }
      ],
      "checks": [
        {
          "check": "captured_rows_count",
          "params": {
            "name": "runs",
            "min": 0,
            "max": 0
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "critical_after_evolve",
      "seed": {
        "collection": "FleetOrder",
        "document": {
          "unit": "TRK-99",
          "issue": "axle crack",
          "severity": "critical"
        }
      },
      "deadline_secs": 300,
      "settle": true,
      "capture": [
        {
          "kind": "runs",
          "name": "seed_runs",
          "of_seed": true
        },
        {
          "kind": "documents",
          "name": "skipped_notes",
          "collection": "FleetNote",
          "filter": {
            "unit": {
              "_eq": "VAN-88"
            }
          },
          "fields": [
            "unit",
            "summary"
          ]
        },
        {
          "kind": "documents",
          "name": "crit_notes",
          "collection": "FleetNote",
          "filter": {
            "unit": {
              "_eq": "TRK-99"
            }
          },
          "fields": [
            "unit",
            "summary",
            "priority"
          ]
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "seed_runs",
                "min": 1,
                "max": 1
              },
              {
                "capture": "skipped_notes",
                "min": 0,
                "max": 0
              },
              {
                "capture": "crit_notes",
                "min": 1,
                "max": 1
              }
            ],
            "rows": [
              {
                "capture": "crit_notes",
                "key": "unit",
                "id": "TRK-99",
                "expect": [
                  {
                    "field": "summary",
                    "matches": "(?i)axle|crack|TRK-99|critical"
                  },
                  {
                    "field": "priority",
                    "matches": "\\S+"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}
