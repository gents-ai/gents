{
  "case_id": "solar-grid-dispatch",
  "split": "held_out",
  "reducer": "all",
  "fixtures": {
    "schemas": [
      "type ArrayMeter { site: String kw: Float hour: String }",
      "type GridDispatch { site: String action: String }"
    ],
    "documents": [
      {
        "collection": "ArrayMeter",
        "document": {
          "site": "mesa",
          "kw": 28.0,
          "hour": "09:00"
        }
      }
    ]
  },
  "stages": [
    {
      "stage_id": "build",
      "prompt": "Set up a Grid Operator agent woken in session site- plus site only when a new ArrayMeter drops below 15 kw, logging a GridDispatch. Build and lint a Solar Grid page showing a line chart, stats, and status badges.",
      "capture": [
        {
          "kind": "documents",
          "name": "pages",
          "collection": "Page",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "page_id",
            "display_name",
            "module",
            "css",
            "data",
            "enabled"
          ]
        },
        {
          "kind": "documents",
          "name": "surfaces",
          "collection": "DatastoreToolSurface",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "surface_id": {
              "_ne": "engineer-mailbox"
            }
          },
          "fields": [
            "surface_id",
            "display_name",
            "entries",
            "enabled"
          ]
        },
        {
          "kind": "documents",
          "name": "worker",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "enabled": {
              "_eq": true
            },
            "display_name": {
              "_ilike": "%grid operator%"
            }
          },
          "fields": [
            "agent_did",
            "display_name"
          ]
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "pages",
                "min": 1,
                "max": 1
              },
              {
                "capture": "surfaces",
                "min": 1
              },
              {
                "capture": "worker",
                "min": 1,
                "max": 1
              }
            ],
            "rows": [
              {
                "capture": "pages",
                "key": "display_name",
                "id": "Solar Grid",
                "expect": [
                  {
                    "field": "enabled",
                    "equals": true
                  },
                  {
                    "field": "module",
                    "matches": "\\bLineChart\\b"
                  },
                  {
                    "field": "module",
                    "matches": "\\bStat\\b"
                  },
                  {
                    "field": "module",
                    "matches": "\\bBadge\\b"
                  },
                  {
                    "field": "module",
                    "matches": "\\buseQuery\\b"
                  },
                  {
                    "field": "module",
                    "matches": "\\bkw\\b"
                  },
                  {
                    "field": "data",
                    "matches": "\"surface\"\\s*:\\s*\"[^\"]+\""
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "surfaces",
            "min_rows": 1,
            "expect": [
              {
                "field": "entries",
                "matches": "\"collection\"\\s*:\\s*\"(ArrayMeter|GridDispatch)\""
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "tool_result_matches",
          "params": {
            "expect": [
              {
                "field": "admitted",
                "equals": true
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "healthy_site",
      "seed": {
        "collection": "ArrayMeter",
        "document": {
          "site": "ridge",
          "kw": 24.5,
          "hour": "10:00"
        }
      },
      "deadline_secs": 180,
      "capture": [],
      "checks": []
    },
    {
      "stage_id": "low_site",
      "seed": {
        "collection": "ArrayMeter",
        "document": {
          "site": "valley",
          "kw": 9.2,
          "hour": "10:05"
        }
      },
      "deadline_secs": 300,
      "settle": true,
      "capture": [
        {
          "kind": "documents",
          "name": "ridge_dispatches",
          "collection": "GridDispatch",
          "filter": {
            "site": {
              "_eq": "ridge"
            }
          },
          "fields": [
            "site",
            "action"
          ]
        },
        {
          "kind": "documents",
          "name": "valley_dispatches",
          "collection": "GridDispatch",
          "filter": {
            "site": {
              "_eq": "valley"
            }
          },
          "fields": [
            "site",
            "action"
          ]
        },
        {
          "kind": "documents",
          "name": "valley_runs",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "session_id": {
              "_eq": "site-valley"
            },
            "caused_by_trigger_id": {
              "_ne": null
            },
            "lifecycle_state": {
              "_eq": "completed"
            }
          },
          "fields": [
            "request_id",
            "session_id"
          ]
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "ridge_dispatches",
                "min": 0,
                "max": 0
              },
              {
                "capture": "valley_dispatches",
                "min": 1
              },
              {
                "capture": "valley_runs",
                "min": 1
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}
