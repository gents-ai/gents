  "stages": [
    {
      "stage_id": "run",
      "prompt": "Put a note in my inbox titled \"Warm cold bins\" listing every cold bin running warmer than 8 degrees (exactly 8 is fine), written as BIN (TEMP) and sorted by bin, like \"CB-90 (12), CB-91 (15)\".",
      "capture": [
        {
          "kind": "documents",
          "name": "notices",
          "collection": "MailboxItem",
          "filter": {
            "title": {
              "_eq": "Warm cold bins"
            }
          },
          "fields": [
            "title",
            "summary",
            "payload",
            "status"
          ]
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "notices",
                "min": 1,
                "max": 1
              }
            ],
            "rows": [
              {
                "capture": "notices",
                "key": "title",
                "id": "Warm cold bins",
                "expect": [
                  {
                    "field": "summary",
                    "fallback_field": "payload",
                    "matches": "^(?:[^C]|C[^B])*CB-14 \\(9\\),\\s*CB-23 \\(12\\),\\s*CB-30 \\(10\\),\\s*CB-41 \\(9\\)(?:[^C]|C[^B]|C$)*$"
                  },
                  {
                    "field": "status",
                    "equals": "open"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
