{
  "case_id": "pickup-reconcile",
  "split": "train",
  "reducer": "all",
  "fixtures": {
    "files": [
      {
        "path": "pickup/orders.json",
        "contents": "[\n  {\n    \"order\": \"PL-71\",\n    \"units\": 4\n  },\n  {\n    \"order\": \"PL-74\",\n    \"units\": 9\n  },\n  {\n    \"order\": \"PL-80\",\n    \"units\": 5\n  }\n]\n"
      },
      {
        "path": "pickup/scans.json",
        "contents": "[\n  {\n    \"order\": \"PL-71\",\n    \"scanned\": 2\n  },\n  {\n    \"order\": \"PL-74\",\n    \"scanned\": 4\n  },\n  {\n    \"order\": \"PL-80\",\n    \"scanned\": 5\n  },\n  {\n    \"order\": \"PL-74\",\n    \"scanned\": 3,\n    \"void\": true\n  },\n  {\n    \"order\": \"PL-71\",\n    \"scanned\": 2\n  },\n  {\n    \"order\": \"PL-74\",\n    \"scanned\": 2\n  }\n]\n"
      }
    ]
  },
  "stages": [
    {
      "stage_id": "run",
      "prompt": "Reconcile today's pickups with one script: have it read pickup/orders.json and pickup/scans.json through your file tools and add up every scan per order; a scan marked void doesn't count. Which order is short, by how many units, and how many orders are fully scanned? Make the script return an object with short_order, missing_units and fulfilled_orders, then tell me those three facts. Don't change either file.",
      "capture": [
        {
          "kind": "documents",
          "name": "inner_reads",
          "collection": "AgentToolCall",
          "filter": {
            "plugin_parent_tool_call_doc_id": {
              "_ne": null
            },
            "tool_name": {
              "_eq": "read_file"
            },
            "lifecycle_state": {
              "_eq": "completed"
            }
          },
          "fields": [
            "tool_name",
            "lifecycle_state",
            "plugin_parent_tool_call_doc_id"
          ]
        },
        {
          "kind": "file",
          "name": "pickup",
          "glob": "pickup/*.json"
        }
      ],
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "script",
              "read_file"
            ],
            "forbidden": [
              "bash",
              "bash_unrestricted",
              "write_file",
              "edit_file"
            ],
            "config_read_only": true
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "tool_result_matches",
          "params": {
            "expect": [
              {
                "field": "short_order",
                "equals": "PL-74"
              },
              {
                "field": "missing_units",
                "equals": 3
              },
              {
                "field": "fulfilled_orders",
                "equals": 2
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "inner_reads",
                "min": 2
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_files_match",
          "params": {
            "name": "pickup",
            "expect": [
              {
                "path": "pickup/orders.json",
                "sha256": "96a047f510a2a8706a62b0260e92d27e92589fc303cac3f525a69d8361ed1d22"
              },
              {
                "path": "pickup/scans.json",
                "sha256": "1aa31976aff4ee775a17299f61484af9d2c46a02122a64d0218c5be45b2e85d2"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              {
                "matches": "PL-74"
              },
              {
                "matches": "(?i)\\b(3|three)\\b"
              },
              {
                "matches": "(?i)\\b(2|two)\\b"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}
