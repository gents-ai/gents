  "stages": [
    {
      "stage_id": "run",
      "prompt": "Each support ticket is a JSON file in tickets/. In a single script, close every stale ticket: one whose status is open, that is waiting_on the customer, and whose idle_days is at least 14. Set its status to closed and keep its other fields as they are; leave every other ticket file exactly as it is. Have the script return {\"closed\": [...]} with the closed ticket IDs sorted, and tell me how many you closed.",
      "capture": [
        {
          "kind": "documents",
          "name": "inner_writes",
          "collection": "AgentToolCall",
          "filter": {
            "plugin_parent_tool_call_doc_id": {
              "_ne": null
            },
            "tool_name": {
              "_in": [
                "write_file",
                "edit_file"
              ]
            },
            "lifecycle_state": {
              "_eq": "completed"
            }
          },
          "fields": [
            "tool_name",
            "lifecycle_state",
            "plugin_parent_tool_call_doc_id"
          ]
        },
        {
          "kind": "documents",
          "name": "inner_reads",
          "collection": "AgentToolCall",
          "filter": {
            "plugin_parent_tool_call_doc_id": {
              "_ne": null
            },
            "tool_name": {
              "_in": [
                "read_file",
                "list_files",
                "glob",
                "grep"
              ]
            },
            "lifecycle_state": {
              "_eq": "completed"
            }
          },
          "fields": [
            "tool_name",
            "lifecycle_state",
            "plugin_parent_tool_call_doc_id"
          ]
        },
        {
          "kind": "file",
          "name": "tickets",
          "glob": "tickets/*.json"
        }
      ],
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "script"
            ],
            "forbidden": [
              "bash"
            ],
            "config_read_only": true
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "tool_result_matches",
          "params": {
            "expect": [
              {
                "field": "closed",
                "equals": [
                  "T-101",
                  "T-105",
                  "T-107",
                  "T-109",
                  "T-111"
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "inner_writes",
                "min": 5
              },
              {
                "capture": "inner_reads",
                "min": 1
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_files_match",
          "params": {
            "name": "tickets",
            "expect": [
              {
                "path": "tickets/T-101.json",
                "pointer": "/status",
                "equals": "closed"
