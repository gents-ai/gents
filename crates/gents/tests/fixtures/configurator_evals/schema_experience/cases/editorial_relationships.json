{
  "case_id": "editorial-relationships",
  "split": "validation",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "configure",
      "prompt": "We need an editorial database: Writer { name, stories } and Story { headline, draft, writer }. Name and headline are text, draft is true/false. A writer has many stories and each story one writer, linked both ways. Headlines are English and need keyword search, best match first.",
      "checks": [
        {
          "check": "schema_matches",
          "params": {
            "name": "schema",
            "sdl": "type Writer { name: String stories: [Story] } type Story { headline: String @fulltext(language:\"english\") draft: Boolean writer: Writer }"
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "schema",
          "name": "schema",
          "collections": [
            "Writer",
            "Story"
          ]
        }
      ]
    },
    {
      "stage_id": "use",
      "settle": true,
      "continuation": {
        "prompt": "OK, go ahead.",
        "max": 1,
        "until": "loaded"
      },
      "prompt": "Add writer Ada Okafor with stories \"Harbor dredging delayed again\" (draft) and \"Council approves harbor budget\" (not a draft), and writer Ben Ruiz with \"School lunch prices rise\" (not a draft). Search the headlines for \"lunch\": who wrote the best match?",
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "writers",
                "min": 2,
                "max": 2
              },
              {
                "capture": "stories",
                "min": 3,
                "max": 3
              }
            ],
            "rows": [
              {
                "capture": "writers",
                "key": "name",
                "id": "Ada Okafor",
                "expect": []
              },
              {
                "capture": "writers",
                "key": "name",
                "id": "Ben Ruiz",
                "expect": []
              },
              {
                "capture": "stories",
                "key": "headline",
                "id": "Harbor dredging delayed again",
                "expect": [
                  {
                    "field": "draft",
                    "equals": true
                  }
                ]
              },
              {
                "capture": "stories",
                "key": "headline",
                "id": "Council approves harbor budget",
                "expect": [
                  {
                    "field": "draft",
                    "equals": false
                  }
                ]
              },
              {
                "capture": "stories",
                "key": "headline",
                "id": "School lunch prices rise",
                "expect": [
                  {
                    "field": "draft",
                    "equals": false
                  }
                ]
              }
            ],
            "links": [
              {
                "capture": "stories",
                "key": "headline",
                "id": "Harbor dredging delayed again",
                "field": "writer_id",
                "target_capture": "writers",
                "target_key": "_docID",
                "expect": [
                  {
                    "field": "name",
                    "equals": "Ada Okafor"
                  }
                ]
              },
              {
                "capture": "stories",
                "key": "headline",
                "id": "Council approves harbor budget",
                "field": "writer_id",
                "target_capture": "writers",
                "target_key": "_docID",
                "expect": [
                  {
                    "field": "name",
                    "equals": "Ada Okafor"
                  }
                ]
              },
              {
                "capture": "stories",
                "key": "headline",
                "id": "School lunch prices rise",
                "field": "writer_id",
                "target_capture": "writers",
                "target_key": "_docID",
                "expect": [
                  {
                    "field": "name",
                    "equals": "Ben Ruiz"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              {
                "matches": "(?i)\\bBen\\b|\\bRuiz\\b"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "writers",
          "collection": "Writer",
          "filter": {},
          "fields": [
            "_docID",
            "name"
          ]
        },
        {
          "kind": "documents",
          "name": "stories",
          "collection": "Story",
          "filter": {},
          "fields": [
            "headline",
            "draft",
            "writer_id"
          ]
        },
        {
          "kind": "documents",
          "name": "loaded",
          "collection": "Story",
          "filter": {
            "headline": {
              "_eq": "School lunch prices rise"
            }
          },
          "fields": [
            "headline"
          ]
        }
      ]
    }
  ]
}
