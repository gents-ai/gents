{
  "case_id": "cooler-target-temperature",
  "split": "train",
  "reducer": "all",
  "fixtures": {
    "schemas": [
      "type CoolerRack { rack: String @index(unique: true) zone: String verified_c: Int }",
      "type CoolerImport { rack: String @index(unique: true) import_c: Int }",
      "type CoolerInspection { inspection: String @index(unique: true) rack: String note: String }"
    ],
    "documents": [
      {
        "collection": "CoolerRack",
        "document": {
          "rack": "CR-2",
          "zone": "east",
          "verified_c": 0
        }
      },
      {
        "collection": "CoolerRack",
        "document": {
          "rack": "CR-4",
          "zone": "west"
        }
      },
      {
        "collection": "CoolerRack",
        "document": {
          "rack": "CR-7",
          "zone": "east",
          "verified_c": -2
        }
      },
      {
        "collection": "CoolerRack",
        "document": {
          "rack": "CR-9",
          "zone": "west"
        }
      },
      {
        "collection": "CoolerImport",
        "document": {
          "rack": "CR-2",
          "import_c": 5
        }
      },
      {
        "collection": "CoolerImport",
        "document": {
          "rack": "CR-4",
          "import_c": -3
        }
      },
      {
        "collection": "CoolerImport",
        "document": {
          "rack": "CR-9"
        }
      },
      {
        "collection": "CoolerInspection",
        "document": {
          "inspection": "CI-1",
          "rack": "CR-2",
          "note": "manual review"
        }
      },
      {
        "collection": "CoolerInspection",
        "document": {
          "inspection": "CI-2",
          "rack": "CR-4",
          "note": "probe changed"
        }
      }
    ]
  },
  "stages": [
    {
      "stage_id": "access",
      "prompt": "I keep application records in CoolerRack, CoolerImport and CoolerInspection. Enable your general read access only to those collections, and general create/update/delete access only to CoolerRack if your native tools support it. Keep shell execution off and leave all other collection permissions alone. Inspect the available fields before working with records. Set up only the access now; do not change any records or collection definitions until I send the change request.",
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ],
            "forbidden": [
              "bash"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "schema_matches",
          "params": {
            "name": "schema",
            "sdl": "type CoolerRack { rack: String @index(unique: true) zone: String verified_c: Int }\ntype CoolerImport { rack: String @index(unique: true) import_c: Int }\ntype CoolerInspection { inspection: String @index(unique: true) rack: String note: String }",
            "exact_nullability": true
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "agents": {
              "agents": "agents",
              "contexts": "contexts",
              "tools": "tools",
              "expect": [
                {
                  "agent_did": "gents:agent-slot:engineer",
                  "tools": [
                    {
                      "field": "host.bash.mode",
                      "matches": "^(null|Off)$"
                    },
                    {
                      "field": "datastore.write_collections",
                      "equals": [
                        "CoolerRack"
                      ]
                    },
                    {
                      "field": "datastore.defra_query_collections",
                      "contains": "\"CoolerRack\""
                    },
                    {
                      "field": "datastore.defra_query_collections",
                      "contains": "\"CoolerImport\""
                    },
                    {
                      "field": "datastore.defra_query_collections",
                      "contains": "\"CoolerInspection\""
                    }
                  ]
                }
              ]
            },
            "present": [
              {
                "capture": "CoolerRack",
                "min": 4,
                "max": 4
              },
              {
                "capture": "CoolerImport",
                "min": 3,
                "max": 3
              },
              {
                "capture": "CoolerInspection",
                "min": 2,
                "max": 2
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_did",
            "display_name",
            "context_id"
          ]
        },
        {
          "kind": "documents",
          "name": "contexts",
          "collection": "AgentContext",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "context_id",
            "tools_id"
          ]
        },
        {
          "kind": "documents",
          "name": "tools",
          "collection": "Tools",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "tools_id",
            "host",
            "datastore"
          ]
        },
        {
          "kind": "schema",
          "name": "schema",
          "collections": [
            "CoolerRack",
            "CoolerImport",
            "CoolerInspection"
          ]
        },
        {
          "kind": "documents",
          "name": "CoolerRack",
          "collection": "CoolerRack",
          "filter": {},
          "fields": [
            "rack",
            "zone",
            "verified_c"
          ]
        },
        {
          "kind": "documents",
          "name": "CoolerImport",
          "collection": "CoolerImport",
          "filter": {},
          "fields": [
            "rack",
            "import_c"
          ]
        },
        {
          "kind": "documents",
          "name": "CoolerInspection",
          "collection": "CoolerInspection",
          "filter": {},
          "fields": [
            "inspection",
            "rack",
            "note"
          ]
        }
      ]
    },
    {
      "stage_id": "migrate",
      "prompt": "Add an optional integer target_c to CoolerRack. Backfill it from CoolerImport for racks with no verified_c. A verified value always wins, including zero. Leave target_c unset when neither source has a value. Keep the existing rack records, fields and inspections. Reply with one JSON object whose \"unresolved\" array lists the rack values.",
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "forbidden": [
              "bash"
            ],
            "config_read_only": true
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "schema_matches",
          "params": {
            "name": "schema",
            "sdl": "type CoolerRack { rack: String @index(unique: true) zone: String verified_c: Int target_c: Int }\ntype CoolerImport { rack: String @index(unique: true) import_c: Int }\ntype CoolerInspection { inspection: String @index(unique: true) rack: String note: String }",
            "exact_nullability": true
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "CoolerRack",
                "min": 4,
                "max": 4
              },
              {
                "capture": "CoolerImport",
                "min": 3,
                "max": 3
              },
              {
                "capture": "CoolerInspection",
                "min": 2,
                "max": 2
              }
            ],
            "rows": [
              {
                "capture": "CoolerRack",
                "key": "rack",
                "id": "CR-2",
                "expect": [
                  {
                    "field": "zone",
                    "equals": "east"
                  },
                  {
                    "field": "verified_c",
                    "equals": 0
                  },
                  {
                    "field": "target_c",
                    "equals": 0
                  }
                ]
              },
              {
                "capture": "CoolerRack",
                "key": "rack",
                "id": "CR-4",
                "expect": [
                  {
                    "field": "zone",
                    "equals": "west"
                  },
                  {
                    "field": "verified_c",
                    "equals": null
                  },
                  {
                    "field": "target_c",
                    "equals": -3
                  }
                ]
              },
              {
                "capture": "CoolerRack",
                "key": "rack",
                "id": "CR-7",
                "expect": [
                  {
                    "field": "zone",
                    "equals": "east"
                  },
                  {
                    "field": "verified_c",
                    "equals": -2
                  },
                  {
                    "field": "target_c",
                    "equals": -2
                  }
                ]
              },
              {
                "capture": "CoolerRack",
                "key": "rack",
                "id": "CR-9",
                "expect": [
                  {
                    "field": "zone",
                    "equals": "west"
                  },
                  {
                    "field": "verified_c",
                    "equals": null
                  },
                  {
                    "field": "target_c",
                    "equals": null
                  }
                ]
              },
              {
                "capture": "CoolerImport",
                "key": "rack",
                "id": "CR-2",
                "expect": [
                  {
                    "field": "import_c",
                    "equals": 5
                  }
                ]
              },
              {
                "capture": "CoolerImport",
                "key": "rack",
                "id": "CR-4",
                "expect": [
                  {
                    "field": "import_c",
                    "equals": -3
                  }
                ]
              },
              {
                "capture": "CoolerImport",
                "key": "rack",
                "id": "CR-9",
                "expect": [
                  {
                    "field": "import_c",
                    "equals": null
                  }
                ]
              },
              {
                "capture": "CoolerInspection",
                "key": "inspection",
                "id": "CI-1",
                "expect": [
                  {
                    "field": "rack",
                    "equals": "CR-2"
                  },
                  {
                    "field": "note",
                    "equals": "manual review"
                  }
                ]
              },
              {
                "capture": "CoolerInspection",
                "key": "inspection",
                "id": "CI-2",
                "expect": [
                  {
                    "field": "rack",
                    "equals": "CR-4"
                  },
                  {
                    "field": "note",
                    "equals": "probe changed"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              {
                "matches": "\"unresolved\"\\s*:\\s*\\[\\s*(?:\"CR-9\")\\s*\\]"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "schema",
          "name": "schema",
          "collections": [
            "CoolerRack",
            "CoolerImport",
            "CoolerInspection"
          ]
        },
        {
          "kind": "documents",
          "name": "CoolerRack",
          "collection": "CoolerRack",
          "filter": {},
          "fields": [
            "rack",
            "zone",
            "verified_c",
            "target_c"
          ]
        },
        {
          "kind": "documents",
          "name": "CoolerImport",
          "collection": "CoolerImport",
          "filter": {},
          "fields": [
            "rack",
            "import_c"
          ]
        },
        {
          "kind": "documents",
          "name": "CoolerInspection",
          "collection": "CoolerInspection",
          "filter": {},
          "fields": [
            "inspection",
            "rack",
            "note"
          ]
        }
      ]
    }
  ]
}
