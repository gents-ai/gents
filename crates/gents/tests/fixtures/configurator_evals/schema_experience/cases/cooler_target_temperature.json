{
  "case_id": "cooler-target-temperature",
  "split": "train",
  "reducer": "all",
  "fixtures": {
    "schemas": [
      "type CoolerRack { rack: String @index(unique: true) zone: String verified_c: Int }",
      "type CoolerImport { rack: String @index(unique: true) import_c: Int }",
      "type CoolerInspection { inspection: String @index(unique: true) rack: String note: String }"
    ],
    "documents": [
      {
        "collection": "CoolerRack",
        "document": {
          "rack": "CR-2",
          "zone": "east",
          "verified_c": 0
        }
      },
      {
        "collection": "CoolerRack",
        "document": {
          "rack": "CR-4",
          "zone": "west"
        }
      },
      {
        "collection": "CoolerRack",
        "document": {
          "rack": "CR-7",
          "zone": "east",
          "verified_c": -2
        }
      },
      {
        "collection": "CoolerRack",
        "document": {
          "rack": "CR-9",
          "zone": "west"
        }
      },
      {
        "collection": "CoolerImport",
        "document": {
          "rack": "CR-2",
          "import_c": 5
        }
      },
      {
        "collection": "CoolerImport",
        "document": {
          "rack": "CR-4",
          "import_c": -3
        }
      },
      {
        "collection": "CoolerImport",
        "document": {
          "rack": "CR-9"
        }
      },
      {
        "collection": "CoolerInspection",
        "document": {
          "inspection": "CI-1",
          "rack": "CR-2",
          "note": "manual review"
        }
      },
      {
        "collection": "CoolerInspection",
        "document": {
          "inspection": "CI-2",
          "rack": "CR-4",
          "note": "probe changed"
        }
      }
    ]
  },
  "stages": [
    {
      "stage_id": "migrate",
      "settle": true,
      "continuation": {
        "prompt": "OK, go ahead.",
        "max": 1,
        "until": "done"
      },
      "prompt": "Add an optional whole-number target_c to CoolerRack. Where a rack has a verified_c, use that, even when it is zero; otherwise take import_c from CoolerImport. Leave it empty if neither has a value. Which racks end up without a target?",
      "checks": [
        {
          "check": "schema_matches",
          "params": {
            "name": "schema",
            "sdl": "type CoolerRack { rack: String @index(unique: true) zone: String verified_c: Int target_c: Int }\ntype CoolerImport { rack: String @index(unique: true) import_c: Int }\ntype CoolerInspection { inspection: String @index(unique: true) rack: String note: String }",
            "exact_nullability": true
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "CoolerRack",
                "min": 4,
                "max": 4
              },
              {
                "capture": "CoolerImport",
                "min": 3,
                "max": 3
              },
              {
                "capture": "CoolerInspection",
                "min": 2,
                "max": 2
              }
            ],
            "rows": [
              {
                "capture": "CoolerRack",
                "key": "rack",
                "id": "CR-2",
                "expect": [
                  {
                    "field": "zone",
                    "equals": "east"
                  },
                  {
                    "field": "verified_c",
                    "equals": 0
                  },
                  {
                    "field": "target_c",
                    "equals": 0
                  }
                ]
              },
              {
                "capture": "CoolerRack",
                "key": "rack",
                "id": "CR-4",
                "expect": [
                  {
                    "field": "zone",
                    "equals": "west"
                  },
                  {
                    "field": "verified_c",
                    "equals": null
                  },
                  {
                    "field": "target_c",
                    "equals": -3
                  }
                ]
              },
              {
                "capture": "CoolerRack",
                "key": "rack",
                "id": "CR-7",
                "expect": [
                  {
                    "field": "zone",
                    "equals": "east"
                  },
                  {
                    "field": "verified_c",
                    "equals": -2
                  },
                  {
                    "field": "target_c",
                    "equals": -2
                  }
                ]
              },
              {
                "capture": "CoolerRack",
                "key": "rack",
                "id": "CR-9",
                "expect": [
                  {
                    "field": "zone",
                    "equals": "west"
                  },
                  {
                    "field": "verified_c",
                    "equals": null
                  },
                  {
                    "field": "target_c",
                    "equals": null
                  }
                ]
              },
              {
                "capture": "CoolerImport",
                "key": "rack",
                "id": "CR-2",
                "expect": [
                  {
                    "field": "import_c",
                    "equals": 5
                  }
                ]
              },
              {
                "capture": "CoolerImport",
                "key": "rack",
                "id": "CR-4",
                "expect": [
                  {
                    "field": "import_c",
                    "equals": -3
                  }
                ]
              },
              {
                "capture": "CoolerImport",
                "key": "rack",
                "id": "CR-9",
                "expect": [
                  {
                    "field": "import_c",
                    "equals": null
                  }
                ]
              },
              {
                "capture": "CoolerInspection",
                "key": "inspection",
                "id": "CI-1",
                "expect": [
                  {
                    "field": "rack",
                    "equals": "CR-2"
                  },
                  {
                    "field": "note",
                    "equals": "manual review"
                  }
                ]
              },
              {
                "capture": "CoolerInspection",
                "key": "inspection",
                "id": "CI-2",
                "expect": [
                  {
                    "field": "rack",
                    "equals": "CR-4"
                  },
                  {
                    "field": "note",
                    "equals": "probe changed"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              "CR-9"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "schema",
          "name": "schema",
          "collections": [
            "CoolerRack",
            "CoolerImport",
            "CoolerInspection"
          ]
        },
        {
          "kind": "documents",
          "name": "CoolerRack",
          "collection": "CoolerRack",
          "filter": {},
          "fields": [
            "rack",
            "zone",
            "verified_c",
            "target_c"
          ]
        },
        {
          "kind": "documents",
          "name": "CoolerImport",
          "collection": "CoolerImport",
          "filter": {},
          "fields": [
            "rack",
            "import_c"
          ]
        },
        {
          "kind": "documents",
          "name": "CoolerInspection",
          "collection": "CoolerInspection",
          "filter": {},
          "fields": [
            "inspection",
            "rack",
            "note"
          ]
        },
        {
          "kind": "documents",
          "name": "done",
          "collection": "CoolerRack",
          "filter": {
            "rack": {
              "_eq": "CR-4"
            },
            "target_c": {
              "_eq": -3
            }
          },
          "fields": [
            "rack",
            "target_c"
          ]
        }
      ]
    },
    {
      "stage_id": "read",
      "prompt": "Which racks have a target below zero now, and what is each one's target?",
      "checks": [
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              {
                "matches": "CR-4\\b[^\\n]{0,80}?[-−–]\\s?3\\b|[-−–]\\s?3\\b[^\\n]{0,80}?CR-4\\b"
              },
              {
                "matches": "CR-7\\b[^\\n]{0,80}?[-−–]\\s?2\\b|[-−–]\\s?2\\b[^\\n]{0,80}?CR-7\\b"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": []
    }
  ]
}
