{
  "case_id": "extend-customer-records",
  "split": "validation",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "configure",
      "prompt": "We already have Customer records in production. Add an optional notes text field and an optional newsletter true/false field, and keep every existing customer as it is.",
      "checks": [
        {
          "check": "schema_matches",
          "params": {
            "name": "schema",
            "sdl": "type Customer { name: String email: String notes: String newsletter: Boolean }",
            "exact_nullability": true
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "customers",
            "min": 2,
            "max": 2
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "rows": [
              {
                "capture": "customers",
                "key": "name",
                "id": "Mina",
                "expect": [
                  {
                    "field": "email",
                    "equals": "mina@example.test"
                  }
                ]
              },
              {
                "capture": "customers",
                "key": "name",
                "id": "Owen",
                "expect": [
                  {
                    "field": "email",
                    "equals": "owen@example.test"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "schema",
          "name": "schema",
          "collections": [
            "Customer"
          ]
        },
        {
          "kind": "documents",
          "name": "customers",
          "collection": "Customer",
          "filter": {},
          "fields": [
            "name",
            "email"
          ]
        }
      ]
    },
    {
      "stage_id": "use",
      "settle": true,
      "continuation": {
        "prompt": "OK, go ahead.",
        "max": 1,
        "until": "done"
      },
      "prompt": "Mina wants the newsletter. And add the note \"prefers phone calls\" to Owen.",
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "customers",
                "min": 2,
                "max": 2
              }
            ],
            "rows": [
              {
                "capture": "customers",
                "key": "name",
                "id": "Mina",
                "expect": [
                  {
                    "field": "email",
                    "equals": "mina@example.test"
                  },
                  {
                    "field": "newsletter",
                    "equals": true
                  }
                ]
              },
              {
                "capture": "customers",
                "key": "name",
                "id": "Owen",
                "expect": [
                  {
                    "field": "email",
                    "equals": "owen@example.test"
                  },
                  {
                    "field": "notes",
                    "equals": "prefers phone calls"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "customers",
          "collection": "Customer",
          "filter": {},
          "fields": [
            "name",
            "email",
            "notes",
            "newsletter"
          ]
        },
        {
          "kind": "documents",
          "name": "done",
          "collection": "Customer",
          "filter": {
            "name": {
              "_eq": "Owen"
            },
            "notes": {
              "_eq": "prefers phone calls"
            }
          },
          "fields": [
            "name",
            "notes"
          ]
        }
      ]
    }
  ],
  "fixtures": {
    "schemas": [
      "type Customer { name: String email: String }"
    ],
    "documents": [
      {
        "collection": "Customer",
        "document": {
          "name": "Mina",
          "email": "mina@example.test"
        }
      },
      {
        "collection": "Customer",
        "document": {
          "name": "Owen",
          "email": "owen@example.test"
        }
      }
    ]
  }
}
