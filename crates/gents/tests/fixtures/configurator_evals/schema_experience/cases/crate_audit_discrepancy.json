        {
          "check": "final_message_matches",
          "params": {
            "all": [
              {
                "matches": "\"missing\"\\s*:\\s*\\[\\s*(?:\"CT-111\"\\s*,\\s*\"CT-120\"|\"CT-120\"\\s*,\\s*\"CT-111\")\\s*\\]"
              }
