{
  "case_id": "catalog-neighbors",
  "split": "validation",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "configure",
      "prompt": "Our matching prototype gives every product a three-number vector. Set up CatalogItem with sku and label (text) and coordinates (the vector) so I can ask for the items closest to a vector by straight-line distance. The catalog is small, so exact answers matter more than speed.",
      "checks": [
        {
          "check": "schema_matches",
          "params": {
            "name": "schema",
            "sdl": "type CatalogItem { sku: String label: String coordinates: [Float32!] @index(vector:{dimensions:3,flat:{metric:EUCLIDEAN}}) }"
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "schema",
          "name": "schema",
          "collections": [
            "CatalogItem"
          ]
        }
      ]
    },
    {
      "stage_id": "use",
      "settle": true,
      "continuation": {
        "prompt": "OK, go ahead.",
        "max": 1,
        "until": "loaded"
      },
      "prompt": "Add NUT-1 \"hex nut\" [1, 0, 0], BOLT-2 \"hex bolt\" [0.9, 0.1, 0], GEAR-3 \"spur gear\" [0, 1, 0] and BELT-4 \"drive belt\" [0, 0, 1]. Which item is closest to [0.86, 0.14, 0]?",
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "items",
                "min": 4,
                "max": 4
              }
            ],
            "rows": [
              {
                "capture": "items",
                "key": "sku",
                "id": "NUT-1",
                "expect": [
                  {
                    "field": "label",
                    "equals": "hex nut"
                  }
                ]
              },
              {
                "capture": "items",
                "key": "sku",
                "id": "BOLT-2",
                "expect": [
                  {
                    "field": "label",
                    "equals": "hex bolt"
                  }
                ]
              },
              {
                "capture": "items",
                "key": "sku",
                "id": "GEAR-3",
                "expect": [
                  {
                    "field": "label",
                    "equals": "spur gear"
                  }
                ]
              },
              {
                "capture": "items",
                "key": "sku",
                "id": "BELT-4",
                "expect": [
                  {
                    "field": "label",
                    "equals": "drive belt"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              {
                "matches": "(?i)BOLT-2|hex bolt"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "items",
          "collection": "CatalogItem",
          "filter": {},
          "fields": [
            "sku",
            "label",
            "coordinates"
          ]
        },
        {
          "kind": "documents",
          "name": "loaded",
          "collection": "CatalogItem",
          "filter": {
            "sku": {
              "_eq": "BELT-4"
            }
          },
          "fields": [
            "sku"
          ]
        }
      ]
    }
  ]
}
