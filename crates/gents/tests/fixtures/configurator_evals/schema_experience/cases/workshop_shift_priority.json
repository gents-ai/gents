{
  "case_id": "workshop-shift-priority",
  "split": "validation",
  "reducer": "all",
  "fixtures": {
    "schemas": [
      "type WorkshopShift { shift: String @index(unique: true) station: String manual_priority: Boolean }",
      "type WorkshopQueue { line: String @index(unique: true) shift: String urgent: Boolean }",
      "type WorkshopStation { station: String @index(unique: true) display: String }"
    ],
    "documents": [
      {
        "collection": "WorkshopShift",
        "document": {
          "shift": "WS-14",
          "station": "press",
          "manual_priority": false
        }
      },
      {
        "collection": "WorkshopShift",
        "document": {
          "shift": "WS-18",
          "station": "bench"
        }
      },
      {
        "collection": "WorkshopShift",
        "document": {
          "shift": "WS-21",
          "station": "press"
        }
      },
      {
        "collection": "WorkshopShift",
        "document": {
          "shift": "WS-30",
          "station": "paint",
          "manual_priority": true
        }
      },
      {
        "collection": "WorkshopQueue",
        "document": {
          "line": "Q1",
          "shift": "WS-14",
          "urgent": true
        }
      },
      {
        "collection": "WorkshopQueue",
        "document": {
          "line": "Q2",
          "shift": "WS-18",
          "urgent": false
        }
      },
      {
        "collection": "WorkshopQueue",
        "document": {
          "line": "Q3",
          "shift": "WS-21",
          "urgent": true
        }
      },
      {
        "collection": "WorkshopQueue",
        "document": {
          "line": "Q4",
          "shift": "WS-21",
          "urgent": false
        }
      },
      {
        "collection": "WorkshopQueue",
        "document": {
          "line": "Q5",
          "shift": "WS-30",
          "urgent": false
        }
      },
      {
        "collection": "WorkshopStation",
        "document": {
          "station": "press",
          "display": "Brake press"
        }
      },
      {
        "collection": "WorkshopStation",
        "document": {
          "station": "bench",
          "display": "Repair bench"
        }
      },
      {
        "collection": "WorkshopStation",
        "document": {
          "station": "paint",
          "display": "Paint booth"
        }
      }
    ]
  },
  "stages": [
    {
      "stage_id": "migrate",
      "settle": true,
      "continuation": {
        "prompt": "OK, go ahead.",
        "max": 1,
        "until": "done"
      },
      "prompt": "Add an optional true/false priority to WorkshopShift. Keep a shift's manual_priority if it has one, even false. Otherwise use the urgent flag of its WorkshopQueue lines when they all agree. Leave it empty if they disagree or there are none. Which shifts are left empty?",
      "checks": [
        {
          "check": "schema_matches",
          "params": {
            "name": "schema",
            "sdl": "type WorkshopShift { shift: String @index(unique: true) station: String manual_priority: Boolean priority: Boolean }\ntype WorkshopQueue { line: String @index(unique: true) shift: String urgent: Boolean }\ntype WorkshopStation { station: String @index(unique: true) display: String }",
            "exact_nullability": true
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "WorkshopShift",
                "min": 4,
                "max": 4
              },
              {
                "capture": "WorkshopQueue",
                "min": 5,
                "max": 5
              },
              {
                "capture": "WorkshopStation",
                "min": 3,
                "max": 3
              }
            ],
            "rows": [
              {
                "capture": "WorkshopShift",
                "key": "shift",
                "id": "WS-14",
                "expect": [
                  {
                    "field": "station",
                    "equals": "press"
                  },
                  {
                    "field": "manual_priority",
                    "equals": false
                  },
                  {
                    "field": "priority",
                    "equals": false
                  }
                ]
              },
              {
                "capture": "WorkshopShift",
                "key": "shift",
                "id": "WS-18",
                "expect": [
                  {
                    "field": "station",
                    "equals": "bench"
                  },
                  {
                    "field": "manual_priority",
                    "equals": null
                  },
                  {
                    "field": "priority",
                    "equals": false
                  }
                ]
              },
              {
                "capture": "WorkshopShift",
                "key": "shift",
                "id": "WS-21",
                "expect": [
                  {
                    "field": "station",
                    "equals": "press"
                  },
                  {
                    "field": "manual_priority",
                    "equals": null
                  },
                  {
                    "field": "priority",
                    "equals": null
                  }
                ]
              },
              {
                "capture": "WorkshopShift",
                "key": "shift",
                "id": "WS-30",
                "expect": [
                  {
                    "field": "station",
                    "equals": "paint"
                  },
                  {
                    "field": "manual_priority",
                    "equals": true
                  },
                  {
                    "field": "priority",
                    "equals": true
                  }
                ]
              },
              {
                "capture": "WorkshopQueue",
                "key": "line",
                "id": "Q1",
                "expect": [
                  {
                    "field": "shift",
                    "equals": "WS-14"
                  },
                  {
                    "field": "urgent",
                    "equals": true
                  }
                ]
              },
              {
                "capture": "WorkshopQueue",
                "key": "line",
                "id": "Q2",
                "expect": [
                  {
                    "field": "shift",
                    "equals": "WS-18"
                  },
                  {
                    "field": "urgent",
                    "equals": false
                  }
                ]
              },
              {
                "capture": "WorkshopQueue",
                "key": "line",
                "id": "Q3",
                "expect": [
                  {
                    "field": "shift",
                    "equals": "WS-21"
                  },
                  {
                    "field": "urgent",
                    "equals": true
                  }
                ]
              },
              {
                "capture": "WorkshopQueue",
                "key": "line",
                "id": "Q4",
                "expect": [
                  {
                    "field": "shift",
                    "equals": "WS-21"
                  },
                  {
                    "field": "urgent",
                    "equals": false
                  }
                ]
              },
              {
                "capture": "WorkshopQueue",
                "key": "line",
                "id": "Q5",
                "expect": [
                  {
                    "field": "shift",
                    "equals": "WS-30"
                  },
                  {
                    "field": "urgent",
                    "equals": false
                  }
                ]
              },
              {
                "capture": "WorkshopStation",
                "key": "station",
                "id": "press",
                "expect": [
                  {
                    "field": "display",
                    "equals": "Brake press"
                  }
                ]
              },
              {
                "capture": "WorkshopStation",
                "key": "station",
                "id": "bench",
                "expect": [
                  {
                    "field": "display",
                    "equals": "Repair bench"
                  }
                ]
              },
              {
                "capture": "WorkshopStation",
                "key": "station",
                "id": "paint",
                "expect": [
                  {
                    "field": "display",
                    "equals": "Paint booth"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              "WS-21"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "schema",
          "name": "schema",
          "collections": [
            "WorkshopShift",
            "WorkshopQueue",
            "WorkshopStation"
          ]
        },
        {
          "kind": "documents",
          "name": "WorkshopShift",
          "collection": "WorkshopShift",
          "filter": {},
          "fields": [
            "shift",
            "station",
            "manual_priority",
            "priority"
          ]
        },
        {
          "kind": "documents",
          "name": "WorkshopQueue",
          "collection": "WorkshopQueue",
          "filter": {},
          "fields": [
            "line",
            "shift",
            "urgent"
          ]
        },
        {
          "kind": "documents",
          "name": "WorkshopStation",
          "collection": "WorkshopStation",
          "filter": {},
          "fields": [
            "station",
            "display"
          ]
        },
        {
          "kind": "documents",
          "name": "done",
          "collection": "WorkshopShift",
          "filter": {
            "shift": {
              "_eq": "WS-30"
            },
            "priority": {
              "_eq": true
            }
          },
          "fields": [
            "shift",
            "priority"
          ]
        }
      ]
    },
    {
      "stage_id": "read",
      "prompt": "Which shifts are marked as priority now?",
      "checks": [
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              "WS-30"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": []
    }
  ]
}
