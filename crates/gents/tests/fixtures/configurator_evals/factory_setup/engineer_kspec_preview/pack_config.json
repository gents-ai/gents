{
  "agent_principal": {},
  "agent_behaviors": [
    {
      "behavior_id": "engineer",
      "display_name": "The Engineer",
      "description": "Walks you through configuring Gents for the work you want to do.",
      "context_id": "engineer-context",
      "inference_profile_id": "gents:inference-slot:engineer",
      "enabled": true,
      "tags": [
        "gents:setup-steward"
      ]
    }
  ],
  "contexts": [
    {
      "context_id": "engineer-context",
      "display_name": "The Engineer",
      "system_prompt": "./engineer/system_prompt.md",
      "tools_id": "engineer-tools"
    }
  ],
  "tools": [
    {
      "tools_id": "engineer-tools",
      "display_name": "The Engineer (eval node)",
      "host": {
        "files": {
          "mode": "ReadWrite",
          "max_read_chars": 120000
        },
        "bash": {
          "mode": "Off"
        }
      },
      "subagents": {
        "enabled": true
      },
      "built_ins": {
        "enable_graph_tools": true,
        "enable_goal_tools": true,
        "enable_goal_creation": false,
        "enable_memory": false,
        "enable_session_history_tool": true,
        "enable_schema_tool": true,
        "enable_context_budget": true
      },
      "datastore": {
        "enable_defra_query": true,
        "datastore_tool_surface_ids": [
          "engineer-mailbox"
        ]
      },
      "self_config": {
        "enable_self_config": true,
        "self_config_categories": [
          "behavior",
          "tools",
          "profile",
          "persona",
          "backend",
          "mcp_service",
          "automation"
        ],
        "self_config_no_lockout": true,
        "self_config_preview": true,
        "enable_pack_install": true
      }
    }
  ],
  "datastore_tool_surfaces": [
    {
      "surface_id": "engineer-mailbox",
      "display_name": "Engineer escalations",
      "enabled": true,
      "entries": [
        {
          "notification": {
            "identity": {
              "mode": "event"
            },
            "kind": "flag",
            "action": "ack"
          },
          "tool_name": "file_mailbox_item",
          "collection": "MailboxItem",
          "description": "Publish notification content using the configured identity and handling policy; runtime stamps ownership and provenance.",
          "fields": [
            {
              "name": "title",
              "required": true
            },
            {
              "name": "summary",
              "required": false
            },
            {
              "name": "payload",
              "required": false
            }
          ]
        }
      ]
    }
  ]
}
