{
  "case_id": "freeze-check",
  "split": "validation",
  "reducer": "all",
  "fixtures": {
    "files": [
      {
        "path": "readings.json",
        "contents": "[{\"label\": \"plum\", \"value\": 0}, {\"label\": \"pine\", \"value\": 6}, {\"label\": \"oak\", \"value\": 1}]\n"
      }
    ]
  },
  "stages": [
    {
      "stage_id": "run",
      "prompt": "Start a background workflow called freeze-check. Have one worker agent check readings.json for readings below zero. Give me the receipt. The job should return JSON with a frozen array of matching labels, even if empty.",
      "settle": true,
      "capture": [
        {
          "kind": "documents",
          "name": "finished",
          "collection": "AgentToolCall",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "tool_name": {
              "_eq": "workflow"
            },
            "session_id": {
              "_eq": "$session"
            },
            "lifecycle_state": {
              "_eq": "completed"
            }
          },
          "fields": [
            "_docID",
            "lifecycle_state"
          ]
        },
        {
          "kind": "documents",
          "name": "children",
          "collection": "AgentSession",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "session_id": {
              "_like": "job-session:%"
            }
          },
          "fields": [
            "session_id",
            "agent_did"
          ]
        },
        {
          "kind": "documents",
          "name": "segments",
          "collection": "AgentOutputSegment",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "session_id": {
              "_eq": "$session"
            }
          },
          "fields": [
            "_docID",
            "source",
            "payload",
            "close"
          ]
        },
        {
          "kind": "documents",
          "name": "file_changes",
          "collection": "ToolFileChange",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "tool_call_doc_id",
            "session_id",
            "file_changes"
          ]
        }
      ],
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "workflow"
            ],
            "forbidden": [
              "agent_new"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "file_changes",
            "min": 0,
            "max": 0
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "finished",
                "min": 1,
                "max": 1
              },
              {
                "capture": "children",
                "min": 1,
                "max": 1
              }
            ],
            "links": [
              {
                "capture": "finished",
                "key": "lifecycle_state",
                "id": "completed",
                "field": "_docID",
                "target_capture": "segments",
                "target_key": "source.tool_call_doc_id",
                "expect": [
                  {
                    "field": "close",
                    "matches": "\\\\?\"outcome\\\\?\"\\s*:\\s*\\\\?\"complete\\\\?\""
                  },
                  {
                    "field": "payload",
                    "matches": "\\\\?\"frozen\\\\?\"\\s*:\\s*\\[\\s*\\]"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 2
        }
      ]
    }
  ]
}
