{
  "case_id": "freeze-check",
  "split": "validation",
  "reducer": "all",
  "fixtures": {
    "files": [
      {
        "path": "readings.json",
        "contents": "[{\"label\": \"plum\", \"value\": 0}, {\"label\": \"pine\", \"value\": 6}, {\"label\": \"oak\", \"value\": 1}]\n"
      }
    ]
  },
  "stages": [
    {
      "stage_id": "run",
      "prompt": "Run a background job called freeze-check: one helper checks readings.json for readings below zero, and the job returns frozen with the list of their labels, an empty list if there are none. Only read the file.",
      "settle": true,
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "finished",
                "min": 1
              },
              {
                "capture": "helpers",
                "min": 1,
                "max": 1
              },
              {
                "capture": "helper_calls",
                "min": 1
              }
            ],
            "links": [
              {
                "capture": "finished",
                "key": "lifecycle_state",
                "id": "completed",
                "field": "_docID",
                "target_capture": "segments",
                "target_key": "source.tool_call_doc_id",
                "expect": [
                  {
                    "field": "close",
                    "matches": "\\\\?\"outcome\\\\?\"\\s*:\\s*\\\\?\"complete\\\\?\""
                  },
                  {
                    "field": "payload",
                    "matches": "\\\\?\"frozen\\\\?\"\\s*:\\s*\\[\\s*\\]"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 2
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "file_changes",
            "min": 0,
            "max": 0
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "finished",
          "collection": "AgentToolCall",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "tool_name": {
              "_eq": "workflow"
            },
            "session_id": {
              "_eq": "$session"
            },
            "lifecycle_state": {
              "_eq": "completed"
            },
            "job_pin": {
              "handle": {
                "_eq": "freeze-check"
              }
            }
          },
          "fields": [
            "_docID",
            "lifecycle_state",
            "job_pin"
          ]
        },
        {
          "kind": "documents",
          "name": "helpers",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "session_id": {
              "_like": "job-session:%"
            },
            "caused_by_parent_tool_call_doc_id": {
              "_eq": {
                "$capture": {
                  "capture": "finished",
                  "source_match": {
                    "field": "lifecycle_state",
                    "matches": "^completed$"
                  },
                  "field": "_docID"
                }
              }
            },
            "lifecycle_state": {
              "_eq": "completed"
            }
          },
          "fields": [
            "request_id",
            "session_id",
            "lifecycle_state",
            "caused_by_parent_tool_call_doc_id"
          ]
        },
        {
          "kind": "documents",
          "name": "helper_calls",
          "collection": "AgentToolCall",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "session_id": {
              "_like": "job-session:%"
            }
          },
          "fields": [
            "session_id",
            "tool_name",
            "lifecycle_state"
          ]
        },
        {
          "kind": "documents",
          "name": "segments",
          "collection": "AgentOutputSegment",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "session_id": {
              "_eq": "$session"
            }
          },
          "fields": [
            "_docID",
            "source",
            "payload",
            "close"
          ]
        },
        {
          "kind": "documents",
          "name": "file_changes",
          "collection": "ToolFileChange",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "tool_call_doc_id",
            "session_id",
            "file_changes"
          ]
        }
      ]
    }
  ]
}
