{
  "case_id": "west-loading-reconcile",
  "split": "held_out",
  "reducer": "all",
  "fixtures": {
    "files": [
      {
        "path": "west-scan.csv",
        "contents": "pallet,reading\nM08,loaded\nM09,returned\nM13,loaded\nM08,loaded\nM14,loaded\n"
      },
      {
        "path": "dispatch.json",
        "contents": "[{\"pallet\": \"M08\", \"status\": \"outbound\"}, {\"pallet\": \"M09\", \"status\": \"outbound\"}, {\"pallet\": \"M12\", \"status\": \"outbound\"}, {\"pallet\": \"M13\", \"status\": \"outbound\"}, {\"pallet\": \"M14\", \"status\": \"hold\"}]\n"
      }
    ]
  },
  "stages": [
    {
      "stage_id": "run",
      "prompt": "Run a background job called west-loading-check with two helpers working side by side: one pulls the unique loaded pallet IDs from west-scan.csv, the other the outbound pallet IDs in dispatch.json. Return missing (outbound but not loaded) and unexpected (loaded but not outbound), each sorted. Only read the files.",
      "settle": true,
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "children",
                "min": 2,
                "max": 2
              }
            ],
            "links": [
              {
                "capture": "finished",
                "source_match": {
                  "field": "job_pin",
                  "matches": "\"handle\"\\s*:\\s*\"west-loading-check\""
                },
                "field": "_docID",
                "target_capture": "segments",
                "target_key": "source.tool_call_doc_id",
                "expect": [
                  {
                    "field": "close",
                    "matches": "\\\\?\"outcome\\\\?\"\\s*:\\s*\\\\?\"complete\\\\?\""
                  },
                  {
                    "field": "payload",
                    "matches": "\\\\?\"missing\\\\?\"\\s*:\\s*\\[\\s*\\\\?\"M09\\\\?\"\\s*,\\s*\\\\?\"M12\\\\?\"\\s*\\]"
                  },
                  {
                    "field": "payload",
                    "matches": "\\\\?\"unexpected\\\\?\"\\s*:\\s*\\[\\s*\\\\?\"M14\\\\?\"\\s*\\]"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 2
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "file_changes",
            "min": 0,
            "max": 0
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "finished",
          "collection": "AgentToolCall",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "tool_name": {
              "_eq": "workflow"
            },
            "session_id": {
              "_eq": "$session"
            },
            "lifecycle_state": {
              "_eq": "completed"
            }
          },
          "fields": [
            "_docID",
            "lifecycle_state",
            "job_pin"
          ]
        },
        {
          "kind": "documents",
          "name": "children",
          "collection": "AgentSession",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "session_id": {
              "_like": "job-session:%"
            }
          },
          "fields": [
            "session_id",
            "agent_did"
          ]
        },
        {
          "kind": "documents",
          "name": "helper_calls",
          "collection": "AgentToolCall",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "session_id": {
              "_like": "job-session:%"
            }
          },
          "fields": [
            "session_id",
            "tool_name",
            "lifecycle_state"
          ]
        },
        {
          "kind": "documents",
          "name": "segments",
          "collection": "AgentOutputSegment",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "session_id": {
              "_eq": "$session"
            }
          },
          "fields": [
            "_docID",
            "source",
            "payload",
            "close"
          ]
        },
        {
          "kind": "documents",
          "name": "file_changes",
          "collection": "ToolFileChange",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "tool_call_doc_id",
            "session_id",
            "file_changes"
          ]
        }
      ]
    }
  ]
}
