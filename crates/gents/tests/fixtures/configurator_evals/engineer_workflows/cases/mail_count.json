{
  "case_id": "mail-count",
  "split": "train",
  "reducer": "all",
  "fixtures": {
    "files": [
      {
        "path": "desks.json",
        "contents": "{\"upper\": 7, \"lower\": 18, \"ramp\": 4}\n"
      }
    ]
  },
  "stages": [
    {
      "stage_id": "run",
      "prompt": "Start a background workflow named mail-count. Have one worker agent total the unread counts in desks.json without changing it. The job result should be JSON with unread. Tell me the total once the job has finished.",
      "settle": true,
      "capture": [
        {
          "kind": "documents",
          "name": "finished",
          "collection": "AgentToolCall",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "tool_name": {
              "_eq": "workflow"
            },
            "session_id": {
              "_eq": "$session"
            },
            "lifecycle_state": {
              "_eq": "completed"
            }
          },
          "fields": [
            "_docID",
            "lifecycle_state"
          ]
        },
        {
          "kind": "documents",
          "name": "children",
          "collection": "AgentSession",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "session_id": {
              "_like": "job-session:%"
            }
          },
          "fields": [
            "session_id",
            "agent_did"
          ]
        },
        {
          "kind": "documents",
          "name": "segments",
          "collection": "AgentOutputSegment",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "session_id": {
              "_eq": "$session"
            }
          },
          "fields": [
            "_docID",
            "source",
            "payload",
            "close"
          ]
        },
        {
          "kind": "documents",
          "name": "file_changes",
          "collection": "ToolFileChange",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "tool_call_doc_id",
            "session_id",
            "file_changes"
          ]
        }
      ],
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "workflow"
            ],
            "forbidden": [
              "agent_new"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "file_changes",
            "min": 0,
            "max": 0
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "finished",
                "min": 1,
                "max": 1
              },
              {
                "capture": "children",
                "min": 1,
                "max": 1
              }
            ],
            "links": [
              {
                "capture": "finished",
                "key": "lifecycle_state",
                "id": "completed",
                "field": "_docID",
                "target_capture": "segments",
                "target_key": "source.tool_call_doc_id",
                "expect": [
                  {
                    "field": "close",
                    "matches": "\\\\?\"outcome\\\\?\"\\s*:\\s*\\\\?\"complete\\\\?\""
                  },
                  {
                    "field": "payload",
                    "matches": "\\\\?\"unread\\\\?\"\\s*:\\s*29\\b"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 2
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              "29"
            ]
          },
          "tier": "development",
          "weight": 1
        }
      ],
      "continuation": {
        "prompt": "Has mail-count finished? Tell me its unread total.",
        "max": 2,
        "until": "finished"
      }
    }
  ]
}
