{
  "case_id": "reefer-tally-fan-in",
  "split": "held_out",
  "reducer": "all",
  "fixtures": {
    "files": [
      {
        "path": "tallies/east.txt",
        "contents": "quay: east\nreefer: 12\ndry: 40\n"
      },
      {
        "path": "tallies/west.txt",
        "contents": "quay: west\ndry: 31\nreefer: 21\n"
      },
      {
        "path": "tallies/south.txt",
        "contents": "quay: south\nreefer: 14\ndry: 9\n"
      }
    ]
  },
  "stages": [
    {
      "stage_id": "run",
      "prompt": "The quay tallies are in tallies/, one file per quay. As one background job called reefer-tally, give each file its own helper to report that quay's reefer count, then return reefer_total, the sum, and busiest, the quay with the most reefers. Tell me both when it's done.",
      "settle": true,
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "children",
                "min": 3,
                "max": 3
              }
            ],
            "links": [
              {
                "capture": "finished",
                "source_match": {
                  "field": "job_pin",
                  "matches": "\"handle\"\\s*:\\s*\"reefer-tally\""
                },
                "field": "_docID",
                "target_capture": "segments",
                "target_key": "source.tool_call_doc_id",
                "expect": [
                  {
                    "field": "close",
                    "matches": "\\\\?\"outcome\\\\?\"\\s*:\\s*\\\\?\"complete\\\\?\""
                  },
                  {
                    "field": "payload",
                    "matches": "\\\\?\"reefer_total\\\\?\"\\s*:\\s*47\\b"
                  },
                  {
                    "field": "payload",
                    "matches": "\\\\?\"busiest\\\\?\"\\s*:\\s*\\\\?\"west\\\\?\""
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 2
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "file_changes",
            "min": 0,
            "max": 0
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              {
                "matches": "\\b47\\b"
              },
              {
                "matches": "(?i)\\bwest\\b"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "finished",
          "collection": "AgentToolCall",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "tool_name": {
              "_eq": "workflow"
            },
            "session_id": {
              "_eq": "$session"
            },
            "lifecycle_state": {
              "_eq": "completed"
            }
          },
          "fields": [
            "_docID",
            "lifecycle_state",
            "job_pin"
          ]
        },
        {
          "kind": "documents",
          "name": "children",
          "collection": "AgentSession",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "session_id": {
              "_like": "job-session:%"
            }
          },
          "fields": [
            "session_id",
            "agent_did"
          ]
        },
        {
          "kind": "documents",
          "name": "helper_calls",
          "collection": "AgentToolCall",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "session_id": {
              "_like": "job-session:%"
            }
          },
          "fields": [
            "session_id",
            "tool_name",
            "lifecycle_state"
          ]
        },
        {
          "kind": "documents",
          "name": "segments",
          "collection": "AgentOutputSegment",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "session_id": {
              "_eq": "$session"
            }
          },
          "fields": [
            "_docID",
            "source",
            "payload",
            "close"
          ]
        },
        {
          "kind": "documents",
          "name": "file_changes",
          "collection": "ToolFileChange",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "tool_call_doc_id",
            "session_id",
            "file_changes"
          ]
        }
      ]
    }
  ]
}
