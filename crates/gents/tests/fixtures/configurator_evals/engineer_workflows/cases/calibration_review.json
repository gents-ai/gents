{
  "case_id": "calibration-review",
  "split": "validation",
  "reducer": "all",
  "fixtures": {
    "files": [
      {
        "path": "reports/limestone.json",
        "contents": "{\"station\": \"LST-47\", \"revision\": 8, \"offsets\": [-6, 0, 7]}\n"
      },
      {
        "path": "reports/lichen.json",
        "contents": "{\"station\": \"LCH-82\", \"revision\": 7, \"offsets\": [-3, 4, 9]}\n"
      }
    ]
  },
  "stages": [
    {
      "stage_id": "run",
      "prompt": "Run one background workflow named calibration-review. Have two worker agents each read exactly one report from reports/, then combine their returned data. Revision 8 is current. For a current station, put the range of its offsets under its station ID in spreads. Put older station IDs in stale. The workflow result should be JSON with spreads and stale. Keep the reports unchanged and give me the job address.",
      "settle": true,
      "capture": [
        {
          "kind": "documents",
          "name": "finished",
          "collection": "AgentToolCall",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "tool_name": {
              "_eq": "workflow"
            },
            "session_id": {
              "_eq": "$session"
            },
            "lifecycle_state": {
              "_eq": "completed"
            }
          },
          "fields": [
            "_docID",
            "lifecycle_state"
          ]
        },
        {
          "kind": "documents",
          "name": "children",
          "collection": "AgentSession",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "session_id": {
              "_like": "job-session:%"
            }
          },
          "fields": [
            "session_id",
            "agent_did"
          ]
        },
        {
          "kind": "documents",
          "name": "segments",
          "collection": "AgentOutputSegment",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "session_id": {
              "_eq": "$session"
            }
          },
          "fields": [
            "_docID",
            "source",
            "payload",
            "close"
          ]
        },
        {
          "kind": "documents",
          "name": "file_changes",
          "collection": "ToolFileChange",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "tool_call_doc_id",
            "session_id",
            "file_changes"
          ]
        }
      ],
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "workflow"
            ],
            "forbidden": [
              "agent_new"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "file_changes",
            "min": 0,
            "max": 0
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "finished",
                "min": 1,
                "max": 1
              },
              {
                "capture": "children",
                "min": 2,
                "max": 2
              }
            ],
            "links": [
              {
                "capture": "finished",
                "key": "lifecycle_state",
                "id": "completed",
                "field": "_docID",
                "target_capture": "segments",
                "target_key": "source.tool_call_doc_id",
                "expect": [
                  {
                    "field": "close",
                    "matches": "\\\\?\"outcome\\\\?\"\\s*:\\s*\\\\?\"complete\\\\?\""
                  },
                  {
                    "field": "payload",
                    "matches": "\\\\?\"spreads\\\\?\"\\s*:\\s*\\{\\s*\\\\?\"LST-47\\\\?\"\\s*:\\s*13\\s*\\}"
                  },
                  {
                    "field": "payload",
                    "matches": "\\\\?\"stale\\\\?\"\\s*:\\s*\\[\\s*\\\\?\"LCH-82\\\\?\"\\s*\\]"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 2
        }
      ]
    }
  ]
}
