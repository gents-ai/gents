{
  "case_id": "calibration-review",
  "split": "validation",
  "reducer": "all",
  "fixtures": {
    "files": [
      {
        "path": "reports/limestone.json",
        "contents": "{\"station\": \"LST-47\", \"revision\": 8, \"offsets\": [-6, 0, 7]}\n"
      },
      {
        "path": "reports/lichen.json",
        "contents": "{\"station\": \"LCH-82\", \"revision\": 7, \"offsets\": [-3, 4, 9]}\n"
      }
    ]
  },
  "stages": [
    {
      "stage_id": "run",
      "prompt": "Run background job calibration-review with two helpers, each reading one report in reports/. Revision 8 is current: map each current station ID in spreads to its max-minus-min offset, and list non-current station IDs in stale. Return spreads and stale without editing reports/.",
      "settle": true,
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "finished",
                "min": 1
              },
              {
                "capture": "helpers",
                "min": 2,
                "max": 2
              }
            ],
            "links": [
              {
                "capture": "finished",
                "key": "lifecycle_state",
                "id": "completed",
                "field": "_docID",
                "target_capture": "segments",
                "target_key": "source.tool_call_doc_id",
                "expect": [
                  {
                    "field": "close",
                    "matches": "\\\\?\"outcome\\\\?\"\\s*:\\s*\\\\?\"complete\\\\?\""
                  },
                  {
                    "field": "payload",
                    "matches": "\\\\?\"spreads\\\\?\"\\s*:\\s*\\{\\s*\\\\?\"LST-47\\\\?\"\\s*:\\s*13\\s*\\}"
                  },
                  {
                    "field": "payload",
                    "matches": "\\\\?\"stale\\\\?\"\\s*:\\s*\\[\\s*\\\\?\"LCH-82\\\\?\"\\s*\\]"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 2
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "file_changes",
            "min": 0,
            "max": 0
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "finished",
          "collection": "AgentToolCall",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "tool_name": {
              "_eq": "workflow"
            },
            "session_id": {
              "_eq": "$session"
            },
            "lifecycle_state": {
              "_eq": "completed"
            },
            "job_pin": {
              "handle": {
                "_eq": "calibration-review"
              }
            }
          },
          "fields": [
            "_docID",
            "lifecycle_state",
            "job_pin"
          ]
        },
        {
          "kind": "documents",
          "name": "helpers",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "session_id": {
              "_like": "job-session:%"
            },
            "caused_by_parent_tool_call_doc_id": {
              "_eq": {
                "$capture": {
                  "capture": "finished",
                  "source_match": {
                    "field": "lifecycle_state",
                    "matches": "^completed$"
                  },
                  "field": "_docID"
                }
              }
            },
            "lifecycle_state": {
              "_eq": "completed"
            }
          },
          "fields": [
            "request_id",
            "session_id",
            "lifecycle_state",
            "caused_by_parent_tool_call_doc_id"
          ]
        },
        {
          "kind": "documents",
          "name": "helper_calls",
          "collection": "AgentToolCall",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "session_id": {
              "_like": "job-session:%"
            }
          },
          "fields": [
            "session_id",
            "tool_name",
            "lifecycle_state"
          ]
        },
        {
          "kind": "documents",
          "name": "segments",
          "collection": "AgentOutputSegment",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "session_id": {
              "_eq": "$session"
            }
          },
          "fields": [
            "_docID",
            "source",
            "payload",
            "close"
          ]
        },
        {
          "kind": "documents",
          "name": "file_changes",
          "collection": "ToolFileChange",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "tool_call_doc_id",
            "session_id",
            "file_changes"
          ]
        }
      ]
    }
  ]
}
