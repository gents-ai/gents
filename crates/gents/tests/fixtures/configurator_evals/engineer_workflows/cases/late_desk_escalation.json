{
  "case_id": "late-desk-escalation",
  "split": "train",
  "reducer": "all",
  "fixtures": {
    "files": [
      {
        "path": "notices.json",
        "contents": "[{\"id\": \"N6\", \"state\": \"late\"}, {\"id\": \"N2\", \"state\": \"filed\"}, {\"id\": \"N1\", \"state\": \"late\"}, {\"id\": \"N4\", \"state\": \"on_time\"}]\n"
      },
      {
        "path": "escalations.json",
        "contents": "{\"N1\": \"Ines\", \"N6\": \"Teodor\", \"N2\": \"Ines\"}\n"
      }
    ]
  },
  "stages": [
    {
      "stage_id": "run",
      "prompt": "Run a background job called late-desk. One helper reads notices.json and reports the IDs marked late. Only if more than two are late, have a second helper look up each late ID's owner in escalations.json. Return late_ids, sorted, and escalated, true or false. Only read the files.",
      "settle": true,
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "finished",
                "min": 1
              },
              {
                "capture": "helpers",
                "min": 1,
                "max": 1
              }
            ],
            "links": [
              {
                "capture": "finished",
                "key": "lifecycle_state",
                "id": "completed",
                "field": "_docID",
                "target_capture": "segments",
                "target_key": "source.tool_call_doc_id",
                "expect": [
                  {
                    "field": "close",
                    "matches": "\\\\?\"outcome\\\\?\"\\s*:\\s*\\\\?\"complete\\\\?\""
                  },
                  {
                    "field": "payload",
                    "matches": "\\\\?\"late_ids\\\\?\"\\s*:\\s*\\[\\s*\\\\?\"N1\\\\?\"\\s*,\\s*\\\\?\"N6\\\\?\"\\s*\\]"
                  },
                  {
                    "field": "payload",
                    "matches": "\\\\?\"escalated\\\\?\"\\s*:\\s*false\\b"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 2
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "file_changes",
            "min": 0,
            "max": 0
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "finished",
          "collection": "AgentToolCall",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "tool_name": {
              "_eq": "workflow"
            },
            "session_id": {
              "_eq": "$session"
            },
            "lifecycle_state": {
              "_eq": "completed"
            },
            "job_pin": {
              "handle": {
                "_eq": "late-desk"
              }
            }
          },
          "fields": [
            "_docID",
            "lifecycle_state",
            "job_pin"
          ]
        },
        {
          "kind": "documents",
          "name": "helpers",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "session_id": {
              "_like": "job-session:%"
            },
            "lifecycle_state": {
              "_eq": "completed"
            }
          },
          "fields": [
            "request_id",
            "session_id",
            "lifecycle_state",
            "caused_by_parent_tool_call_doc_id"
          ]
        },
        {
          "kind": "documents",
          "name": "helper_calls",
          "collection": "AgentToolCall",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "session_id": {
              "_like": "job-session:%"
            }
          },
          "fields": [
            "session_id",
            "tool_name",
            "lifecycle_state"
          ]
        },
        {
          "kind": "documents",
          "name": "segments",
          "collection": "AgentOutputSegment",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "session_id": {
              "_eq": "$session"
            }
          },
          "fields": [
            "_docID",
            "source",
            "payload",
            "close"
          ]
        },
        {
          "kind": "documents",
          "name": "file_changes",
          "collection": "ToolFileChange",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "tool_call_doc_id",
            "session_id",
            "file_changes"
          ]
        }
      ]
    }
  ]
}
