{
  "case_id": "late-desk-escalation",
  "split": "train",
  "reducer": "all",
  "fixtures": {
    "files": [
      {
        "path": "notices.json",
        "contents": "[{\"id\": \"N6\", \"state\": \"late\"}, {\"id\": \"N2\", \"state\": \"filed\"}, {\"id\": \"N1\", \"state\": \"late\"}, {\"id\": \"N4\", \"state\": \"on_time\"}]\n"
      },
      {
        "path": "escalations.json",
        "contents": "{\"N1\": \"Ines\", \"N6\": \"Teodor\", \"N2\": \"Ines\"}\n"
      }
    ]
  },
  "stages": [
    {
      "stage_id": "run",
      "prompt": "Launch a background workflow called late-desk. First have one worker agent read notices.json and report the IDs marked late. Only if more than two notices are late, start a second worker to look up each late ID's owner in escalations.json. The job should return JSON with late_ids, a sorted list, and escalated, true or false.",
      "settle": true,
      "capture": [
        {
          "kind": "documents",
          "name": "finished",
          "collection": "AgentToolCall",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "tool_name": {
              "_eq": "workflow"
            },
            "session_id": {
              "_eq": "$session"
            },
            "lifecycle_state": {
              "_eq": "completed"
            }
          },
          "fields": [
            "_docID",
            "lifecycle_state"
          ]
        },
        {
          "kind": "documents",
          "name": "children",
          "collection": "AgentSession",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "session_id": {
              "_like": "job-session:%"
            }
          },
          "fields": [
            "session_id",
            "agent_did"
          ]
        },
        {
          "kind": "documents",
          "name": "segments",
          "collection": "AgentOutputSegment",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "session_id": {
              "_eq": "$session"
            }
          },
          "fields": [
            "_docID",
            "source",
            "payload",
            "close"
          ]
        },
        {
          "kind": "documents",
          "name": "file_changes",
          "collection": "ToolFileChange",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "tool_call_doc_id",
            "session_id",
            "file_changes"
          ]
        }
      ],
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "workflow"
            ],
            "forbidden": [
              "agent_new"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "file_changes",
            "min": 0,
            "max": 0
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "finished",
                "min": 1,
                "max": 1
              },
              {
                "capture": "children",
                "min": 1,
                "max": 1
              }
            ],
            "links": [
              {
                "capture": "finished",
                "key": "lifecycle_state",
                "id": "completed",
                "field": "_docID",
                "target_capture": "segments",
                "target_key": "source.tool_call_doc_id",
                "expect": [
                  {
                    "field": "close",
                    "matches": "\\\\?\"outcome\\\\?\"\\s*:\\s*\\\\?\"complete\\\\?\""
                  },
                  {
                    "field": "payload",
                    "matches": "\\\\?\"late_ids\\\\?\"\\s*:\\s*\\[\\s*\\\\?\"N1\\\\?\"\\s*,\\s*\\\\?\"N6\\\\?\"\\s*\\]"
                  },
                  {
                    "field": "payload",
                    "matches": "\\\\?\"escalated\\\\?\"\\s*:\\s*false\\b"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 2
        }
      ]
    }
  ]
}
