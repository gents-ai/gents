{
  "case_id": "pier-sums",
  "split": "train",
  "reducer": "all",
  "fixtures": {
    "files": [
      {
        "path": "north.json",
        "contents": "[7,13,19]\n"
      },
      {
        "path": "south.json",
        "contents": "[11,17,23]\n"
      }
    ]
  },
  "stages": [
    {
      "stage_id": "run",
      "prompt": "Run one background job called pier-sums with two helpers, one per file: each totals the numbers in north.json or south.json. Return north and south with the totals, and tell me both when it's done. Only read the files.",
      "settle": true,
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "children",
                "min": 2,
                "max": 2
              }
            ],
            "links": [
              {
                "capture": "finished",
                "source_match": {
                  "field": "job_pin",
                  "matches": "\"handle\"\\s*:\\s*\"pier-sums\""
                },
                "field": "_docID",
                "target_capture": "segments",
                "target_key": "source.tool_call_doc_id",
                "expect": [
                  {
                    "field": "close",
                    "matches": "\\\\?\"outcome\\\\?\"\\s*:\\s*\\\\?\"complete\\\\?\""
                  },
                  {
                    "field": "payload",
                    "matches": "\\\\?\"north\\\\?\"\\s*:\\s*39\\b"
                  },
                  {
                    "field": "payload",
                    "matches": "\\\\?\"south\\\\?\"\\s*:\\s*51\\b"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 2
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "file_changes",
            "min": 0,
            "max": 0
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              {
                "matches": "\\b39\\b"
              },
              {
                "matches": "\\b51\\b"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "finished",
          "collection": "AgentToolCall",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "tool_name": {
              "_eq": "workflow"
            },
            "session_id": {
              "_eq": "$session"
            },
            "lifecycle_state": {
              "_eq": "completed"
            }
          },
          "fields": [
            "_docID",
            "lifecycle_state",
            "job_pin"
          ]
        },
        {
          "kind": "documents",
          "name": "children",
          "collection": "AgentSession",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "session_id": {
              "_like": "job-session:%"
            }
          },
          "fields": [
            "session_id",
            "agent_did"
          ]
        },
        {
          "kind": "documents",
          "name": "helper_calls",
          "collection": "AgentToolCall",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "session_id": {
              "_like": "job-session:%"
            }
          },
          "fields": [
            "session_id",
            "tool_name",
            "lifecycle_state"
          ]
        },
        {
          "kind": "documents",
          "name": "segments",
          "collection": "AgentOutputSegment",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "session_id": {
              "_eq": "$session"
            }
          },
          "fields": [
            "_docID",
            "source",
            "payload",
            "close"
          ]
        },
        {
          "kind": "documents",
          "name": "file_changes",
          "collection": "ToolFileChange",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "tool_call_doc_id",
            "session_id",
            "file_changes"
          ]
        }
      ]
    }
  ]
}
