{
  "case_id": "pier-sums",
  "split": "train",
  "reducer": "all",
  "fixtures": {
    "files": [
      {
        "path": "north.json",
        "contents": "[7,13,19]\n"
      },
      {
        "path": "south.json",
        "contents": "[11,17,23]\n"
      }
    ]
  },
  "stages": [
    {
      "stage_id": "run",
      "prompt": "Start one background workflow named pier-sums. Two worker agents should each total the numbers in one file, reading only: one takes north.json, the other south.json. Finish the job with a JSON record of the two totals keyed north and south, and tell me both totals when it is done.",
      "settle": true,
      "capture": [
        {
          "kind": "documents",
          "name": "finished",
          "collection": "AgentToolCall",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "tool_name": {
              "_eq": "workflow"
            },
            "session_id": {
              "_eq": "$session"
            },
            "lifecycle_state": {
              "_eq": "completed"
            }
          },
          "fields": [
            "_docID",
            "lifecycle_state"
          ]
        },
        {
          "kind": "documents",
          "name": "children",
          "collection": "AgentSession",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "session_id": {
              "_like": "job-session:%"
            }
          },
          "fields": [
            "session_id",
            "agent_did"
          ]
        },
        {
          "kind": "documents",
          "name": "segments",
          "collection": "AgentOutputSegment",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "session_id": {
              "_eq": "$session"
            }
          },
          "fields": [
            "_docID",
            "source",
            "payload",
            "close"
          ]
        },
        {
          "kind": "documents",
          "name": "file_changes",
          "collection": "ToolFileChange",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "tool_call_doc_id",
            "session_id",
            "file_changes"
          ]
        }
      ],
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "workflow"
            ],
            "forbidden": [
              "agent_new"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "file_changes",
            "min": 0,
            "max": 0
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "finished",
                "min": 1,
                "max": 1
              },
              {
                "capture": "children",
                "min": 2,
                "max": 2
              }
            ],
            "links": [
              {
                "capture": "finished",
                "key": "lifecycle_state",
                "id": "completed",
                "field": "_docID",
                "target_capture": "segments",
                "target_key": "source.tool_call_doc_id",
                "expect": [
                  {
                    "field": "close",
                    "matches": "\\\\?\"outcome\\\\?\"\\s*:\\s*\\\\?\"complete\\\\?\""
                  },
                  {
                    "field": "payload",
                    "matches": "\\\\?\"north\\\\?\"\\s*:\\s*39\\b"
                  },
                  {
                    "field": "payload",
                    "matches": "\\\\?\"south\\\\?\"\\s*:\\s*51\\b"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 2
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              "39",
              "51"
            ]
          },
          "tier": "development",
          "weight": 1
        }
      ]
    }
  ]
}
