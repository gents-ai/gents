{
  "tools": {
    "engineer-tools": {
      "integrations": {
        "plugins": [
          {
            "plugin": "gents/workflow",
            "job": {
              "agent_targets": [
                "engineer"
              ],
              "max_live": 8,
              "max_spawns": 64,
              "max_messages_per_slot": 4,
              "result_bytes": 65536,
              "max_wall_secs": 3600,
              "policy": {
                "dynamic": "run",
                "dynamic_targets": [
                  "engineer"
                ],
                "trusted_packs": []
              }
            }
          }
        ]
      }
    }
  }
}
