{
  "case_id": "no-goal-check",
  "split": "train",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "check",
      "prompt": "Before we start: is this session already working toward a goal? Just check, and don't set one.",
      "capture": [
        {
          "kind": "documents",
          "name": "goal",
          "collection": "Goal",
          "filter": {
            "session_id": {
              "_eq": "$session"
            }
          },
          "fields": [
            "goal_id",
            "objective",
            "status",
            "token_budget",
            "completion_evidence",
            "consecutive_blocked_audits",
            "last_blocked_reason"
          ]
        }
      ],
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "get_goal"
            ],
            "forbidden": [
              "write",
              "bash",
              "bash_unrestricted",
              "write_file",
              "edit_file",
              "create_goal",
              "update_goal"
            ],
            "config_read_only": true
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "goal",
            "min": 0,
            "max": 0
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "final_message_matches",
          "params": {
            "any": [
              {
                "matches": "(?i)\\bno\\b[^.]{0,30}\\bgoal\\b|\\bnot\\b[^.]{0,40}\\bgoal\\b|\\bnone\\b|\\bnull\\b"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}
