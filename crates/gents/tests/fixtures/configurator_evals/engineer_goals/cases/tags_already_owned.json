{
  "case_id": "tags-already-owned",
  "split": "train",
  "reducer": "all",
  "fixtures": {
    "files": [
      {
        "path": "tags/a.json",
        "contents": "{\n  \"tag\": \"A\",\n  \"owner\": \"Ruth\"\n}\n"
      },
      {
        "path": "tags/b.json",
        "contents": "{\n  \"tag\": \"B\",\n  \"owner\": \"Ike\"\n}\n"
      },
      {
        "path": "tags/c.json",
        "contents": "{\n  \"tag\": \"C\",\n  \"owner\": \"Mo\"\n}\n"
      }
    ]
  },
  "stages": [
    {
      "stage_id": "goal",
      "prompt": "Make it a goal with a 300,000-token budget: every file in tags/ should have an owner field, so add \"owner\": \"unassigned\" to any that lack one. Finish the goal once that's true and tell me what you changed.",
      "settle": true,
      "checks": [
        {
          "check": "captured_fields_match",
          "params": {
            "name": "goal",
            "expect": [
              {
                "field": "token_budget",
                "equals": 300000
              },
              {
                "field": "status",
                "equals": "complete"
              }
            ],
            "min_rows": 1,
            "max_rows": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_files_match",
          "params": {
            "name": "tags",
            "expect": [
              {
                "path": "tags/a.json",
                "pointer": "/owner",
                "equals": "Ruth"
              },
              {
                "path": "tags/b.json",
                "pointer": "/owner",
                "equals": "Ike"
              },
              {
                "path": "tags/c.json",
                "pointer": "/owner",
                "equals": "Mo"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "goal",
          "collection": "Goal",
          "filter": {
            "session_id": {
              "_eq": "$session"
            }
          },
          "fields": [
            "goal_id",
            "objective",
            "status",
            "token_budget",
            "tokens_used",
            "completion_evidence",
            "consecutive_blocked_audits",
            "last_blocked_reason"
          ]
        },
        {
          "kind": "file",
          "name": "tags",
          "glob": "tags/*.json"
        }
      ]
    }
  ]
}
