{
  "case_id": "narrow-report-objective",
  "split": "train",
  "reducer": "all",
  "fixtures": {
    "files": [
      {
        "path": "reports/q1.md",
        "contents": "# Q1 report\nStatus: final\n\nRevenue held at 4.1M.\n"
      },
      {
        "path": "reports/q2.md",
        "contents": "# Q2 report\nStatus: draft\n\nNumbers pending review.\n"
      },
      {
        "path": "reports/q3.md",
        "contents": "# Q3 report\nStatus: final\n\nRevenue rose to 4.6M.\n"
      }
    ]
  },
  "stages": [
    {
      "stage_id": "goal",
      "prompt": "Make it a goal with a 500,000-token budget to copy every report in reports/ into archive/, unchanged and under the same names. If any report turns out to be a draft, leave the drafts out and change the goal to say final reports only. Finish the goal when the copies are done.",
      "settle": true,
      "checks": [
        {
          "check": "captured_fields_match",
          "params": {
            "name": "goal",
            "expect": [
              {
                "field": "objective",
                "matches": "(?i)\\bfinal\\b"
              },
              {
                "field": "token_budget",
                "equals": 500000
              },
              {
                "field": "status",
                "equals": "complete"
              }
            ],
            "min_rows": 1,
            "max_rows": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_files_match",
          "params": {
            "name": "archive",
            "expect": [
              {
                "path": "archive/q1.md",
                "matches": "\\A\\# Q1 report\\nStatus: final\\n\\nRevenue held at 4\\.1M\\.\\n?\\z"
              },
              {
                "path": "archive/q3.md",
                "matches": "\\A\\# Q3 report\\nStatus: final\\n\\nRevenue rose to 4\\.6M\\.\\n?\\z"
              },
              {
                "path": "archive/q2.md",
                "exists": false
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "goal",
          "collection": "Goal",
          "filter": {
            "session_id": {
              "_eq": "$session"
            }
          },
          "fields": [
            "goal_id",
            "objective",
            "status",
            "token_budget",
            "tokens_used",
            "completion_evidence",
            "blocked_reason"
          ]
        },
        {
          "kind": "file",
          "name": "archive",
          "glob": "archive/*"
        }
      ]
    }
  ]
}
