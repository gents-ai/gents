{
  "case_id": "no-goal-needed",
  "split": "train",
  "reducer": "all",
  "fixtures": {
    "files": [
      {
        "path": "counts/north.json",
        "contents": "{\n  \"crates\": 14\n}\n"
      },
      {
        "path": "counts/south.json",
        "contents": "{\n  \"crates\": 23\n}\n"
      },
      {
        "path": "counts/west.json",
        "contents": "{\n  \"crates\": 31\n}\n"
      }
    ]
  },
  "stages": [
    {
      "stage_id": "check",
      "prompt": "Are we working toward a goal in this conversation right now? Just check.",
      "checks": [
        {
          "check": "captured_rows_count",
          "params": {
            "name": "goal",
            "min": 0,
            "max": 0
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "final_message_matches",
          "params": {
            "any": [
              {
                "matches": "(?i)\\bno\\b[^.]{0,30}\\bgoal\\b|\\bnot\\b[^.]{0,40}\\bgoal\\b|\\bnone\\b|\\bnull\\b"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "goal",
          "collection": "Goal",
          "filter": {
            "session_id": {
              "_eq": "$session"
            }
          },
          "fields": [
            "goal_id",
            "objective",
            "status",
            "token_budget",
            "tokens_used",
            "completion_evidence",
            "blocked_reason"
          ]
        }
      ]
    },
    {
      "stage_id": "answer",
      "prompt": "Which file in counts/ has the most crates, and how many?",
      "settle": true,
      "checks": [
        {
          "check": "captured_rows_count",
          "params": {
            "name": "goal",
            "min": 0,
            "max": 0
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              {
                "matches": "(?i)west"
              },
              {
                "matches": "\\b31\\b"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "goal",
          "collection": "Goal",
          "filter": {
            "session_id": {
              "_eq": "$session"
            }
          },
          "fields": [
            "goal_id",
            "objective",
            "status",
            "token_budget",
            "tokens_used",
            "completion_evidence",
            "blocked_reason"
          ]
        }
      ]
    }
  ]
}
