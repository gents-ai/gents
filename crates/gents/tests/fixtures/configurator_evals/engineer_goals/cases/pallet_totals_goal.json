{
  "case_id": "pallet-totals-goal",
  "split": "train",
  "reducer": "all",
  "fixtures": {
    "files": [
      {
        "path": "counts/north.json",
        "contents": "{\n  \"pallets\": 14\n}\n"
      },
      {
        "path": "counts/south.json",
        "contents": "{\n  \"pallets\": 23\n}\n"
      },
      {
        "path": "counts/east.json",
        "contents": "{\n  \"pallets\": 9,\n  \"void\": true\n}\n"
      },
      {
        "path": "counts/archive/2025.json",
        "contents": "{\n  \"pallets\": 50\n}\n"
      }
    ]
  },
  "stages": [
    {
      "stage_id": "goal",
      "settle": true,
      "prompt": "Set this session's goal to exactly \"Write totals.json with the total pallet count from counts/\". Budget it at 150000 tokens per depot that counts toward the total, then work it to completion. Each file directly under counts/ is one depot; a depot marked void doesn't count, and nothing under counts/archive/ does either. totals.json should hold {\"total_pallets\": N}.",
      "capture": [
        {
          "kind": "documents",
          "name": "goal",
          "collection": "Goal",
          "filter": {
            "session_id": {
              "_eq": "$session"
            }
          },
          "fields": [
            "goal_id",
            "objective",
            "status",
            "token_budget",
            "completion_evidence",
            "consecutive_blocked_audits",
            "last_blocked_reason"
          ]
        },
        {
          "kind": "file",
          "name": "totals",
          "glob": "totals.json"
        }
      ],
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "create_goal"
            ],
            "forbidden": [
              "bash",
              "bash_unrestricted"
            ],
            "config_read_only": true
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "goal",
            "expect": [
              {
                "field": "objective",
                "equals": "Write totals.json with the total pallet count from counts/"
              },
              {
                "field": "token_budget",
                "equals": 300000
              },
              {
                "field": "status",
                "equals": "complete"
              },
              {
                "field": "completion_evidence",
                "matches": "(?:^|\\D)37(?:\\D|$)"
              }
            ],
            "min_rows": 1,
            "max_rows": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_files_match",
          "params": {
            "name": "totals",
            "expect": [
              {
                "path": "totals.json",
                "pointer": "/total_pallets",
                "equals": 37
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}
