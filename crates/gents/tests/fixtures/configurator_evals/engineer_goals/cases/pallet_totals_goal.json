{
  "case_id": "pallet-totals-goal",
  "split": "train",
  "reducer": "all",
  "fixtures": {
    "files": [
      {
        "path": "counts/north.json",
        "contents": "{\n  \"pallets\": 14\n}\n"
      },
      {
        "path": "counts/south.json",
        "contents": "{\n  \"pallets\": 23\n}\n"
      },
      {
        "path": "counts/east.json",
        "contents": "{\n  \"pallets\": 9,\n  \"void\": true\n}\n"
      },
      {
        "path": "counts/archive/2025.json",
        "contents": "{\n  \"pallets\": 50\n}\n"
      }
    ]
  },
  "stages": [
    {
      "stage_id": "goal",
      "prompt": "Make this a goal with a 300,000-token budget: total the pallets in counts/ and write totals.json as {\"total_pallets\": N}. Each file directly in counts/ is a depot; skip depots marked void and anything under counts/archive/.",
      "settle": true,
      "checks": [
        {
          "check": "captured_fields_match",
          "params": {
            "name": "goal",
            "expect": [
              {
                "field": "token_budget",
                "equals": 300000
              },
              {
                "field": "status",
                "equals": "complete"
              }
            ],
            "min_rows": 1,
            "max_rows": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_files_match",
          "params": {
            "name": "totals",
            "expect": [
              {
                "path": "totals.json",
                "pointer": "/total_pallets",
                "equals": 37
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "goal",
          "collection": "Goal",
          "filter": {
            "session_id": {
              "_eq": "$session"
            }
          },
          "fields": [
            "goal_id",
            "objective",
            "status",
            "token_budget",
            "tokens_used",
            "completion_evidence",
            "consecutive_blocked_audits",
            "last_blocked_reason"
          ]
        },
        {
          "kind": "file",
          "name": "totals",
          "glob": "totals.json"
        }
      ]
    }
  ]
}
