      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ],
            "forbidden": [
              "bash"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": []
    },
    {
      "stage_id": "read",
      "prompt": "How many queued shipments go to Oslo? Give the exact total across the collection. Then give the second page of five, ordered by priority ascending, including each reference and priority. Do not change any records.",
      "deadline_secs": 600,
