{
  "case_id": "library-hold-edition-links",
  "split": "held_out",
  "reducer": "all",
  "fixtures": {
    "schemas": [
      "type LibraryHoldEdition { hold: String @index(unique: true) edition: String }",
      "type LibraryHold { hold: String @index(unique: true) branch: String }",
      "type LibraryEdition { edition: String @index(unique: true) title: String format: String }",
      "type LibraryHoldImport { hold: String @index(unique: true) edition: String title_hint: String }"
    ],
    "documents": [
      {
        "collection": "LibraryHoldEdition",
        "document": {
          "hold": "LH-4",
          "edition": "ED-50"
        }
      },
      {
        "collection": "LibraryHold",
        "document": {
          "hold": "LH-1",
          "branch": "main"
        }
      },
      {
        "collection": "LibraryHold",
        "document": {
          "hold": "LH-2",
          "branch": "main"
        }
      },
      {
        "collection": "LibraryHold",
        "document": {
          "hold": "LH-3",
          "branch": "east"
        }
      },
      {
        "collection": "LibraryHold",
        "document": {
          "hold": "LH-4",
          "branch": "east"
        }
      },
      {
        "collection": "LibraryEdition",
        "document": {
          "edition": "ED-11",
          "title": "Field atlas",
          "format": "print"
        }
      },
      {
        "collection": "LibraryEdition",
        "document": {
          "edition": "ED-19",
          "title": "Field atlas",
          "format": "audio"
        }
      },
      {
        "collection": "LibraryEdition",
        "document": {
          "edition": "ED-50",
          "title": "Bird list",
          "format": "print"
        }
      },
      {
        "collection": "LibraryHoldImport",
        "document": {
          "hold": "LH-1",
          "edition": "ED-19",
          "title_hint": "Field atlas"
        }
      },
      {
        "collection": "LibraryHoldImport",
        "document": {
          "hold": "LH-2",
          "edition": "ED-11",
          "title_hint": "Field atlas"
        }
      },
      {
        "collection": "LibraryHoldImport",
        "document": {
          "hold": "LH-3",
          "title_hint": "Field atlas"
        }
      }
    ]
  },
  "stages": [
    {
      "stage_id": "link",
      "settle": true,
      "continuation": {
        "prompt": "OK, go ahead.",
        "max": 1,
        "until": "done"
      },
      "prompt": "The branch import left some holds without an edition. Add the missing LibraryHoldEdition records from LibraryHoldImport, using only an edition ID the import gives and LibraryEdition has. Several editions share a title, so a title hint alone isn't enough. Which holds are still open?",
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "LibraryHoldEdition",
                "min": 3,
                "max": 3
              },
              {
                "capture": "LibraryHold",
                "min": 4,
                "max": 4
              },
              {
                "capture": "LibraryEdition",
                "min": 3,
                "max": 3
              },
              {
                "capture": "LibraryHoldImport",
                "min": 3,
                "max": 3
              }
            ],
            "rows": [
              {
                "capture": "LibraryHoldEdition",
                "key": "hold",
                "id": "LH-4",
                "expect": [
                  {
                    "field": "edition",
                    "equals": "ED-50"
                  }
                ]
              },
              {
                "capture": "LibraryHoldEdition",
                "key": "hold",
                "id": "LH-1",
                "expect": [
                  {
                    "field": "edition",
                    "equals": "ED-19"
                  }
                ]
              },
              {
                "capture": "LibraryHoldEdition",
                "key": "hold",
                "id": "LH-2",
                "expect": [
                  {
                    "field": "edition",
                    "equals": "ED-11"
                  }
                ]
              },
              {
                "capture": "LibraryHold",
                "key": "hold",
                "id": "LH-1",
                "expect": [
                  {
                    "field": "branch",
                    "equals": "main"
                  }
                ]
              },
              {
                "capture": "LibraryHold",
                "key": "hold",
                "id": "LH-2",
                "expect": [
                  {
                    "field": "branch",
                    "equals": "main"
                  }
                ]
              },
              {
                "capture": "LibraryHold",
                "key": "hold",
                "id": "LH-3",
                "expect": [
                  {
                    "field": "branch",
                    "equals": "east"
                  }
                ]
              },
              {
                "capture": "LibraryHold",
                "key": "hold",
                "id": "LH-4",
                "expect": [
                  {
                    "field": "branch",
                    "equals": "east"
                  }
                ]
              },
              {
                "capture": "LibraryEdition",
                "key": "edition",
                "id": "ED-11",
                "expect": [
                  {
                    "field": "title",
                    "equals": "Field atlas"
                  },
                  {
                    "field": "format",
                    "equals": "print"
                  }
                ]
              },
              {
                "capture": "LibraryEdition",
                "key": "edition",
                "id": "ED-19",
                "expect": [
                  {
                    "field": "title",
                    "equals": "Field atlas"
                  },
                  {
                    "field": "format",
                    "equals": "audio"
                  }
                ]
              },
              {
                "capture": "LibraryEdition",
                "key": "edition",
                "id": "ED-50",
                "expect": [
                  {
                    "field": "title",
                    "equals": "Bird list"
                  },
                  {
                    "field": "format",
                    "equals": "print"
                  }
                ]
              },
              {
                "capture": "LibraryHoldImport",
                "key": "hold",
                "id": "LH-1",
                "expect": [
                  {
                    "field": "edition",
                    "equals": "ED-19"
                  },
                  {
                    "field": "title_hint",
                    "equals": "Field atlas"
                  }
                ]
              },
              {
                "capture": "LibraryHoldImport",
                "key": "hold",
                "id": "LH-2",
                "expect": [
                  {
                    "field": "edition",
                    "equals": "ED-11"
                  },
                  {
                    "field": "title_hint",
                    "equals": "Field atlas"
                  }
                ]
              },
              {
                "capture": "LibraryHoldImport",
                "key": "hold",
                "id": "LH-3",
                "expect": [
                  {
                    "field": "edition",
                    "equals": null
                  },
                  {
                    "field": "title_hint",
                    "equals": "Field atlas"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              "LH-3"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "LibraryHoldEdition",
          "collection": "LibraryHoldEdition",
          "filter": {},
          "fields": [
            "hold",
            "edition"
          ]
        },
        {
          "kind": "documents",
          "name": "LibraryHold",
          "collection": "LibraryHold",
          "filter": {},
          "fields": [
            "hold",
            "branch"
          ]
        },
        {
          "kind": "documents",
          "name": "LibraryEdition",
          "collection": "LibraryEdition",
          "filter": {},
          "fields": [
            "edition",
            "title",
            "format"
          ]
        },
        {
          "kind": "documents",
          "name": "LibraryHoldImport",
          "collection": "LibraryHoldImport",
          "filter": {},
          "fields": [
            "hold",
            "edition",
            "title_hint"
          ]
        },
        {
          "kind": "documents",
          "name": "done",
          "collection": "LibraryHoldEdition",
          "filter": {
            "hold": {
              "_eq": "LH-1"
            }
          },
          "fields": [
            "hold"
          ]
        }
      ]
    }
  ]
}
