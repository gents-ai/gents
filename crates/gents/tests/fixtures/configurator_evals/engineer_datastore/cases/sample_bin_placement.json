        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ],
            "forbidden": [
              "bash"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "agents": {
              "agents": "agents",
              "contexts": "contexts",
              "tools": "tools",
              "expect": [
                {
                  "agent_did": "gents:agent-slot:engineer",
                  "tools": [
                    {
                      "field": "host.bash.mode",
                      "matches": "^(null|Off)$"
                    },
                    {
                      "field": "datastore.write_collections",
                      "equals": [
                        "SamplePlacement"
                      ]
                    },
                    {
                      "field": "datastore.defra_query_collections",
                      "contains": "\"SamplePlacement\""
                    },
                    {
                      "field": "datastore.defra_query_collections",
                      "contains": "\"SampleIntake\""
                    },
                    {
                      "field": "datastore.defra_query_collections",
                      "contains": "\"LabBin\""
                    }
                  ]
                }
              ]
            },
            "present": [
              {
                "capture": "SamplePlacement",
                "min": 1,
                "max": 1
              },
              {
                "capture": "SampleIntake",
                "min": 6,
                "max": 6
              },
              {
                "capture": "LabBin",
                "min": 7,
                "max": 7
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
