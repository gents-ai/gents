{
  "case_id": "shipment-lifecycle",
  "split": "validation",
  "reducer": "all",
  "fixtures": {
    "schemas": [
      "type Shipment { reference: String destination: String status: String priority: Int }"
    ],
    "documents": [
      {
        "collection": "Shipment",
        "document": {
          "reference": "KEEP-41",
          "destination": "Oslo",
          "status": "queued",
          "priority": 1
        }
      }
    ]
  },
  "stages": [
    {
      "stage_id": "create",
      "settle": true,
      "continuation": {
        "prompt": "OK, go ahead.",
        "max": 1,
        "until": "new"
      },
      "prompt": "Add shipment NEW-83 going to Quito, queued, priority 4.",
      "checks": [
        {
          "check": "captured_rows_count",
          "params": {
            "name": "new",
            "min": 1,
            "max": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "new",
            "expect": [
              {
                "field": "destination",
                "equals": "Quito"
              },
              {
                "field": "status",
                "equals": "queued"
              },
              {
                "field": "priority",
                "equals": 4
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "new",
          "collection": "Shipment",
          "fields": [
            "reference",
            "destination",
            "status",
            "priority"
          ],
          "filter": {
            "reference": {
              "_eq": "NEW-83"
            }
          }
        }
      ]
    },
    {
      "stage_id": "update",
      "settle": true,
      "prompt": "NEW-83 has been delivered. Update it.",
      "checks": [
        {
          "check": "captured_fields_match",
          "params": {
            "name": "new",
            "expect": [
              {
                "field": "status",
                "equals": "delivered"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "keep",
                "min": 1,
                "max": 1
              }
            ],
            "rows": [
              {
                "capture": "keep",
                "key": "reference",
                "id": "KEEP-41",
                "expect": [
                  {
                    "field": "status",
                    "equals": "queued"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "new",
          "collection": "Shipment",
          "fields": [
            "reference",
            "destination",
            "status",
            "priority"
          ],
          "filter": {
            "reference": {
              "_eq": "NEW-83"
            }
          }
        },
        {
          "kind": "documents",
          "name": "keep",
          "collection": "Shipment",
          "fields": [
            "reference",
            "destination",
            "status",
            "priority"
          ],
          "filter": {
            "reference": {
              "_eq": "KEEP-41"
            }
          }
        }
      ]
    },
    {
      "stage_id": "delete",
      "settle": true,
      "prompt": "NEW-83 was only a practice shipment. Remove it.",
      "checks": [
        {
          "check": "captured_rows_count",
          "params": {
            "name": "new",
            "min": 0,
            "max": 0
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "keep",
                "min": 1,
                "max": 1
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "new",
          "collection": "Shipment",
          "fields": [
            "reference",
            "destination",
            "status",
            "priority"
          ],
          "filter": {
            "reference": {
              "_eq": "NEW-83"
            }
          }
        },
        {
          "kind": "documents",
          "name": "keep",
          "collection": "Shipment",
          "fields": [
            "reference",
            "destination",
            "status",
            "priority"
          ],
          "filter": {
            "reference": {
              "_eq": "KEEP-41"
            }
          }
        }
      ]
    }
  ]
}
