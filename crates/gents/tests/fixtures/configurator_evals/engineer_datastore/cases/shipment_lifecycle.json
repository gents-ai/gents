{
  "case_id": "shipment-lifecycle",
  "split": "validation",
  "reducer": "all",
  "fixtures": {
    "schemas": [
      "type Shipment { reference: String destination: String status: String priority: Int }"
    ],
    "documents": [
      {
        "collection": "Shipment",
        "document": {
          "reference": "KEEP-41",
          "destination": "Oslo",
          "status": "queued",
          "priority": 1
        }
      }
    ]
  },
  "stages": [
    {
      "stage_id": "access",
      "prompt": "I keep application records in Shipment. Enable your general read access only to Shipment, and general create/update/delete access only to Shipment if your native tools support it. Keep shell execution off and leave all other collection permissions alone. Inspect the available fields before working with records.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ],
            "forbidden": [
              "bash"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": []
    },
    {
      "stage_id": "create",
      "prompt": "Add shipment NEW-83 going to Quito, queued, priority 4. Verify the saved record using a fresh read.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "captured_rows_count",
          "params": {
            "name": "new",
            "min": 1,
            "max": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "new",
            "expect": [
              {
                "field": "destination",
                "equals": "Quito"
              },
              {
                "field": "status",
                "equals": "queued"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "tool_calls_expected",
          "params": {
            "forbidden": [
              "bash",
              "schema"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "new",
          "collection": "Shipment",
          "fields": [
            "reference",
            "destination",
            "status",
            "priority"
          ],
          "filter": {
            "reference": {
              "_eq": "NEW-83"
            }
          }
        }
      ]
    },
    {
      "stage_id": "update",
      "prompt": "Mark only NEW-83 delivered and confirm its stored status. Keep KEEP-41 queued.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "captured_fields_match",
          "params": {
            "name": "new",
            "expect": [
              {
                "field": "status",
                "equals": "delivered"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "keep",
                "min": 1,
                "max": 1
              }
            ],
            "rows": [
              {
                "capture": "keep",
                "key": "reference",
                "id": "KEEP-41",
                "expect": [
                  {
                    "field": "status",
                    "equals": "queued"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "new",
          "collection": "Shipment",
          "fields": [
            "reference",
            "destination",
            "status",
            "priority"
          ],
          "filter": {
            "reference": {
              "_eq": "NEW-83"
            }
          }
        },
        {
          "kind": "documents",
          "name": "keep",
          "collection": "Shipment",
          "fields": [
            "reference",
            "destination",
            "status",
            "priority"
          ],
          "filter": {
            "reference": {
              "_eq": "KEEP-41"
            }
          }
        }
      ]
    },
    {
      "stage_id": "delete",
      "prompt": "Remove NEW-83 because it was a practice shipment. Verify it is gone and KEEP-41 still exists.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "captured_rows_count",
          "params": {
            "name": "new",
            "min": 0,
            "max": 0
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "keep",
                "min": 1,
                "max": 1
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "new",
          "collection": "Shipment",
          "fields": [
            "reference",
            "destination",
            "status",
            "priority"
          ],
          "filter": {
            "reference": {
              "_eq": "NEW-83"
            }
          }
        },
        {
          "kind": "documents",
          "name": "keep",
          "collection": "Shipment",
          "fields": [
            "reference",
            "destination",
            "status",
            "priority"
          ],
          "filter": {
            "reference": {
              "_eq": "KEEP-41"
            }
          }
        }
      ]
    }
  ]
}
