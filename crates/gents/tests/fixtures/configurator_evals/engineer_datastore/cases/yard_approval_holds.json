  "stages": [
    {
      "stage_id": "access",
      "prompt": "I keep application records in AssetHold, AssetApproval and AssetSafetyStop. Enable your general read access only to those collections, and general create/update/delete access only to AssetHold if your native tools support it. Keep shell execution off and leave all other collection permissions alone. Inspect the available fields before working with records.",
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ],
            "forbidden": [
              "bash"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "agents": {
              "agents": "agents",
              "contexts": "contexts",
              "tools": "tools",
              "expect": [
                {
                  "agent_did": "gents:agent-slot:engineer",
                  "tools": [
                    {
                      "field": "host.bash.mode",
                      "matches": "^(null|Off)$"
                    },
                    {
                      "field": "datastore.write_collections",
                      "equals": [
                        "AssetHold"
                      ]
                    },
                    {
                      "field": "datastore.defra_query_collections",
                      "contains": "\"AssetHold\""
                    },
                    {
                      "field": "datastore.defra_query_collections",
                      "contains": "\"AssetApproval\""
                    },
                    {
                      "field": "datastore.defra_query_collections",
                      "contains": "\"AssetSafetyStop\""
                    }
                  ]
                }
              ]
            },
            "present": [
              {
                "capture": "AssetHold",
                "min": 6,
                "max": 6
              },
              {
                "capture": "AssetApproval",
                "min": 9,
                "max": 9
              },
              {
                "capture": "AssetSafetyStop",
                "min": 2,
                "max": 2
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
