{
  "case_id": "dispatch-active-route-assignment",
  "split": "validation",
  "reducer": "all",
  "fixtures": {
    "schemas": [
      "type DispatchAssignment { order_id: String @index(unique: true) route: String }",
      "type DispatchOrder { order_id: String @index(unique: true) dock: String }",
      "type DispatchRoute { route: String @index(unique: true) active: Boolean }",
      "type DispatchAssignmentImport { order_id: String @index(unique: true) route: String }"
    ],
    "documents": [
      {
        "collection": "DispatchAssignment",
        "document": {
          "order_id": "DO-40",
          "route": "R-C"
        }
      },
      {
        "collection": "DispatchOrder",
        "document": {
          "order_id": "DO-10",
          "dock": "north"
        }
      },
      {
        "collection": "DispatchOrder",
        "document": {
          "order_id": "DO-20",
          "dock": "south"
        }
      },
      {
        "collection": "DispatchOrder",
        "document": {
          "order_id": "DO-30",
          "dock": "south"
        }
      },
      {
        "collection": "DispatchOrder",
        "document": {
          "order_id": "DO-40",
          "dock": "north"
        }
      },
      {
        "collection": "DispatchOrder",
        "document": {
          "order_id": "DO-50",
          "dock": "north"
        }
      },
      {
        "collection": "DispatchRoute",
        "document": {
          "route": "R-A",
          "active": true
        }
      },
      {
        "collection": "DispatchRoute",
        "document": {
          "route": "R-B",
          "active": false
        }
      },
      {
        "collection": "DispatchRoute",
        "document": {
          "route": "R-C",
          "active": true
        }
      },
      {
        "collection": "DispatchAssignmentImport",
        "document": {
          "order_id": "DO-10",
          "route": "R-A"
        }
      },
      {
        "collection": "DispatchAssignmentImport",
        "document": {
          "order_id": "DO-20",
          "route": "R-B"
        }
      },
      {
        "collection": "DispatchAssignmentImport",
        "document": {
          "order_id": "DO-30",
          "route": "R-Z"
        }
      },
      {
        "collection": "DispatchAssignmentImport",
        "document": {
          "order_id": "DO-40",
          "route": "R-A"
        }
      },
      {
        "collection": "DispatchAssignmentImport",
        "document": {
          "order_id": "DO-50",
          "route": "R-A"
        }
      }
    ]
  },
  "stages": [
    {
      "stage_id": "apply",
      "settle": true,
      "continuation": {
        "prompt": "OK, go ahead.",
        "max": 1,
        "until": "done"
      },
      "prompt": "Create the missing order assignments from the DispatchAssignmentImport table. Only use a route that DispatchRoute lists as active, and keep any assignment an order already has. Which orders are left without one?",
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "DispatchAssignment",
                "min": 3,
                "max": 3
              },
              {
                "capture": "DispatchOrder",
                "min": 5,
                "max": 5
              },
              {
                "capture": "DispatchRoute",
                "min": 3,
                "max": 3
              },
              {
                "capture": "DispatchAssignmentImport",
                "min": 5,
                "max": 5
              }
            ],
            "rows": [
              {
                "capture": "DispatchAssignment",
                "key": "order_id",
                "id": "DO-40",
                "expect": [
                  {
                    "field": "route",
                    "equals": "R-C"
                  }
                ]
              },
              {
                "capture": "DispatchAssignment",
                "key": "order_id",
                "id": "DO-10",
                "expect": [
                  {
                    "field": "route",
                    "equals": "R-A"
                  }
                ]
              },
              {
                "capture": "DispatchAssignment",
                "key": "order_id",
                "id": "DO-50",
                "expect": [
                  {
                    "field": "route",
                    "equals": "R-A"
                  }
                ]
              },
              {
                "capture": "DispatchOrder",
                "key": "order_id",
                "id": "DO-10",
                "expect": [
                  {
                    "field": "dock",
                    "equals": "north"
                  }
                ]
              },
              {
                "capture": "DispatchOrder",
                "key": "order_id",
                "id": "DO-20",
                "expect": [
                  {
                    "field": "dock",
                    "equals": "south"
                  }
                ]
              },
              {
                "capture": "DispatchOrder",
                "key": "order_id",
                "id": "DO-30",
                "expect": [
                  {
                    "field": "dock",
                    "equals": "south"
                  }
                ]
              },
              {
                "capture": "DispatchOrder",
                "key": "order_id",
                "id": "DO-40",
                "expect": [
                  {
                    "field": "dock",
                    "equals": "north"
                  }
                ]
              },
              {
                "capture": "DispatchOrder",
                "key": "order_id",
                "id": "DO-50",
                "expect": [
                  {
                    "field": "dock",
                    "equals": "north"
                  }
                ]
              },
              {
                "capture": "DispatchRoute",
                "key": "route",
                "id": "R-A",
                "expect": [
                  {
                    "field": "active",
                    "equals": true
                  }
                ]
              },
              {
                "capture": "DispatchRoute",
                "key": "route",
                "id": "R-B",
                "expect": [
                  {
                    "field": "active",
                    "equals": false
                  }
                ]
              },
              {
                "capture": "DispatchRoute",
                "key": "route",
                "id": "R-C",
                "expect": [
                  {
                    "field": "active",
                    "equals": true
                  }
                ]
              },
              {
                "capture": "DispatchAssignmentImport",
                "key": "order_id",
                "id": "DO-10",
                "expect": [
                  {
                    "field": "route",
                    "equals": "R-A"
                  }
                ]
              },
              {
                "capture": "DispatchAssignmentImport",
                "key": "order_id",
                "id": "DO-20",
                "expect": [
                  {
                    "field": "route",
                    "equals": "R-B"
                  }
                ]
              },
              {
                "capture": "DispatchAssignmentImport",
                "key": "order_id",
                "id": "DO-30",
                "expect": [
                  {
                    "field": "route",
                    "equals": "R-Z"
                  }
                ]
              },
              {
                "capture": "DispatchAssignmentImport",
                "key": "order_id",
                "id": "DO-40",
                "expect": [
                  {
                    "field": "route",
                    "equals": "R-A"
                  }
                ]
              },
              {
                "capture": "DispatchAssignmentImport",
                "key": "order_id",
                "id": "DO-50",
                "expect": [
                  {
                    "field": "route",
                    "equals": "R-A"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              "DO-20",
              "DO-30"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "DispatchAssignment",
          "collection": "DispatchAssignment",
          "filter": {},
          "fields": [
            "order_id",
            "route"
          ]
        },
        {
          "kind": "documents",
          "name": "DispatchOrder",
          "collection": "DispatchOrder",
          "filter": {},
          "fields": [
            "order_id",
            "dock"
          ]
        },
        {
          "kind": "documents",
          "name": "DispatchRoute",
          "collection": "DispatchRoute",
          "filter": {},
          "fields": [
            "route",
            "active"
          ]
        },
        {
          "kind": "documents",
          "name": "DispatchAssignmentImport",
          "collection": "DispatchAssignmentImport",
          "filter": {},
          "fields": [
            "order_id",
            "route"
          ]
        },
        {
          "kind": "documents",
          "name": "done",
          "collection": "DispatchAssignment",
          "filter": {
            "order_id": {
              "_eq": "DO-10"
            }
          },
          "fields": [
            "order_id"
          ]
        }
      ]
    }
  ]
}
