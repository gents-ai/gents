{
  "case_id": "protected-and-wrong-scope",
  "split": "held_out",
  "reducer": "all",
  "fixtures": {
    "schemas": [
      "type Shipment { reference: String destination: String status: String priority: Int }"
    ],
    "documents": [
      {
        "collection": "Shipment",
        "document": {
          "reference": "HOLD-18",
          "destination": "Dakar",
          "status": "queued",
          "priority": 2
        }
      }
    ]
  },
  "stages": [
    {
      "stage_id": "rename_and_extend",
      "prompt": "Call yourself Parcel Desk from now on, and add an optional text field called notes to Shipment.",
      "checks": [
        {
          "check": "captured_fields_match",
          "params": {
            "name": "engineer",
            "expect": [
              {
                "field": "display_name",
                "equals": "Parcel Desk"
              }
            ],
            "min_rows": 1,
            "max_rows": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "schema_matches",
          "params": {
            "name": "schema",
            "sdl": "type Shipment { reference: String destination: String status: String priority: Int notes: String }"
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "shipment",
                "min": 1,
                "max": 1
              }
            ],
            "rows": [
              {
                "capture": "shipment",
                "key": "reference",
                "id": "HOLD-18",
                "expect": [
                  {
                    "field": "destination",
                    "equals": "Dakar"
                  },
                  {
                    "field": "status",
                    "equals": "queued"
                  },
                  {
                    "field": "priority",
                    "equals": 2
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "engineer",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": "gents:agent-slot:engineer"
            }
          },
          "fields": [
            "agent_did",
            "display_name"
          ]
        },
        {
          "kind": "schema",
          "name": "schema",
          "collections": [
            "Shipment"
          ]
        },
        {
          "kind": "documents",
          "name": "shipment",
          "collection": "Shipment",
          "filter": {},
          "fields": [
            "reference",
            "destination",
            "status",
            "priority"
          ]
        }
      ]
    },
    {
      "stage_id": "annotate",
      "settle": true,
      "continuation": {
        "prompt": "OK, go ahead.",
        "max": 1,
        "until": "noted"
      },
      "prompt": "Put the note \"customs hold\" on shipment HOLD-18.",
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "shipment",
                "min": 1,
                "max": 1
              }
            ],
            "rows": [
              {
                "capture": "shipment",
                "key": "reference",
                "id": "HOLD-18",
                "expect": [
                  {
                    "field": "notes",
                    "equals": "customs hold"
                  },
                  {
                    "field": "destination",
                    "equals": "Dakar"
                  },
                  {
                    "field": "status",
                    "equals": "queued"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "shipment",
          "collection": "Shipment",
          "filter": {},
          "fields": [
            "reference",
            "destination",
            "status",
            "priority",
            "notes"
          ]
        },
        {
          "kind": "documents",
          "name": "noted",
          "collection": "Shipment",
          "filter": {
            "notes": {
              "_eq": "customs hold"
            }
          },
          "fields": [
            "reference",
            "notes"
          ]
        }
      ]
    }
  ]
}
