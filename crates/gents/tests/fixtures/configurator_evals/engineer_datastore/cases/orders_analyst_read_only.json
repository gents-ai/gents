            "min": 1,
            "max": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "records",
                "min": 6,
                "max": 6
              }
            ],
            "rows": [
              {
                "capture": "records",
                "key": "order_id",
                "id": "O-101",
                "expect": [
                  {
                    "field": "customer",
                    "equals": "Halden Cycles"
