{
  "case_id": "native-local-sealed-install-select-call",
  "split": "train",
  "reducer": "all",
  "fixtures": {
    "assets": [
      "artifacts/native_echo.pack"
    ],
    "documents": [
      {
        "collection": "AgentContext",
        "document": {
          "node_did": "$trial",
          "context_id": "personal-notes",
          "system_prompt": "Keep this unrelated context unchanged."
        }
      }
    ]
  },
  "stages": [
    {
      "stage_id": "inspect",
      "prompt": "A built local plugins-only artifact is available at ./artifacts/native_echo.pack in your granted workspace. Discover native pack help and inspect the artifact and its exact digest. Preview installation. Do not install, select tools, or run anything yet; keep shell off. Use native config, never shell or CLI passthrough.",
      "capture": [
        {
          "kind": "documents",
          "name": "installation",
          "collection": "PackInstallation",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "coordinate": {
              "_eq": "fixture/native_echo_pack"
            }
          },
          "fields": [
            "coordinate",
            "version",
            "digest"
          ]
        },
        {
          "kind": "documents",
          "name": "notes",
          "collection": "AgentContext",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "context_id": {
              "_eq": "personal-notes"
            }
          },
          "fields": [
            "context_id",
            "system_prompt"
          ]
        },
        {
          "kind": "documents",
          "name": "tools",
          "collection": "Tools",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "tools_id": {
              "_eq": "engineer-tools"
            }
          },
          "fields": [
            "tools_id",
            "host",
            "integrations"
          ]
        }
      ],
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ],
            "forbidden": [
              "bash",
              "agent_message",
              "agent_new"
            ],
            "config_read_only": true
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "tool_result_matches",
          "params": {
            "expect": [
              {
                "field": "ready",
                "equals": true
              },
              {
                "field": "committed",
                "equals": false
              },
              {
                "field": "manifest.name",
                "equals": "native_echo_pack"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "installation",
            "min": 0,
            "max": 0
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "notes",
                "min": 1,
                "max": 1
              },
              {
                "capture": "tools",
                "min": 1,
                "max": 1
              }
            ],
            "rows": [
              {
                "capture": "notes",
                "key": "context_id",
                "id": "personal-notes",
                "expect": [
                  {
                    "field": "system_prompt",
                    "equals": "Keep this unrelated context unchanged."
                  }
                ]
              },
              {
                "capture": "tools",
                "key": "tools_id",
                "id": "engineer-tools",
                "expect": [
                  {
                    "field": "host.bash.mode",
                    "equals": null
                  },
                  {
                    "field": "host.files.mode",
                    "equals": "ReadWrite"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "install-select",
      "prompt": "Install the exact sealed local artifact you previewed. Reinspect and preview if necessary, use the returned digest, inspect the installed fixture/native_echo plugin, then explicitly select its pinned digest on your existing Tools while preserving all other fields and entries. Read back Tools and effective configuration. Do not call the plugin in this request; report that a fresh request is needed. Never claim installation alone exposes tools. Keep shell off and the unrelated context unchanged.",
      "capture": [
        {
          "kind": "documents",
          "name": "installation",
          "collection": "PackInstallation",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "coordinate": {
              "_eq": "fixture/native_echo_pack"
            }
          },
          "fields": [
            "coordinate",
            "version",
            "digest"
          ]
        },
        {
          "kind": "documents",
          "name": "notes",
          "collection": "AgentContext",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "context_id": {
              "_eq": "personal-notes"
            }
          },
          "fields": [
            "context_id",
            "system_prompt"
          ]
        },
        {
          "kind": "documents",
          "name": "tools",
          "collection": "Tools",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "tools_id": {
              "_eq": "engineer-tools"
            }
          },
          "fields": [
            "tools_id",
            "host",
            "integrations"
          ]
        }
      ],
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ],
            "forbidden": [
              "bash",
              "agent_message",
              "agent_new"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "tool_result_matches",
          "params": {
            "expect": [
              {
                "field": "committed",
                "equals": true
              },
              {
                "field": "installed.coordinate",
                "equals": "fixture/native_echo_pack"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "installation",
                "min": 1,
                "max": 1
              },
              {
                "capture": "tools",
                "min": 1,
                "max": 1
              },
              {
                "capture": "notes",
                "min": 1,
                "max": 1
              }
            ],
            "rows": [
              {
                "capture": "installation",
                "key": "coordinate",
                "id": "fixture/native_echo_pack",
                "expect": [
                  {
                    "field": "version",
                    "equals": "1.0.0"
                  }
                ]
              },
              {
                "capture": "tools",
                "key": "tools_id",
                "id": "engineer-tools",
                "expect": [
                  {
                    "field": "integrations.plugins",
                    "matches": "\"plugin\"\\s*:\\s*\"fixture/native_echo\""
                  },
                  {
                    "field": "integrations.plugins",
                    "matches": "\"digest\"\\s*:\\s*\"sha256:[0-9a-f]{64}\""
                  },
                  {
                    "field": "host.bash.mode",
                    "equals": null
                  },
                  {
                    "field": "host.files.mode",
                    "equals": "ReadWrite"
                  }
                ]
              },
              {
                "capture": "notes",
                "key": "context_id",
                "id": "personal-notes",
                "expect": [
                  {
                    "field": "system_prompt",
                    "equals": "Keep this unrelated context unchanged."
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "fresh-call",
      "prompt": "This is the fresh request after explicit Tools selection. Call native_echo with {} and return the actual result. Keep configuration and all unrelated data unchanged; do not use shell.",
      "capture": [
        {
          "kind": "documents",
          "name": "installation",
          "collection": "PackInstallation",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "coordinate": {
              "_eq": "fixture/native_echo_pack"
            }
          },
          "fields": [
            "coordinate",
            "version",
            "digest"
          ]
        },
        {
          "kind": "documents",
          "name": "notes",
          "collection": "AgentContext",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "context_id": {
              "_eq": "personal-notes"
            }
          },
          "fields": [
            "context_id",
            "system_prompt"
          ]
        },
        {
          "kind": "documents",
          "name": "tools",
          "collection": "Tools",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "tools_id": {
              "_eq": "engineer-tools"
            }
          },
          "fields": [
            "tools_id",
            "host",
            "integrations"
          ]
        }
      ],
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "native_echo"
            ],
            "forbidden": [
              "bash",
              "agent_message",
              "agent_new"
            ],
            "config_read_only": true
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "tool_result_matches",
          "params": {
            "expect": [
              {
                "field": "native_pack_echo",
                "equals": "ok"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "notes",
                "min": 1,
                "max": 1
              },
              {
                "capture": "tools",
                "min": 1,
                "max": 1
              }
            ],
            "rows": [
              {
                "capture": "notes",
                "key": "context_id",
                "id": "personal-notes",
                "expect": [
                  {
                    "field": "system_prompt",
                    "equals": "Keep this unrelated context unchanged."
                  }
                ]
              },
              {
                "capture": "tools",
                "key": "tools_id",
                "id": "engineer-tools",
                "expect": [
                  {
                    "field": "host.bash.mode",
                    "equals": null
                  },
                  {
                    "field": "host.files.mode",
                    "equals": "ReadWrite"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}
