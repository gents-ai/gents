{
  "case_id": "native-local-sealed-install-select-call",
  "split": "train",
  "reducer": "all",
  "fixtures": {
    "assets": [
      "artifacts/native_echo.pack"
    ],
    "documents": [
      {
        "collection": "AgentContext",
        "document": {
          "node_did": "$trial",
          "context_id": "personal-notes",
          "system_prompt": "Keep this unrelated context unchanged."
        }
      }
    ]
  },
  "stages": [
    {
      "stage_id": "inspect",
      "prompt": "There's a plugin pack at artifacts/native_echo.pack. What's in it, and what would installing it do? Don't install it yet.",
      "checks": [
        {
          "check": "tool_result_matches",
          "params": {
            "expect": [
              {
                "field": "ready",
                "equals": true
              },
              {
                "field": "committed",
                "equals": false
              },
              {
                "field": "manifest.name",
                "equals": "native_echo_pack"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "installation",
            "min": 0,
            "max": 0
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "notes",
                "min": 1,
                "max": 1
              }
            ],
            "rows": [
              {
                "capture": "notes",
                "key": "context_id",
                "id": "personal-notes",
                "expect": [
                  {
                    "field": "system_prompt",
                    "equals": "Keep this unrelated context unchanged."
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "installation",
          "collection": "PackInstallation",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "coordinate": {
              "_eq": "fixture/native_echo_pack"
            }
          },
          "fields": [
            "coordinate",
            "version",
            "digest"
          ]
        },
        {
          "kind": "documents",
          "name": "notes",
          "collection": "AgentContext",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "context_id": {
              "_eq": "personal-notes"
            }
          },
          "fields": [
            "context_id",
            "system_prompt"
          ]
        },
        {
          "kind": "documents",
          "name": "tools",
          "collection": "Tools",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "tools_id": {
              "_eq": "engineer-tools"
            }
          },
          "fields": [
            "tools_id",
            "host",
            "integrations"
          ]
        }
      ]
    },
    {
      "stage_id": "install-select",
      "prompt": "Go ahead and install it, and give yourself its tool.",
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "installation",
                "min": 1,
                "max": 1
              },
              {
                "capture": "tools",
                "min": 1,
                "max": 1
              },
              {
                "capture": "notes",
                "min": 1,
                "max": 1
              }
            ],
            "rows": [
              {
                "capture": "installation",
                "key": "coordinate",
                "id": "fixture/native_echo_pack",
                "expect": [
                  {
                    "field": "version",
                    "equals": "1.0.0"
                  }
                ]
              },
              {
                "capture": "tools",
                "key": "tools_id",
                "id": "engineer-tools",
                "expect": [
                  {
                    "field": "integrations.plugins",
                    "matches": "\\{[^{}]*\"plugin\"\\s*:\\s*\"fixture/native_echo\"[^{}]*\"digest\"\\s*:\\s*\"sha256:[0-9a-f]{64}\"[^{}]*\\}|\\{[^{}]*\"digest\"\\s*:\\s*\"sha256:[0-9a-f]{64}\"[^{}]*\"plugin\"\\s*:\\s*\"fixture/native_echo\"[^{}]*\\}"
                  }
                ]
              },
              {
                "capture": "notes",
                "key": "context_id",
                "id": "personal-notes",
                "expect": [
                  {
                    "field": "system_prompt",
                    "equals": "Keep this unrelated context unchanged."
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "installation",
          "collection": "PackInstallation",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "coordinate": {
              "_eq": "fixture/native_echo_pack"
            }
          },
          "fields": [
            "coordinate",
            "version",
            "digest"
          ]
        },
        {
          "kind": "documents",
          "name": "notes",
          "collection": "AgentContext",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "context_id": {
              "_eq": "personal-notes"
            }
          },
          "fields": [
            "context_id",
            "system_prompt"
          ]
        },
        {
          "kind": "documents",
          "name": "tools",
          "collection": "Tools",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "tools_id": {
              "_eq": "engineer-tools"
            }
          },
          "fields": [
            "tools_id",
            "host",
            "integrations"
          ]
        }
      ]
    },
    {
      "stage_id": "fresh-call",
      "prompt": "Now run the echo plugin's tool with no arguments and show me exactly what it returns.",
      "checks": [
        {
          "check": "tool_result_matches",
          "params": {
            "expect": [
              {
                "field": "native_pack_echo",
                "equals": "ok"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "notes",
                "min": 1,
                "max": 1
              }
            ],
            "rows": [
              {
                "capture": "notes",
                "key": "context_id",
                "id": "personal-notes",
                "expect": [
                  {
                    "field": "system_prompt",
                    "equals": "Keep this unrelated context unchanged."
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "installation",
          "collection": "PackInstallation",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "coordinate": {
              "_eq": "fixture/native_echo_pack"
            }
          },
          "fields": [
            "coordinate",
            "version",
            "digest"
          ]
        },
        {
          "kind": "documents",
          "name": "notes",
          "collection": "AgentContext",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "context_id": {
              "_eq": "personal-notes"
            }
          },
          "fields": [
            "context_id",
            "system_prompt"
          ]
        },
        {
          "kind": "documents",
          "name": "tools",
          "collection": "Tools",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "tools_id": {
              "_eq": "engineer-tools"
            }
          },
          "fields": [
            "tools_id",
            "host",
            "integrations"
          ]
        }
      ]
    }
  ]
}
