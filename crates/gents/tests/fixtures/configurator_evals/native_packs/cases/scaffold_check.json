{
  "case_id": "native-scaffold-and-check-without-installation",
  "split": "validation",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "scaffold",
      "prompt": "Start a new, minimal documents pack called scratch_native in the workspace. Don't install it.",
      "checks": [
        {
          "check": "captured_files_match",
          "params": {
            "name": "pack",
            "expect": [
              {
                "path": "scratch_native/manifest.json",
                "exists": true
              },
              {
                "path": "scratch_native/manifest.json",
                "pointer": "/name",
                "equals": "scratch_native"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "installations",
            "min": 0,
            "max": 0
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "file",
          "name": "pack",
          "glob": "scratch_native/manifest.json"
        },
        {
          "kind": "documents",
          "name": "installations",
          "collection": "PackInstallation",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "coordinate": {
              "_like": "%scratch_native%"
            }
          },
          "fields": [
            "coordinate",
            "version"
          ]
        }
      ]
    },
    {
      "stage_id": "check",
      "prompt": "Check that scratch_native is a valid pack and tell me the result. Still don't install it.",
      "checks": [
        {
          "check": "tool_result_matches",
          "params": {
            "expect": [
              {
                "field": "pack",
                "equals": "scratch_native"
              },
              {
                "field": "validated",
                "equals": true
              },
              {
                "field": "problems",
                "equals": []
              },
              {
                "field": "unverified",
                "equals": []
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "installations",
            "min": 0,
            "max": 0
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "installations",
          "collection": "PackInstallation",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "coordinate": {
              "_like": "%scratch_native%"
            }
          },
          "fields": [
            "coordinate",
            "version"
          ]
        }
      ]
    }
  ]
}
