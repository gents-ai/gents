{
  "case_id": "redline-follow-up",
  "split": "validation",
  "reducer": "all",
  "fixtures": {
    "schemas": [
      "type MeterCheck { reference: String handoff_id: String disposition: String }"
    ]
  },
  "stages": [
    {
      "stage_id": "configure",
      "prompt": "When a new MeterCheck comes in, confirm it: CONFIRM and its reference. Once a confirmation has gone through for a check whose handoff_id starts with redline-, follow up in that same conversation with FOLLOW and the handoff_id. Other checks get no follow-up. Set it up now; checks come in later.",
      "checks": [],
      "capture": []
    },
    {
      "stage_id": "greenline",
      "seed": {
        "collection": "MeterCheck",
        "document": {
          "reference": "PC9",
          "handoff_id": "greenline-7",
          "disposition": "inspection"
        }
      },
      "deadline_secs": 300,
      "checks": [
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              {
                "matches": "(?i)\\bconfirm\\W+PC9\\b"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": []
    },
    {
      "stage_id": "redline",
      "seed": {
        "collection": "MeterCheck",
        "document": {
          "reference": "PB6",
          "handoff_id": "redline-8",
          "disposition": "inspection"
        }
      },
      "deadline_secs": 300,
      "settle": true,
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "confirm",
                "min": 1,
                "max": 1
              },
              {
                "capture": "follow",
                "min": 1,
                "max": 1
              }
            ],
            "rows": [
              {
                "capture": "follow",
                "key": "lifecycle_state",
                "id": "completed",
                "expect": [
                  {
                    "field": "content",
                    "matches": "(?s)\\].*\\bFOLLOW\\b"
                  },
                  {
                    "field": "content",
                    "matches": "(?s)\\].*\\bredline-8\\b"
                  }
                ]
              }
            ],
            "links": [
              {
                "capture": "follow",
                "key": "lifecycle_state",
                "id": "completed",
                "field": "session_id",
                "target_capture": "confirm",
                "target_key": "session_id",
                "exact": true
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "confirm",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "purpose": {
              "_eq": "normal"
            },
            "caused_by_trigger_id": {
              "_ne": null
            },
            "_and": [
              {
                "content": {
                  "_like": "%PB6%"
                }
              },
              {
                "content": {
                  "_nlike": "%FOLLOW%"
                }
              }
            ]
          },
          "fields": [
            "request_id",
            "session_id",
            "lifecycle_state",
            "content",
            "caused_by_trigger_id",
            "caused_by_trigger_kind",
            "caused_by_source_doc_id",
            "caused_by_correlation",
            "execution_origin"
          ]
        },
        {
          "kind": "documents",
          "name": "follow",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "purpose": {
              "_eq": "normal"
            },
            "caused_by_trigger_id": {
              "_ne": null
            },
            "content": {
              "_like": "%FOLLOW%"
            }
          },
          "fields": [
            "request_id",
            "session_id",
            "lifecycle_state",
            "content",
            "caused_by_trigger_id",
            "caused_by_trigger_kind",
            "caused_by_source_doc_id",
            "caused_by_correlation",
            "execution_origin"
          ]
        }
      ]
    }
  ]
}
