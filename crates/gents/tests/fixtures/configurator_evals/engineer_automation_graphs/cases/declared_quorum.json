{
  "case_id": "declared-quorum",
  "split": "train",
  "reducer": "all",
  "fixtures": {
    "schemas": [
      "type SamplePart { reference: String batch: String required: Int }"
    ]
  },
  "stages": [
    {
      "stage_id": "configure",
      "prompt": "Each new SamplePart says in its required field how many parts its batch needs. Log every part as it arrives with PART and its reference, and once a batch has all its parts, send one more note: BATCH, the batch name, complete. Set it up now; parts come in later.",
      "checks": [],
      "capture": []
    },
    {
      "stage_id": "ash_first",
      "seed": {
        "collection": "SamplePart",
        "document": {
          "reference": "QR1",
          "batch": "ASH",
          "required": 2
        }
      },
      "deadline_secs": 300,
      "checks": [
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              {
                "matches": "(?i)\\bpart\\W+QR1\\b"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": []
    },
    {
      "stage_id": "elm_first",
      "seed": {
        "collection": "SamplePart",
        "document": {
          "reference": "QS1",
          "batch": "ELM",
          "required": 3
        }
      },
      "deadline_secs": 300,
      "checks": [
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              {
                "matches": "(?i)\\bpart\\W+QS1\\b"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": []
    },
    {
      "stage_id": "ash_second",
      "seed": {
        "collection": "SamplePart",
        "document": {
          "reference": "QR2",
          "batch": "ASH",
          "required": 2
        }
      },
      "deadline_secs": 300,
      "settle": true,
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "part_qr2",
                "min": 1,
                "max": 1
              },
              {
                "capture": "ash_done",
                "min": 1,
                "max": 1
              },
              {
                "capture": "elm_done",
                "min": 0,
                "max": 0
              }
            ],
            "rows": [
              {
                "capture": "ash_done",
                "key": "lifecycle_state",
                "id": "completed",
                "expect": [
                  {
                    "field": "content",
                    "matches": "(?s)\\].*\\bBATCH\\b"
                  },
                  {
                    "field": "content",
                    "matches": "(?s)\\].*\\bASH\\b"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "part_qr2",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "purpose": {
              "_eq": "normal"
            },
            "caused_by_trigger_id": {
              "_ne": null
            },
            "_and": [
              {
                "content": {
                  "_like": "%QR2%"
                }
              },
              {
                "content": {
                  "_nlike": "%complete%"
                }
              }
            ]
          },
          "fields": [
            "request_id",
            "session_id",
            "lifecycle_state",
            "content",
            "caused_by_trigger_id",
            "caused_by_trigger_kind",
            "caused_by_source_doc_id",
            "caused_by_correlation",
            "execution_origin"
          ]
        },
        {
          "kind": "documents",
          "name": "ash_done",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "purpose": {
              "_eq": "normal"
            },
            "caused_by_trigger_id": {
              "_ne": null
            },
            "_and": [
              {
                "content": {
                  "_like": "%complete%"
                }
              },
              {
                "content": {
                  "_like": "%ASH%"
                }
              }
            ]
          },
          "fields": [
            "request_id",
            "session_id",
            "lifecycle_state",
            "content",
            "caused_by_trigger_id",
            "caused_by_trigger_kind",
            "caused_by_source_doc_id",
            "caused_by_correlation",
            "execution_origin"
          ]
        },
        {
          "kind": "documents",
          "name": "elm_done",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "purpose": {
              "_eq": "normal"
            },
            "caused_by_trigger_id": {
              "_ne": null
            },
            "_and": [
              {
                "content": {
                  "_like": "%complete%"
                }
              },
              {
                "content": {
                  "_like": "%ELM%"
                }
              }
            ]
          },
          "fields": [
            "request_id",
            "session_id",
            "lifecycle_state",
            "content",
            "caused_by_trigger_id",
            "caused_by_trigger_kind",
            "caused_by_source_doc_id",
            "caused_by_correlation",
            "execution_origin"
          ]
        }
      ]
    }
  ]
}
