{
  "case_id": "proof-slip-run",
  "split": "train",
  "reducer": "all",
  "fixtures": {
    "files": [
      {
        "path": "slips/pending.json",
        "contents": "[\n  {\n    \"ref\": \"J5\",\n    \"units\": 7,\n    \"status\": \"open\"\n  },\n  {\n    \"ref\": \"K8\",\n    \"units\": 3,\n    \"status\": \"closed\"\n  },\n  {\n    \"ref\": \"Q2\",\n    \"units\": 13,\n    \"status\": \"open\"\n  }\n]\n"
      }
    ]
  },
  "stages": [
    {
      "stage_id": "create_and_run",
      "prompt": "Make me a task I can start by hand, proof-slip: given units and a ref, its run replies SLIP, the units, then the ref. Run it once for each open slip in slips/pending.json; you don't need to wait for the runs to finish. Leave that file as it is.",
      "settle": true,
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "j5",
                "min": 1,
                "max": 1
              },
              {
                "capture": "q2",
                "min": 1,
                "max": 1
              },
              {
                "capture": "k8",
                "min": 0,
                "max": 0
              }
            ],
            "rows": [
              {
                "capture": "j5",
                "key": "lifecycle_state",
                "id": "completed",
                "expect": [
                  {
                    "field": "content",
                    "matches": "\\bJ5\\b"
                  },
                  {
                    "field": "content",
                    "matches": "(?:^|[^0-9.])7(?:[^0-9.]|$)"
                  }
                ]
              },
              {
                "capture": "q2",
                "key": "lifecycle_state",
                "id": "completed",
                "expect": [
                  {
                    "field": "content",
                    "matches": "\\bQ2\\b"
                  },
                  {
                    "field": "content",
                    "matches": "(?:^|[^0-9.])13(?:[^0-9.]|$)"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_files_match",
          "params": {
            "name": "slips",
            "expect": [
              {
                "path": "slips/pending.json",
                "equals": "[\n  {\n    \"ref\": \"J5\",\n    \"units\": 7,\n    \"status\": \"open\"\n  },\n  {\n    \"ref\": \"K8\",\n    \"units\": 3,\n    \"status\": \"closed\"\n  },\n  {\n    \"ref\": \"Q2\",\n    \"units\": 13,\n    \"status\": \"open\"\n  }\n]\n"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "j5",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "caused_by_trigger_kind": {
              "_eq": "manual"
            },
            "content": {
              "_like": "%J5%"
            }
          },
          "fields": [
            "request_id",
            "session_id",
            "lifecycle_state",
            "content",
            "caused_by_trigger_id",
            "caused_by_trigger_kind",
            "caused_by_source_doc_id",
            "caused_by_correlation",
            "execution_origin"
          ]
        },
        {
          "kind": "documents",
          "name": "q2",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "caused_by_trigger_kind": {
              "_eq": "manual"
            },
            "content": {
              "_like": "%Q2%"
            }
          },
          "fields": [
            "request_id",
            "session_id",
            "lifecycle_state",
            "content",
            "caused_by_trigger_id",
            "caused_by_trigger_kind",
            "caused_by_source_doc_id",
            "caused_by_correlation",
            "execution_origin"
          ]
        },
        {
          "kind": "documents",
          "name": "k8",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "caused_by_trigger_kind": {
              "_eq": "manual"
            },
            "content": {
              "_like": "%K8%"
            }
          },
          "fields": [
            "request_id",
            "session_id",
            "lifecycle_state",
            "content",
            "caused_by_trigger_id",
            "caused_by_trigger_kind",
            "caused_by_source_doc_id",
            "caused_by_correlation",
            "execution_origin"
          ]
        },
        {
          "kind": "file",
          "name": "slips",
          "glob": "slips/*"
        }
      ]
    },
    {
      "stage_id": "preview",
      "prompt": "I'm thinking of adding the bay after the ref. What would that change to proof-slip look like, and what would a run for 7, J5, bay 3 reply? Don't change anything yet.",
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "j5",
                "min": 1,
                "max": 1
              },
              {
                "capture": "q2",
                "min": 1,
                "max": 1
              },
              {
                "capture": "unchanged",
                "min": 1,
                "max": 1
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              {
                "matches": "\\bSLIP\\W+7\\W+J5\\W+(?:bay\\W+)?3\\b"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "j5",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "caused_by_trigger_kind": {
              "_eq": "manual"
            },
            "content": {
              "_like": "%J5%"
            }
          },
          "fields": [
            "request_id",
            "session_id",
            "lifecycle_state",
            "content",
            "caused_by_trigger_id",
            "caused_by_trigger_kind",
            "caused_by_source_doc_id",
            "caused_by_correlation",
            "execution_origin"
          ]
        },
        {
          "kind": "documents",
          "name": "q2",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "caused_by_trigger_kind": {
              "_eq": "manual"
            },
            "content": {
              "_like": "%Q2%"
            }
          },
          "fields": [
            "request_id",
            "session_id",
            "lifecycle_state",
            "content",
            "caused_by_trigger_id",
            "caused_by_trigger_kind",
            "caused_by_source_doc_id",
            "caused_by_correlation",
            "execution_origin"
          ]
        },
        {
          "kind": "documents",
          "name": "unchanged",
          "collection": "Task",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "_or": [
              {
                "task_id": {
                  "_eq": "proof-slip"
                }
              },
              {
                "display_name": {
                  "_eq": "proof-slip"
                }
              }
            ],
            "prompt_template": {
              "_nlike": "%bay%"
            }
          },
          "fields": [
            "task_id",
            "display_name",
            "prompt_template",
            "enabled"
          ]
        }
      ]
    }
  ]
}
