{
  "case_id": "scale-card-repair",
  "split": "train",
  "reducer": "all",
  "fixtures": {
    "schemas": [
      "type ScaleCard { ref: String lane: String grams: Int }"
    ],
    "documents": [
      {
        "collection": "AgentSession",
        "document": {
          "session_id": "scale-receipts",
          "node_did": "$trial",
          "agent_did": "gents:agent-slot:engineer",
          "created_at": "2026-01-01T00:00:00Z",
          "requester_did": "$evaluator"
        }
      },
      {
        "collection": "AgentSession",
        "document": {
          "session_id": "scale-audit",
          "node_did": "$trial",
          "agent_did": "gents:agent-slot:engineer",
          "created_at": "2026-01-01T00:00:00Z",
          "requester_did": "$evaluator"
        }
      }
    ]
  },
  "stages": [
    {
      "stage_id": "configure",
      "prompt": "For every new ScaleCard, post a receipt in our scale-receipts conversation (RECEIPT and the card's ref) and an audit line in scale-audit (AUDIT, the ref and its grams). Both conversations already exist. Set it up now; cards come in later.",
      "checks": [],
      "capture": []
    },
    {
      "stage_id": "first_card",
      "seed": {
        "collection": "ScaleCard",
        "document": {
          "ref": "R1",
          "lane": "north",
          "grams": 250
        }
      },
      "deadline_secs": 300,
      "settle": true,
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "receipt_r1",
                "min": 1,
                "max": 1
              },
              {
                "capture": "audit_r1",
                "min": 1,
                "max": 1
              }
            ],
            "rows": [
              {
                "capture": "receipt_r1",
                "key": "lifecycle_state",
                "id": "completed",
                "expect": [
                  {
                    "field": "content",
                    "matches": "(?s)\\].*\\bRECEIPT\\b"
                  },
                  {
                    "field": "content",
                    "matches": "(?s)\\].*\\bR1\\b"
                  }
                ]
              },
              {
                "capture": "audit_r1",
                "key": "lifecycle_state",
                "id": "completed",
                "expect": [
                  {
                    "field": "content",
                    "matches": "(?s)\\].*\\bAUDIT\\b"
                  },
                  {
                    "field": "content",
                    "matches": "(?s)\\].*\\bR1\\b"
                  },
                  {
                    "field": "content",
                    "matches": "(?s)\\].*\\b250\\b"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "receipt_r1",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "purpose": {
              "_eq": "normal"
            },
            "caused_by_trigger_id": {
              "_ne": null
            },
            "session_id": {
              "_eq": "scale-receipts"
            },
            "content": {
              "_like": "%R1%"
            }
          },
          "fields": [
            "request_id",
            "session_id",
            "lifecycle_state",
            "content",
            "caused_by_trigger_id",
            "caused_by_trigger_kind",
            "caused_by_source_doc_id",
            "caused_by_correlation",
            "execution_origin"
          ]
        },
        {
          "kind": "documents",
          "name": "audit_r1",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "purpose": {
              "_eq": "normal"
            },
            "caused_by_trigger_id": {
              "_ne": null
            },
            "session_id": {
              "_eq": "scale-audit"
            },
            "content": {
              "_like": "%R1%"
            }
          },
          "fields": [
            "request_id",
            "session_id",
            "lifecycle_state",
            "content",
            "caused_by_trigger_id",
            "caused_by_trigger_kind",
            "caused_by_source_doc_id",
            "caused_by_correlation",
            "execution_origin"
          ]
        }
      ]
    },
    {
      "stage_id": "change",
      "prompt": "Change the receipts: cards under 100 grams don't get one anymore, and a receipt now reads RECEIPT, the card's lane, then its ref. Leave the audit lines as they are.",
      "checks": [],
      "capture": []
    },
    {
      "stage_id": "heavy",
      "seed": {
        "collection": "ScaleCard",
        "document": {
          "ref": "R9",
          "lane": "west",
          "grams": 412
        }
      },
      "deadline_secs": 300,
      "checks": [],
      "capture": []
    },
    {
      "stage_id": "light",
      "seed": {
        "collection": "ScaleCard",
        "document": {
          "ref": "R4",
          "lane": "east",
          "grams": 75
        }
      },
      "deadline_secs": 300,
      "settle": true,
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "receipt_r1",
                "min": 1,
                "max": 1
              },
              {
                "capture": "receipt_r9",
                "min": 1,
                "max": 1
              },
              {
                "capture": "receipt_r4",
                "min": 0,
                "max": 0
              },
              {
                "capture": "audit_r9",
                "min": 1,
                "max": 1
              },
              {
                "capture": "audit_r4",
                "min": 1,
                "max": 1
              }
            ],
            "rows": [
              {
                "capture": "receipt_r9",
                "key": "lifecycle_state",
                "id": "completed",
                "expect": [
                  {
                    "field": "content",
                    "matches": "(?s)\\].*\\bRECEIPT\\W+west\\W+R9\\b"
                  }
                ]
              },
              {
                "capture": "audit_r9",
                "key": "lifecycle_state",
                "id": "completed",
                "expect": [
                  {
                    "field": "content",
                    "matches": "(?s)\\].*\\bAUDIT\\b"
                  },
                  {
                    "field": "content",
                    "matches": "(?s)\\].*\\b412\\b"
                  }
                ]
              },
              {
                "capture": "audit_r4",
                "key": "lifecycle_state",
                "id": "completed",
                "expect": [
                  {
                    "field": "content",
                    "matches": "(?s)\\].*\\bAUDIT\\b"
                  },
                  {
                    "field": "content",
                    "matches": "(?s)\\].*\\b75\\b"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "receipt_r1",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "purpose": {
              "_eq": "normal"
            },
            "caused_by_trigger_id": {
              "_ne": null
            },
            "session_id": {
              "_eq": "scale-receipts"
            },
            "content": {
              "_like": "%R1%"
            }
          },
          "fields": [
            "request_id",
            "session_id",
            "lifecycle_state",
            "content",
            "caused_by_trigger_id",
            "caused_by_trigger_kind",
            "caused_by_source_doc_id",
            "caused_by_correlation",
            "execution_origin"
          ]
        },
        {
          "kind": "documents",
          "name": "receipt_r9",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "purpose": {
              "_eq": "normal"
            },
            "caused_by_trigger_id": {
              "_ne": null
            },
            "session_id": {
              "_eq": "scale-receipts"
            },
            "content": {
              "_like": "%R9%"
            }
          },
          "fields": [
            "request_id",
            "session_id",
            "lifecycle_state",
            "content",
            "caused_by_trigger_id",
            "caused_by_trigger_kind",
            "caused_by_source_doc_id",
            "caused_by_correlation",
            "execution_origin"
          ]
        },
        {
          "kind": "documents",
          "name": "receipt_r4",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "purpose": {
              "_eq": "normal"
            },
            "caused_by_trigger_id": {
              "_ne": null
            },
            "session_id": {
              "_eq": "scale-receipts"
            },
            "content": {
              "_like": "%R4%"
            }
          },
          "fields": [
            "request_id",
            "session_id",
            "lifecycle_state",
            "content",
            "caused_by_trigger_id",
            "caused_by_trigger_kind",
            "caused_by_source_doc_id",
            "caused_by_correlation",
            "execution_origin"
          ]
        },
        {
          "kind": "documents",
          "name": "audit_r9",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "purpose": {
              "_eq": "normal"
            },
            "caused_by_trigger_id": {
              "_ne": null
            },
            "session_id": {
              "_eq": "scale-audit"
            },
            "content": {
              "_like": "%R9%"
            }
          },
          "fields": [
            "request_id",
            "session_id",
            "lifecycle_state",
            "content",
            "caused_by_trigger_id",
            "caused_by_trigger_kind",
            "caused_by_source_doc_id",
            "caused_by_correlation",
            "execution_origin"
          ]
        },
        {
          "kind": "documents",
          "name": "audit_r4",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "purpose": {
              "_eq": "normal"
            },
            "caused_by_trigger_id": {
              "_ne": null
            },
            "session_id": {
              "_eq": "scale-audit"
            },
            "content": {
              "_like": "%R4%"
            }
          },
          "fields": [
            "request_id",
