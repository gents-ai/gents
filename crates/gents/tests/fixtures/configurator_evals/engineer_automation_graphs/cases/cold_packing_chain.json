{
  "case_id": "cold-packing-chain",
  "split": "held_out",
  "reducer": "all",
  "fixtures": {
    "schemas": [
      "type PackingSlip { slip: String handoff_id: String station: String }"
    ]
  },
  "stages": [
    {
      "stage_id": "configure",
      "prompt": "Set up an automation for new PackingSlip records: each one gets a run that replies PACKED and the slip. Once that run has finished for a slip whose handoff_id starts with cold-, start a follow-up run that replies CHILL and the handoff_id. Other slips get no follow-up. Set it up now; slips come in later.",
      "checks": [],
      "capture": []
    },
    {
      "stage_id": "dry",
      "seed": {
        "collection": "PackingSlip",
        "document": {
          "slip": "H7",
          "handoff_id": "dry-41",
          "station": "aisle 3"
        }
      },
      "deadline_secs": 300,
      "checks": [
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              {
                "matches": "(?im)^\\W*(?:[a-z]+\\W+){0,2}packed\\W+H7\\W*$"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": []
    },
    {
      "stage_id": "cold",
      "seed": {
        "collection": "PackingSlip",
        "document": {
          "slip": "H8",
          "handoff_id": "cold-42",
          "station": "aisle 9"
        }
      },
      "deadline_secs": 300,
      "settle": true,
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "confirm",
                "min": 1,
                "max": 1
              },
              {
                "capture": "follow",
                "min": 1,
                "max": 1
              }
            ],
            "rows": [
              {
                "capture": "follow",
                "key": "lifecycle_state",
                "id": "completed",
                "expect": [
                  {
                    "field": "content",
                    "matches": "(?s)\\].*\\bCHILL\\b"
                  },
                  {
                    "field": "content",
                    "matches": "(?s)\\].*\\bcold-42\\b"
                  }
                ]
              }
            ],
            "links": [
              {
                "capture": "follow",
                "key": "lifecycle_state",
                "id": "completed",
                "field": "caused_by_trigger_id",
                "target_capture": "outcome_fires",
                "target_key": "trigger_id",
                "exact": true
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "confirm",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "purpose": {
              "_eq": "normal"
            },
            "caused_by_trigger_id": {
              "_ne": null
            },
            "_and": [
              {
                "content": {
                  "_like": "%H8%"
                }
              },
              {
                "content": {
                  "_nlike": "%CHILL%"
                }
              }
            ]
          },
          "fields": [
            "request_id",
            "session_id",
            "lifecycle_state",
            "content",
            "caused_by_trigger_id",
            "caused_by_trigger_kind",
            "caused_by_source_doc_id",
            "caused_by_correlation",
            "execution_origin"
          ]
        },
        {
          "kind": "documents",
          "name": "follow",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "purpose": {
              "_eq": "normal"
            },
            "caused_by_trigger_id": {
              "_ne": null
            },
            "content": {
              "_like": "%CHILL%"
            }
          },
          "fields": [
            "request_id",
            "session_id",
            "lifecycle_state",
            "content",
            "caused_by_trigger_id",
            "caused_by_trigger_kind",
            "caused_by_source_doc_id",
            "caused_by_correlation",
            "execution_origin"
          ]
        },
        {
          "kind": "documents",
          "name": "outcome_fires",
          "collection": "TriggerFire",
          "filter": {
            "owner_did": {
              "_eq": "$trial"
            },
            "source_collection": {
              "_eq": "FireOutcome"
            }
          },
          "fields": [
            "fire_key",
            "trigger_id",
            "task_id",
            "request_id",
            "session_id",
            "source_collection",
            "source_doc_id",
            "source_handoff_id"
          ]
        }
      ]
    }
  ]
}
