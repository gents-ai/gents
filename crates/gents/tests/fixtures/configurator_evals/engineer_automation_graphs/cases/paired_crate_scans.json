{
  "case_id": "paired-crate-scans",
  "split": "validation",
  "reducer": "all",
  "fixtures": {
    "schemas": [
      "type CrateScan { scan_id: String lot: String dock: String }"
    ]
  },
  "stages": [
    {
      "stage_id": "configure",
      "prompt": "Set up an automation for new CrateScan records: each scan gets a run that replies SCAN and its scan_id, and once both scans of a lot are in, one more run replies LOT, the lot, complete. Set it up now; scans come in later.",
      "checks": [],
      "capture": []
    },
    {
      "stage_id": "kite_first",
      "seed": {
        "collection": "CrateScan",
        "document": {
          "scan_id": "S1",
          "lot": "KITE",
          "dock": "4"
        }
      },
      "deadline_secs": 300,
      "checks": [
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              {
                "matches": "(?im)^\\W*(?:[a-z]+\\W+){0,2}scan\\W+S1\\W*$"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": []
    },
    {
      "stage_id": "lark_first",
      "seed": {
        "collection": "CrateScan",
        "document": {
          "scan_id": "S2",
          "lot": "LARK",
          "dock": "4"
        }
      },
      "deadline_secs": 300,
      "checks": [
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              {
                "matches": "(?im)^\\W*(?:[a-z]+\\W+){0,2}scan\\W+S2\\W*$"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": []
    },
    {
      "stage_id": "kite_second",
      "seed": {
        "collection": "CrateScan",
        "document": {
          "scan_id": "S3",
          "lot": "KITE",
          "dock": "5"
        }
      },
      "deadline_secs": 300,
      "settle": true,
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "scan_s3",
                "min": 1,
                "max": 1
              },
              {
                "capture": "kite_done",
                "min": 1,
                "max": 1
              },
              {
                "capture": "lark_done",
                "min": 0,
                "max": 0
              }
            ],
            "rows": [
              {
                "capture": "kite_done",
                "key": "lifecycle_state",
                "id": "completed",
                "expect": [
                  {
                    "field": "content",
                    "matches": "(?s)\\].*\\bLOT\\b"
                  },
                  {
                    "field": "content",
                    "matches": "(?s)\\].*\\bKITE\\b"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "scan_s3",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "purpose": {
              "_eq": "normal"
            },
            "caused_by_trigger_id": {
              "_ne": null
            },
            "_and": [
              {
                "content": {
                  "_like": "%S3%"
                }
              },
              {
                "content": {
                  "_nlike": "%complete%"
                }
              }
            ]
          },
          "fields": [
            "request_id",
            "session_id",
            "lifecycle_state",
            "content",
            "caused_by_trigger_id",
            "caused_by_trigger_kind",
            "caused_by_source_doc_id",
            "caused_by_correlation",
            "execution_origin"
          ]
        },
        {
          "kind": "documents",
          "name": "kite_done",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "purpose": {
              "_eq": "normal"
            },
            "caused_by_trigger_id": {
              "_ne": null
            },
            "_and": [
              {
                "content": {
                  "_like": "%complete%"
                }
              },
              {
                "content": {
                  "_like": "%KITE%"
                }
              }
            ]
          },
          "fields": [
            "request_id",
            "session_id",
            "lifecycle_state",
            "content",
            "caused_by_trigger_id",
            "caused_by_trigger_kind",
            "caused_by_source_doc_id",
            "caused_by_correlation",
            "execution_origin"
          ]
        },
        {
          "kind": "documents",
          "name": "lark_done",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "purpose": {
              "_eq": "normal"
            },
            "caused_by_trigger_id": {
              "_ne": null
            },
            "_and": [
              {
                "content": {
                  "_like": "%complete%"
                }
              },
              {
                "content": {
                  "_like": "%LARK%"
                }
              }
            ]
          },
          "fields": [
            "request_id",
            "session_id",
            "lifecycle_state",
            "content",
            "caused_by_trigger_id",
            "caused_by_trigger_kind",
            "caused_by_source_doc_id",
            "caused_by_correlation",
            "execution_origin"
          ]
        }
      ]
    }
  ]
}
