{
  "case_id": "inspection-band",
  "split": "train",
  "reducer": "all",
  "fixtures": {
    "schemas": [
      "type ScaleReading { reading_id: String units: Int bay: String }"
    ]
  },
  "stages": [
    {
      "stage_id": "configure",
      "prompt": "Set up an automation for new ScaleReading records: each one gets a run that replies with a one-line verdict, INSPECT and the reading_id when its units are more than 4 and less than 8, CLEAR and the reading_id otherwise. Set it up now; readings come in later.",
      "checks": [],
      "capture": []
    },
    {
      "stage_id": "at_lower",
      "seed": {
        "collection": "ScaleReading",
        "document": {
          "reading_id": "BR2",
          "units": 4,
          "bay": "B"
        }
      },
      "deadline_secs": 300,
      "checks": [
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              {
                "matches": "(?im)^\\W*(?:[a-z]+\\W+){0,2}clear\\W+BR2\\W*$"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": []
    },
    {
      "stage_id": "at_upper",
      "seed": {
        "collection": "ScaleReading",
        "document": {
          "reading_id": "BR5",
          "units": 8,
          "bay": "B"
        }
      },
      "deadline_secs": 300,
      "checks": [
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              {
                "matches": "(?im)^\\W*(?:[a-z]+\\W+){0,2}clear\\W+BR5\\W*$"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": []
    },
    {
      "stage_id": "inside",
      "seed": {
        "collection": "ScaleReading",
        "document": {
          "reading_id": "BL6",
          "units": 7,
          "bay": "B"
        }
      },
      "deadline_secs": 300,
      "settle": true,
      "checks": [
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              {
                "matches": "(?im)^\\W*(?:[a-z]+\\W+){0,2}inspect\\W+BL6\\W*$"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "br2",
                "min": 1,
                "max": 1
              },
              {
                "capture": "br5",
                "min": 1,
                "max": 1
              },
              {
                "capture": "bl6",
                "min": 1,
                "max": 1
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "br2",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "purpose": {
              "_eq": "normal"
            },
            "caused_by_trigger_id": {
              "_ne": null
            },
            "content": {
              "_like": "%BR2%"
            }
          },
          "fields": [
            "request_id",
            "session_id",
            "lifecycle_state",
            "content",
            "caused_by_trigger_id",
            "caused_by_trigger_kind",
            "caused_by_source_doc_id",
            "caused_by_correlation",
            "execution_origin"
          ]
        },
        {
          "kind": "documents",
          "name": "br5",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "purpose": {
              "_eq": "normal"
            },
            "caused_by_trigger_id": {
              "_ne": null
            },
            "content": {
              "_like": "%BR5%"
            }
          },
          "fields": [
            "request_id",
            "session_id",
            "lifecycle_state",
            "content",
            "caused_by_trigger_id",
            "caused_by_trigger_kind",
            "caused_by_source_doc_id",
            "caused_by_correlation",
            "execution_origin"
          ]
        },
        {
          "kind": "documents",
          "name": "bl6",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "purpose": {
              "_eq": "normal"
            },
            "caused_by_trigger_id": {
              "_ne": null
            },
            "content": {
              "_like": "%BL6%"
            }
          },
          "fields": [
            "request_id",
            "session_id",
            "lifecycle_state",
            "content",
            "caused_by_trigger_id",
            "caused_by_trigger_kind",
            "caused_by_source_doc_id",
            "caused_by_correlation",
            "execution_origin"
          ]
        }
      ]
    }
  ]
}
