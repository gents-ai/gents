{
  "case_id": "desk-ticket-routing",
  "split": "validation",
  "reducer": "all",
  "fixtures": {
    "schemas": [
      "type DeskTicket { ticket: String desk: String note: String urgent: Boolean }"
    ],
    "documents": [
      {
        "collection": "AgentSession",
        "document": {
          "session_id": "desk-north",
          "node_did": "$trial",
          "agent_did": "gents:agent-slot:engineer",
          "created_at": "2026-01-01T00:00:00Z",
          "requester_did": "$evaluator"
        }
      },
      {
        "collection": "AgentSession",
        "document": {
          "session_id": "desk-south",
          "node_did": "$trial",
          "agent_did": "gents:agent-slot:engineer",
          "created_at": "2026-01-01T00:00:00Z",
          "requester_did": "$evaluator"
        }
      },
      {
        "collection": "AgentSession",
        "document": {
          "session_id": "duty-desk",
          "node_did": "$trial",
          "agent_did": "gents:agent-slot:engineer",
          "created_at": "2026-01-01T00:00:00Z",
          "requester_did": "$evaluator"
        }
      }
    ]
  },
  "stages": [
    {
      "stage_id": "configure",
      "prompt": "Post each new DeskTicket into the conversation its desk field names (desk-north or desk-south) as ACK and the ticket. Urgent tickets go to duty-desk instead, as URGENT and the ticket. Those three conversations already exist; don't start new ones. Set it up now; tickets come in later.",
      "checks": [],
      "capture": []
    },
    {
      "stage_id": "north",
      "seed": {
        "collection": "DeskTicket",
        "document": {
          "ticket": "T-11",
          "desk": "desk-north",
          "note": "printer jam",
          "urgent": false
        }
      },
      "deadline_secs": 300,
      "checks": [],
      "capture": []
    },
    {
      "stage_id": "south_urgent",
      "seed": {
        "collection": "DeskTicket",
        "document": {
          "ticket": "T-12",
          "desk": "desk-south",
          "note": "badge reader down",
          "urgent": true
        }
      },
      "deadline_secs": 300,
      "checks": [],
      "capture": []
    },
    {
      "stage_id": "south",
      "seed": {
        "collection": "DeskTicket",
        "document": {
          "ticket": "T-13",
          "desk": "desk-south",
          "note": "new monitor",
          "urgent": false
        }
      },
      "deadline_secs": 300,
      "settle": true,
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "t11",
                "min": 1,
                "max": 1
              },
              {
                "capture": "t12",
                "min": 1,
                "max": 1
              },
              {
                "capture": "t13",
                "min": 1,
                "max": 1
              },
              {
                "capture": "sessions",
                "min": 3,
                "max": 3
              }
            ],
            "rows": [
              {
                "capture": "t11",
                "key": "lifecycle_state",
                "id": "completed",
                "expect": [
                  {
                    "field": "content",
                    "matches": "(?s)\\].*\\bACK\\b"
                  },
                  {
                    "field": "content",
                    "matches": "(?s)\\].*T-11"
                  },
                  {
                    "field": "session_id",
                    "equals": "desk-north"
                  }
                ]
              },
              {
                "capture": "t12",
                "key": "lifecycle_state",
                "id": "completed",
                "expect": [
                  {
                    "field": "content",
                    "matches": "(?s)\\].*\\bURGENT\\b"
                  },
                  {
                    "field": "content",
                    "matches": "(?s)\\].*T-12"
                  },
                  {
                    "field": "session_id",
                    "equals": "duty-desk"
                  }
                ]
              },
              {
                "capture": "t13",
                "key": "lifecycle_state",
                "id": "completed",
                "expect": [
                  {
                    "field": "content",
                    "matches": "(?s)\\].*\\bACK\\b"
                  },
                  {
                    "field": "content",
                    "matches": "(?s)\\].*T-13"
                  },
                  {
                    "field": "session_id",
                    "equals": "desk-south"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "t11",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "purpose": {
              "_eq": "normal"
            },
            "caused_by_trigger_id": {
              "_ne": null
            },
            "content": {
              "_like": "%T-11%"
            }
          },
          "fields": [
            "request_id",
            "session_id",
            "lifecycle_state",
            "content",
            "caused_by_trigger_id",
            "caused_by_trigger_kind",
            "caused_by_source_doc_id",
            "caused_by_correlation",
            "execution_origin"
          ]
        },
        {
          "kind": "documents",
          "name": "t12",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "purpose": {
              "_eq": "normal"
            },
            "caused_by_trigger_id": {
              "_ne": null
            },
            "content": {
              "_like": "%T-12%"
            }
          },
          "fields": [
            "request_id",
            "session_id",
            "lifecycle_state",
            "content",
            "caused_by_trigger_id",
            "caused_by_trigger_kind",
            "caused_by_source_doc_id",
            "caused_by_correlation",
            "execution_origin"
          ]
        },
        {
          "kind": "documents",
          "name": "t13",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "purpose": {
              "_eq": "normal"
            },
            "caused_by_trigger_id": {
              "_ne": null
            },
            "content": {
              "_like": "%T-13%"
            }
          },
          "fields": [
            "request_id",
            "session_id",
            "lifecycle_state",
            "content",
            "caused_by_trigger_id",
            "caused_by_trigger_kind",
            "caused_by_source_doc_id",
            "caused_by_correlation",
            "execution_origin"
          ]
        },
        {
          "kind": "documents",
          "name": "sessions",
          "collection": "AgentSession",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "session_id": {
              "_like": "%desk%"
            }
          },
          "fields": [
            "session_id",
            "agent_did"
          ]
        }
      ]
    }
  ]
}
