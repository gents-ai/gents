{
  "case_id": "desk-ticket-routing",
  "split": "validation",
  "reducer": "all",
  "fixtures": {
    "schemas": [
      "type DeskTicket { ticket: String desk: String note: String urgent: Boolean }"
    ],
    "documents": [
      {
        "collection": "AgentSession",
        "document": {
          "session_id": "desk-north",
          "node_did": "$trial",
          "agent_did": "gents:agent-slot:engineer",
          "created_at": "2026-01-01T00:00:00Z",
          "requester_did": "$evaluator"
        }
      },
      {
        "collection": "AgentSession",
        "document": {
          "session_id": "desk-south",
          "node_did": "$trial",
          "agent_did": "gents:agent-slot:engineer",
          "created_at": "2026-01-01T00:00:00Z",
          "requester_did": "$evaluator"
        }
      },
      {
        "collection": "AgentSession",
        "document": {
          "session_id": "duty-desk",
          "node_did": "$trial",
          "agent_did": "gents:agent-slot:engineer",
          "created_at": "2026-01-01T00:00:00Z",
          "requester_did": "$evaluator"
        }
      }
    ]
  },
  "stages": [
    {
      "stage_id": "configure",
      "prompt": "Each new DeskTicket names its desk's conversation in its desk field: desk-north or desk-south. Route each ticket into the conversation its desk field names, asking the agent there to reply exactly ACK followed by the ticket. Urgent tickets (urgent is true) are the exception: whatever their desk field says, they go to the duty-desk conversation instead, asking for a reply of exactly URGENT followed by the ticket. All three conversations already exist; never open a new one. Set it up now; tickets arrive later.",
      "capture": [
        {
          "kind": "documents",
          "name": "triggers",
          "collection": "Trigger",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "trigger_id",
            "task_id",
            "source",
            "concurrency",
            "session_id_template",
            "create_session",
            "enabled",
            "last_status",
            "last_error"
          ]
        },
        {
          "kind": "documents",
          "name": "sources",
          "collection": "EventSource",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "event_source_id",
            "source_collection",
            "event_kind",
            "filter",
            "correlation_field",
            "group"
          ]
        },
        {
          "kind": "documents",
          "name": "tasks",
          "collection": "Task",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "task_id",
            "prompt_template",
            "emit_outcome",
            "enabled"
          ]
        }
      ],
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ],
            "forbidden": [
              "bash",
              "write_file",
              "edit_file"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "triggers",
                "min": 1
              },
              {
                "capture": "tasks",
                "min": 1
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "north",
      "seed": {
        "collection": "DeskTicket",
        "document": {
          "ticket": "T-11",
          "desk": "desk-north",
          "note": "printer jam",
          "urgent": false
        }
      },
      "deadline_secs": 300,
      "checks": [],
      "capture": []
    },
    {
      "stage_id": "south_urgent",
      "seed": {
        "collection": "DeskTicket",
        "document": {
          "ticket": "T-12",
          "desk": "desk-south",
          "note": "badge reader down",
          "urgent": true
        }
      },
      "deadline_secs": 300,
      "checks": [],
      "capture": []
    },
    {
      "stage_id": "south",
      "seed": {
        "collection": "DeskTicket",
        "document": {
          "ticket": "T-13",
          "desk": "desk-south",
          "note": "new monitor",
          "urgent": false
        }
      },
      "deadline_secs": 300,
      "settle": true,
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "fires",
                "min": 3,
                "max": 3
              },
              {
                "capture": "t11",
                "min": 1,
                "max": 1
              },
              {
                "capture": "t12",
                "min": 1,
                "max": 1
              },
              {
                "capture": "t13",
                "min": 1,
                "max": 1
              },
              {
                "capture": "sessions",
                "min": 3,
                "max": 3
              }
            ],
            "rows": [
              {
                "capture": "t11",
                "key": "lifecycle_state",
                "id": "completed",
                "expect": [
                  {
                    "field": "content",
                    "matches": "(?s)\\].*ACK"
                  },
                  {
                    "field": "content",
                    "matches": "(?s)\\].*T-11"
                  },
                  {
                    "field": "session_id",
                    "equals": "desk-north"
                  }
                ]
              },
              {
                "capture": "t12",
                "key": "lifecycle_state",
                "id": "completed",
                "expect": [
                  {
                    "field": "content",
                    "matches": "(?s)\\].*URGENT"
                  },
                  {
                    "field": "content",
                    "matches": "(?s)\\].*T-12"
                  },
                  {
                    "field": "session_id",
                    "equals": "duty-desk"
                  }
                ]
              },
              {
                "capture": "t13",
                "key": "lifecycle_state",
                "id": "completed",
                "expect": [
                  {
                    "field": "content",
                    "matches": "(?s)\\].*ACK"
                  },
                  {
                    "field": "content",
                    "matches": "(?s)\\].*T-13"
                  },
                  {
                    "field": "session_id",
                    "equals": "desk-south"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "fires",
          "collection": "TriggerFire",
          "filter": {
            "owner_did": {
              "_eq": "$trial"
            },
            "source_collection": {
              "_eq": "DeskTicket"
            }
          },
          "fields": [
            "fire_key",
            "trigger_id",
            "task_id",
            "request_id",
            "session_id",
            "source_collection",
            "source_doc_id",
            "source_handoff_id"
          ]
        },
        {
          "kind": "documents",
          "name": "t11",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "purpose": {
              "_eq": "normal"
            },
            "caused_by_trigger_id": {
              "_ne": null
            },
            "_and": [
              {
                "content": {
                  "_like": "%T-11%"
                }
              },
              {
                "content": {
                  "_nlike": "%URGENT%"
                }
              }
            ]
          },
          "fields": [
            "request_id",
            "session_id",
            "lifecycle_state",
            "content",
            "terminal_output",
            "caused_by_trigger_id",
            "caused_by_trigger_kind",
            "caused_by_source_doc_id",
            "caused_by_correlation",
            "execution_origin"
          ]
        },
        {
          "kind": "documents",
          "name": "t12",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "purpose": {
              "_eq": "normal"
            },
            "caused_by_trigger_id": {
              "_ne": null
            },
            "_and": [
              {
                "content": {
                  "_like": "%T-12%"
                }
              },
              {
                "content": {
                  "_like": "%URGENT%"
                }
              }
            ]
          },
          "fields": [
            "request_id",
            "session_id",
            "lifecycle_state",
            "content",
            "terminal_output",
            "caused_by_trigger_id",
            "caused_by_trigger_kind",
            "caused_by_source_doc_id",
            "caused_by_correlation",
            "execution_origin"
          ]
        },
        {
          "kind": "documents",
          "name": "t13",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "purpose": {
              "_eq": "normal"
            },
            "caused_by_trigger_id": {
              "_ne": null
            },
            "_and": [
              {
                "content": {
                  "_like": "%T-13%"
                }
              },
              {
                "content": {
                  "_nlike": "%URGENT%"
                }
              }
            ]
          },
          "fields": [
            "request_id",
            "session_id",
            "lifecycle_state",
            "content",
            "terminal_output",
            "caused_by_trigger_id",
            "caused_by_trigger_kind",
            "caused_by_source_doc_id",
            "caused_by_correlation",
            "execution_origin"
          ]
        },
        {
          "kind": "documents",
          "name": "sessions",
          "collection": "AgentSession",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "session_id": {
              "_like": "%desk%"
            }
          },
          "fields": [
            "session_id"
          ]
        }
      ]
    }
  ]
}
