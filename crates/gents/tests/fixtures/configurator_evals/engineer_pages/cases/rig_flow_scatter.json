{
  "case_id": "rig-flow-scatter",
  "split": "held_out",
  "reducer": "all",
  "fixtures": {
    "files": [
      {
        "path": "trials/rig.csv",
        "contents": "vane_deg,flow_lps,operator\n12,3.4,ana\n18,4.9,ana\n27,4.1,lee\n9,2.2,lee\n33,5.6,ana\n21,6.0,lee\n"
      }
    ]
  },
  "stages": [
    {
      "stage_id": "chart",
      "prompt": "Plot the rig trial in trials/rig.csv as a scatter of flow against vane angle, angle on the x axis, with each operator's runs in their own colour. What flow did the rig give at the widest vane angle, and whose runs track the vane angle more closely?",
      "checks": [
        {
          "check": "tool_result_matches",
          "params": {
            "expect": [
              {
                "field": "response.chart",
                "fallback_field": "chart",
                "equals": "scatter"
              },
              {
                "field": "response.series",
                "fallback_field": "series",
                "matches": "\"name\"\\s*:\\s*\"ana\""
              },
              {
                "field": "response.series",
                "fallback_field": "series",
                "matches": "\"name\"\\s*:\\s*\"lee\""
              },
              {
                "field": "response.series",
                "fallback_field": "series",
                "matches": "\"correlation\""
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              {
                "matches": "\\b5\\.6\\b"
              },
              {
                "matches": "(?i)\\bana\\b"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}
