{
  "case_id": "rig-flow-scatter",
  "split": "held_out",
  "reducer": "all",
  "fixtures": {
    "files": [
      {
        "path": "trials/rig.csv",
        "contents": "vane_deg,flow_lps,operator\n12,3.4,ana\n18,4.9,ana\n27,4.1,lee\n9,2.2,lee\n33,5.6,ana\n21,6.0,lee\n"
      }
    ]
  },
  "stages": [
    {
      "stage_id": "chart",
      "prompt": "Plot the rig trial from trials/rig.csv as a scatter of flow against vane angle, angle on the x axis, with each operator's runs as their own colour. What flow did the rig give at the widest vane angle, and whose runs track the vane angle more closely? Finish with JSON holding widest_flow and closer_operator.",
      "capture": [
        {
          "kind": "documents",
          "name": "file_changes",
          "collection": "ToolFileChange",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "tool_call_doc_id",
            "session_id",
            "file_changes"
          ]
        },
        {
          "kind": "documents",
          "name": "charts",
          "collection": "AgentToolCall",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "tool_name": {
              "_eq": "charts"
            },
            "lifecycle_state": {
              "_eq": "completed"
            }
          },
          "fields": [
            "_docID",
            "tool_name",
            "lifecycle_state",
            "plugin_parent_tool_call_doc_id",
            "result"
          ]
        }
      ],
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "charts"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "file_changes",
            "min": 0,
            "max": 0
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "charts",
                "min": 1
              }
            ],
            "rows": [
              {
                "capture": "charts",
                "key": "lifecycle_state",
                "id": "completed",
                "expect": [
                  {
                    "field": "result",
                    "matches": "\\\\?\"chart\\\\?\"\\s*:\\s*\\\\?\"scatter\\\\?\""
                  },
                  {
                    "field": "result",
                    "matches": "\\\\?\"correlation\\\\?\""
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              {
                "matches": "\"widest_flow\"\\s*:\\s*5\\.6\\b"
              },
              {
                "matches": "\"closer_operator\"\\s*:\\s*\"ana\""
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}
