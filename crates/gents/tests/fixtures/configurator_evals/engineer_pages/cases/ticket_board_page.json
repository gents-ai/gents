{
  "case_id": "ticket-board-page",
  "split": "train",
  "reducer": "all",
  "fixtures": {
    "schemas": [
      "type Ticket { ticket: String title: String lane: String }"
    ],
    "documents": [
      {
        "collection": "Ticket",
        "document": {
          "ticket": "TK-310",
          "title": "Dock door sticks",
          "lane": "maintenance"
        }
      },
      {
        "collection": "Ticket",
        "document": {
          "ticket": "TK-318",
          "title": "Pallet scanner offline",
          "lane": "it"
        }
      },
      {
        "collection": "Ticket",
        "document": {
          "ticket": "TK-322",
          "title": "Forklift battery swap",
          "lane": "maintenance"
        }
      }
    ]
  },
  "stages": [
    {
      "stage_id": "build",
      "prompt": "Make me a Ticket Board page that lists every ticket with its title and lane, and shows at the top how many tickets are in the maintenance lane. Lint it before you tell me it's ready.",
      "capture": [
        {
          "kind": "documents",
          "name": "pages",
          "collection": "Page",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "page_id",
            "display_name",
            "module",
            "css",
            "data",
            "enabled"
          ]
        },
        {
          "kind": "documents",
          "name": "surfaces",
          "collection": "DatastoreToolSurface",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "surface_id": {
              "_ne": "engineer-mailbox"
            }
          },
          "fields": [
            "surface_id",
            "display_name",
            "entries",
            "enabled"
          ]
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "pages",
                "min": 1,
                "max": 1
              }
            ],
            "rows": [
              {
                "capture": "pages",
                "key": "display_name",
                "id": "Ticket Board",
                "expect": [
                  {
                    "field": "enabled",
                    "equals": true
                  },
                  {
                    "field": "module",
                    "matches": "\\buseQuery\\("
                  },
                  {
                    "field": "module",
                    "matches": "maintenance"
                  },
                  {
                    "field": "module",
                    "matches": "\\btitle\\b"
                  },
                  {
                    "field": "module",
                    "matches": "\\blane\\b"
                  },
                  {
                    "field": "data",
                    "matches": "\"surface\"\\s*:\\s*\"[a-z0-9_]+\""
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "surfaces",
            "min_rows": 1,
            "expect": [
              {
                "field": "entries",
                "matches": "\"kind\"\\s*:\\s*\"query\""
              },
              {
                "field": "entries",
                "matches": "\"collection\"\\s*:\\s*\"Ticket\""
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "tool_result_matches",
          "params": {
            "expect": [
              {
                "field": "admitted",
                "equals": true
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}
