{
  "case_id": "clear-lint-finding",
  "split": "train",
  "reducer": "all",
  "fixtures": {
    "schemas": [
      "type Shift { shift: String needed: Int staffed: Int }"
    ],
    "documents": [
      {
        "collection": "Shift",
        "document": {
          "shift": "early",
          "needed": 6,
          "staffed": 4
        }
      },
      {
        "collection": "Shift",
        "document": {
          "shift": "late",
          "needed": 5,
          "staffed": 5
        }
      },
      {
        "collection": "DatastoreToolSurface",
        "document": {
          "surface_id": "shift_desk",
          "node_did": "$trial",
          "display_name": "Shift desk",
          "entries": [
            {
              "kind": "query",
              "tool_name": "list_shifts",
              "collection": "Shift",
              "description": "Shifts with staffing.",
              "fields": [
                "shift",
                "needed",
                "staffed"
              ]
            }
          ]
        }
      },
      {
        "collection": "Page",
        "document": {
          "page_id": "shift_board",
          "node_did": "$trial",
          "display_name": "Shift Board",
          "module": "import { NAV_AREA, PLUGIN_PAGE_AREA, Page, Table, Badge, useQuery } from '@gents/ux-sdk'\nimport { jsx, jsxs } from 'react/jsx-runtime'\n\nfunction ShiftBoard({ ctx }) {\n  const q = useQuery(ctx, 'shift_desk', 'list_shifts', { pages: 'all' })\n  const rows = q.data?.results ?? []\n  const short = rows.filter(row => row.staffed < row.needed).length\n  return jsxs(Page, { title: 'Shift Board', children: [\n    jsx('p', { className: 'shift-alert', style: { borderBottom: '1px solid var(--background)' }, children: jsx(Badge, { variant: 'outline', children: short + ' short-staffed' }) }),\n    jsx(Table, { columns: ['shift', 'needed', 'staffed'], rows, rowKey: 'shift' }),\n  ] })\n}\n\nexport default {\n  id: 'shift_board',\n  name: 'Shift Board',\n  register(ctx) {\n    ctx.registerMany([\n      { id: 'nav', area: NAV_AREA, data: { id: 'shift_board:nav', label: 'Shift Board', icon: 'calendar', to: { name: 'plugin', pluginId: 'shift_board' }, placement: 'footer' } },\n      { id: 'page', area: PLUGIN_PAGE_AREA, render: () => jsx(ShiftBoard, { ctx }) },\n    ])\n  },\n}\n",
          "data": [
            {
              "surface": "shift_desk",
              "tools": [
                "list_shifts"
              ]
            }
          ],
          "css": ".shift-alert { color: #c0392b; font-weight: 600; }"
        }
      }
    ]
  },
  "stages": [
    {
      "stage_id": "fix",
      "prompt": "The page lint flags my Shift Board page. Fix what it reports without changing what the page shows or does, and show me that the lint passes.",
      "capture": [
        {
          "kind": "documents",
          "name": "pages",
          "collection": "Page",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "page_id",
            "display_name",
            "module",
            "css",
            "data",
            "enabled"
          ]
        },
        {
          "kind": "documents",
          "name": "surfaces",
          "collection": "DatastoreToolSurface",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "surface_id": {
              "_ne": "engineer-mailbox"
            }
          },
          "fields": [
            "surface_id",
            "display_name",
            "entries",
            "enabled"
          ]
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "pages",
                "min": 1,
                "max": 1
              }
            ],
            "rows": [
              {
                "capture": "pages",
                "key": "page_id",
                "id": "shift_board",
                "expect": [
                  {
                    "field": "enabled",
                    "equals": true
                  },
                  {
                    "field": "module",
                    "matches": "useQuery\\(\\s*ctx\\s*,\\s*['\"]shift_desk['\"]\\s*,\\s*['\"]list_shifts['\"]"
                  },
                  {
                    "field": "module",
                    "matches": "borderBottom\\s*:\\s*['\"]1px solid var\\(--"
                  },
                  {
                    "field": "module",
                    "matches": "\\bBadge\\b"
                  },
                  {
                    "field": "module",
                    "matches": "\\bTable\\b"
                  },
                  {
                    "field": "css",
                    "matches": "\\.shift-alert\\s*\\{"
                  },
                  {
                    "field": "css",
                    "matches": "font-weight\\s*:\\s*600"
                  },
                  {
                    "field": "css",
                    "matches": "color\\s*:\\s*var\\(--"
                  },
                  {
                    "field": "data",
                    "matches": "\"surface\"\\s*:\\s*\"shift_desk\""
                  },
                  {
                    "field": "data",
                    "matches": "\"list_shifts\""
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "tool_result_matches",
          "params": {
            "expect": [
              {
                "field": "page",
                "equals": "shift_board"
              },
              {
                "field": "admitted",
                "equals": true
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}
