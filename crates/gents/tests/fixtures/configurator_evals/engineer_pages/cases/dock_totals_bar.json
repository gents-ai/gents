{
  "case_id": "dock-totals-bar",
  "split": "train",
  "reducer": "all",
  "fixtures": {
    "files": [
      {
        "path": "quay.csv",
        "contents": "dock,crates\nTern,11\nKite,20\nTern,17\nLoon,13\nKite,4\n"
      },
      {
        "path": "quay-late.csv",
        "contents": "dock,crates\nLoon,9\nKite,3\nTern,6\n"
      }
    ]
  },
  "stages": [
    {
      "stage_id": "chart",
      "prompt": "Chart crates per dock as bars, counting both quay.csv and the late deliveries in quay-late.csv and combining repeat deliveries. Which dock handled the most, and how many crates? End with a JSON object with dock and crates.",
      "capture": [
        {
          "kind": "documents",
          "name": "file_changes",
          "collection": "ToolFileChange",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "tool_call_doc_id",
            "session_id",
            "file_changes"
          ]
        },
        {
          "kind": "documents",
          "name": "charts",
          "collection": "AgentToolCall",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "session_id": {
              "_eq": "$session"
            },
            "tool_name": {
              "_eq": "charts"
            },
            "lifecycle_state": {
              "_eq": "completed"
            }
          },
          "fields": [
            "_docID",
            "tool_name",
            "lifecycle_state"
          ]
        },
        {
          "kind": "documents",
          "name": "segments",
          "collection": "AgentOutputSegment",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "session_id": {
              "_eq": "$session"
            }
          },
          "fields": [
            "_docID",
            "source",
            "payload"
          ]
        }
      ],
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "charts"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "file_changes",
            "min": 0,
            "max": 0
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "charts",
                "min": 1
              }
            ],
            "links": [
              {
                "capture": "charts",
                "key": "lifecycle_state",
                "id": "completed",
                "field": "_docID",
                "target_capture": "segments",
                "target_key": "source.tool_call_doc_id",
                "expect": [
                  {
                    "field": "payload",
                    "matches": "\\\\?\"chart\\\\?\"\\s*:\\s*\\\\?\"bar\\\\?\""
                  },
                  {
                    "field": "payload",
                    "matches": "\\\\?\"sum\\\\?\"\\s*:\\s*83(\\.0+)?\\b"
                  },
                  {
                    "field": "payload",
                    "matches": "\\\\?\"max\\\\?\"\\s*:\\s*34(\\.0+)?\\b"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              {
                "matches": "\"dock\"\\s*:\\s*\"Tern\""
              },
              {
                "matches": "\"crates\"\\s*:\\s*34\\b"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}
