{
  "case_id": "dock-totals-bar",
  "split": "train",
  "reducer": "all",
  "fixtures": {
    "files": [
      {
        "path": "quay.csv",
        "contents": "dock,crates\nTern,11\nKite,20\nTern,17\nLoon,13\nKite,4\n"
      },
      {
        "path": "quay-late.csv",
        "contents": "dock,crates\nLoon,9\nKite,3\nTern,6\n"
      }
    ]
  },
  "stages": [
    {
      "stage_id": "chart",
      "prompt": "Chart crates per dock as bars, counting both quay.csv and the late deliveries in quay-late.csv; a dock that shows up more than once should be added up. Which dock handled the most, and how many crates?",
      "checks": [
        {
          "check": "tool_result_matches",
          "params": {
            "expect": [
              {
                "field": "response.chart",
                "fallback_field": "chart",
                "equals": "bar"
              },
              {
                "field": "response.series",
                "fallback_field": "series",
                "matches": "\"sum\"\\s*:\\s*83(\\.0+)?[,}\\s]"
              },
              {
                "field": "response.series",
                "fallback_field": "series",
                "matches": "\"max\"\\s*:\\s*34(\\.0+)?[,}\\s]"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              {
                "matches": "\\bTern\\b"
              },
              {
                "matches": "\\b34\\b"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}
