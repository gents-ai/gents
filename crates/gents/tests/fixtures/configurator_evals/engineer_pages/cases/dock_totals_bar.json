{
  "case_id": "dock-totals-bar",
  "split": "train",
  "reducer": "all",
  "fixtures": {
    "files": [
      {
        "path": "quay.csv",
        "contents": "dock,crates\nTern,11\nKite,20\nTern,17\nLoon,13\nKite,4\n"
      },
      {
        "path": "quay-late.csv",
        "contents": "dock,crates\nLoon,9\nKite,3\nTern,6\n"
      }
    ]
  },
  "stages": [
    {
      "stage_id": "chart",
      "prompt": "Chart crates per dock as bars, counting both quay.csv and the late deliveries in quay-late.csv; a dock that shows up more than once should be added up. How many crates did each dock handle?",
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "charts"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              {
                "matches": "Tern\\b(?:[^-]|-\\D){0,40}?\\b34\\b"
              },
              {
                "matches": "Kite\\b(?:[^-]|-\\D){0,40}?\\b27\\b"
              },
              {
                "matches": "Loon\\b(?:[^-]|-\\D){0,40}?\\b22\\b"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}
