{
  "case_id": "tide-line",
  "split": "train",
  "reducer": "all",
  "fixtures": {
    "files": [
      {
        "path": "tide.csv",
        "contents": "day,level\nMonday,14\nMonday,6\nTuesday,9\nTuesday,12\nWednesday,23\nWednesday,3\nThursday,n/a\nThursday,19\nFriday,18\nFriday,17\n"
      }
    ]
  },
  "stages": [
    {
      "stage_id": "chart",
      "prompt": "tide.csv logs two readings a day. Draw a line chart of each day's high water. Which day had the highest high water, and what was it?",
      "checks": [
        {
          "check": "tool_result_matches",
          "params": {
            "expect": [
              {
                "field": "response.chart",
                "fallback_field": "chart",
                "equals": "line"
              },
              {
                "field": "response.series",
                "fallback_field": "series",
                "matches": "\"sum\"\\s*:\\s*86(\\.0+)?[,}\\s]"
              },
              {
                "field": "response.series",
                "fallback_field": "series",
                "matches": "\"max\"\\s*:\\s*23(\\.0+)?[,}\\s]"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              {
                "matches": "(?i)\\bWednesday\\b"
              },
              {
                "matches": "\\b23\\b"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}
