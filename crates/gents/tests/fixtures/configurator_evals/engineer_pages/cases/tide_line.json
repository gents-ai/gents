{
  "case_id": "tide-line",
  "split": "train",
  "reducer": "all",
  "fixtures": {
    "files": [
      {
        "path": "tide.csv",
        "contents": "day,level\nMonday,14\nMonday,6\nTuesday,9\nTuesday,12\nWednesday,23\nWednesday,3\nThursday,n/a\nThursday,19\nFriday,18\nFriday,17\n"
      }
    ]
  },
  "stages": [
    {
      "stage_id": "chart",
      "prompt": "tide.csv logs two readings a day. Draw a line chart of each day's high water. What was each day's high, and which day had the highest?",
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "charts"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              {
                "matches": "(?i:Monday)\\b(?:[^-]|-\\D){0,40}?\\b14\\b"
              },
              {
                "matches": "(?i:Tuesday)\\b(?:[^-]|-\\D){0,40}?\\b12\\b"
              },
              {
                "matches": "(?i:Wednesday)\\b(?:[^-]|-\\D){0,40}?\\b23\\b"
              },
              {
                "matches": "(?i:Thursday)\\b(?:[^-]|-\\D){0,40}?\\b19\\b"
              },
              {
                "matches": "(?i:Friday)\\b(?:[^-]|-\\D){0,40}?\\b18\\b"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}
