{
  "case_id": "retry-callers-audit",
  "split": "validation",
  "reducer": "all",
  "fixtures": {
    "files": [
      {
        "path": "Cargo.toml",
        "contents": "[workspace]\nmembers = [\"crates/*\"]\nresolver = \"2\"\n"
      },
      {
        "path": "crates/ledger-core/Cargo.toml",
        "contents": "[package]\nname = \"tally_core\"\nversion = \"0.3.1\"\nedition = \"2021\"\n"
      },
      {
        "path": "crates/ledger-core/src/lib.rs",
        "contents": "pub mod retry;\npub mod totals;\n"
      },
      {
        "path": "crates/ledger-core/src/retry.rs",
        "contents": "use std::time::Duration;\n\npub fn retry_forever<T, E>(mut op: impl FnMut() -> Result<T, E>) -> T {\n    loop {\n        if let Ok(value) = op() {\n            return value;\n        }\n        std::thread::sleep(Duration::from_millis(50));\n    }\n}\n\npub fn retry_bounded<T, E>(attempts: u32, mut op: impl FnMut() -> Result<T, E>) -> Result<T, E> {\n    let mut last = op();\n    for _ in 1..attempts {\n        if last.is_ok() {\n            break;\n        }\n        last = op();\n    }\n    last\n}\n\n#[cfg(test)]\nmod tests {\n    #[test]\n    fn returns_first_success() {\n        assert_eq!(super::retry_forever(|| Ok::<_, ()>(3)), 3);\n    }\n}\n"
      },
      {
        "path": "crates/ledger-core/src/totals.rs",
        "contents": "pub fn total(values: &[i64]) -> i64 {\n    values.iter().sum()\n}\n"
      },
      {
        "path": "crates/ferry-api/Cargo.toml",
        "contents": "[package]\nname = \"ferry_api\"\nversion = \"0.1.0\"\nedition = \"2021\"\n\n[dependencies]\ntally_core = { path = \"../ledger-core\" }\n"
      },
      {
        "path": "crates/ferry-api/src/lib.rs",
        "contents": "pub mod client;\n"
      },
      {
        "path": "crates/ferry-api/src/client.rs",
        "contents": "use tally_core::retry;\n\npub struct Client;\n\nimpl Client {\n    pub fn fetch_manifest(&self) -> String {\n        retry::retry_forever(|| self.try_fetch())\n    }\n\n    fn try_fetch(&self) -> Result<String, ()> {\n        Ok(String::from(\"manifest\"))\n    }\n}\n"
      },
      {
        "path": "crates/dock-sync/Cargo.toml",
        "contents": "[package]\nname = \"dock_sync\"\nversion = \"0.2.0\"\nedition = \"2021\"\n\n[dependencies]\ntally_core = { path = \"../ledger-core\" }\n"
      },
      {
        "path": "crates/dock-sync/src/lib.rs",
        "contents": "// retry_forever is banned on sync paths: a dead peer would hang the dock.\nuse tally_core::retry::retry_bounded;\n\npub fn push(batch: &[u8]) -> Result<usize, ()> {\n    retry_bounded(3, || send(batch))\n}\n\nfn send(batch: &[u8]) -> Result<usize, ()> {\n    Ok(batch.len())\n}\n"
      },
      {
        "path": "crates/berth-plan/Cargo.toml",
        "contents": "[package]\nname = \"berth_planner\"\nversion = \"0.5.2\"\nedition = \"2021\"\n\n[dependencies]\ntally_core = { path = \"../ledger-core\" }\n"
      },
      {
        "path": "crates/berth-plan/src/lib.rs",
        "contents": "use tally_core::retry::retry_forever as forever;\n\npub fn reserve(slot: u32) -> u32 {\n    forever(|| try_reserve(slot))\n}\n\nfn try_reserve(slot: u32) -> Result<u32, ()> {\n    Ok(slot)\n}\n"
      },
      {
        "path": "crates/ops-notes/Cargo.toml",
        "contents": "[package]\nname = \"ops_journal\"\nversion = \"0.1.0\"\nedition = \"2021\"\n"
      },
      {
        "path": "crates/ops-notes/src/lib.rs",
        "contents": "pub fn reminder() -> &'static str {\n    \"never call retry_forever() from a request handler\"\n}\n"
      },
      {
        "path": "crates/prelude/Cargo.toml",
        "contents": "[package]\nname = \"harbor_prelude\"\nversion = \"0.1.0\"\nedition = \"2021\"\n\n[dependencies]\ntally_core = { path = \"../ledger-core\" }\n"
      },
      {
        "path": "crates/prelude/src/lib.rs",
        "contents": "pub use tally_core::retry::retry_forever as keep_trying;\npub use tally_core::totals::total;\n"
      },
      {
        "path": "crates/pilot-tools/Cargo.toml",
        "contents": "[package]\nname = \"pilot_tools\"\nversion = \"0.4.0\"\nedition = \"2021\"\n\n[dependencies]\nharbor_prelude = { path = \"../prelude\" }\n"
      },
      {
        "path": "crates/pilot-tools/src/lib.rs",
        "contents": "use harbor_prelude::keep_trying;\n\npub fn tide_window() -> u8 {\n    keep_trying(read_gauge)\n}\n\nfn read_gauge() -> Result<u8, ()> {\n    Ok(4)\n}\n"
      },
      {
        "path": "crates/tools-cli/Cargo.toml",
        "contents": "[package]\nname = \"harbor_cli\"\nversion = \"1.4.0\"\nedition = \"2021\"\n\n[dependencies]\ntally_core = { path = \"../ledger-core\" }\n"
      },
      {
        "path": "crates/tools-cli/src/main.rs",
        "contents": "use tally_core::retry::retry_forever;\n\nfn connect() -> Result<u16, ()> {\n    Ok(7)\n}\n\nfn main() {\n    let port = retry_forever(connect);\n    println!(\"connected on {port}\");\n}\n"
      }
    ]
  },
  "stages": [
    {
      "stage_id": "audit",
      "prompt": "In this Rust workspace, which packages call tally_core's retry_forever, under any name it is imported or re-exported as? Don't count the package that defines it, and a mention or re-export that isn't a call doesn't count. Write their Cargo package names (the name in each Cargo.toml, not the directory) to audit/retry_callers.txt, one per line, sorted. Don't change any source.",
      "capture": [
        {
          "kind": "file",
          "name": "workspace",
          "glob": "**/*"
        }
      ],
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "forbidden": [
              "bash"
            ],
            "config_read_only": true
          },
          "tier": "acceptance",
          "weight": 1
