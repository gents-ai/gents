{
  "case_id": "stockroom-register-pack",
  "split": "train",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "author",
      "prompt": "Package our stockroom register as a pack, fielddesk/stockroom_register 1.0.0, in packs/stockroom_register: one collection, StockroomBin, with binCode, itemName and onHand (a whole number), and nothing else. Install it here.",
      "capture": [
        {
          "kind": "documents",
          "name": "install",
          "collection": "PackInstallation",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "coordinate": {
              "_eq": "fielddesk/stockroom_register"
            }
          },
          "fields": [
            "coordinate",
            "version",
            "digest",
            "source"
          ]
        },
        {
          "kind": "schema",
          "name": "schema",
          "collections": [
            "StockroomBin"
          ]
        },
        {
          "kind": "file",
          "name": "packs",
          "glob": "packs/**/*"
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "install",
                "min": 1,
                "max": 1
              }
            ],
            "rows": [
              {
                "capture": "install",
                "key": "coordinate",
                "id": "fielddesk/stockroom_register",
                "expect": [
                  {
                    "field": "version",
                    "equals": "1.0.0"
                  },
                  {
                    "field": "digest",
                    "matches": "^sha256:[0-9a-f]{64}$"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "schema_matches",
          "params": {
            "name": "schema",
            "sdl": "type StockroomBin { binCode: String itemName: String onHand: Int }"
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_files_match",
          "params": {
            "name": "packs",
            "expect": [
              {
                "path": "packs/stockroom_register/manifest.json",
                "pointer": "/kind",
                "equals": "documents"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "use",
      "prompt": "Add bin A-01 to the stockroom register: 40 hex bolts.",
      "settle": true,
      "continuation": {
        "prompt": "Is bin A-01 in the register now?",
        "max": 1,
        "until": "bins"
      },
      "checks": [
        {
          "check": "captured_fields_match",
          "params": {
            "name": "bins",
            "min_rows": 1,
            "max_rows": 1,
            "expect": [
              {
                "field": "itemName",
                "matches": "(?i)hex bolt"
              },
              {
                "field": "onHand",
                "equals": 40
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "bins",
          "collection": "StockroomBin",
          "filter": {
            "binCode": {
              "_eq": "A-01"
            }
          },
          "fields": [
            "binCode",
            "itemName",
            "onHand"
          ]
        }
      ]
    }
  ]
}
