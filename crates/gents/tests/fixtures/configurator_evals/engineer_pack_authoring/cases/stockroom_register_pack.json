{
  "case_id": "stockroom-register-pack",
  "split": "train",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "author",
      "prompt": "Make a pack for the stockroom register: fielddesk/stockroom_register, version 1.0.0, authored in packs/stockroom_register. It holds one collection, StockroomBin, with binCode (String), itemName (String) and onHand (Int), and nothing else: no agents, plugins or records. Check it, build it, and install the archive you built rather than the directory.",
      "capture": [
        {
          "kind": "documents",
          "name": "install",
          "collection": "PackInstallation",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "coordinate": {
              "_eq": "fielddesk/stockroom_register"
            }
          },
          "fields": [
            "coordinate",
            "version",
            "digest",
            "source"
          ]
        },
        {
          "kind": "schema",
          "name": "schema",
          "collections": [
            "StockroomBin"
          ]
        },
        {
          "kind": "file",
          "name": "packs",
          "glob": "packs/**/*"
        }
      ],
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ],
            "forbidden": [
              "bash"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "install",
                "min": 1,
                "max": 1
              }
            ],
            "rows": [
              {
                "capture": "install",
                "key": "coordinate",
                "id": "fielddesk/stockroom_register",
                "expect": [
                  {
                    "field": "version",
                    "equals": "1.0.0"
                  },
                  {
                    "field": "digest",
                    "matches": "^sha256:[0-9a-f]{64}$"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "schema_matches",
          "params": {
            "name": "schema",
            "sdl": "type StockroomBin { binCode: String itemName: String onHand: Int }"
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_files_match",
          "params": {
            "name": "packs",
            "expect": [
              {
                "path": "packs/fielddesk.stockroom_register-1.0.0.pack",
                "exists": true
              },
              {
                "path": "packs/stockroom_register/manifest.json",
                "pointer": "/kind",
                "equals": "documents"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}
