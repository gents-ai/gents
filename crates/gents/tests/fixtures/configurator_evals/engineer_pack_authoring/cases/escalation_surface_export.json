{
  "case_id": "escalation-surface-export",
  "split": "train",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "export",
      "prompt": "I want to carry this node's live engineer-mailbox datastore surface to another node. Export it as a new pack named escalation_surface in namespace fielddesk, written to escalation_surface/ in the workspace, and give it version 1.0.0. Check and build it, but don't install it here.",
      "capture": [
        {
          "kind": "documents",
          "name": "install",
          "collection": "PackInstallation",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "coordinate": {
              "_eq": "fielddesk/escalation_surface"
            }
          },
          "fields": [
            "coordinate",
            "version",
            "digest",
            "source"
          ]
        },
        {
          "kind": "file",
          "name": "workspace",
          "glob": "**/*"
        }
      ],
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ],
            "forbidden": [
              "bash",
              "bash_unrestricted"
            ],
            "config_read_only": true
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "install",
            "min": 0,
            "max": 0
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_files_match",
          "params": {
            "name": "workspace",
            "expect": [
              {
                "path": "escalation_surface/manifest.json",
                "pointer": "/name",
                "equals": "escalation_surface"
              },
              {
                "path": "escalation_surface/manifest.json",
                "pointer": "/namespace",
                "equals": "fielddesk"
              },
              {
                "path": "escalation_surface/manifest.json",
                "pointer": "/version",
                "equals": "1.0.0"
              },
              {
                "path": "escalation_surface/pack_config.json",
                "pointer": "/datastore_tool_surfaces/0/surface_id",
                "equals": "engineer-mailbox"
              },
              {
                "path": "fielddesk.escalation_surface-1.0.0.pack",
                "exists": true
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}
