{
  "case_id": "parts-desk-app-pack",
  "split": "held_out",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "package",
      "prompt": "Package and install depot/parts_desk 2.0.0 in packs/parts_desk: PartBin(binCode, partName, onHand: Int), PartRequest(binCode, quantity: Int, requestedBy), surface parts-desk with list_bins (all PartBin fields) and request_part (creates PartRequest, all fields required). No agents or records.",
      "capture": [
        {
          "kind": "documents",
          "name": "install",
          "collection": "PackInstallation",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "coordinate": {
              "_eq": "depot/parts_desk"
            }
          },
          "fields": [
            "coordinate",
            "version",
            "digest",
            "source"
          ]
        },
        {
          "kind": "documents",
          "name": "surface",
          "collection": "DatastoreToolSurface",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "surface_id": {
              "_eq": "parts-desk"
            }
          },
          "fields": [
            "surface_id",
            "entries"
          ]
        },
        {
          "kind": "schema",
          "name": "schema",
          "collections": [
            "PartBin",
            "PartRequest"
          ]
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "install",
                "min": 1,
                "max": 1
              },
              {
                "capture": "surface",
                "min": 1,
                "max": 1
              }
            ],
            "rows": [
              {
                "capture": "install",
                "key": "coordinate",
                "id": "depot/parts_desk",
                "expect": [
                  {
                    "field": "version",
                    "equals": "2.0.0"
                  },
                  {
                    "field": "digest",
                    "matches": "^sha256:[0-9a-f]{64}$"
                  }
                ]
              },
              {
                "capture": "surface",
                "key": "surface_id",
                "id": "parts-desk",
                "expect": [
                  {
                    "field": "entries",
                    "matches": "(?s)list_bins.*request_part|request_part.*list_bins"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "schema_matches",
          "params": {
            "name": "schema",
            "sdl": "type PartBin { binCode: String partName: String onHand: Int } type PartRequest { binCode: String quantity: Int requestedBy: String }"
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "use",
      "prompt": "Use the parts desk to request 3 from bin B-12 for Dana.",
      "settle": true,
      "continuation": {
        "prompt": "Did the request for bin B-12 go in?",
        "max": 1,
        "until": "requests"
      },
      "checks": [
        {
          "check": "captured_fields_match",
          "params": {
            "name": "requests",
            "min_rows": 1,
            "max_rows": 1,
            "expect": [
              {
                "field": "quantity",
                "equals": 3
              },
              {
                "field": "requestedBy",
                "matches": "(?i)\\bdana\\b"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "requests",
          "collection": "PartRequest",
          "filter": {
            "binCode": {
              "_eq": "B-12"
            }
          },
          "fields": [
            "binCode",
            "quantity",
            "requestedBy"
          ]
        }
      ]
    }
  ]
}
