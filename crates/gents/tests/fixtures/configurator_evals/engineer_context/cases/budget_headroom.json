{
  "case_id": "budget-headroom",
  "split": "train",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "budget",
      "prompt": "Before I paste a big import into this chat: how big is your context window, how much of it is in use right now, and how full does it get before you start compacting?",
      "checks": [
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              {
                "matches": "(?i)\\b75(\\.0+)?\\s*(%|percent)"
              },
              {
                "matches": "(?i)\\b\\d{1,3}(,\\d{3})+\\b|\\b\\d{5,}\\b|\\b\\d{2,4}(\\.\\d+)?\\s?k\\b"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}
