{
  "case_id": "kiln-flag-and-question",
  "split": "train",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "both",
      "prompt": "Two inbox items: flag \"K3 door seal\" with note \"K3 failed the door seal check and is out of service.\" And ask me, titled \"Glaze supplier\", whether to reorder glaze from Marlow Ceramics or Tidewell Supply (just those two choices, optional so I can skip it).",
      "capture": [
        {
          "kind": "documents",
          "name": "visible",
          "collection": "MailboxItem",
          "filter": {},
          "fields": [
            "item_key",
            "title",
            "kind"
          ]
        },
        {
          "kind": "documents",
          "name": "notice",
          "collection": "MailboxItem",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "target_node_did": {
              "_eq": "$trial"
            },
            "target_agent_did": {
              "_eq": "gents:agent-slot:engineer"
            },
            "requester_did": {
              "_eq": "$evaluator"
            },
            "session_id": {
              "_eq": "$session"
            }
          },
          "fields": [
            "item_key",
            "node_did",
            "requester_did",
            "kind",
            "action",
            "status",
            "title",
            "summary",
            "payload",
            "source_kind",
            "session_id",
            "request_id",
            "target_node_did",
            "target_agent_did"
          ]
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "visible",
                "min": 2,
                "max": 2
              },
              {
                "capture": "notice",
                "min": 2,
                "max": 2
              }
            ],
            "rows": [
              {
                "capture": "notice",
                "key": "title",
                "id": "K3 door seal",
                "expect": [
                  {
                    "field": "summary",
                    "fallback_field": "payload",
                    "equals": "K3 failed the door seal check and is out of service."
                  },
                  {
                    "field": "kind",
                    "equals": "flag"
                  },
                  {
                    "field": "action",
                    "equals": "ack"
                  },
                  {
                    "field": "status",
                    "equals": "open"
                  },
                  {
                    "field": "source_kind",
                    "equals": "agent"
                  }
                ]
              },
              {
                "capture": "notice",
                "key": "title",
                "id": "Glaze supplier",
                "expect": [
                  {
                    "field": "payload",
                    "matches": "\"label\"\\s*:\\s*\"Marlow Ceramics\\b"
                  },
                  {
                    "field": "payload",
                    "matches": "\"label\"\\s*:\\s*\"Tidewell Supply\\b"
                  },
                  {
                    "field": "payload",
                    "contains": "\"optional\":true"
                  },
                  {
                    "field": "payload",
                    "matches": "\"options\":\\[\\{[^\\[\\]]*\\},\\s*\\{[^\\[\\]]*\\}\\]"
                  },
                  {
                    "field": "kind",
                    "equals": "ask"
                  },
                  {
                    "field": "action",
                    "equals": "start_request"
                  },
                  {
                    "field": "status",
                    "equals": "open"
                  },
                  {
                    "field": "source_kind",
                    "equals": "agent"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}
