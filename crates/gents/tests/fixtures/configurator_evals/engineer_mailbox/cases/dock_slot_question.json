{
  "case_id": "dock-slot-question",
  "split": "train",
  "reducer": "all",
  "fixtures": {
    "schemas": [
      "type CarrierBid { carrier: String dock: Int slot: String price: Int withdrawn: Boolean }"
    ],
    "documents": [
      {
        "collection": "CarrierBid",
        "document": {
          "carrier": "Harlow Freight",
          "dock": 4,
          "slot": "06:00",
          "price": 410,
          "withdrawn": false
        }
      },
      {
        "collection": "CarrierBid",
        "document": {
          "carrier": "Quayside Haulage",
          "dock": 4,
          "slot": "06:00",
          "price": 300,
          "withdrawn": true
        }
      },
      {
        "collection": "CarrierBid",
        "document": {
          "carrier": "Ostend Lines",
          "dock": 4,
          "slot": "06:00",
          "price": 385,
          "withdrawn": false
        }
      },
      {
        "collection": "CarrierBid",
        "document": {
          "carrier": "Brightway Cargo",
          "dock": 4,
          "slot": "06:00",
          "price": 455,
          "withdrawn": false
        }
      },
      {
        "collection": "CarrierBid",
        "document": {
          "carrier": "Marsh & Vale",
          "dock": 2,
          "slot": "06:00",
          "price": 250,
          "withdrawn": false
        }
      }
    ]
  },
  "stages": [
    {
      "stage_id": "ask",
      "prompt": "Carriers have bid for dock 4 at 06:00 tomorrow; the bids are in CarrierBid, and withdrawn bids don't count. Choosing is my call, not yours. Put a question in my inbox titled \"Dock 4 at 06:00\" whose only choices are the two lowest bidders for that slot, by carrier name, and don't pick one for me.",
      "capture": [
        {
          "kind": "documents",
          "name": "visible",
          "collection": "MailboxItem",
          "filter": {},
          "fields": [
            "item_key",
            "title",
            "kind"
          ]
        },
        {
          "kind": "documents",
          "name": "notice",
          "collection": "MailboxItem",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "target_node_did": {
              "_eq": "$trial"
            },
            "target_agent_did": {
              "_eq": "gents:agent-slot:engineer"
            },
            "requester_did": {
              "_eq": "$evaluator"
            },
            "session_id": {
              "_eq": "$session"
            }
          },
          "fields": [
            "item_key",
            "node_did",
            "requester_did",
            "kind",
            "action",
            "status",
            "title",
            "summary",
            "payload",
            "source_kind",
            "session_id",
            "request_id",
            "target_node_did",
            "target_agent_did"
          ]
        }
      ],
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "file_mailbox_item"
            ],
            "forbidden": [
              "write",
              "bash",
              "bash_unrestricted",
              "write_file",
              "edit_file"
            ],
            "config_read_only": true
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "visible",
                "min": 1,
                "max": 1
              },
              {
                "capture": "notice",
                "min": 1,
                "max": 1
              }
            ],
            "rows": [
              {
                "capture": "notice",
                "key": "title",
                "id": "Dock 4 at 06:00",
                "expect": [
                  {
                    "field": "payload",
                    "contains": "\"label\":\"Ostend Lines\""
                  },
                  {
                    "field": "payload",
                    "contains": "\"label\":\"Harlow Freight\""
                  },
                  {
                    "field": "payload",
                    "matches": "\"options\":\\[\\{[^\\[\\]]*\\},\\s*\\{[^\\[\\]]*\\}\\]"
                  },
                  {
                    "field": "kind",
                    "equals": "ask"
                  },
                  {
                    "field": "action",
                    "equals": "start_request"
                  },
                  {
                    "field": "status",
                    "equals": "open"
                  },
                  {
                    "field": "source_kind",
                    "equals": "agent"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}
