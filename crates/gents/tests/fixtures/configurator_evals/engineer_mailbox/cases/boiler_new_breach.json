{
  "case_id": "boiler-new-breach",
  "split": "validation",
  "reducer": "all",
  "fixtures": {
    "schemas": [
      "type BoilerGauge { boiler: String bar: Int seq: Int }"
    ],
    "documents": [
      {
        "collection": "BoilerGauge",
        "document": {
          "boiler": "B1",
          "bar": 10,
          "seq": 1
        }
      },
      {
        "collection": "BoilerGauge",
        "document": {
          "boiler": "B2",
          "bar": 11,
          "seq": 1
        }
      },
      {
        "collection": "BoilerGauge",
        "document": {
          "boiler": "B2",
          "bar": 13,
          "seq": 2
        }
      },
      {
        "collection": "BoilerGauge",
        "document": {
          "boiler": "B3",
          "bar": 12,
          "seq": 1
        }
      }
    ]
  },
  "stages": [
    {
      "stage_id": "flag",
      "prompt": "Boilers must stay at or below 12 bar. Use the latest BoilerGauge reading for each boiler (the highest seq for that boiler). If any boiler is above 12 bar, put one flag in my inbox titled \"Boiler pressure high\" with a note listing each such boiler as BOILER (N bar), like B9 (15 bar), sorted by boiler and separated by commas.",
      "capture": [
        {
          "kind": "documents",
          "name": "visible",
          "collection": "MailboxItem",
          "filter": {},
          "fields": [
            "item_key",
            "title",
            "kind"
          ]
        },
        {
          "kind": "documents",
          "name": "notice",
          "collection": "MailboxItem",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "target_node_did": {
              "_eq": "$trial"
            },
            "target_agent_did": {
              "_eq": "gents:agent-slot:engineer"
            },
            "requester_did": {
              "_eq": "$evaluator"
            },
            "session_id": {
              "_eq": "$session"
            }
          },
          "fields": [
            "item_key",
            "node_did",
            "requester_did",
            "kind",
            "action",
            "status",
            "title",
            "summary",
            "payload",
            "source_kind",
            "session_id",
            "request_id",
            "target_node_did",
            "target_agent_did"
          ]
        }
      ],
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "file_mailbox_item"
            ],
            "forbidden": [
              "write",
              "bash",
              "write_file",
              "edit_file"
            ],
            "config_read_only": true
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "visible",
                "min": 1,
                "max": 1
              },
              {
                "capture": "notice",
                "min": 1,
                "max": 1
              }
            ],
            "rows": [
              {
                "capture": "notice",
                "key": "title",
                "id": "Boiler pressure high",
                "expect": [
                  {
                    "field": "summary",
                    "fallback_field": "payload",
                    "equals": "B2 (13 bar)"
                  },
                  {
                    "field": "kind",
                    "equals": "flag"
                  },
                  {
                    "field": "action",
                    "equals": "ack"
                  },
                  {
                    "field": "status",
                    "equals": "open"
                  },
                  {
                    "field": "source_kind",
                    "equals": "agent"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "recheck",
      "prompt": "Gauge B3 just reported 14 bar with seq 2; it isn't in BoilerGauge yet. Taking it into account, re-check the latest reading per boiler. A boiler you already flagged needs no new item; put any boiler that is newly above 12 bar in one new item titled \"Boiler pressure high 2\", listing only those boilers in the same format.",
      "capture": [
        {
          "kind": "documents",
          "name": "visible",
          "collection": "MailboxItem",
          "filter": {},
          "fields": [
            "item_key",
            "title",
            "kind"
          ]
        },
        {
          "kind": "documents",
          "name": "notice",
          "collection": "MailboxItem",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "target_node_did": {
              "_eq": "$trial"
            },
            "target_agent_did": {
              "_eq": "gents:agent-slot:engineer"
            },
            "requester_did": {
              "_eq": "$evaluator"
            },
            "session_id": {
              "_eq": "$session"
            }
          },
          "fields": [
            "item_key",
            "node_did",
            "requester_did",
            "kind",
            "action",
            "status",
            "title",
            "summary",
            "payload",
            "source_kind",
            "session_id",
            "request_id",
            "target_node_did",
            "target_agent_did"
          ]
        }
      ],
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "file_mailbox_item"
            ],
            "forbidden": [
              "write",
              "bash",
              "write_file",
              "edit_file"
            ],
            "config_read_only": true
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "visible",
                "min": 2,
                "max": 2
              },
              {
                "capture": "notice",
                "min": 2,
                "max": 2
              }
            ],
            "rows": [
              {
                "capture": "notice",
                "key": "title",
                "id": "Boiler pressure high",
                "expect": [
                  {
                    "field": "summary",
                    "fallback_field": "payload",
                    "equals": "B2 (13 bar)"
                  },
                  {
                    "field": "kind",
                    "equals": "flag"
                  },
                  {
                    "field": "action",
                    "equals": "ack"
                  },
                  {
                    "field": "status",
                    "equals": "open"
                  },
                  {
                    "field": "source_kind",
                    "equals": "agent"
                  }
                ]
              },
              {
                "capture": "notice",
                "key": "title",
                "id": "Boiler pressure high 2",
                "expect": [
                  {
                    "field": "summary",
                    "fallback_field": "payload",
                    "equals": "B3 (14 bar)"
                  },
                  {
                    "field": "kind",
                    "equals": "flag"
                  },
                  {
                    "field": "action",
                    "equals": "ack"
                  },
                  {
                    "field": "status",
                    "equals": "open"
                  },
                  {
                    "field": "source_kind",
                    "equals": "agent"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}
