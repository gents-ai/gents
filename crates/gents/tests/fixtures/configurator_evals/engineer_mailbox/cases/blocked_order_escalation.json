{
  "case_id": "blocked-order-escalation",
  "split": "train",
  "reducer": "all",
  "fixtures": {
    "files": [
      {
        "path": "orders/A-110.json",
        "contents": "{\n  \"order\": \"A-110\",\n  \"qty\": 4,\n  \"unit_price\": 12,\n  \"approval\": \"not needed\"\n}\n"
      },
      {
        "path": "orders/A-111.json",
        "contents": "{\n  \"order\": \"A-111\",\n  \"qty\": 10,\n  \"unit_price\": 30,\n  \"approval\": \"needs operator sign-off\"\n}\n"
      },
      {
        "path": "orders/A-112.json",
        "contents": "{\n  \"order\": \"A-112\",\n  \"qty\": 2,\n  \"unit_price\": 45,\n  \"approval\": \"not needed\"\n}\n"
      },
      {
        "path": "orders/A-113.json",
        "contents": "{\n  \"order\": \"A-113\",\n  \"qty\": 3,\n  \"unit_price\": 20,\n  \"approval\": \"approved by operator\"\n}\n"
      },
      {
        "path": "orders/A-114.json",
        "contents": "{\n  \"order\": \"A-114\",\n  \"qty\": 1,\n  \"unit_price\": 900,\n  \"approval\": \"needs operator sign-off\"\n}\n"
      },
      {
        "path": "orders/A-115.json",
        "contents": "{\n  \"order\": \"A-115\",\n  \"qty\": 5,\n  \"unit_price\": 8,\n  \"approval\": \"sign-off not needed\"\n}\n"
      }
    ]
  },
  "stages": [
    {
      "stage_id": "invoice",
      "prompt": "For each order in orders/, write invoices/ORDER.json (for example invoices/A-100.json) holding {\"order\": ORDER, \"total\": qty times unit_price}. Orders that need operator sign-off are mine to approve, so skip their invoices and put one item in my inbox titled \"Sign-off needed\" whose note is just those order numbers, ascending, separated by a comma and a space. Leave the orders as they are.",
      "capture": [
        {
          "kind": "documents",
          "name": "visible",
          "collection": "MailboxItem",
          "filter": {},
          "fields": [
            "item_key",
            "title",
            "kind"
          ]
        },
        {
          "kind": "documents",
          "name": "notice",
          "collection": "MailboxItem",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "target_node_did": {
              "_eq": "$trial"
            },
            "target_agent_did": {
              "_eq": "gents:agent-slot:engineer"
            },
            "requester_did": {
              "_eq": "$evaluator"
            },
            "session_id": {
              "_eq": "$session"
            }
          },
          "fields": [
            "item_key",
            "node_did",
            "requester_did",
            "kind",
            "action",
            "status",
            "title",
            "summary",
            "payload",
            "source_kind",
            "session_id",
            "request_id",
            "target_node_did",
            "target_agent_did"
          ]
        },
        {
          "kind": "file",
          "name": "workspace",
          "glob": "*/*.json"
        }
      ],
      "checks": [
        {
          "check": "captured_files_match",
          "params": {
            "name": "workspace",
            "expect": [
              {
                "path": "invoices/A-110.json",
                "pointer": "/total",
                "equals": 48
              },
              {
                "path": "invoices/A-112.json",
                "pointer": "/total",
                "equals": 90
              },
              {
                "path": "invoices/A-113.json",
                "pointer": "/total",
                "equals": 60
              },
              {
                "path": "invoices/A-113.json",
                "pointer": "/order",
                "equals": "A-113"
              },
              {
                "path": "invoices/A-115.json",
                "pointer": "/total",
                "equals": 40
              },
              {
                "path": "invoices/A-111.json",
                "exists": false
              },
              {
                "path": "invoices/A-114.json",
                "exists": false
              },
              {
                "path": "orders/A-110.json",
                "equals": "{\n  \"order\": \"A-110\",\n  \"qty\": 4,\n  \"unit_price\": 12,\n  \"approval\": \"not needed\"\n}\n"
              },
              {
                "path": "orders/A-111.json",
                "equals": "{\n  \"order\": \"A-111\",\n  \"qty\": 10,\n  \"unit_price\": 30,\n  \"approval\": \"needs operator sign-off\"\n}\n"
              },
              {
                "path": "orders/A-112.json",
                "equals": "{\n  \"order\": \"A-112\",\n  \"qty\": 2,\n  \"unit_price\": 45,\n  \"approval\": \"not needed\"\n}\n"
              },
              {
                "path": "orders/A-113.json",
                "equals": "{\n  \"order\": \"A-113\",\n  \"qty\": 3,\n  \"unit_price\": 20,\n  \"approval\": \"approved by operator\"\n}\n"
              },
              {
                "path": "orders/A-114.json",
                "equals": "{\n  \"order\": \"A-114\",\n  \"qty\": 1,\n  \"unit_price\": 900,\n  \"approval\": \"needs operator sign-off\"\n}\n"
              },
              {
                "path": "orders/A-115.json",
                "equals": "{\n  \"order\": \"A-115\",\n  \"qty\": 5,\n  \"unit_price\": 8,\n  \"approval\": \"sign-off not needed\"\n}\n"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "visible",
                "min": 1,
                "max": 1
              },
              {
                "capture": "notice",
                "min": 1,
                "max": 1
              }
            ],
            "rows": [
              {
                "capture": "notice",
                "key": "title",
                "id": "Sign-off needed",
                "expect": [
                  {
                    "field": "summary",
                    "fallback_field": "payload",
                    "equals": "A-111, A-114"
                  },
                  {
                    "field": "kind",
                    "equals": "flag"
                  },
                  {
                    "field": "action",
                    "equals": "ack"
                  },
                  {
                    "field": "status",
                    "equals": "open"
                  },
                  {
                    "field": "source_kind",
                    "equals": "agent"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}
