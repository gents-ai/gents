{
  "case_id": "count-closed",
  "split": "validation",
  "reducer": "all",
  "fixtures": {
    "documents": [
      {
        "collection": "AgentSession",
        "document": {
          "node_did": "$trial",
          "requester_did": "$evaluator",
          "session_id": "launch-review",
          "agent_did": "gents:agent-slot:engineer",
          "created_at": "2025-01-01T00:00:00Z",
          "closed_at": "2025-01-02T00:00:00Z",
          "title": {
            "text": "Atlas rollout review",
            "source": "user"
          },
          "tags": [
            "release"
          ]
        }
      },
      {
        "collection": "AgentSession",
        "document": {
          "node_did": "$trial",
          "requester_did": "$evaluator",
          "session_id": "support-review",
          "agent_did": "gents:agent-slot:engineer",
          "created_at": "2025-01-01T00:00:00Z",
          "closed_at": null,
          "title": {
            "text": "Support triage",
            "source": "user"
          },
          "tags": [
            "support"
          ]
        }
      },
      {
        "collection": "AgentSession",
        "document": {
          "node_did": "$trial",
          "requester_did": "$evaluator",
          "session_id": "launch-followup",
          "agent_did": "gents:agent-slot:engineer",
          "created_at": "2025-01-01T00:00:00Z",
          "closed_at": "2025-01-02T00:00:00Z",
          "title": {
            "text": "Atlas rollback followup",
            "source": "user"
          },
          "tags": [
            "release"
          ]
        }
      },
      {
        "collection": "AgentSession",
        "session_readers": ["engineer"],
        "session_agent_owned": true,
        "document": {
          "node_did": "$trial",
          "requester_did": null,
          "session_id": "partner-review",
          "agent_did": "gents:agent-slot:partner",
          "created_at": "2025-01-01T00:00:00Z",
          "closed_at": "2025-01-02T00:00:00Z",
          "title": {
            "text": "Partner release review",
            "source": "user"
          },
          "tags": [
            "release"
          ]
        }
      }
    ]
  },
  "stages": [
    {
      "stage_id": "investigate",
      "prompt": "How many closed sessions tagged release are there? Count other agents' sessions you can see too.",
      "checks": [
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              {
                "matches": "(?i)\\b(?:3|three)\\b[^.\\n]{0,60}(?:sessions?|closed|release|count|total)|(?:sessions?|closed|release|count|total)[^.\\n]{0,60}?\\b(?:3|three)\\b"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}
