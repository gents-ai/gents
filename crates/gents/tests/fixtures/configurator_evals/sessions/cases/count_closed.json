  },
  "stages": [
    {
      "stage_id": "investigate",
      "prompt": "How many of my closed sessions have the release tag? Give the exact total using sessions; exclude other principals.",
      "deadline_secs": 300,
      "checks": [
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              {
                "matches": "(?i)(?:\\b(?:2|two)\\b[^\\n]{0,24}\\b(?:sessions|closed|release)\\b|\\b(?:count|total|exactly|are|is)\\b[^\\n]{0,24}\\b(?:2|two)\\b|^\\s*(?:2|two)\\s*$)"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "sessions"
            ],
            "forbidden": [
              "bash",
              "query",
              "config"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}
