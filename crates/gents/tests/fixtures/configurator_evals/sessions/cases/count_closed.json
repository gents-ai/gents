          "requester_did": "did:key:z6MkiForeignSessionOwner",
          "session_id": "launch-review",
          "behavior_id": "engineer",
          "created_at": "2025-01-01T00:00:00Z",
          "closed_at": "2025-01-02T00:00:00Z",
