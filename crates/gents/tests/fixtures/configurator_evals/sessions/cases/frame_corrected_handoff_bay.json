            "source": "user"
          },
          "tags": [
            "handoff"
          ]
        }
      },
      {
        "collection": "AgentSession",
        "document": {
          "node_did": "$trial",
          "requester_did": "$evaluator",
          "session_id": "frame-42-order",
          "agent_did": "gents:agent-slot:engineer",
          "created_at": "2026-09-11T08:00:00Z",
          "closed_at": "2026-09-11T17:00:00Z",
          "title": {
            "text": "Frame-42 order notes | security correction: night handoff moves to bay 4",
            "source": "user"
          },
          "tags": [
            "handoff"
          ]
        }
      },
      {
        "collection": "AgentSession",
        "document": {
          "node_did": "$trial",
          "requester_did": "$evaluator",
          "session_id": "frame-42-receipt",
          "agent_did": "gents:agent-slot:engineer",
          "created_at": "2026-09-12T08:00:00Z",
          "closed_at": "2026-09-12T17:00:00Z",
          "title": {
            "text": "Frame-42 receipt notes | transport accepted the security correction and revoked bay 2",
            "source": "user"
          },
          "tags": [
            "handoff"
          ]
        }
      },
      {
        "collection": "AgentSession",
        "document": {
          "node_did": "$trial",
          "requester_did": "$evaluator",
          "session_id": "frame-42-trial",
          "agent_did": "gents:agent-slot:engineer",
          "created_at": "2026-09-13T08:00:00Z",
          "closed_at": "2026-09-13T17:00:00Z",
          "title": {
            "text": "Frame-42 trial notes | rehearsal uses bay 18, production routing unaffected",
            "source": "user"
          },
          "tags": [
            "handoff"
          ]
        }
      }
    ]
  },
  "stages": [
    {
      "stage_id": "investigate",
      "prompt": "Look back through our Frame-42 handoff conversations. Which night handoff bay did security correct to, and did transport actually accept it? Give the bay and cite the two session IDs that settle it.",
      "checks": [
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              {
                "matches": "(?i)\\bbay\\s*4\\b"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "links": [
              {
                "capture": "sources",
                "key": "session_id",
                "id": "frame-42-order",
                "field": "session_id",
                "target_capture": "sources",
                "target_key": "session_id",
                "reported_fields": [
                  "session_id"
                ]
              },
              {
                "capture": "sources",
                "key": "session_id",
                "id": "frame-42-receipt",
                "field": "session_id",
                "target_capture": "sources",
                "target_key": "session_id",
                "reported_fields": [
                  "session_id"
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "sources",
          "collection": "AgentSession",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "session_id": {
              "_in": [
                "frame-42-order",
                "frame-42-receipt"
              ]
            }
          },
          "fields": [
            "_docID",
            "session_id",
            "title",
            "closed_at"
          ]
        }
      ]
    }
  ]
}
