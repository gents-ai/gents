{
  "case_id": "frame-corrected-handoff-bay",
  "split": "train",
  "reducer": "all",
  "fixtures": {
    "documents": [
      {
        "collection": "AgentSession",
        "document": {
          "node_did": "$trial",
          "requester_did": "$evaluator",
          "session_id": "frame-42-store",
          "agent_did": "gents:agent-slot:engineer",
          "created_at": "2026-09-10T08:00:00Z",
          "closed_at": "2026-09-10T17:00:00Z",
          "title": {
