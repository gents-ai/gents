{
  "case_id": "relay-handoff-current-window",
  "split": "validation",
  "reducer": "all",
  "fixtures": {
    "documents": [
      {
        "collection": "AgentSession",
        "document": {
          "node_did": "$trial",
          "requester_did": "$evaluator",
          "session_id": "relay-jun",
          "agent_did": "gents:agent-slot:engineer",
          "created_at": "2026-06-18T08:00:00Z",
          "closed_at": "2026-06-18T16:00:00Z",
          "title": {
            "text": "Relay handoff decision | June 18 | receiving window 06:15 UTC",
            "source": "user"
          },
          "tags": [
            "handoff"
          ]
        }
      },
      {
        "collection": "AgentSession",
        "document": {
          "node_did": "$trial",
          "requester_did": "$evaluator",
          "session_id": "relay-jul",
          "agent_did": "gents:agent-slot:engineer",
          "created_at": "2026-07-08T08:00:00Z",
          "closed_at": "2026-07-08T16:00:00Z",
          "title": {
            "text": "Relay handoff decision | July 8 replacement | receiving window 09:40 UTC",
            "source": "user"
          },
          "tags": [
            "handoff"
          ]
        }
      },
      {
        "collection": "AgentSession",
        "document": {
          "node_did": "$trial",
          "requester_did": "$evaluator",
          "session_id": "other-jul",
          "agent_did": "gents:agent-slot:engineer",
          "created_at": "2026-07-09T08:00:00Z",
          "closed_at": "2026-07-09T16:00:00Z",
          "title": {
            "text": "Beacon handoff decision | July 9 | receiving window 18:05 UTC",
            "source": "user"
          },
          "tags": [
            "handoff"
          ]
        }
      }
    ]
  },
  "stages": [
    {
      "stage_id": "investigate",
      "prompt": "What time did we settle on for the Relay handoff? Show me where you found it.",
      "checks": [
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              {
                "matches": "(?i)\\b0?9[:.]?40\\b"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "sessions"
            ],
            "forbidden": [
              "bash",
              "query",
              "config"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "links": [
              {
                "capture": "sources",
                "key": "session_id",
                "id": "relay-jul",
                "field": "session_id",
                "target_capture": "sources",
                "target_key": "session_id",
                "reported_fields": [
                  "session_id"
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "sources",
          "collection": "AgentSession",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "session_id": {
              "_in": [
                "relay-jul"
              ]
            }
          },
          "fields": [
            "_docID",
            "session_id",
            "title",
            "closed_at"
          ]
        }
      ]
    }
  ]
}
