{
  "case_id": "kestrel-newest-revision",
  "split": "train",
  "reducer": "all",
  "fixtures": {
    "documents": [
      {
        "collection": "AgentSession",
        "document": {
          "node_did": "$trial",
          "requester_did": "$evaluator",
          "session_id": "kestrel-jun",
          "agent_did": "gents:agent-slot:engineer",
          "created_at": "2026-06-28T08:00:00Z",
          "closed_at": "2026-06-28T17:00:00Z",
          "title": {
            "text": "Kestrel handoff | June 28 instruction | pickup 06:15 UTC",
            "source": "user"
          },
          "tags": [
            "handoff"
          ]
        }
      },
      {
        "collection": "AgentSession",
        "document": {
          "node_did": "$trial",
          "requester_did": "$evaluator",
          "session_id": "kestrel-jul",
          "agent_did": "gents:agent-slot:engineer",
          "created_at": "2026-07-11T08:00:00Z",
          "closed_at": "2026-07-11T17:00:00Z",
          "title": {
            "text": "Kestrel handoff | July 11 revision | pickup 10:50 UTC",
            "source": "user"
          },
          "tags": [
            "handoff"
          ]
        }
      },
      {
        "collection": "AgentSession",
        "document": {
          "node_did": "$trial",
          "requester_did": "$evaluator",
          "session_id": "kite-jul",
          "agent_did": "gents:agent-slot:engineer",
          "created_at": "2026-07-13T08:00:00Z",
          "closed_at": "2026-07-13T17:00:00Z",
          "title": {
            "text": "Kite handoff | July 13 revision | pickup 18:20 UTC",
            "source": "user"
          },
          "tags": [
            "handoff"
          ]
        }
      }
    ]
  },
  "stages": [
    {
      "stage_id": "investigate",
      "prompt": "In our Kestrel handoff notes, what UTC pickup time did the July 11 revision specify? Return just the time and the source session ID. Use the notes themselves.",
      "checks": [
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              {
                "matches": "(?i)\\b10[:.]?50\\b"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "sessions"
            ],
            "forbidden": [
              "bash",
              "query",
              "config"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "links": [
              {
                "capture": "sources",
                "key": "session_id",
                "id": "kestrel-jul",
                "field": "session_id",
                "target_capture": "sources",
                "target_key": "session_id",
                "reported_fields": [
                  "session_id"
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "sources",
          "collection": "AgentSession",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "session_id": {
              "_in": [
                "kestrel-jul"
              ]
            }
          },
          "fields": [
            "_docID",
            "session_id",
            "title",
            "closed_at"
          ]
        }
      ]
    }
  ]
}
