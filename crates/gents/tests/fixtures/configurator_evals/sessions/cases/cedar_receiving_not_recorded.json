{
  "case_id": "cedar-receiving-not-recorded",
  "split": "train",
  "reducer": "all",
  "fixtures": {
    "documents": [
      {
        "collection": "AgentSession",
        "document": {
          "node_did": "$trial",
          "requester_did": "$evaluator",
          "session_id": "cedar-transfer",
          "agent_did": "gents:agent-slot:engineer",
          "created_at": "2026-08-03T08:00:00Z",
          "closed_at": "2026-08-03T17:00:00Z",
          "title": {
            "text": "Cedar transfer | confirmed pickup 11:30 UTC | receiving time pending",
            "source": "user"
          },
          "tags": [
