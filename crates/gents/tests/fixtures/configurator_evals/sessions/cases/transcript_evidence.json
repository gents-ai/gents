{
  "case_id": "transcript-evidence",
  "split": "train",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "record",
      "prompt": "For the record: the upload retry keeps its checkpoint until the server acknowledges the batch.",
      "checks": [
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              {
                "matches": "\\S"
              }
            ]
          },
          "tier": "development",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "investigate",
      "prompt": "What did I tell you earlier about upload retries? Quote the rule, and give me the ID of the chat message where I said it, so I can link to it.",
      "checks": [
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              "keeps its checkpoint"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "links": [
              {
                "capture": "source_headers",
                "source_match": {
                  "field": "sequence",
                  "equals": 2
                },
                "field": "_docID",
                "target_capture": "source_headers",
                "target_key": "_docID",
                "reported_fields": [
                  "_docID"
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "source_headers",
          "collection": "AgentMessage",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "sequence": {
              "_eq": 2
            },
            "session_id": {
              "_eq": "$session"
            }
          },
          "fields": [
            "_docID",
            "sequence",
            "session_id"
          ]
        }
      ]
    }
  ]
}
