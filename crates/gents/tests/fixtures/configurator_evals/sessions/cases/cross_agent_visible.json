  "stages": [
    {
      "stage_id": "investigate",
      "prompt": "Find the partner rotation ledger session with sessions, even if another agent owns it. Report its session ID, title and whether it is closed. Include its canonical session document ID so I can check the source.",
      "deadline_secs": 300,
      "checks": [
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              "partner-archive",
              "Partner rotation ledger",
              {
                "matches": "(?i)closed"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "sessions"
            ],
            "forbidden": [
              "bash",
              "query",
              "config"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "links": [
              {
                "capture": "source_sessions",
                "source_match": {
                  "field": "session_id",
                  "equals": "partner-archive"
                },
                "field": "_docID",
                "target_capture": "source_sessions",
                "target_key": "_docID",
                "reported_fields": [
                  "_docID"
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "source_sessions",
          "collection": "AgentSession",
          "filter": {
            "node_did": {
              "_eq": "did:key:z6MkfXG2FkNy3u7Eg3jm8e2YQpGz7Z1JqWgHDAP1hLk9r2bR"
            },
            "session_id": {
              "_eq": "partner-archive"
            }
          },
          "fields": [
            "_docID",
            "session_id",
            "node_did"
          ]
        }
      ]
    }
  ]
}
