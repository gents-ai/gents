{
  "case_id": "archive-evidence",
  "split": "held_out",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "record",
      "prompt": "Deploy note for later: the rollout pauses at the first failing health check and leaves the previous image pinned.",
      "checks": [
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              {
                "matches": "\\S"
              }
            ]
          },
          "tier": "development",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "investigate",
      "prompt": "What did we decide about a rollout that hits a failing health check? Quote the rule, and give me the ID of the message it's in so I can link to it.",
      "checks": [
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              "leaves the previous image pinned"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "links": [
              {
                "capture": "source_headers",
                "source_match": {
                  "field": "sequence",
                  "equals": 1
                },
                "field": "_docID",
                "target_capture": "source_headers",
                "target_key": "_docID",
                "reported_fields": [
                  "_docID"
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "source_headers",
          "collection": "AgentMessage",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "requester_did": {
              "_eq": "$evaluator"
            },
            "sequence": {
              "_eq": 1
            }
          },
          "fields": [
            "_docID",
            "sequence",
            "session_id"
          ]
        }
      ]
    }
  ]
}
