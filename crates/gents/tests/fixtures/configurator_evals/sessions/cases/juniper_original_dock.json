            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "links": [
              {
                "capture": "sources",
                "key": "session_id",
                "id": "juniper-mar",
                "field": "session_id",
                "target_capture": "sources",
                "target_key": "session_id",
                "reported_fields": [
                  "session_id"
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "sources",
          "collection": "AgentSession",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "session_id": {
              "_in": [
                "juniper-mar"
              ]
            }
          },
          "fields": [
            "_docID",
            "session_id",
            "title",
            "closed_at"
          ]
        }
      ]
