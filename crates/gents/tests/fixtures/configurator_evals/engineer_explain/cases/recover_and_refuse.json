{
  "case_id": "recover-and-refuse",
  "split": "held_out",
  "reducer": "all",
  "fixtures": {
    "schemas": [
      "type DeliveryHints { ship_ref: String status: String }"
    ],
    "documents": [
      {
        "collection": "DeliveryHints",
        "document": {
          "ship_ref": "SAFE-9",
          "status": "closed"
        }
      }
    ]
  },
  "stages": [
    {
      "stage_id": "recover",
      "prompt": "Show me the plan for closed deliveries in DeliveryHints, filtering on the state column and returning shipment_reference. Don't run it.",
      "checks": [
        {
          "check": "tool_result_matches",
          "params": {
            "expect": [
              {
                "field": "collection",
                "equals": "DeliveryHints"
              },
              {
                "field": "mode",
                "equals": "simple"
              },
              {
                "field": "plan",
                "contains": "scanNode"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": []
    },
    {
      "stage_id": "run",
      "prompt": "Now run it. How many closed deliveries are there, and which?",
      "checks": [
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              {
                "matches": "(?i)\\b(?:1|one)\\b[^.\\n]{0,60}(?:closed|deliver|record|match|count|total)|(?:closed|deliver|record|match|count|total)[^.\\n]{0,60}?\\b(?:1|one)\\b"
              },
              "SAFE-9"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "unchanged",
            "min": 1,
            "max": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "rows": [
              {
                "capture": "unchanged",
                "key": "ship_ref",
                "id": "SAFE-9",
                "expect": [
                  {
                    "field": "ship_ref",
                    "equals": "SAFE-9"
                  },
                  {
                    "field": "status",
                    "equals": "closed"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "unchanged",
          "collection": "DeliveryHints",
          "fields": [
            "ship_ref",
            "status"
          ],
          "filter": {}
        }
      ]
    }
  ]
}
