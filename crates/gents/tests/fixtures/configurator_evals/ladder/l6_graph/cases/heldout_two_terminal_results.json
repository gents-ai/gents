{
  "case_id": "heldout-two-terminal-results",
  "split": "held_out",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "build_and_run",
      "prompt": "One more graph, and this one declares two results. Graph id 'g-heldout-two-results'. 1) Create tasks bound to this engineer agent: 't-extract-word' emits its input word unchanged on output port 'out'; 't-upper-word' uppercases its input and emits on port 'out'. 2) Author the graph: node 'extract' bound to t-extract-word, node 'upper' bound to t-upper-word, edge extract.out -> upper.in, declared input 'word' feeding node 'extract', and two results, both cardinality one: 'raw' from node 'extract' port 'out' and 'uppercased' from node 'upper' port 'out'. 3) Preview; fix and re-preview on any validation error; never run an invalid graph. 4) Run it with input {\"word\": \"heldout\"}. 5) Read the run back with get_graph_run and its results with get_graph_result.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ],
            "forbidden": [
              "bash"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "verify_run",
      "prompt": "Read-only check: report what you configured and the graph run outcome. Change nothing.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "captured_fields_match",
          "params": {
            "name": "runs",
            "expect": [
              {
                "field": "status",
                "equals": "completed"
              },
              {
                "field": "result_refs_json",
                "contains": "heldout"
              },
              {
                "field": "result_refs_json",
                "contains": "HELDOUT"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "run_calls",
            "min": 1
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "runs",
          "collection": "GraphRun",
          "filter": {
            "graph_id": {
              "_eq": "g-heldout-two-results"
            },
            "owner_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "run_id",
            "graph_id",
            "status",
            "result_refs_json",
            "error"
          ]
        },
        {
          "kind": "documents",
          "name": "run_calls",
          "collection": "AgentToolCall",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "tool_name": {
              "_eq": "run_graph"
            }
          },
          "fields": [
            "tool_call_key",
            "tool_name",
            "status",
            "request_id"
          ]
        }
      ]
    },
    {
      "stage_id": "verify_graph",
      "prompt": "Read-only check: confirm the graph definition state for 'g-heldout-two-results'. Change nothing.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "captured_rows_count",
          "params": {
            "name": "graph_def",
            "min": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "graph_def",
            "expect": [
              {
                "field": "enabled",
                "equals": true
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "graph_def",
          "collection": "GraphDefinition",
          "filter": {
            "graph_id": {
              "_eq": "g-heldout-two-results"
            },
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "graph_id",
            "enabled",
            "active_revision_digest",
            "updated_at"
          ]
        }
      ]
    }
  ]
}
