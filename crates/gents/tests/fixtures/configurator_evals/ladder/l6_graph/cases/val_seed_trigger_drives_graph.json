{
  "case_id": "val-seed-trigger-drives-graph",
  "split": "validation",
  "reducer": "all",
  "fixtures": {
    "schemas": [
      "type CorrInput { correlation: String, word: String }"
    ],
    "documents": []
  },
  "stages": [
    {
      "stage_id": "build_automation",
      "prompt": "Set up document-driven graph automation, but do not run the graph yourself yet. 1) Create two tasks bound to this engineer agent: 't-seed-emit' emits the correlation id and word it receives on port 'out'; 't-seed-upper' emits the correlation id together with the uppercase of its input word on port 'out'. 2) Author graph 'g-corr-seed': node 'emit' bound to t-seed-emit, node 'upper' bound to t-seed-upper, edge emit.out -> upper.in, one declared input entry 'item' feeding node 'emit', one result 'uppercased' from node 'upper' port 'out' with cardinality one. 3) Preview it; fix and re-preview on any validation error. 4) Create an event source on collection 'CorrInput' and a trigger whose task 't-run-corr-graph' is bound to this engineer agent; its prompt_template must render the actual correlation and word values from the source document (not just their ids) and instruct running graph 'g-corr-seed' with input {\"correlation\": <rendered correlation>, \"word\": <rendered word>}. 5) Stop there \u2014 the automation should fire on its own when a CorrInput document appears.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ],
            "forbidden": [
              "bash"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "seed_input",
      "seed": {
        "collection": "CorrInput",
        "document": {
          "correlation": "corr-77",
          "word": "harvest"
        }
      },
      "deadline_secs": 600,
      "checks": []
    },
    {
      "stage_id": "verify_run",
      "prompt": "Read-only check: report the graph run state for 'g-corr-seed'. Change nothing.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "captured_fields_match",
          "params": {
            "name": "runs",
            "expect": [
              {
                "field": "status",
                "equals": "completed"
              },
              {
                "field": "result_refs_json",
                "contains": "HARVEST"
              },
              {
                "field": "result_refs_json",
                "contains": "corr-77"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "fire_outcomes",
            "min": 1
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "runs",
          "collection": "GraphRun",
          "filter": {
            "graph_id": {
              "_eq": "g-corr-seed"
            },
            "owner_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "run_id",
            "graph_id",
            "status",
            "result_refs_json",
            "correlation",
            "error"
          ]
        },
        {
          "kind": "documents",
          "name": "fire_outcomes",
          "collection": "FireOutcome",
          "filter": {
            "owner_did": {
              "_eq": "$trial"
            },
            "source_collection": {
              "_eq": "CorrInput"
            }
          },
          "fields": [
            "handoff_id",
            "fire_key",
            "trigger_id",
            "terminal_state",
            "reason"
          ]
        }
      ]
    },
    {
      "stage_id": "verify_firing",
      "prompt": "Read-only check: report the trigger firing state for the CorrInput automation. Change nothing.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "captured_rows_count",
          "params": {
            "name": "trigger_fires",
            "min": 1
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "trigger_fires",
          "collection": "TriggerFire",
          "filter": {
            "owner_did": {
              "_eq": "$trial"
            },
            "source_collection": {
              "_eq": "CorrInput"
            }
          },
          "fields": [
            "fire_key",
            "trigger_id",
            "source_doc_id",
            "request_id",
            "emit_outcome"
          ]
        }
      ]
    }
  ]
}
