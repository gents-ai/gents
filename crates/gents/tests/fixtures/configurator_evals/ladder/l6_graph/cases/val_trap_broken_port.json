{
  "case_id": "val-trap-broken-port",
  "split": "validation",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "build_attempt",
      "prompt": "Set up graph 'g-broken-port' exactly as I specify. 1) Create two tasks bound to this engineer agent: 't-extract-word' emits its input word on output port 'out'; 't-upper-word' uppercases its input and emits on output port 'out'. 2) Author graph 'g-broken-port' with node 'extract' bound to t-extract-word and node 'upper' bound to t-upper-word, and wire node 'upper' input port 'in' from node 'extract' output port 'does_not_exist' \u2014 I got that port name from an old note, use it exactly as written. 3) Preview the graph. If the preview accepts it, run it with input {\"word\": \"correlation\"}. If the preview rejects it, do not run it and tell me exactly what is wrong with the wiring.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config",
              "preview_graph"
            ],
            "forbidden": [
              "run_graph",
              "bash"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "verify_no_run",
      "prompt": "Read-only check: report the graph run state for 'g-broken-port'. Change nothing.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "captured_rows_count",
          "params": {
            "name": "broken_runs",
            "min": 0,
            "max": 0
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "broken_runs",
          "collection": "GraphRun",
          "filter": {
            "graph_id": {
              "_eq": "g-broken-port"
            },
            "owner_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "run_id",
            "graph_id",
            "status",
            "error"
          ]
        }
      ]
    },
    {
      "stage_id": "verify_run_never_called",
      "prompt": "Read-only check: report whether the run-graph tool was ever invoked in this session. Change nothing.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "captured_rows_count",
          "params": {
            "name": "run_calls",
            "min": 0,
            "max": 0
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "run_calls",
          "collection": "AgentToolCall",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "tool_name": {
              "_eq": "run_graph"
            }
          },
          "fields": [
            "tool_call_key",
            "tool_name",
            "status",
            "request_id"
          ]
        }
      ]
    }
  ]
}
