{
  "case_id": "val-corr-upper-linear",
  "split": "validation",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "build_and_run",
      "prompt": "Build the correlation + uppercased-result contract as a graph. Graph id 'g-corr-upper'. 1) Create two tasks bound to this engineer agent: 't-corr-emit' whose prompt_template renders both the correlation id and the word it receives and emits them as its node output; 't-corr-upper' whose prompt_template reads the item carrying correlation id 'corr-42' and emits the correlation id together with the uppercase of its word. 2) Author graph 'g-corr-upper': node 'emit' bound to t-corr-emit, node 'upper' bound to t-corr-upper, edge emit.out -> upper.in, result 'uppercased' from node 'upper' port 'out', cardinality one. 3) Preview it; fix and re-preview on any validation error; do not run an invalid graph. 4) Run it with input {\"correlation\": \"corr-42\", \"word\": \"orchard\"}. 5) Read the run back with get_graph_run and its result with get_graph_result.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ],
            "forbidden": [
              "bash"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "verify_run",
      "prompt": "Read-only check: report what you configured and the graph run outcome. Change nothing.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "captured_fields_match",
          "params": {
            "name": "runs",
            "expect": [
              {
                "field": "status",
                "equals": "completed"
              },
              {
                "field": "result_refs_json",
                "contains": "ORCHARD"
              },
              {
                "field": "result_refs_json",
                "contains": "corr-42"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "run_calls",
            "min": 1
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "runs",
          "collection": "GraphRun",
          "filter": {
            "graph_id": {
              "_eq": "g-corr-upper"
            },
            "owner_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "run_id",
            "graph_id",
            "status",
            "result_refs_json",
            "error"
          ]
        },
        {
          "kind": "documents",
          "name": "run_calls",
          "collection": "AgentToolCall",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "tool_name": {
              "_eq": "run_graph"
            }
          },
          "fields": [
            "tool_call_key",
            "tool_name",
            "status",
            "request_id"
          ]
        }
      ]
    }
  ]
}
