{
  "case_id": "val-three-node-chain-report",
  "split": "validation",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "build_and_run",
      "prompt": "Build a three-node graph and run it. Graph id 'g-chain-report'. 1) Create three tasks bound to this engineer agent: 't-pick-word' receives a phrase and emits the last word of it on port 'out'; 't-upper-word' uppercases its input; 't-prefix' prepends 'READY: ' to its input and emits on port 'out'. 2) Author the graph: node 'pick' bound to t-pick-word, node 'upper' bound to t-upper-word, node 'prefix' bound to t-prefix; edges pick.out -> upper.in and upper.out -> prefix.in; declared input entry 'text' feeding node 'pick'; result 'report' from node 'prefix' port 'out', cardinality one. 3) Preview; fix and re-preview on validation errors; never run an invalid graph. 4) Run it with input {\"text\": \"deploy the pipeline\"}. 5) Read the run back with get_graph_run and its result with get_graph_result.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ],
            "forbidden": [
              "bash"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "verify_run",
      "prompt": "Read-only check: report what you configured and the graph run outcome. Change nothing.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "captured_fields_match",
          "params": {
            "name": "runs",
            "expect": [
              {
                "field": "status",
                "equals": "completed"
              },
              {
                "field": "result_refs_json",
                "contains": "READY"
              },
              {
                "field": "result_refs_json",
                "contains": "PIPELINE"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "preview_calls",
            "min": 1
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "runs",
          "collection": "GraphRun",
          "filter": {
            "graph_id": {
              "_eq": "g-chain-report"
            },
            "owner_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "run_id",
            "graph_id",
            "status",
            "result_refs_json",
            "error"
          ]
        },
        {
          "kind": "documents",
          "name": "preview_calls",
          "collection": "AgentToolCall",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "tool_name": {
              "_eq": "preview_graph"
            }
          },
          "fields": [
            "tool_call_key",
            "tool_name",
            "status",
            "request_id"
          ]
        }
      ]
    }
  ]
}
