{
  "case_id": "val-declared-input-run-supplied",
  "split": "validation",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "build_and_run",
      "prompt": "Author a graph whose data enters only through a declared input that the run supplies \u2014 nothing may be hardcoded in the node prompts. Graph id 'g-input-manifest'. 1) Create tasks bound to this engineer agent: 't-render-word' whose prompt_template interpolates the declared input word into its rendered request and emits it on port 'out' (render the actual word, not just an id or reference to it); 't-upper-word' that uppercases its input and emits on port 'out'. 2) Author graph 'g-input-manifest': node 'render' bound to t-render-word, node 'upper' bound to t-upper-word, edge render.out -> upper.in, declared input entry 'word' feeding node 'render', result 'uppercased' from node 'upper' port 'out', cardinality one. 3) Preview; correct and re-preview on any validation error; do not run an invalid graph. 4) Run it, supplying input {\"word\": \"manifest\"}. 5) Read the run back with get_graph_run and its result with get_graph_result.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ],
            "forbidden": [
              "bash"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "verify_run",
      "prompt": "Read-only check: report what you configured and the graph run outcome. Change nothing.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "captured_fields_match",
          "params": {
            "name": "runs",
            "expect": [
              {
                "field": "status",
                "equals": "completed"
              },
              {
                "field": "result_refs_json",
                "contains": "MANIFEST"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "run_calls",
            "min": 1
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "runs",
          "collection": "GraphRun",
          "filter": {
            "graph_id": {
              "_eq": "g-input-manifest"
            },
            "owner_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "run_id",
            "graph_id",
            "status",
            "result_refs_json",
            "error"
          ]
        },
        {
          "kind": "documents",
          "name": "run_calls",
          "collection": "AgentToolCall",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "tool_name": {
              "_eq": "run_graph"
            }
          },
          "fields": [
            "tool_call_key",
            "tool_name",
            "status",
            "request_id"
          ]
        }
      ]
    },
    {
      "stage_id": "verify_graph",
      "prompt": "Read-only check: confirm the graph definition state for 'g-input-manifest'. Change nothing.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "captured_rows_count",
          "params": {
            "name": "graph_def",
            "min": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "graph_def",
            "expect": [
              {
                "field": "enabled",
                "equals": true
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "graph_def",
          "collection": "GraphDefinition",
          "filter": {
            "graph_id": {
              "_eq": "g-input-manifest"
            },
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "graph_id",
            "enabled",
            "active_revision_digest",
            "updated_at"
          ]
        }
      ]
    }
  ]
}
