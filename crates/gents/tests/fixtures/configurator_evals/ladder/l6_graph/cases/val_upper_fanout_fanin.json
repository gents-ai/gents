{
  "case_id": "val-upper-fanout-fanin",
  "split": "validation",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "build_and_run",
      "prompt": "I need a fan-out/fan-in graph. Graph id 'g-upper-fanout'. 1) Create three tasks bound to this engineer agent: 't-upper-a' uppercases the text on its input and emits it on port 'out'; 't-upper-b' does the same; 't-join' receives two texts and emits them joined with a single space on port 'out'. 2) Author the graph: node 'up_a' bound to t-upper-a, node 'up_b' bound to t-upper-b, node 'join' bound to t-join; wire the declared inputs so 'w1' feeds up_a and 'w2' feeds up_b (fan-out), and both up_a.out and up_b.out feed join.in (fan-in); declare one result 'joined' from node 'join' port 'out', cardinality one. 3) Preview; fix and re-preview on validation errors; never run an invalid graph. 4) Run it with input {\"w1\": \"alpha\", \"w2\": \"beta\"}. 5) Read the run back with get_graph_run and its result with get_graph_result.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ],
            "forbidden": [
              "bash"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "verify_run",
      "prompt": "Read-only check: report what you configured and the graph run outcome. Change nothing.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "captured_fields_match",
          "params": {
            "name": "runs",
            "expect": [
              {
                "field": "status",
                "equals": "completed"
              },
              {
                "field": "result_refs_json",
                "contains": "ALPHA"
              },
              {
                "field": "result_refs_json",
                "contains": "BETA"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "preview_calls",
            "min": 1
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "runs",
          "collection": "GraphRun",
          "filter": {
            "graph_id": {
              "_eq": "g-upper-fanout"
            },
            "owner_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "run_id",
            "graph_id",
            "status",
            "result_refs_json",
            "error"
          ]
        },
        {
          "kind": "documents",
          "name": "preview_calls",
          "collection": "AgentToolCall",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "tool_name": {
              "_eq": "preview_graph"
            }
          },
          "fields": [
            "tool_call_key",
            "tool_name",
            "status",
            "request_id"
          ]
        }
      ]
    }
  ]
}
