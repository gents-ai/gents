{
  "case_id": "train-repair-intake-acknowledgement",
  "split": "train",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "configure",
      "prompt": "Create an assistant named Workshop Clerk, using our current model, for keeping the tool repair desk's threads. Make it available for you to delegate to. Set this up without sending it a message yet.",
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ],
            "forbidden": [
              "bash",
              "agent_new"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "targets",
            "min": 1,
            "max": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "agents": {
              "agents": "agents",
              "contexts": "contexts",
              "tools": "tools",
              "expect": [
                {
                  "agent_did": "gents:agent-slot:engineer",
                  "delegates": {
                    "targets": "targets",
                    "agents": [
                      "workshop-clerk"
                    ]
                  }
                },
                {
                  "agent_did": "workshop-clerk",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^workshop[ -]?clerk$"
                  },
                  "agent": [
                    {
                      "field": "enabled",
                      "equals": true
                    }
                  ]
                }
              ]
            }
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_did",
            "display_name",
            "context_id",
            "enabled",
            "inference_profile_id"
          ]
        },
        {
          "kind": "documents",
          "name": "contexts",
          "collection": "AgentContext",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "context_id",
            "tools_id",
            "system_prompt"
          ]
        },
        {
          "kind": "documents",
          "name": "tools",
          "collection": "Tools",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "tools_id",
            "host",
            "datastore",
            "agents",
            "self_config"
          ]
        },
        {
          "kind": "documents",
          "name": "targets",
          "collection": "AgentTarget",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "target_id",
            "node_did",
            "name",
            "target_node_did",
            "agent_did"
          ]
        }
      ]
    },
    {
      "stage_id": "open_threads",
      "prompt": "Open two separate conversations with Workshop Clerk, titled exactly \"Tool Repair Intake\" and \"Tool Repair Estimates\". In each one, ask it only to acknowledge that it is ready.",
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "agent_new"
            ],
            "forbidden": [
              "bash"
            ],
            "config_read_only": true
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "threads",
            "min": 2,
            "max": 2
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "links": [
              {
                "capture": "threads",
                "source_match": {
                  "field": "title.text",
                  "matches": "(?i)^\\s*Tool Repair Intake\\s*$"
                },
                "field": "session_id",
                "target_capture": "threads",
                "target_key": "session_id",
                "exact": true,
                "expect": [
                  {
                    "field": "stopped_at",
                    "equals": null
                  }
                ]
              },
              {
                "capture": "threads",
                "source_match": {
                  "field": "title.text",
                  "matches": "(?i)^\\s*Tool Repair Estimates\\s*$"
                },
                "field": "session_id",
                "target_capture": "threads",
                "target_key": "session_id",
                "exact": true,
                "expect": [
                  {
                    "field": "stopped_at",
                    "equals": null
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "role_agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_did",
            "display_name"
          ]
        },
        {
          "kind": "documents",
          "name": "threads",
          "collection": "AgentSession",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "role_agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^workshop[ -]?clerk$"
                  },
                  "field": "agent_did"
                }
              }
            }
          },
          "fields": [
            "session_id",
            "title",
            "stopped_at"
          ]
        }
      ],
      "settle": true
    },
    {
      "stage_id": "notify",
      "prompt": "Send this note to the existing \"Tool Repair Intake\" thread only: \"The wrench W72 is in locker B6 instead of the workbench. Please acknowledge W72.\" Have them answer exactly \"ACK W72\", and report their answer when it arrives.",
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "agent_message"
            ],
            "forbidden": [
              "bash",
              "agent_new"
            ],
            "config_read_only": true
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "notes",
            "min": 1,
            "max": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "threads",
                "min": 2,
                "max": 2
              }
            ],
            "links": [
              {
                "capture": "notes",
                "source_match": {
                  "field": "content",
                  "matches": "(?i)W72"
                },
                "field": "session_id",
                "target_capture": "threads",
                "target_key": "session_id",
                "exact": true,
                "expect": [
                  {
                    "field": "title.text",
                    "matches": "(?i)^\\s*Tool Repair Intake\\s*$"
                  }
                ]
              },
              {
                "capture": "notes",
                "source_match": {
                  "field": "content",
                  "matches": "(?i)W72"
                },
                "field": "caused_by_parent_tool_call_doc_id",
                "target_capture": "sends",
                "target_key": "_docID",
                "exact": true,
                "expect": [
                  {
                    "field": "tool_name",
                    "equals": "agent_message"
                  },
                  {
                    "field": "lifecycle_state",
                    "equals": "completed"
                  }
                ]
              },
              {
                "capture": "notes",
                "source_match": {
                  "field": "content",
                  "matches": "(?i)W72"
                },
                "field": "request_id",
                "target_capture": "notes",
                "target_key": "request_id",
                "exact": true,
                "expect": [
                  {
                    "field": "lifecycle_state",
                    "equals": "completed"
                  },
                  {
                    "field": "content",
                    "matches": "(?i)locker\\s*B6"
                  },
                  {
                    "field": "terminal_output",
                    "contains": "message_doc_id"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              "ACK W72"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "role_agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_did",
            "display_name"
          ]
        },
        {
          "kind": "documents",
          "name": "threads",
          "collection": "AgentSession",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "role_agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^workshop[ -]?clerk$"
                  },
                  "field": "agent_did"
                }
              }
            }
          },
          "fields": [
            "session_id",
            "title",
            "stopped_at"
          ]
        },
        {
          "kind": "documents",
          "name": "notes",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "role_agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^workshop[ -]?clerk$"
                  },
                  "field": "agent_did"
                }
              }
            },
            "purpose": {
              "_eq": "normal"
            },
            "content": {
              "_like": "%W72%"
            }
          },
          "fields": [
            "request_id",
            "session_id",
            "content",
            "lifecycle_state",
            "terminal_output",
            "caused_by_parent_tool_call_doc_id"
          ]
        },
        {
          "kind": "documents",
          "name": "sends",
          "collection": "AgentToolCall",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "tool_name": {
              "_in": [
                "agent_message",
                "agent_new"
              ]
            },
            "request_id": {
              "_eq": "$request"
            }
          },
          "fields": [
            "_docID",
            "tool_name",
            "lifecycle_state"
          ]
        }
      ],
      "settle": true
    }
  ]
}
