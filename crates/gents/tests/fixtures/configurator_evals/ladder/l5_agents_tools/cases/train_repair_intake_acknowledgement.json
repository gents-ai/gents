{
  "case_id": "train-repair-intake-acknowledgement",
  "split": "train",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "configure",
      "prompt": "Create an assistant called Workshop Clerk for keeping the tool repair desk's threads, and set it up so you can hand work to it. Do not message it yet.",
      "capture": [
        {
          "kind": "documents",
          "name": "agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_did",
            "display_name",
            "context_id",
            "enabled",
            "inference_profile_id",
            "tags"
          ]
        },
        {
          "kind": "documents",
          "name": "contexts",
          "collection": "AgentContext",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "context_id",
            "system_prompt",
            "tools_id"
          ]
        },
        {
          "kind": "documents",
          "name": "tools",
          "collection": "Tools",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "tools_id",
            "host",
            "datastore",
            "self_config",
            "agents",
            "remote",
            "built_ins",
            "integrations"
          ]
        },
        {
          "kind": "documents",
          "name": "helper_targets",
          "collection": "AgentTarget",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^workshop[ -]?clerk$"
                  },
                  "field": "agent_did"
                }
              }
            }
          }
        },
        {
          "kind": "documents",
          "name": "helper_sessions",
          "collection": "AgentSession",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^workshop[ -]?clerk$"
                  },
                  "field": "agent_did"
                }
              }
            }
          }
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "agents": {
              "agents": "agents",
              "contexts": "contexts",
              "tools": "tools",
              "expect": [
                {
                  "agent_did": "workshop-clerk",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^workshop[ -]?clerk$"
                  },
                  "agent": [
                    {
                      "field": "enabled",
                      "equals": true
                    }
                  ]
                }
              ]
            },
            "present": [
              {
                "capture": "helper_targets",
                "min": 1
              },
              {
                "capture": "helper_sessions",
                "max": 0
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "open_threads",
      "prompt": "Open two separate conversations with Workshop Clerk, titled exactly \"Tool Repair Intake\" and \"Tool Repair Estimates\". In each one, ask it only to acknowledge that it is ready.",
      "settle": true,
      "capture": [
        {
          "kind": "documents",
          "name": "role_agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_did",
            "display_name"
          ]
        },
        {
          "kind": "documents",
          "name": "threads",
          "collection": "AgentSession",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "role_agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^workshop[ -]?clerk$"
                  },
                  "field": "agent_did"
                }
              }
            }
          }
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "threads",
                "min": 2,
                "max": 2
              }
            ],
            "links": [
              {
                "capture": "threads",
                "source_match": {
                  "field": "title.text",
                  "matches": "(?i)^\\s*Tool Repair Intake\\s*$"
                },
                "field": "session_id",
                "target_capture": "threads",
                "target_key": "session_id",
                "exact": true,
                "expect": [
                  {
                    "field": "stopped_at",
                    "equals": null
                  }
                ]
              },
              {
                "capture": "threads",
                "source_match": {
                  "field": "title.text",
                  "matches": "(?i)^\\s*Tool Repair Estimates\\s*$"
                },
                "field": "session_id",
                "target_capture": "threads",
                "target_key": "session_id",
                "exact": true,
                "expect": [
                  {
                    "field": "stopped_at",
                    "equals": null
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "notify",
      "prompt": "Send this note to the existing \"Tool Repair Intake\" thread only: \"The wrench W72 is in locker B6 instead of the workbench. Please acknowledge W72.\" Have them answer exactly \"ACK W72\", and tell me their answer when it arrives.",
      "settle": true,
      "capture": [
        {
          "kind": "documents",
          "name": "role_agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_did",
            "display_name"
          ]
        },
        {
          "kind": "documents",
          "name": "threads",
          "collection": "AgentSession",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "role_agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^workshop[ -]?clerk$"
                  },
                  "field": "agent_did"
                }
              }
            }
          }
        },
        {
          "kind": "documents",
          "name": "notes",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "role_agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^workshop[ -]?clerk$"
                  },
                  "field": "agent_did"
                }
              }
            },
            "purpose": {
              "_eq": "normal"
            },
            "content": {
              "_like": "%W72%"
            }
          }
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "threads",
                "min": 2,
                "max": 2
              },
              {
                "capture": "notes",
                "min": 1,
                "max": 1
              }
            ],
            "links": [
              {
                "capture": "notes",
                "source_match": {
                  "field": "content",
                  "matches": "(?i)W72"
                },
                "field": "session_id",
                "target_capture": "threads",
                "target_key": "session_id",
                "exact": true,
                "expect": [
                  {
                    "field": "title.text",
                    "matches": "(?i)^\\s*Tool Repair Intake\\s*$"
                  }
                ]
              },
              {
                "capture": "notes",
                "source_match": {
                  "field": "content",
                  "matches": "(?i)W72"
                },
                "field": "request_id",
                "target_capture": "notes",
                "target_key": "request_id",
                "exact": true,
                "expect": [
                  {
                    "field": "lifecycle_state",
                    "equals": "completed"
                  },
                  {
                    "field": "content",
                    "matches": "(?i)locker\\s*B6"
                  },
                  {
                    "field": "terminal_output",
                    "contains": "message_doc_id"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              "ACK W72"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}