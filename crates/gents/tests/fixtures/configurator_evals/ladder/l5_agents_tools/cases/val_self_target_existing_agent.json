{
  "case_id": "val-self-target-existing-agent",
  "split": "validation",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "delegate",
      "prompt": "Start another session of yourself, ask it to reply with exactly ECHO-2468, and tell me what it says.",
      "settle": true,
      "capture": [
        {
          "kind": "documents",
          "name": "own_sessions",
          "collection": "AgentSession",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": "gents:agent-slot:engineer"
            }
          }
        },
        {
          "kind": "documents",
          "name": "helper_requests",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": "gents:agent-slot:engineer"
            },
            "content": {
              "_like": "%ECHO-2468%"
            },
            "request_hop": {
              "_gt": 0
            },
            "purpose": {
              "_eq": "normal"
            }
          }
        },
        {
          "kind": "documents",
          "name": "delegation_calls",
          "collection": "AgentToolCall",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "tool_name": {
              "_in": [
                "agent_new",
                "agent_message"
              ]
            },
            "request_id": {
              "_eq": "$request"
            }
          }
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "own_sessions",
                "min": 2
              },
              {
                "capture": "helper_requests",
                "min": 1,
                "max": 1
              }
            ],
            "links": [
              {
                "capture": "helper_requests",
                "source_match": {
                  "field": "content",
                  "contains": "ECHO-2468"
                },
                "field": "request_id",
                "target_capture": "helper_requests",
                "target_key": "request_id",
                "exact": true,
                "expect": [
                  {
                    "field": "lifecycle_state",
                    "equals": "completed"
                  },
                  {
                    "field": "terminal_output",
                    "contains": "message_doc_id"
                  }
                ]
              },
              {
                "capture": "helper_requests",
                "source_match": {
                  "field": "content",
                  "contains": "ECHO-2468"
                },
                "field": "caused_by_parent_tool_call_doc_id",
                "target_capture": "delegation_calls",
                "target_key": "_docID",
                "exact": true,
                "expect": [
                  {
                    "field": "lifecycle_state",
                    "equals": "completed"
                  },
                  {
                    "field": "completion_notification_delivered_at",
                    "matches": "^[0-9]{4}-"
                  }
                ]
              },
              {
                "capture": "helper_requests",
                "source_match": {
                  "field": "content",
                  "contains": "ECHO-2468"
                },
                "field": "session_id",
                "target_capture": "own_sessions",
                "target_key": "session_id",
                "exact": true
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              "ECHO-2468"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}