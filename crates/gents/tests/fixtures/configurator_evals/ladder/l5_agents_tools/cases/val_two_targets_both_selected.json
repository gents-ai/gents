{
  "case_id": "val-two-targets-both-selected",
  "split": "validation",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "configure-two",
      "prompt": "Create two assistants: Researcher for finding facts and Reviewer for checking conclusions. Set both up so you can hand work to them.",
      "capture": [
        {
          "kind": "documents",
          "name": "agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_did",
            "display_name",
            "context_id",
            "enabled",
            "inference_profile_id",
            "tags"
          ]
        },
        {
          "kind": "documents",
          "name": "contexts",
          "collection": "AgentContext",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "context_id",
            "system_prompt",
            "tools_id"
          ]
        },
        {
          "kind": "documents",
          "name": "tools",
          "collection": "Tools",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "tools_id",
            "host",
            "datastore",
            "self_config",
            "agents",
            "remote",
            "built_ins",
            "integrations"
          ]
        },
        {
          "kind": "documents",
          "name": "helper_targets_1",
          "collection": "AgentTarget",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^researcher$"
                  },
                  "field": "agent_did"
                }
              }
            }
          },
          "fields": [
            "target_id",
            "node_did",
            "name",
            "target_node_did",
            "agent_did"
          ]
        },
        {
          "kind": "documents",
          "name": "helper_targets_2",
          "collection": "AgentTarget",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^reviewer$"
                  },
                  "field": "agent_did"
                }
              }
            }
          },
          "fields": [
            "target_id",
            "node_did",
            "name",
            "target_node_did",
            "agent_did"
          ]
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "agents": {
              "agents": "agents",
              "contexts": "contexts",
              "tools": "tools",
              "expect": [
                {
                  "agent_did": "researcher",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^researcher$"
                  },
                  "agent": [
                    {
                      "field": "enabled",
                      "equals": true
                    }
                  ]
                },
                {
                  "agent_did": "reviewer",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^reviewer$"
                  },
                  "agent": [
                    {
                      "field": "enabled",
                      "equals": true
                    }
                  ]
                }
              ]
            },
            "present": [
              {
                "capture": "helper_targets_1",
                "min": 1
              },
              {
                "capture": "helper_targets_2",
                "min": 1
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "delegate-to-both",
      "prompt": "Ask Researcher to reply with exactly ALPHA-333 and Reviewer to reply with exactly BETA-777, and tell me what each says.",
      "settle": true,
      "capture": [
        {
          "kind": "documents",
          "name": "role_agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_did",
            "display_name"
          ]
        },
        {
          "kind": "documents",
          "name": "helper-1-session",
          "collection": "AgentSession",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "role_agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^researcher$"
                  },
                  "field": "agent_did"
                }
              }
            }
          },
          "fields": [
            "session_id",
            "agent_did",
            "title",
            "stopped_at"
          ]
        },
        {
          "kind": "documents",
          "name": "helper-1-request",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "role_agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^researcher$"
                  },
                  "field": "agent_did"
                }
              }
            },
            "purpose": {
              "_eq": "normal"
            },
            "content": {
              "_like": "%ALPHA-333%"
            },
            "lifecycle_state": {
              "_eq": "completed"
            }
          },
          "fields": [
            "request_id",
            "agent_did",
            "session_id",
            "content",
            "lifecycle_state",
            "terminal_output",
            "caused_by_parent_tool_call_doc_id",
            "caused_by_parent_request_id"
          ]
        },
        {
          "kind": "documents",
          "name": "helper-2-session",
          "collection": "AgentSession",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "role_agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^reviewer$"
                  },
                  "field": "agent_did"
                }
              }
            }
          },
          "fields": [
            "session_id",
            "agent_did",
            "title",
            "stopped_at"
          ]
        },
        {
          "kind": "documents",
          "name": "helper-2-request",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "role_agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^reviewer$"
                  },
                  "field": "agent_did"
                }
              }
            },
            "purpose": {
              "_eq": "normal"
            },
            "content": {
              "_like": "%BETA-777%"
            },
            "lifecycle_state": {
              "_eq": "completed"
            }
          },
          "fields": [
            "request_id",
            "agent_did",
            "session_id",
            "content",
            "lifecycle_state",
            "terminal_output",
            "caused_by_parent_tool_call_doc_id",
            "caused_by_parent_request_id"
          ]
        },
        {
          "kind": "documents",
          "name": "delegation_calls",
          "collection": "AgentToolCall",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "tool_name": {
              "_in": [
                "agent_new",
                "agent_message"
              ]
            },
            "request_id": {
              "_eq": "$request"
            }
          },
          "fields": [
            "_docID",
            "tool_name",
            "lifecycle_state",
            "completion_notification_delivered_at"
          ]
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "links": [
              {
                "capture": "helper-1-request",
                "field": "caused_by_parent_tool_call_doc_id",
                "target_capture": "delegation_calls",
                "target_key": "_docID",
                "expect": [
                  {
                    "field": "lifecycle_state",
                    "equals": "completed"
                  },
                  {
                    "field": "completion_notification_delivered_at",
                    "matches": "^[0-9]{4}-"
                  }
                ],
                "source_match": {
                  "field": "content",
                  "contains": "ALPHA-333"
                },
                "exact": true
              },
              {
                "capture": "helper-1-request",
                "source_match": {
                  "field": "content",
                  "contains": "ALPHA-333"
                },
                "field": "session_id",
                "target_capture": "helper-1-session",
                "target_key": "session_id",
                "exact": true
              },
              {
                "capture": "helper-2-request",
                "field": "caused_by_parent_tool_call_doc_id",
                "target_capture": "delegation_calls",
                "target_key": "_docID",
                "expect": [
                  {
                    "field": "lifecycle_state",
                    "equals": "completed"
                  },
                  {
                    "field": "completion_notification_delivered_at",
                    "matches": "^[0-9]{4}-"
                  }
                ],
                "source_match": {
                  "field": "content",
                  "contains": "BETA-777"
                },
                "exact": true
              },
              {
                "capture": "helper-2-request",
                "source_match": {
                  "field": "content",
                  "contains": "BETA-777"
                },
                "field": "session_id",
                "target_capture": "helper-2-session",
                "target_key": "session_id",
                "exact": true
              }
            ],
            "present": [
              {
                "capture": "helper-1-session",
                "min": 1
              },
              {
                "capture": "helper-1-request",
                "min": 1,
                "max": 1
              },
              {
                "capture": "helper-2-session",
                "min": 1
              },
              {
                "capture": "helper-2-request",
                "min": 1,
                "max": 1
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              "ALPHA-333",
              "BETA-777"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}