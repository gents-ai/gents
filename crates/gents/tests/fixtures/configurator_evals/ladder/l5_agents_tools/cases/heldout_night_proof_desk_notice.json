{
  "case_id": "heldout-night-proof-desk-notice",
  "split": "held_out",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "configure",
      "prompt": "Create an assistant called Proof Runner for carrying notes between the print proof desks, and set it up so you can hand work to it. Do not message it yet.",
      "capture": [
        {
          "kind": "documents",
          "name": "agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_did",
            "display_name",
            "context_id",
            "enabled",
            "inference_profile_id",
            "tags"
          ]
        },
        {
          "kind": "documents",
          "name": "contexts",
          "collection": "AgentContext",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "context_id",
            "system_prompt",
            "tools_id"
          ]
        },
        {
          "kind": "documents",
          "name": "tools",
          "collection": "Tools",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "tools_id",
            "host",
            "datastore",
            "self_config",
            "agents",
            "remote",
            "built_ins",
            "integrations"
          ]
        },
        {
          "kind": "documents",
          "name": "helper_targets",
          "collection": "AgentTarget",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^proof[ -]?runner$"
                  },
                  "field": "agent_did"
                }
              }
            }
          },
          "fields": [
            "target_id",
            "node_did",
            "name",
            "target_node_did",
            "agent_did"
          ]
        },
        {
          "kind": "documents",
          "name": "helper_sessions",
          "collection": "AgentSession",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^proof[ -]?runner$"
                  },
                  "field": "agent_did"
                }
              }
            }
          },
          "fields": [
            "session_id",
            "agent_did",
            "title",
            "stopped_at"
          ]
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "agents": {
              "agents": "agents",
              "contexts": "contexts",
              "tools": "tools",
              "expect": [
                {
                  "agent_did": "proof-runner",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^proof[ -]?runner$"
                  },
                  "agent": [
                    {
                      "field": "enabled",
                      "equals": true
                    }
                  ]
                }
              ]
            },
            "present": [
              {
                "capture": "helper_targets",
                "min": 1
              },
              {
                "capture": "helper_sessions",
                "max": 0
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "open_threads",
      "prompt": "Open two separate conversations with Proof Runner, titled exactly \"Proof desk night\" and \"Proof desk day\". In each one, ask it only to acknowledge that it is ready.",
      "settle": true,
      "capture": [
        {
          "kind": "documents",
          "name": "role_agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_did",
            "display_name"
          ]
        },
        {
          "kind": "documents",
          "name": "threads",
          "collection": "AgentSession",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "role_agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^proof[ -]?runner$"
                  },
                  "field": "agent_did"
                }
              }
            }
          },
          "fields": [
            "session_id",
            "agent_did",
            "title",
            "stopped_at"
          ]
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "threads",
                "min": 2,
                "max": 2
              }
            ],
            "links": [
              {
                "capture": "threads",
                "source_match": {
                  "field": "title.text",
                  "matches": "(?i)^\\s*Proof desk night\\s*$"
                },
                "field": "session_id",
                "target_capture": "threads",
                "target_key": "session_id",
                "exact": true,
                "expect": [
                  {
                    "field": "stopped_at",
                    "equals": null
                  }
                ]
              },
              {
                "capture": "threads",
                "source_match": {
                  "field": "title.text",
                  "matches": "(?i)^\\s*Proof desk day\\s*$"
                },
                "field": "session_id",
                "target_capture": "threads",
                "target_key": "session_id",
                "exact": true,
                "expect": [
                  {
                    "field": "stopped_at",
                    "equals": null
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "notify",
      "prompt": "Let the existing night proof desk thread know that the Orchid proof has moved to cabinet 6. The day desk does not need to hear about it.",
      "settle": true,
      "capture": [
        {
          "kind": "documents",
          "name": "role_agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_did",
            "display_name"
          ]
        },
        {
          "kind": "documents",
          "name": "threads",
          "collection": "AgentSession",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "role_agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^proof[ -]?runner$"
                  },
                  "field": "agent_did"
                }
              }
            }
          },
          "fields": [
            "session_id",
            "agent_did",
            "title",
            "stopped_at"
          ]
        },
        {
          "kind": "documents",
          "name": "notes",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "role_agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^proof[ -]?runner$"
                  },
                  "field": "agent_did"
                }
              }
            },
            "purpose": {
              "_eq": "normal"
            },
            "content": {
              "_like": "%rchid%"
            }
          },
          "fields": [
            "request_id",
            "agent_did",
            "session_id",
            "content",
            "lifecycle_state",
            "terminal_output",
            "caused_by_parent_tool_call_doc_id",
            "caused_by_parent_request_id"
          ]
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "threads",
                "min": 2,
                "max": 2
              },
              {
                "capture": "notes",
                "min": 1,
                "max": 1
              }
            ],
            "links": [
              {
                "capture": "notes",
                "source_match": {
                  "field": "content",
                  "matches": "(?i)rchid"
                },
                "field": "session_id",
                "target_capture": "threads",
                "target_key": "session_id",
                "exact": true,
                "expect": [
                  {
                    "field": "title.text",
                    "matches": "(?i)^\\s*Proof desk night\\s*$"
                  }
                ]
              },
              {
                "capture": "notes",
                "source_match": {
                  "field": "content",
                  "matches": "(?i)rchid"
                },
                "field": "request_id",
                "target_capture": "notes",
                "target_key": "request_id",
                "exact": true,
                "expect": [
                  {
                    "field": "lifecycle_state",
                    "equals": "completed"
                  },
                  {
                    "field": "content",
                    "matches": "(?i)cabinet\\s*(6|six)"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "retry",
      "prompt": "Did the night proof desk receive the Orchid cabinet change? Resend only if it never arrived.",
      "settle": true,
      "capture": [
        {
          "kind": "documents",
          "name": "role_agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_did",
            "display_name"
          ]
        },
        {
          "kind": "documents",
          "name": "threads",
          "collection": "AgentSession",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "role_agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^proof[ -]?runner$"
                  },
                  "field": "agent_did"
                }
              }
            }
          },
          "fields": [
            "session_id",
            "agent_did",
            "title",
            "stopped_at"
          ]
        },
        {
          "kind": "documents",
          "name": "notes",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "role_agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^proof[ -]?runner$"
                  },
                  "field": "agent_did"
                }
              }
            },
            "purpose": {
              "_eq": "normal"
            },
            "content": {
              "_like": "%rchid%"
            }
          },
          "fields": [
            "request_id",
            "agent_did",
            "session_id",
            "content",
            "lifecycle_state",
            "terminal_output",
            "caused_by_parent_tool_call_doc_id",
            "caused_by_parent_request_id"
          ]
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "threads",
                "min": 2,
                "max": 2
              },
              {
                "capture": "notes",
                "min": 1,
                "max": 1
              }
            ],
            "links": [
              {
                "capture": "notes",
                "source_match": {
                  "field": "content",
                  "matches": "(?i)rchid"
                },
                "field": "session_id",
                "target_capture": "threads",
                "target_key": "session_id",
                "exact": true,
                "expect": [
                  {
                    "field": "title.text",
                    "matches": "(?i)^\\s*Proof desk night\\s*$"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}