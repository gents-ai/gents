{
  "case_id": "heldout-mixed-valid-and-ghost",
  "split": "held_out",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "configure-mixed",
      "prompt": "Create an assistant called Available Helper for short questions that you can hand work to. Also connect my existing assistant Harbor Clerk; if you cannot find it, do not create a stand-in, just tell me and finish the rest.",
      "capture": [
        {
          "kind": "documents",
          "name": "agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_did",
            "display_name",
            "context_id",
            "enabled",
            "inference_profile_id",
            "tags"
          ]
        },
        {
          "kind": "documents",
          "name": "contexts",
          "collection": "AgentContext",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "context_id",
            "system_prompt",
            "tools_id"
          ]
        },
        {
          "kind": "documents",
          "name": "tools",
          "collection": "Tools",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "tools_id",
            "host",
            "datastore",
            "self_config",
            "agents",
            "remote",
            "built_ins",
            "integrations"
          ]
        },
        {
          "kind": "documents",
          "name": "helper_targets",
          "collection": "AgentTarget",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^available[ -]helper$"
                  },
                  "field": "agent_did"
                }
              }
            }
          }
        },
        {
          "kind": "documents",
          "name": "ghost_agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "display_name": {
              "_like": "%arbor%"
            }
          },
          "fields": [
            "agent_did",
            "display_name"
          ]
        },
        {
          "kind": "documents",
          "name": "ghost_targets",
          "collection": "AgentTarget",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "_or": [
              {
                "name": {
                  "_like": "%arbor%"
                }
              },
              {
                "target_id": {
                  "_like": "%arbor%"
                }
              }
            ]
          }
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "agents": {
              "agents": "agents",
              "contexts": "contexts",
              "tools": "tools",
              "expect": [
                {
                  "agent_did": "available-helper",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^available[ -]helper$"
                  },
                  "agent": [
                    {
                      "field": "enabled",
                      "equals": true
                    }
                  ]
                }
              ]
            },
            "present": [
              {
                "capture": "helper_targets",
                "min": 1
              },
              {
                "capture": "ghost_agents",
                "max": 0
              },
              {
                "capture": "ghost_targets",
                "max": 0
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "final_message_matches",
          "params": {
            "any": [
              {
                "matches": "(?i)(not (found|exist|available)|missing|could ?n[o']t find|can ?n[o']t find|unable to find|no (such )?(assistant|agent)|does ?n[o']t exist|did ?n[o']t find)"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "delegate-to-valid",
      "prompt": "Ask Available Helper to reply with exactly HO-999 and tell me what it says.",
      "settle": true,
      "capture": [
        {
          "kind": "documents",
          "name": "role_agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_did",
            "display_name"
          ]
        },
        {
          "kind": "documents",
          "name": "helper-session",
          "collection": "AgentSession",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "role_agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^available[ -]helper$"
                  },
                  "field": "agent_did"
                }
              }
            }
          }
        },
        {
          "kind": "documents",
          "name": "helper-request",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "role_agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^available[ -]helper$"
                  },
                  "field": "agent_did"
                }
              }
            },
            "purpose": {
              "_eq": "normal"
            },
            "content": {
              "_like": "%HO-999%"
            },
            "lifecycle_state": {
              "_eq": "completed"
            }
          }
        },
        {
          "kind": "documents",
          "name": "delegation_calls",
          "collection": "AgentToolCall",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "tool_name": {
              "_in": [
                "agent_new",
                "agent_message"
              ]
            },
            "request_id": {
              "_eq": "$request"
            }
          }
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "links": [
              {
                "capture": "helper-request",
                "field": "caused_by_parent_tool_call_doc_id",
                "target_capture": "delegation_calls",
                "target_key": "_docID",
                "expect": [
                  {
                    "field": "lifecycle_state",
                    "equals": "completed"
                  },
                  {
                    "field": "completion_notification_delivered_at",
                    "matches": "^[0-9]{4}-"
                  }
                ],
                "source_match": {
                  "field": "content",
                  "contains": "HO-999"
                },
                "exact": true
              },
              {
                "capture": "helper-request",
                "source_match": {
                  "field": "content",
                  "contains": "HO-999"
                },
                "field": "session_id",
                "target_capture": "helper-session",
                "target_key": "session_id",
                "exact": true
              }
            ],
            "present": [
              {
                "capture": "helper-session",
                "min": 1
              },
              {
                "capture": "helper-request",
                "min": 1,
                "max": 1
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              "HO-999"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}