{
  "case_id": "heldout-mixed-valid-and-ghost",
  "split": "held_out",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "configure-mixed",
      "prompt": "Create Available Helper for short questions, using our current model, and make it available for you to delegate to. Also connect the existing assistant Missing Assistant. If that assistant does not exist, do not create a replacement or a broken connection; explain the problem and finish the part that works.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ],
            "forbidden": [
              "bash"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "targets",
            "min": 1,
            "max": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "agents": {
              "agents": "agents",
              "contexts": "contexts",
              "tools": "tools",
              "expect": [
                {
                  "agent_id": "engineer",
                  "delegates": {
                    "targets": "targets",
                    "agents": [
                      "available-helper"
                    ]
                  }
                }
              ]
            }
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_id",
            "display_name",
            "context_id",
            "enabled",
            "inference_profile_id"
          ]
        },
        {
          "kind": "documents",
          "name": "contexts",
          "collection": "AgentContext",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "context_id",
            "tools_id",
            "system_prompt"
          ]
        },
        {
          "kind": "documents",
          "name": "tools",
          "collection": "Tools",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "tools_id",
            "host",
            "datastore",
            "agents",
            "self_config"
          ]
        },
        {
          "kind": "documents",
          "name": "targets",
          "collection": "AgentTarget",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "target_id",
            "node_did",
            "name",
            "target_node_did",
            "agent_id"
          ]
        }
      ]
    },
    {
      "stage_id": "delegate-to-valid",
      "prompt": "Ask Available Helper to reply with exactly HO-999 and report its reply when it arrives.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "agent_new"
            ],
            "forbidden": [
              "bash"
            ],
            "config_read_only": true
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "ho-session",
            "min": 1
          },
          "tier": "acceptance",
          "weight": 2
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "ho-request",
            "expect": [
              {
                "field": "content",
                "contains": "HO-999"
              },
              {
                "field": "lifecycle_state",
                "equals": "completed"
              },
              {
                "field": "terminal_output",
                "contains": "message_doc_id"
              }
            ],
            "max_rows": 1
          },
          "tier": "acceptance",
          "weight": 2
        },
        {
          "check": "crew_spec_match",
          "params": {
            "links": [
              {
                "capture": "ho-request",
                "key": "agent_id",
                "id": "available-helper",
                "field": "caused_by_parent_tool_call_doc_id",
                "target_capture": "delegation_calls",
                "target_key": "_docID",
                "expect": [
                  {
                    "field": "lifecycle_state",
                    "equals": "completed"
                  },
                  {
                    "field": "completion_notification_delivered_at",
                    "matches": "^[0-9]{4}-"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 2
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              "HO-999"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "ho-session",
          "collection": "AgentSession",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_id": {
              "_like": "%:available-helper"
            }
          },
          "fields": [
            "session_id",
            "agent_id",
            "node_did"
          ]
        },
        {
          "kind": "documents",
          "name": "ho-request",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_id": {
              "_like": "%:available-helper"
            },
            "purpose": {
              "_eq": "normal"
            }
          },
          "fields": [
            "request_id",
            "agent_id",
            "session_id",
            "content",
            "lifecycle_state",
            "terminal_output",
            "caused_by_parent_tool_call_doc_id"
          ]
        },
        {
          "kind": "documents",
          "name": "delegation_calls",
          "collection": "AgentToolCall",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "tool_name": {
              "_in": [
                "agent_new",
                "agent_message"
              ]
            }
          },
          "fields": [
            "_docID",
            "lifecycle_state",
            "completion_notification_delivered_at"
          ]
        }
      ],
      "settle": true
    }
  ]
}
