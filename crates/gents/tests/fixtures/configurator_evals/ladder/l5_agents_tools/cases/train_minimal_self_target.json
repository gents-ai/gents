{
  "case_id": "train-minimal-self-target",
  "split": "train",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "configure",
      "prompt": "Create a research-helper assistant for short research questions, using our current model. Make it available for you to delegate to. Set this up now; we will try it next.",
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ],
            "forbidden": [
              "bash"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "targets",
            "min": 1,
            "max": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "agents": {
              "agents": "agents",
              "contexts": "contexts",
              "tools": "tools",
              "expect": [
                {
                  "agent_did": "gents:agent-slot:engineer",
                  "delegates": {
                    "targets": "targets",
                    "agents": [
                      "research-helper"
                    ]
                  }
                },
                {
                  "agent_did": "research-helper",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^research[ -]helper$"
                  }
                }
              ]
            }
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_did",
            "display_name",
            "context_id",
            "enabled",
            "inference_profile_id"
          ]
        },
        {
          "kind": "documents",
          "name": "contexts",
          "collection": "AgentContext",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "context_id",
            "tools_id",
            "system_prompt"
          ]
        },
        {
          "kind": "documents",
          "name": "tools",
          "collection": "Tools",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "tools_id",
            "host",
            "datastore",
            "agents",
            "self_config"
          ]
        },
        {
          "kind": "documents",
          "name": "targets",
          "collection": "AgentTarget",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "target_id",
            "node_did",
            "name",
            "target_node_did",
            "agent_did"
          ]
        }
      ]
    },
    {
      "stage_id": "delegate",
      "prompt": "Ask Research Helper to reply with exactly TRAIN-111 and report its reply when it arrives.",
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "agent_new"
            ],
            "forbidden": [
              "bash"
            ],
            "config_read_only": true
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "helper-session",
            "min": 1
          },
          "tier": "acceptance",
          "weight": 2
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "helper-request",
            "expect": [
              {
                "field": "content",
                "contains": "TRAIN-111"
              },
              {
                "field": "lifecycle_state",
                "equals": "completed"
              },
              {
                "field": "terminal_output",
                "contains": "message_doc_id"
              }
            ],
            "max_rows": 1
          },
          "tier": "acceptance",
          "weight": 2
        },
        {
          "check": "crew_spec_match",
          "params": {
            "links": [
              {
                "capture": "helper-request",
                "field": "caused_by_parent_tool_call_doc_id",
                "target_capture": "delegation_calls",
                "target_key": "_docID",
                "expect": [
                  {
                    "field": "lifecycle_state",
                    "equals": "completed"
                  },
                  {
                    "field": "completion_notification_delivered_at",
                    "matches": "^[0-9]{4}-"
                  }
                ],
                "source_match": {
                  "field": "content",
                  "contains": "TRAIN-111"
                },
                "exact": true
              },
              {
                "capture": "helper-request",
                "source_match": {
                  "field": "content",
                  "contains": "TRAIN-111"
                },
                "field": "session_id",
                "target_capture": "helper-session",
                "target_key": "session_id",
                "exact": true
              }
            ]
          },
          "tier": "acceptance",
          "weight": 2
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              "TRAIN-111"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "role_agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_did",
            "display_name"
          ]
        },
        {
          "kind": "documents",
          "name": "helper-session",
          "collection": "AgentSession",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "role_agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^research[ -]helper$"
                  },
                  "field": "agent_did"
                }
              }
            }
          },
          "fields": [
            "session_id",
            "agent_did",
            "node_did"
          ]
        },
        {
          "kind": "documents",
          "name": "helper-request",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "role_agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^research[ -]helper$"
                  },
                  "field": "agent_did"
                }
              }
            },
            "purpose": {
              "_eq": "normal"
            }
          },
          "fields": [
            "request_id",
            "agent_did",
            "session_id",
            "content",
            "lifecycle_state",
            "terminal_output",
            "caused_by_parent_tool_call_doc_id"
          ]
        },
        {
          "kind": "documents",
          "name": "delegation_calls",
          "collection": "AgentToolCall",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "tool_name": {
              "_in": [
                "agent_new",
                "agent_message"
              ]
            },
            "request_id": {
              "_eq": "$request"
            }
          },
          "fields": [
            "_docID",
            "lifecycle_state",
            "completion_notification_delivered_at"
          ]
        }
      ],
      "settle": true
    },
    {
      "stage_id": "follow_up",
      "prompt": "Ask the same helper to reply with exactly FOLLOW-222. Keep using that conversation and report its reply when it arrives.",
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "agent_message"
            ],
            "forbidden": [
              "agent_new"
            ],
            "config_read_only": true
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "helper-session",
            "min": 1,
            "max": 1
          },
          "tier": "acceptance",
          "weight": 2
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "helper-request",
            "expect": [
              {
                "field": "content",
                "contains": "FOLLOW-222"
              },
              {
                "field": "lifecycle_state",
                "equals": "completed"
              },
              {
                "field": "terminal_output",
                "contains": "message_doc_id"
              }
            ],
            "max_rows": 1
          },
          "tier": "acceptance",
          "weight": 2
        },
        {
          "check": "crew_spec_match",
          "params": {
            "links": [
              {
                "capture": "helper-request",
                "field": "caused_by_parent_tool_call_doc_id",
                "target_capture": "delegation_calls",
                "target_key": "_docID",
                "expect": [
                  {
                    "field": "lifecycle_state",
                    "equals": "completed"
                  },
                  {
                    "field": "completion_notification_delivered_at",
                    "matches": "^[0-9]{4}-"
                  }
                ],
                "source_match": {
                  "field": "content",
                  "contains": "FOLLOW-222"
                },
                "exact": true
              },
              {
                "capture": "helper-request",
                "source_match": {
                  "field": "content",
                  "contains": "FOLLOW-222"
                },
                "field": "session_id",
                "target_capture": "helper-session",
                "target_key": "session_id",
                "exact": true
              }
            ]
          },
          "tier": "acceptance",
          "weight": 2
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              "FOLLOW-222"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "role_agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_did",
            "display_name"
          ]
        },
        {
          "kind": "documents",
          "name": "helper-session",
          "collection": "AgentSession",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "role_agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^research[ -]helper$"
                  },
                  "field": "agent_did"
                }
              }
            }
          },
          "fields": [
            "session_id",
            "agent_did",
            "node_did"
          ]
        },
        {
          "kind": "documents",
          "name": "helper-request",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "role_agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^research[ -]helper$"
                  },
                  "field": "agent_did"
                }
              }
            },
            "content": {
              "_like": "%FOLLOW-222%"
            },
            "purpose": {
              "_eq": "normal"
            }
          },
          "fields": [
            "request_id",
            "agent_did",
            "session_id",
            "content",
            "lifecycle_state",
            "terminal_output",
            "caused_by_parent_tool_call_doc_id"
          ]
        },
        {
          "kind": "documents",
          "name": "delegation_calls",
          "collection": "AgentToolCall",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "tool_name": {
              "_in": [
                "agent_new",
                "agent_message"
              ]
            },
            "request_id": {
              "_eq": "$request"
            }
          },
          "fields": [
            "_docID",
            "lifecycle_state",
            "completion_notification_delivered_at"
          ]
        }
      ],
      "settle": true
    }
  ]
}
