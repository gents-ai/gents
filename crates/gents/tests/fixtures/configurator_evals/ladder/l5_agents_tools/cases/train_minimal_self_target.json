{
  "case_id": "train-minimal-self-target",
  "split": "train",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "configure",
      "prompt": "Create an assistant called Research Helper for short research questions, and set it up so you can hand work to it. We will try it next.",
      "capture": [
        {
          "kind": "documents",
          "name": "agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_did",
            "display_name",
            "context_id",
            "enabled",
            "inference_profile_id",
            "tags"
          ]
        },
        {
          "kind": "documents",
          "name": "contexts",
          "collection": "AgentContext",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "context_id",
            "system_prompt",
            "tools_id"
          ]
        },
        {
          "kind": "documents",
          "name": "tools",
          "collection": "Tools",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "tools_id",
            "host",
            "datastore",
            "self_config",
            "agents",
            "remote",
            "built_ins",
            "integrations"
          ]
        },
        {
          "kind": "documents",
          "name": "helper_targets",
          "collection": "AgentTarget",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^research[ -]helper$"
                  },
                  "field": "agent_did"
                }
              }
            }
          }
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "agents": {
              "agents": "agents",
              "contexts": "contexts",
              "tools": "tools",
              "expect": [
                {
                  "agent_did": "research-helper",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^research[ -]helper$"
                  },
                  "agent": [
                    {
                      "field": "enabled",
                      "equals": true
                    }
                  ]
                }
              ]
            },
            "present": [
              {
                "capture": "helper_targets",
                "min": 1
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "delegate",
      "prompt": "Ask Research Helper to reply with exactly TRAIN-111 and tell me what it says.",
      "settle": true,
      "capture": [
        {
          "kind": "documents",
          "name": "role_agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_did",
            "display_name"
          ]
        },
        {
          "kind": "documents",
          "name": "helper-session",
          "collection": "AgentSession",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "role_agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^research[ -]helper$"
                  },
                  "field": "agent_did"
                }
              }
            }
          }
        },
        {
          "kind": "documents",
          "name": "helper-request",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "role_agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^research[ -]helper$"
                  },
                  "field": "agent_did"
                }
              }
            },
            "purpose": {
              "_eq": "normal"
            },
            "content": {
              "_like": "%TRAIN-111%"
            }
          }
        },
        {
          "kind": "documents",
          "name": "delegation_calls",
          "collection": "AgentToolCall",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "tool_name": {
              "_in": [
                "agent_new",
                "agent_message"
              ]
            },
            "request_id": {
              "_eq": "$request"
            }
          }
        }
      ],
      "checks": [
        {
          "check": "captured_fields_match",
          "params": {
            "name": "helper-request",
            "expect": [
              {
                "field": "content",
                "contains": "TRAIN-111"
              },
              {
                "field": "lifecycle_state",
                "equals": "completed"
              },
              {
                "field": "terminal_output",
                "contains": "message_doc_id"
              }
            ],
            "max_rows": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "links": [
              {
                "capture": "helper-request",
                "field": "caused_by_parent_tool_call_doc_id",
                "target_capture": "delegation_calls",
                "target_key": "_docID",
                "expect": [
                  {
                    "field": "lifecycle_state",
                    "equals": "completed"
                  },
                  {
                    "field": "completion_notification_delivered_at",
                    "matches": "^[0-9]{4}-"
                  }
                ],
                "source_match": {
                  "field": "content",
                  "contains": "TRAIN-111"
                },
                "exact": true
              },
              {
                "capture": "helper-request",
                "source_match": {
                  "field": "content",
                  "contains": "TRAIN-111"
                },
                "field": "session_id",
                "target_capture": "helper-session",
                "target_key": "session_id",
                "exact": true
              }
            ],
            "present": [
              {
                "capture": "helper-session",
                "min": 1
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              "TRAIN-111"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "follow_up",
      "prompt": "Now ask it, in that same conversation, to reply with exactly FOLLOW-222, and tell me what it says.",
      "settle": true,
      "capture": [
        {
          "kind": "documents",
          "name": "role_agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_did",
            "display_name"
          ]
        },
        {
          "kind": "documents",
          "name": "helper-session",
          "collection": "AgentSession",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "role_agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^research[ -]helper$"
                  },
                  "field": "agent_did"
                }
              }
            }
          }
        },
        {
          "kind": "documents",
          "name": "helper-request",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "role_agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^research[ -]helper$"
                  },
                  "field": "agent_did"
                }
              }
            },
            "purpose": {
              "_eq": "normal"
            },
            "content": {
              "_like": "%FOLLOW-222%"
            }
          }
        },
        {
          "kind": "documents",
          "name": "delegation_calls",
          "collection": "AgentToolCall",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "tool_name": {
              "_in": [
                "agent_new",
                "agent_message"
              ]
            },
            "request_id": {
              "_eq": "$request"
            }
          }
        }
      ],
      "checks": [
        {
          "check": "captured_fields_match",
          "params": {
            "name": "helper-request",
            "expect": [
              {
                "field": "content",
                "contains": "FOLLOW-222"
              },
              {
                "field": "lifecycle_state",
                "equals": "completed"
              },
              {
                "field": "terminal_output",
                "contains": "message_doc_id"
              }
            ],
            "max_rows": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "links": [
              {
                "capture": "helper-request",
                "field": "caused_by_parent_tool_call_doc_id",
                "target_capture": "delegation_calls",
                "target_key": "_docID",
                "expect": [
                  {
                    "field": "lifecycle_state",
                    "equals": "completed"
                  },
                  {
                    "field": "completion_notification_delivered_at",
                    "matches": "^[0-9]{4}-"
                  }
                ],
                "source_match": {
                  "field": "content",
                  "contains": "FOLLOW-222"
                },
                "exact": true
              },
              {
                "capture": "helper-request",
                "source_match": {
                  "field": "content",
                  "contains": "FOLLOW-222"
                },
                "field": "session_id",
                "target_capture": "helper-session",
                "target_key": "session_id",
                "exact": true
              }
            ],
            "present": [
              {
                "capture": "helper-session",
                "min": 1,
                "max": 1
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              "FOLLOW-222"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}