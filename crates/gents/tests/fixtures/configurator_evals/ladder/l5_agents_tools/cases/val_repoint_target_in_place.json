{
  "case_id": "val-repoint-target-in-place",
  "split": "validation",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "initial-config",
      "prompt": "I want you to be able to delegate work to another conversation running your same role and settings. Make that available under the name helper; reuse your existing role. Set this up without sending a message yet.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ],
            "forbidden": [
              "bash"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "targets",
            "min": 1,
            "max": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "agents": {
              "agents": "agents",
              "contexts": "contexts",
              "tools": "tools",
              "expect": [
                {
                  "agent_id": "engineer",
                  "delegates": {
                    "targets": "targets",
                    "agents": [
                      "engineer"
                    ]
                  }
                }
              ]
            }
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_id",
            "display_name",
            "context_id",
            "enabled",
            "inference_profile_id"
          ]
        },
        {
          "kind": "documents",
          "name": "contexts",
          "collection": "AgentContext",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "context_id",
            "tools_id",
            "system_prompt"
          ]
        },
        {
          "kind": "documents",
          "name": "tools",
          "collection": "Tools",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "tools_id",
            "host",
            "datastore",
            "agents",
            "self_config"
          ]
        },
        {
          "kind": "documents",
          "name": "targets",
          "collection": "AgentTarget",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "target_id",
            "node_did",
            "name",
            "target_node_did",
            "agent_id"
          ]
        }
      ]
    },
    {
      "stage_id": "repoint",
      "prompt": "Change helper to use a new Specialist assistant with its own instructions for focused research, using our current model. Update the existing helper connection; keep just one. Set this up without sending a message yet.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ],
            "forbidden": [
              "bash"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "targets",
            "min": 1,
            "max": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "agents": {
              "agents": "agents",
              "contexts": "contexts",
              "tools": "tools",
              "expect": [
                {
                  "agent_id": "engineer",
                  "delegates": {
                    "targets": "targets",
                    "agents": [
                      "specialist"
                    ]
                  }
                },
                {
                  "agent_id": "specialist",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)\\bspecialist\\b"
                  }
                }
              ]
            }
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_id",
            "display_name",
            "context_id",
            "enabled",
            "inference_profile_id"
          ]
        },
        {
          "kind": "documents",
          "name": "contexts",
          "collection": "AgentContext",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "context_id",
            "tools_id",
            "system_prompt"
          ]
        },
        {
          "kind": "documents",
          "name": "tools",
          "collection": "Tools",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "tools_id",
            "host",
            "datastore",
            "agents",
            "self_config"
          ]
        },
        {
          "kind": "documents",
          "name": "targets",
          "collection": "AgentTarget",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "target_id",
            "node_did",
            "name",
            "target_node_did",
            "agent_id"
          ]
        }
      ]
    },
    {
      "stage_id": "delegate-after-repoint",
      "prompt": "Ask Specialist to reply with exactly REP-555 and report its reply when it arrives.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "agent_new"
            ],
            "forbidden": [
              "bash"
            ],
            "config_read_only": true
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "repointed-session",
            "min": 1
          },
          "tier": "acceptance",
          "weight": 2
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "repointed-request",
            "expect": [
              {
                "field": "content",
                "contains": "REP-555"
              },
              {
                "field": "lifecycle_state",
                "equals": "completed"
              },
              {
                "field": "terminal_output",
                "contains": "message_doc_id"
              }
            ],
            "max_rows": 1
          },
          "tier": "acceptance",
          "weight": 2
        },
        {
          "check": "crew_spec_match",
          "params": {
            "links": [
              {
                "capture": "repointed-request",
                "field": "caused_by_parent_tool_call_doc_id",
                "target_capture": "delegation_calls",
                "target_key": "_docID",
                "expect": [
                  {
                    "field": "lifecycle_state",
                    "equals": "completed"
                  },
                  {
                    "field": "completion_notification_delivered_at",
                    "matches": "^[0-9]{4}-"
                  }
                ],
                "source_match": {
                  "field": "content",
                  "contains": "REP-555"
                }
              },
              {
                "capture": "repointed-request",
                "source_match": {
                  "field": "content",
                  "contains": "REP-555"
                },
                "field": "agent_id",
                "target_capture": "role_agents",
                "target_key": "agent_id",
                "expect": [
                  {
                    "field": "display_name",
                    "matches": "(?i)\\bspecialist\\b"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 2
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              "REP-555"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "repointed-session",
          "collection": "AgentSession",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_id": {
              "_ne": "engineer"
            }
          },
          "fields": [
            "session_id",
            "agent_id",
            "node_did"
          ]
        },
        {
          "kind": "documents",
          "name": "repointed-request",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_id": {
              "_ne": "engineer"
            },
            "purpose": {
              "_eq": "normal"
            }
          },
          "fields": [
            "request_id",
            "agent_id",
            "session_id",
            "content",
            "lifecycle_state",
            "terminal_output",
            "caused_by_parent_tool_call_doc_id"
          ]
        },
        {
          "kind": "documents",
          "name": "delegation_calls",
          "collection": "AgentToolCall",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "tool_name": {
              "_in": [
                "agent_new",
                "agent_message"
              ]
            }
          },
          "fields": [
            "_docID",
            "lifecycle_state",
            "completion_notification_delivered_at"
          ]
        },
        {
          "kind": "documents",
          "name": "role_agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_id",
            "display_name"
          ]
        }
      ],
      "settle": true
    }
  ]
}
