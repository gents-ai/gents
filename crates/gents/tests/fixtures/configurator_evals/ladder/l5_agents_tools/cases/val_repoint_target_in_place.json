{
  "case_id": "val-repoint-target-in-place",
  "split": "validation",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "initial-config",
      "prompt": "Create an assistant called Drafter for rough first drafts. Set it up so you can hand work to it under the name helper. Do not message it yet.",
      "capture": [
        {
          "kind": "documents",
          "name": "agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_did",
            "display_name",
            "context_id",
            "enabled",
            "inference_profile_id",
            "tags"
          ]
        },
        {
          "kind": "documents",
          "name": "contexts",
          "collection": "AgentContext",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "context_id",
            "system_prompt",
            "tools_id"
          ]
        },
        {
          "kind": "documents",
          "name": "tools",
          "collection": "Tools",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "tools_id",
            "host",
            "datastore",
            "self_config",
            "agents",
            "remote",
            "built_ins",
            "integrations"
          ]
        },
        {
          "kind": "documents",
          "name": "helper_targets",
          "collection": "AgentTarget",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^drafter$"
                  },
                  "field": "agent_did"
                }
              }
            }
          },
          "fields": [
            "target_id",
            "node_did",
            "name",
            "target_node_did",
            "agent_did"
          ]
        },
        {
          "kind": "documents",
          "name": "helper_sessions",
          "collection": "AgentSession",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^drafter$"
                  },
                  "field": "agent_did"
                }
              }
            }
          },
          "fields": [
            "session_id",
            "agent_did",
            "title",
            "stopped_at"
          ]
        },
        {
          "kind": "documents",
          "name": "named_helper",
          "collection": "AgentTarget",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "_or": [
              {
                "name": {
                  "_eq": "helper"
                }
              },
              {
                "target_id": {
                  "_eq": "helper"
                }
              }
            ]
          },
          "fields": [
            "target_id",
            "node_did",
            "name",
            "target_node_did",
            "agent_did"
          ]
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "agents": {
              "agents": "agents",
              "contexts": "contexts",
              "tools": "tools",
              "expect": [
                {
                  "agent_did": "drafter",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^drafter$"
                  },
                  "agent": [
                    {
                      "field": "enabled",
                      "equals": true
                    }
                  ]
                }
              ]
            },
            "present": [
              {
                "capture": "helper_targets",
                "min": 1
              },
              {
                "capture": "helper_sessions",
                "max": 0
              },
              {
                "capture": "named_helper",
                "min": 1,
                "max": 1
              }
            ],
            "links": [
              {
                "capture": "named_helper",
                "source_match": {
                  "field": "agent_did",
                  "matches": ".+"
                },
                "field": "agent_did",
                "target_capture": "agents",
                "target_key": "agent_did",
                "exact": true,
                "expect": [
                  {
                    "field": "display_name",
                    "matches": "(?i)^drafter$"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "repoint",
      "prompt": "Change of plan: helper should be a new Specialist assistant for focused research instead. Update the existing helper connection and keep just the one. Do not message it yet.",
      "capture": [
        {
          "kind": "documents",
          "name": "agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_did",
            "display_name",
            "context_id",
            "enabled",
            "inference_profile_id",
            "tags"
          ]
        },
        {
          "kind": "documents",
          "name": "contexts",
          "collection": "AgentContext",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "context_id",
            "system_prompt",
            "tools_id"
          ]
        },
        {
          "kind": "documents",
          "name": "tools",
          "collection": "Tools",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "tools_id",
            "host",
            "datastore",
            "self_config",
            "agents",
            "remote",
            "built_ins",
            "integrations"
          ]
        },
        {
          "kind": "documents",
          "name": "helper_targets",
          "collection": "AgentTarget",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)\\bspecialist\\b"
                  },
                  "field": "agent_did"
                }
              }
            }
          },
          "fields": [
            "target_id",
            "node_did",
            "name",
            "target_node_did",
            "agent_did"
          ]
        },
        {
          "kind": "documents",
          "name": "helper_sessions",
          "collection": "AgentSession",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)\\bspecialist\\b"
                  },
                  "field": "agent_did"
                }
              }
            }
          },
          "fields": [
            "session_id",
            "agent_did",
            "title",
            "stopped_at"
          ]
        },
        {
          "kind": "documents",
          "name": "named_helper",
          "collection": "AgentTarget",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "_or": [
              {
                "name": {
                  "_eq": "helper"
                }
              },
              {
                "target_id": {
                  "_eq": "helper"
                }
              }
            ]
          },
          "fields": [
            "target_id",
            "node_did",
            "name",
            "target_node_did",
            "agent_did"
          ]
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "agents": {
              "agents": "agents",
              "contexts": "contexts",
              "tools": "tools",
              "expect": [
                {
                  "agent_did": "specialist",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)\\bspecialist\\b"
                  },
                  "agent": [
                    {
                      "field": "enabled",
                      "equals": true
                    }
                  ]
                }
              ]
            },
            "present": [
              {
                "capture": "helper_targets",
                "min": 1
              },
              {
                "capture": "helper_sessions",
                "max": 0
              },
              {
                "capture": "named_helper",
                "min": 1,
                "max": 1
              }
            ],
            "links": [
              {
                "capture": "named_helper",
                "source_match": {
                  "field": "agent_did",
                  "matches": ".+"
                },
                "field": "agent_did",
                "target_capture": "agents",
                "target_key": "agent_did",
                "exact": true,
                "expect": [
                  {
                    "field": "display_name",
                    "matches": "(?i)\\bspecialist\\b"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "delegate-after-repoint",
      "prompt": "Ask helper to reply with exactly REP-555 and tell me what it says.",
      "settle": true,
      "capture": [
        {
          "kind": "documents",
          "name": "role_agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_did",
            "display_name"
          ]
        },
        {
          "kind": "documents",
          "name": "helper-session",
          "collection": "AgentSession",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "role_agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)\\bspecialist\\b"
                  },
                  "field": "agent_did"
                }
              }
            }
          },
          "fields": [
            "session_id",
            "agent_did",
            "title",
            "stopped_at"
          ]
        },
        {
          "kind": "documents",
          "name": "helper-request",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "role_agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)\\bspecialist\\b"
                  },
                  "field": "agent_did"
                }
              }
            },
            "purpose": {
              "_eq": "normal"
            },
            "content": {
              "_like": "%REP-555%"
            },
            "lifecycle_state": {
              "_eq": "completed"
            }
          },
          "fields": [
            "request_id",
            "agent_did",
            "session_id",
            "content",
            "lifecycle_state",
            "terminal_output",
            "caused_by_parent_tool_call_doc_id",
            "caused_by_parent_request_id"
          ]
        },
        {
          "kind": "documents",
          "name": "delegation_calls",
          "collection": "AgentToolCall",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "tool_name": {
              "_in": [
                "agent_new",
                "agent_message"
              ]
            },
            "request_id": {
              "_eq": "$request"
            }
          },
          "fields": [
            "_docID",
            "tool_name",
            "lifecycle_state",
            "completion_notification_delivered_at"
          ]
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "links": [
              {
                "capture": "helper-request",
                "field": "caused_by_parent_tool_call_doc_id",
                "target_capture": "delegation_calls",
                "target_key": "_docID",
                "expect": [
                  {
                    "field": "lifecycle_state",
                    "equals": "completed"
                  },
                  {
                    "field": "completion_notification_delivered_at",
                    "matches": "^[0-9]{4}-"
                  }
                ],
                "source_match": {
                  "field": "content",
                  "contains": "REP-555"
                },
                "exact": true
              },
              {
                "capture": "helper-request",
                "source_match": {
                  "field": "content",
                  "contains": "REP-555"
                },
                "field": "agent_did",
                "target_capture": "role_agents",
                "target_key": "agent_did",
                "expect": [
                  {
                    "field": "display_name",
                    "matches": "(?i)\\bspecialist\\b"
                  }
                ],
                "exact": true
              },
              {
                "capture": "helper-request",
                "source_match": {
                  "field": "content",
                  "contains": "REP-555"
                },
                "field": "session_id",
                "target_capture": "helper-session",
                "target_key": "session_id",
                "exact": true
              }
            ],
            "present": [
              {
                "capture": "helper-session",
                "min": 1
              },
              {
                "capture": "helper-request",
                "min": 1,
                "max": 1
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              "REP-555"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}