{
  "case_id": "val-caller-agent-and-delegate",
  "split": "validation",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "helper-and-target",
      "prompt": "Create an assistant called Checking Helper for delegated checks, and set it up so you can hand work to it. Do not message it yet.",
      "capture": [
        {
          "kind": "documents",
          "name": "agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_did",
            "display_name",
            "context_id",
            "enabled",
            "inference_profile_id",
            "tags"
          ]
        },
        {
          "kind": "documents",
          "name": "contexts",
          "collection": "AgentContext",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "context_id",
            "system_prompt",
            "tools_id"
          ]
        },
        {
          "kind": "documents",
          "name": "tools",
          "collection": "Tools",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "tools_id",
            "host",
            "datastore",
            "self_config",
            "agents",
            "remote",
            "built_ins",
            "integrations"
          ]
        },
        {
          "kind": "documents",
          "name": "helper_targets",
          "collection": "AgentTarget",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^checking[ -]helper$"
                  },
                  "field": "agent_did"
                }
              }
            }
          }
        },
        {
          "kind": "documents",
          "name": "helper_sessions",
          "collection": "AgentSession",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^checking[ -]helper$"
                  },
                  "field": "agent_did"
                }
              }
            }
          }
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "agents": {
              "agents": "agents",
              "contexts": "contexts",
              "tools": "tools",
              "expect": [
                {
                  "agent_did": "checking-helper",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^checking[ -]helper$"
                  },
                  "agent": [
                    {
                      "field": "enabled",
                      "equals": true
                    }
                  ]
                }
              ]
            },
            "present": [
              {
                "capture": "helper_targets",
                "min": 1
              },
              {
                "capture": "helper_sessions",
                "max": 0
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "caller-selects-target",
      "prompt": "Create a Coordinator assistant for organizing checks that you can hand work to. It should be able to hand work to the same Checking Helper itself; reuse the existing connection. Do not message either yet.",
      "capture": [
        {
          "kind": "documents",
          "name": "agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_did",
            "display_name",
            "context_id",
            "enabled",
            "inference_profile_id",
            "tags"
          ]
        },
        {
          "kind": "documents",
          "name": "contexts",
          "collection": "AgentContext",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "context_id",
            "system_prompt",
            "tools_id"
          ]
        },
        {
          "kind": "documents",
          "name": "tools",
          "collection": "Tools",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "tools_id",
            "host",
            "datastore",
            "self_config",
            "agents",
            "remote",
            "built_ins",
            "integrations"
          ]
        },
        {
          "kind": "documents",
          "name": "helper_targets",
          "collection": "AgentTarget",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^coordinator$"
                  },
                  "field": "agent_did"
                }
              }
            }
          }
        },
        {
          "kind": "documents",
          "name": "helper_sessions",
          "collection": "AgentSession",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^coordinator$"
                  },
                  "field": "agent_did"
                }
              }
            }
          }
        },
        {
          "kind": "documents",
          "name": "targets",
          "collection": "AgentTarget",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          }
        },
        {
          "kind": "documents",
          "name": "checking_targets",
          "collection": "AgentTarget",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^checking[ -]helper$"
                  },
                  "field": "agent_did"
                }
              }
            }
          }
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "agents": {
              "agents": "agents",
              "contexts": "contexts",
              "tools": "tools",
              "expect": [
                {
                  "agent_did": "coordinator",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^coordinator$"
                  },
                  "agent": [
                    {
                      "field": "enabled",
                      "equals": true
                    }
                  ],
                  "delegates": {
                    "targets": "targets",
                    "agents": [
                      "checking-helper"
                    ]
                  }
                },
                {
                  "agent_did": "checking-helper",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^checking[ -]helper$"
                  },
                  "agent": [
                    {
                      "field": "enabled",
                      "equals": true
                    }
                  ]
                }
              ]
            },
            "present": [
              {
                "capture": "helper_targets",
                "min": 1
              },
              {
                "capture": "helper_sessions",
                "max": 0
              },
              {
                "capture": "checking_targets",
                "min": 1,
                "max": 1
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "delegate",
      "prompt": "Ask Coordinator to get the reply PONG-7391 from Checking Helper and pass it back to you. Tell me what came back.",
      "settle": true,
      "capture": [
        {
          "kind": "documents",
          "name": "role_agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_did",
            "display_name"
          ]
        },
        {
          "kind": "documents",
          "name": "helper-session",
          "collection": "AgentSession",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "role_agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^checking[ -]helper$"
                  },
                  "field": "agent_did"
                }
              }
            }
          }
        },
        {
          "kind": "documents",
          "name": "helper-request",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "role_agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^checking[ -]helper$"
                  },
                  "field": "agent_did"
                }
              }
            },
            "purpose": {
              "_eq": "normal"
            },
            "content": {
              "_like": "%PONG-7391%"
            },
            "lifecycle_state": {
              "_eq": "completed"
            }
          }
        },
        {
          "kind": "documents",
          "name": "coordinator_requests",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "role_agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^coordinator$"
                  },
                  "field": "agent_did"
                }
              }
            },
            "purpose": {
              "_eq": "normal"
            }
          }
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "links": [
              {
                "capture": "helper-request",
                "source_match": {
                  "field": "content",
                  "contains": "PONG-7391"
                },
                "field": "caused_by_parent_request_id",
                "target_capture": "coordinator_requests",
                "target_key": "request_id",
                "exact": true,
                "expect": [
                  {
                    "field": "lifecycle_state",
                    "equals": "completed"
                  }
                ]
              },
              {
                "capture": "helper-request",
                "source_match": {
                  "field": "content",
                  "contains": "PONG-7391"
                },
                "field": "session_id",
                "target_capture": "helper-session",
                "target_key": "session_id",
                "exact": true
              }
            ],
            "present": [
              {
                "capture": "helper-session",
                "min": 1
              },
              {
                "capture": "helper-request",
                "min": 1,
                "max": 1
              },
              {
                "capture": "coordinator_requests",
                "min": 1
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              "PONG-7391"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}