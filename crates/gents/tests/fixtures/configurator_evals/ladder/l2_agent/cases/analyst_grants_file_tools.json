{
  "case_id": "analyst-grants-file-tools",
  "split": "validation",
  "reducer": "all",
  "fixtures": {
    "files": [
      {
        "path": "research/tidal-notes.md",
        "contents": "# Tidal notes\n\nSource: Ferrow Quay harbour survey, 2019.\n\n- Spring tide range at Ferrow Quay: 4.7 m.\n- Neap tide range at Ferrow Quay: 1.9 m.\n"
      },
      {
        "path": "research/silt-notes.md",
        "contents": "# Silt notes\n\nSource: Dredging log, 2021.\n\n- Channel depth after dredging: 6.2 m.\n"
      }
    ]
  },
  "stages": [
    {
      "stage_id": "configure",
      "prompt": "Create an assistant called Analyst that reads my local research notes and summarizes them, citing their sources. It must not change files or run commands. Set it up so you can hand work to it.",
      "capture": [
        {
          "kind": "documents",
          "name": "agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_did",
            "display_name",
            "context_id",
            "enabled",
            "inference_profile_id",
            "tags"
          ]
        },
        {
          "kind": "documents",
          "name": "contexts",
          "collection": "AgentContext",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "context_id",
            "system_prompt",
            "tools_id"
          ]
        },
        {
          "kind": "documents",
          "name": "tools",
          "collection": "Tools",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "tools_id",
            "host",
            "datastore",
            "self_config",
            "agents",
            "remote",
            "built_ins",
            "integrations"
          ]
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "agents": {
              "agents": "agents",
              "contexts": "contexts",
              "tools": "tools",
              "expect": [
                {
                  "agent_did": "analyst",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^analyst$"
                  },
                  "agent": [
                    {
                      "field": "display_name",
                      "matches": "(?i)^analyst$"
                    },
                    {
                      "field": "enabled",
                      "equals": true
                    }
                  ],
                  "context": [
                    {
                      "field": "system_prompt",
                      "matches": "(?i)(research|analys|notes)"
                    }
                  ],
                  "tools": [
                    {
                      "field": "host.files.mode",
                      "equals": "ReadOnly"
                    },
                    {
                      "field": "host.bash.mode",
                      "matches": "^(Off|null)$"
                    },
                    {
                      "field": "self_config.enable_self_config",
                      "matches": "^(null|false)$"
                    }
                  ]
                }
              ]
            }
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "exercise",
      "prompt": "Ask Analyst what my notes under research/ give as the spring tide range at Ferrow Quay, and which source that comes from. Tell me its answer.",
      "settle": true,
      "capture": [
        {
          "kind": "documents",
          "name": "role_agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_did",
            "display_name"
          ]
        },
        {
          "kind": "documents",
          "name": "helper_requests",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "role_agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^analyst$"
                  },
                  "field": "agent_did"
                }
              }
            },
            "purpose": {
              "_eq": "normal"
            },
            "lifecycle_state": {
              "_eq": "completed"
            }
          },
          "fields": [
            "request_id",
            "agent_did",
            "lifecycle_state",
            "content"
          ]
        },
        {
          "kind": "file",
          "name": "workspace",
          "glob": "**/*"
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "helper_requests",
                "min": 1
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              {
                "matches": "4\\.7"
              },
              {
                "matches": "(?i)(survey|2019)"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_files_match",
          "params": {
            "name": "workspace",
            "expect": [
              {
                "path": "research/tidal-notes.md",
                "sha256": "3c8c1a8f8f625fe72c2f0ee751634a55774a098ad39e19c801bf0a86a79ae7fe"
              },
              {
                "path": "research/silt-notes.md",
                "sha256": "927f0b81d980a8f661592a2a3c469450d50beb8fb65d18aa82b3596e4c2b19f2"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}