{
  "case_id": "ledger-prompt-edit-in-place",
  "split": "held_out",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "configure",
      "prompt": "Create an assistant named Ledger for checking records. Give it its own instructions and tool permissions, appropriate for its role: read and summarize local records. It must not modify files or run shell commands. Use our existing model settings. Keep your own role and permissions unchanged.",
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "agents": {
              "agents": "agents",
              "contexts": "contexts",
              "tools": "tools",
              "expect": [
                {
                  "agent_did": "ledger",
                  "agent": [
                    {
                      "field": "display_name",
                      "matches": "(?i)^ledger$"
                    },
                    {
                      "field": "enabled",
                      "equals": true
                    }
                  ],
                  "context": [
                    {
                      "field": "system_prompt",
                      "matches": "(?i)(record|ledger)"
                    }
                  ],
                  "tools": [
                    {
                      "field": "host.files.mode",
                      "equals": "ReadOnly"
                    },
                    {
                      "field": "host.bash.mode",
                      "matches": "^(Off|null)$"
                    },
                    {
                      "field": "self_config.enable_self_config",
                      "matches": "^(null|false)$"
                    },
                    {
                      "field": "agents.enabled",
                      "matches": "^(null|false)$"
                    },
                    {
                      "field": "datastore.enable_defra_query",
                      "matches": "^(null|false)$"
                    },
                    {
                      "field": "datastore.datastore_tool_surface_ids",
                      "matches": "^(null|\\[\\])$"
                    }
                  ],
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^ledger$"
                  }
                }
              ]
            }
          },
          "tier": "acceptance",
          "weight": 5
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "agents",
            "min": 2,
            "max": 2
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_did",
            "display_name",
            "context_id",
            "enabled",
            "inference_profile_id",
            "tags"
          ]
        },
        {
          "kind": "documents",
          "name": "contexts",
          "collection": "AgentContext",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "context_id",
            "system_prompt",
            "tools_id"
          ]
        },
        {
          "kind": "documents",
          "name": "tools",
          "collection": "Tools",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "tools_id",
            "host",
            "datastore",
            "self_config",
            "agents",
            "remote",
            "built_ins",
            "integrations"
          ]
        }
      ]
    },
    {
      "stage_id": "edit_prompt",
      "prompt": "One change for Ledger: require it to cite the file path for every finding. Update its existing instructions and keep the same permissions.",
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "agents": {
              "agents": "agents",
              "contexts": "contexts",
              "tools": "tools",
              "expect": [
                {
                  "agent_did": "ledger",
                  "agent": [
                    {
                      "field": "display_name",
                      "matches": "(?i)^ledger$"
                    },
                    {
                      "field": "enabled",
                      "equals": true
                    }
                  ],
                  "context": [
                    {
                      "field": "system_prompt",
                      "matches": "(?i)(record|ledger)"
                    },
                    {
                      "field": "system_prompt",
                      "matches": "(?i)(file.?path|cite|citation)"
                    }
                  ],
                  "tools": [
                    {
                      "field": "host.files.mode",
                      "equals": "ReadOnly"
                    },
                    {
                      "field": "host.bash.mode",
                      "matches": "^(Off|null)$"
                    },
                    {
                      "field": "self_config.enable_self_config",
                      "matches": "^(null|false)$"
                    },
                    {
                      "field": "agents.enabled",
                      "matches": "^(null|false)$"
                    },
                    {
                      "field": "datastore.enable_defra_query",
                      "matches": "^(null|false)$"
                    },
                    {
                      "field": "datastore.datastore_tool_surface_ids",
                      "matches": "^(null|\\[\\])$"
                    }
                  ],
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^ledger$"
                  }
                }
              ]
            }
          },
          "tier": "acceptance",
          "weight": 5
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "agents",
            "min": 2,
            "max": 2
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_did",
            "display_name",
            "context_id",
            "enabled",
            "inference_profile_id",
            "tags"
          ]
        },
        {
          "kind": "documents",
          "name": "contexts",
          "collection": "AgentContext",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "context_id",
            "system_prompt",
            "tools_id"
          ]
        },
        {
          "kind": "documents",
          "name": "tools",
          "collection": "Tools",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "tools_id",
            "host",
            "datastore",
            "self_config",
            "agents",
            "remote",
            "built_ins",
            "integrations"
          ]
        }
      ]
    }
  ]
}
