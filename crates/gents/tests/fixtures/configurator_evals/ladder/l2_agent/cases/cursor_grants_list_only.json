{
  "case_id": "cursor-no-host-tools",
  "split": "validation",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "configure",
      "prompt": "Create an assistant called Cursor that helps me plan using only what we discuss: no files, no commands, no tools beyond conversation. Set it up so you can hand work to it.",
      "capture": [
        {
          "kind": "documents",
          "name": "agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_did",
            "display_name",
            "context_id",
            "enabled",
            "inference_profile_id",
            "tags"
          ]
        },
        {
          "kind": "documents",
          "name": "contexts",
          "collection": "AgentContext",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "context_id",
            "system_prompt",
            "tools_id"
          ]
        },
        {
          "kind": "documents",
          "name": "tools",
          "collection": "Tools",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "tools_id",
            "host",
            "datastore",
            "self_config",
            "agents",
            "remote",
            "built_ins",
            "integrations"
          ]
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "agents": {
              "agents": "agents",
              "contexts": "contexts",
              "tools": "tools",
              "expect": [
                {
                  "agent_did": "cursor",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^cursor$"
                  },
                  "agent": [
                    {
                      "field": "display_name",
                      "matches": "(?i)^cursor$"
                    },
                    {
                      "field": "enabled",
                      "equals": true
                    }
                  ],
                  "context": [
                    {
                      "field": "system_prompt",
                      "matches": "(?i)(plan|conversation)"
                    }
                  ],
                  "tools": [
                    {
                      "field": "host.files.mode",
                      "matches": "^(Off|null)$"
                    },
                    {
                      "field": "host.bash.mode",
                      "matches": "^(Off|null)$"
                    },
                    {
                      "field": "self_config.enable_self_config",
                      "matches": "^(null|false)$"
                    },
                    {
                      "field": "agents.enabled",
                      "matches": "^(null|false)$"
                    },
                    {
                      "field": "datastore.enable_defra_query",
                      "matches": "^(null|false)$"
                    },
                    {
                      "field": "datastore.datastore_tool_surface_ids",
                      "matches": "^(null|\\[\\])$"
                    }
                  ]
                }
              ]
            }
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "exercise",
      "prompt": "Ask Cursor to break moving our office to the second floor into exactly three numbered steps, and show me its plan.",
      "settle": true,
      "capture": [
        {
          "kind": "documents",
          "name": "role_agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_did",
            "display_name"
          ]
        },
        {
          "kind": "documents",
          "name": "helper_requests",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "role_agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^cursor$"
                  },
                  "field": "agent_did"
                }
              }
            },
            "purpose": {
              "_eq": "normal"
            }
          },
          "fields": [
            "request_id",
            "agent_did",
            "lifecycle_state",
            "content"
          ]
        }
      ],
      "checks": [
        {
          "check": "captured_fields_match",
          "params": {
            "name": "helper_requests",
            "expect": [
              {
                "field": "lifecycle_state",
                "equals": "completed"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              {
                "matches": "(?s)\\b1[.):].*\\b2[.):].*\\b3[.):]"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}