{
  "case_id": "archivist-full-files-no-bash",
  "split": "validation",
  "reducer": "all",
  "fixtures": {
    "files": [
      {
        "path": "archive/1998-leases.txt",
        "contents": "Leases 1998\nHolloway yard lease signed March 1998, term 20 years.\n"
      },
      {
        "path": "archive/2004-leases.txt",
        "contents": "Leases 2004\nMarlow wharf lease signed June 2004; it ended in 2016.\n"
      },
      {
        "path": "archive/2011-permits.txt",
        "contents": "Permits 2011\nCrane permit C-88 renewed for the east berth.\n"
      }
    ]
  },
  "stages": [
    {
      "stage_id": "configure",
      "prompt": "Create an assistant called Archivist that searches and summarizes our local archive. It must not change files or run commands. Set it up so you can hand work to it.",
      "capture": [
        {
          "kind": "documents",
          "name": "agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_did",
            "display_name",
            "context_id",
            "enabled",
            "inference_profile_id",
            "tags"
          ]
        },
        {
          "kind": "documents",
          "name": "contexts",
          "collection": "AgentContext",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "context_id",
            "system_prompt",
            "tools_id"
          ]
        },
        {
          "kind": "documents",
          "name": "tools",
          "collection": "Tools",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "tools_id",
            "host",
            "datastore",
            "self_config",
            "agents",
            "remote",
            "built_ins",
            "integrations"
          ]
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "agents": {
              "agents": "agents",
              "contexts": "contexts",
              "tools": "tools",
              "expect": [
                {
                  "agent_did": "archivist",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^archivist$"
                  },
                  "agent": [
                    {
                      "field": "display_name",
                      "matches": "(?i)^archivist$"
                    },
                    {
                      "field": "enabled",
                      "equals": true
                    }
                  ],
                  "context": [
                    {
                      "field": "system_prompt",
                      "matches": "(?i)(archiv|records)"
                    }
                  ],
                  "tools": [
                    {
                      "field": "host.files.mode",
                      "equals": "ReadOnly"
                    },
                    {
                      "field": "host.bash.mode",
                      "matches": "^(Off|null)$"
                    },
                    {
                      "field": "self_config.enable_self_config",
                      "matches": "^(null|false)$"
                    }
                  ]
                }
              ]
            }
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "exercise",
      "prompt": "Ask Archivist which file under archive/ mentions the Marlow lease and what year that lease ended. Tell me its answer.",
      "settle": true,
      "capture": [
        {
          "kind": "documents",
          "name": "role_agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_did",
            "display_name"
          ]
        },
        {
          "kind": "documents",
          "name": "helper_requests",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "role_agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^archivist$"
                  },
                  "field": "agent_did"
                }
              }
            },
            "purpose": {
              "_eq": "normal"
            },
            "lifecycle_state": {
              "_eq": "completed"
            }
          },
          "fields": [
            "request_id",
            "agent_did",
            "lifecycle_state",
            "content"
          ]
        },
        {
          "kind": "file",
          "name": "workspace",
          "glob": "**/*"
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "helper_requests",
                "min": 1
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              {
                "matches": "2004-leases"
              },
              {
                "matches": "\\b2016\\b"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_files_match",
          "params": {
            "name": "workspace",
            "expect": [
              {
                "path": "archive/1998-leases.txt",
                "sha256": "3d0ad0bdd8c3cff2546bc76f9e3601f4dff1835f0282374dbc9b28518f7a1bcb"
              },
              {
                "path": "archive/2004-leases.txt",
                "sha256": "a245cd50f5d75274163d73e33b00fc8c7685d93db558a9bef94868178837d60b"
              },
              {
                "path": "archive/2011-permits.txt",
                "sha256": "e45a95a31870b8d0f3f44ea1ca0640cf635c6111c887c7739ce5e24df745ba63"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}