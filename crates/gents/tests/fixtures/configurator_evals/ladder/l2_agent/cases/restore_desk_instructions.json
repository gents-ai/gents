{
  "case_id": "restore-desk-instructions",
  "split": "train",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "repair",
      "prompt": "The Returns desk template desk-live has outdated instructions. Replace them with the exact text from the approved template desk-approved, and change nothing else on either.",
      "capture": [
        {
          "kind": "documents",
          "name": "desks",
          "collection": "AgentContext",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "display_name": {
              "_eq": "Returns desk"
            }
          },
          "fields": [
            "context_id",
            "display_name",
            "description",
            "system_prompt",
            "tools_id"
          ]
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "desks",
                "min": 2,
                "max": 2
              }
            ],
            "rows": [
              {
                "capture": "desks",
                "key": "context_id",
                "id": "desk-live",
                "expect": [
                  {
                    "field": "display_name",
                    "equals": "Returns desk"
                  },
                  {
                    "field": "description",
                    "equals": "Production template"
                  },
                  {
                    "field": "system_prompt",
                    "equals": "Route return labels to pier seven. Keep the carton code."
                  }
                ]
              },
              {
                "capture": "desks",
                "key": "context_id",
                "id": "desk-approved",
                "expect": [
                  {
                    "field": "display_name",
                    "equals": "Returns desk"
                  },
                  {
                    "field": "description",
                    "equals": "Signed-off template"
                  },
                  {
                    "field": "system_prompt",
                    "equals": "Route return labels to pier seven. Keep the carton code."
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "staff",
      "prompt": "Now create an assistant called Returns Desk on the desk-live template, ask it which pier return labels go to, and tell me what it says.",
      "settle": true,
      "capture": [
        {
          "kind": "documents",
          "name": "role_agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_did",
            "display_name"
          ]
        },
        {
          "kind": "documents",
          "name": "helper_requests",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "role_agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^returns[ -]desk$"
                  },
                  "field": "agent_did"
                }
              }
            },
            "purpose": {
              "_eq": "normal"
            },
            "lifecycle_state": {
              "_eq": "completed"
            }
          },
          "fields": [
            "request_id",
            "agent_did",
            "lifecycle_state",
            "content"
          ]
        },
        {
          "kind": "documents",
          "name": "agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_did",
            "display_name",
            "context_id",
            "enabled",
            "inference_profile_id",
            "tags"
          ]
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "helper_requests",
                "min": 1
              }
            ],
            "links": [
              {
                "capture": "agents",
                "source_match": {
                  "field": "display_name",
                  "matches": "(?i)^returns[ -]desk$"
                },
                "field": "context_id",
                "target_capture": "agents",
                "target_key": "context_id",
                "exact": true,
                "expect": [
                  {
                    "field": "context_id",
                    "matches": "desk-live$"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              {
                "matches": "(?i)pier (seven|7)"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}