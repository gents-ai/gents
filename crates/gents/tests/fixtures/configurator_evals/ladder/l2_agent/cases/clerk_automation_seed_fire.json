{
  "case_id": "clerk-automation-seed-fire",
  "split": "validation",
  "reducer": "all",
  "fixtures": {
    "schemas": [
      "type RestockNote { sku: String handoff_id: String }"
    ],
    "documents": []
  },
  "stages": [
    {
      "stage_id": "configure",
      "prompt": "Create an assistant named Clerk for restock notes. Give it its own instructions and tool permissions, appropriate for its role: acknowledge incoming restock notes by SKU. It must not modify files or run shell commands. Use our existing model settings. Keep your own role and permissions unchanged. Let it read files but do not grant other capabilities. Our RestockNote records carry sku and handoff_id; handoff_id identifies each note through its processing. When a new note arrives, have Clerk acknowledge its sku. Keep the app’s standard run record so I can see whether each run succeeded or failed. Do not submit a restock note yet.",
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "agents": {
              "agents": "agents",
              "contexts": "contexts",
              "tools": "tools",
              "expect": [
                {
                  "agent_did": "clerk",
                  "agent": [
                    {
                      "field": "display_name",
                      "matches": "(?i)^clerk$"
                    },
                    {
                      "field": "enabled",
                      "equals": true
                    }
                  ],
                  "context": [
                    {
                      "field": "system_prompt",
                      "matches": "(?i)(restock|sku)"
                    }
                  ],
                  "tools": [
                    {
                      "field": "host.files.mode",
                      "equals": "ReadOnly"
                    },
                    {
                      "field": "host.bash.mode",
                      "matches": "^(Off|null)$"
                    },
                    {
                      "field": "self_config.enable_self_config",
                      "matches": "^(null|false)$"
                    },
                    {
                      "field": "agents.enabled",
                      "matches": "^(null|false)$"
                    },
                    {
                      "field": "datastore.enable_defra_query",
                      "matches": "^(null|false)$"
                    },
                    {
                      "field": "datastore.datastore_tool_surface_ids",
                      "matches": "^(null|\\[\\])$"
                    }
                  ],
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^clerk$"
                  }
                }
              ]
            }
          },
          "tier": "acceptance",
          "weight": 5
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "agents",
            "min": 2,
            "max": 2
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_did",
            "display_name",
            "context_id",
            "enabled",
            "inference_profile_id",
            "tags"
          ]
        },
        {
          "kind": "documents",
          "name": "contexts",
          "collection": "AgentContext",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "context_id",
            "system_prompt",
            "tools_id"
          ]
        },
        {
          "kind": "documents",
          "name": "tools",
          "collection": "Tools",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "tools_id",
            "host",
            "datastore",
            "self_config",
            "agents",
            "remote",
            "built_ins",
            "integrations"
          ]
        }
      ]
    },
    {
      "stage_id": "seed_restock_note",
      "seed": {
        "collection": "RestockNote",
        "document": {
          "sku": "A-100",
          "handoff_id": "clerk-restock-A-100"
        }
      },
      "checks": [
        {
          "check": "captured_fields_match",
          "params": {
            "name": "clerk_requests",
            "min_rows": 1,
            "max_rows": 1,
            "expect": [
              {
                "field": "lifecycle_state",
                "equals": "completed"
              },
              {
                "field": "caused_by_trigger_id",
                "matches": ".+"
              },
              {
                "field": "content",
                "contains": "A-100"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 3
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "clerk_outcomes",
            "min": 1,
            "max": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "links": [
              {
                "capture": "clerk_fires",
                "key": "source_collection",
                "id": "RestockNote",
                "field": "request_id",
                "target_capture": "clerk_requests",
                "target_key": "request_id",
                "expect": [
                  {
                    "field": "lifecycle_state",
                    "equals": "completed"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "role_agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_did",
            "display_name"
          ]
        },
        {
          "kind": "documents",
          "name": "clerk_fires",
          "collection": "TriggerFire",
          "filter": {
            "owner_did": {
              "_eq": "$trial"
            },
            "source_collection": {
              "_eq": "RestockNote"
            }
          },
          "fields": [
            "fire_key",
            "trigger_id",
            "source_collection",
            "request_id"
          ]
        },
        {
          "kind": "documents",
          "name": "clerk_trigger",
          "collection": "Trigger",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "trigger_id",
            "task_id",
            "enabled"
          ]
        },
        {
          "kind": "documents",
          "name": "clerk_requests",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "role_agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^clerk$"
                  },
                  "field": "agent_did"
                }
              }
            },
            "purpose": {
              "_eq": "normal"
            }
          },
          "fields": [
            "request_id",
            "agent_did",
            "caused_by_trigger_id",
            "caused_by_source_doc_id",
            "lifecycle_state",
            "content"
          ]
        },
        {
          "kind": "documents",
          "name": "clerk_outcomes",
          "collection": "FireOutcome",
          "filter": {
            "owner_did": {
              "_eq": "$trial"
            },
            "source_collection": {
              "_eq": "RestockNote"
            }
          },
          "fields": [
            "fire_key",
            "trigger_id",
            "terminal_state",
            "reason",
            "source_collection"
          ]
        }
      ],
      "settle": true
    }
  ]
}
