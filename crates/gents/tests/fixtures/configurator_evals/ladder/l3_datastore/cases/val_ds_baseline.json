{
  "case_id": "val-ds-baseline",
  "split": "validation",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "configure",
      "prompt": "I need to keep workflow records: WorkflowInput with a correlation and a message, and WorkflowOutput with a correlation and a result. Set up storage for both so you can add outputs and look them up by correlation.",
      "capture": [
        {
          "kind": "schema",
          "name": "storage",
          "collections": [
            "WorkflowInput",
            "WorkflowOutput"
          ]
        }
      ],
      "checks": [
        {
          "check": "schema_matches",
          "params": {
            "name": "storage",
            "sdl": "type WorkflowInput {\n  correlation: String\n  message: String\n}\ntype WorkflowOutput {\n  correlation: String\n  result: String\n}"
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "exercise",
      "prompt": "Save an output with result ok for correlation val-alpha-002, then look it up and tell me what is stored.",
      "settle": true,
      "capture": [
        {
          "kind": "documents",
          "name": "outputs",
          "collection": "WorkflowOutput",
          "filter": {
            "correlation": {
              "_eq": "val-alpha-002"
            }
          }
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "outputs",
                "min": 1,
                "max": 1
              }
            ],
            "rows": [
              {
                "capture": "outputs",
                "key": "correlation",
                "id": "val-alpha-002",
                "expect": [
                  {
                    "field": "correlation",
                    "equals": "val-alpha-002"
                  },
                  {
                    "field": "result",
                    "equals": "ok"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              "val-alpha-002",
              {
                "matches": "(?i)\\bok\\b"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "continuation": {
        "prompt": "OK, go ahead.",
        "max": 1,
        "until": "outputs"
      }
    }
  ]
}