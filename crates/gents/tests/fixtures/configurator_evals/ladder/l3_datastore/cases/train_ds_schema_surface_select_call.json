{
  "case_id": "train-ds-schema-surface-select-call",
  "split": "train",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "configure",
      "prompt": "Keep workflow results as WorkflowOutput records with a correlation and a result. Create an assistant called Results Clerk that can add them and look one up by its correlation, with no other database access. I will hand it work through you.",
      "capture": [
        {
          "kind": "documents",
          "name": "agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_did",
            "display_name",
            "context_id",
            "enabled",
            "inference_profile_id",
            "tags"
          ]
        },
        {
          "kind": "documents",
          "name": "contexts",
          "collection": "AgentContext",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "context_id",
            "system_prompt",
            "tools_id"
          ]
        },
        {
          "kind": "documents",
          "name": "tools",
          "collection": "Tools",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "tools_id",
            "host",
            "datastore",
            "self_config",
            "agents",
            "remote",
            "built_ins",
            "integrations"
          ]
        },
        {
          "kind": "documents",
          "name": "surfaces",
          "collection": "DatastoreToolSurface",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          }
        },
        {
          "kind": "documents",
          "name": "helper_targets",
          "collection": "AgentTarget",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^results[ -]?clerk$"
                  },
                  "field": "agent_did"
                }
              }
            }
          }
        },
        {
          "kind": "schema",
          "name": "storage",
          "collections": [
            "WorkflowOutput"
          ]
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "agents": {
              "agents": "agents",
              "contexts": "contexts",
              "tools": "tools",
              "expect": [
                {
                  "agent_did": "results-clerk",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^results[ -]?clerk$"
                  },
                  "agent": [
                    {
                      "field": "enabled",
                      "equals": true
                    }
                  ],
                  "datastore": {
                    "surfaces": "surfaces",
                    "create": [
                      "WorkflowOutput"
                    ],
                    "query": [
                      "WorkflowOutput"
                    ],
                    "lookup_by": "correlation",
                    "caller_fields": {
                      "WorkflowOutput": [
                        "correlation",
                        "result"
                      ]
                    }
                  },
                  "tools": [
                    {
                      "field": "datastore.enable_defra_query",
                      "matches": "^(null|false)$"
                    }
                  ]
                }
              ]
            },
            "present": [
              {
                "capture": "helper_targets",
                "min": 1
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "schema_matches",
          "params": {
            "name": "storage",
            "sdl": "type WorkflowOutput {\n  correlation: String\n  result: String\n}"
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "exercise",
      "prompt": "Have Results Clerk save result ok for correlation train-alpha-001, then look it up by correlation, and tell me what it found.",
      "settle": true,
      "capture": [
        {
          "kind": "documents",
          "name": "role_agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_did",
            "display_name"
          ]
        },
        {
          "kind": "documents",
          "name": "helper_requests",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "role_agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^results[ -]?clerk$"
                  },
                  "field": "agent_did"
                }
              }
            },
            "purpose": {
              "_eq": "normal"
            }
          },
          "fields": [
            "request_id",
            "agent_did",
            "lifecycle_state",
            "content"
          ]
        },
        {
          "kind": "documents",
          "name": "outputs",
          "collection": "WorkflowOutput",
          "filter": {
            "correlation": {
              "_eq": "train-alpha-001"
            }
          }
        }
      ],
      "checks": [
        {
          "check": "captured_fields_match",
          "params": {
            "name": "helper_requests",
            "expect": [
              {
                "field": "lifecycle_state",
                "equals": "completed"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "outputs",
                "min": 1,
                "max": 1
              }
            ],
            "rows": [
              {
                "capture": "outputs",
                "key": "correlation",
                "id": "train-alpha-001",
                "expect": [
                  {
                    "field": "result",
                    "equals": "ok"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              "train-alpha-001",
              {
                "matches": "(?i)\\bok\\b"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}