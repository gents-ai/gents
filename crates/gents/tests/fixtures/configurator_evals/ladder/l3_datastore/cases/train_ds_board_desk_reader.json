{
  "case_id": "train-ds-board-desk-reader",
  "split": "train",
  "reducer": "all",
  "fixtures": {
    "schemas": [
      "type DispatchThread { ticket: String @index(unique: true) desk: String }"
    ],
    "documents": [
      {
        "collection": "DispatchThread",
        "document": {
          "ticket": "B-14",
          "desk": "receiving"
        }
      },
      {
        "collection": "DispatchThread",
        "document": {
          "ticket": "B-18",
          "desk": "receiving"
        }
      },
      {
        "collection": "DispatchThread",
        "document": {
          "ticket": "B-22",
          "desk": "receiving"
        }
      },
      {
        "collection": "DispatchThread",
        "document": {
          "ticket": "B-31",
          "desk": "dispatch"
        }
      },
      {
        "collection": "DispatchThread",
        "document": {
          "ticket": "B-37",
          "desk": "receiving"
        }
      }
    ]
  },
  "stages": [
    {
      "stage_id": "configure",
      "prompt": "Our bulletin board keeps DispatchThread records, each with a ticket and a desk. Create an assistant called Board Reader that can look up tickets by desk, read-only, with no other database access. I will hand it work through you.",
      "capture": [
        {
          "kind": "documents",
          "name": "agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_did",
            "display_name",
            "context_id",
            "enabled",
            "inference_profile_id",
            "tags"
          ]
        },
        {
          "kind": "documents",
          "name": "contexts",
          "collection": "AgentContext",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "context_id",
            "system_prompt",
            "tools_id"
          ]
        },
        {
          "kind": "documents",
          "name": "tools",
          "collection": "Tools",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "tools_id",
            "host",
            "datastore",
            "self_config",
            "agents",
            "remote",
            "built_ins",
            "integrations"
          ]
        },
        {
          "kind": "documents",
          "name": "surfaces",
          "collection": "DatastoreToolSurface",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "surface_id",
            "node_did",
            "display_name",
            "enabled",
            "entries"
          ]
        },
        {
          "kind": "documents",
          "name": "helper_targets",
          "collection": "AgentTarget",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^board[ -]?reader$"
                  },
                  "field": "agent_did"
                }
              }
            }
          },
          "fields": [
            "target_id",
            "node_did",
            "name",
            "target_node_did",
            "agent_did"
          ]
        },
        {
          "kind": "documents",
          "name": "DispatchThread",
          "collection": "DispatchThread",
          "filter": {},
          "fields": [
            "ticket",
            "desk"
          ]
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "agents": {
              "agents": "agents",
              "contexts": "contexts",
              "tools": "tools",
              "expect": [
                {
                  "agent_did": "board-reader",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^board[ -]?reader$"
                  },
                  "agent": [
                    {
                      "field": "enabled",
                      "equals": true
                    }
                  ],
                  "datastore": {
                    "surfaces": "surfaces",
                    "create": [],
                    "query": [
                      "DispatchThread"
                    ],
                    "lookup_by": "desk",
                    "query_fields": {
                      "DispatchThread": [
                        "ticket",
                        "desk"
                      ]
                    }
                  },
                  "tools": [
                    {
                      "field": "datastore.enable_defra_query",
                      "matches": "^(null|false)$"
                    }
                  ]
                }
              ]
            },
            "present": [
              {
                "capture": "helper_targets",
                "min": 1
              },
              {
                "capture": "DispatchThread",
                "min": 5,
                "max": 5
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "exercise",
      "prompt": "Ask Board Reader which tickets belong to the receiving desk, and tell me its answer.",
      "settle": true,
      "capture": [
        {
          "kind": "documents",
          "name": "role_agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_did",
            "display_name"
          ]
        },
        {
          "kind": "documents",
          "name": "helper_requests",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "role_agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^board[ -]?reader$"
                  },
                  "field": "agent_did"
                }
              }
            },
            "purpose": {
              "_eq": "normal"
            },
            "lifecycle_state": {
              "_eq": "completed"
            }
          },
          "fields": [
            "request_id",
            "agent_did",
            "lifecycle_state",
            "content"
          ]
        },
        {
          "kind": "documents",
          "name": "DispatchThread",
          "collection": "DispatchThread",
          "filter": {},
          "fields": [
            "ticket",
            "desk"
          ]
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "helper_requests",
                "min": 1
              },
              {
                "capture": "DispatchThread",
                "min": 5,
                "max": 5
              }
            ],
            "rows": [
              {
                "capture": "DispatchThread",
                "key": "ticket",
                "id": "B-14",
                "expect": [
                  {
                    "field": "desk",
                    "equals": "receiving"
                  }
                ]
              },
              {
                "capture": "DispatchThread",
                "key": "ticket",
                "id": "B-18",
                "expect": [
                  {
                    "field": "desk",
                    "equals": "receiving"
                  }
                ]
              },
              {
                "capture": "DispatchThread",
                "key": "ticket",
                "id": "B-22",
                "expect": [
                  {
                    "field": "desk",
                    "equals": "receiving"
                  }
                ]
              },
              {
                "capture": "DispatchThread",
                "key": "ticket",
                "id": "B-31",
                "expect": [
                  {
                    "field": "desk",
                    "equals": "dispatch"
                  }
                ]
              },
              {
                "capture": "DispatchThread",
                "key": "ticket",
                "id": "B-37",
                "expect": [
                  {
                    "field": "desk",
                    "equals": "receiving"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              "B-14",
              "B-18",
              "B-22",
              "B-37"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}