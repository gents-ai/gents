{
  "case_id": "val-ds-automation-seed-to-output",
  "split": "validation",
  "reducer": "all",
  "fixtures": {
    "seed_schemas": [
      "type WorkflowInput {\n  correlation: String\n  message: String\n}"
    ]
  },
  "stages": [
    {
      "stage_id": "configure",
      "prompt": "Keep WorkflowInput records (correlation, message) and WorkflowOutput records (correlation, result). Whenever a new input arrives, handle it yourself: save one output with the same correlation and the result processed. Do not add an input yet.",
      "capture": [
        {
          "kind": "schema",
          "name": "storage",
          "collections": [
            "WorkflowInput",
            "WorkflowOutput"
          ]
        }
      ],
      "checks": [
        {
          "check": "schema_matches",
          "params": {
            "name": "storage",
            "sdl": "type WorkflowInput {\n  correlation: String\n  message: String\n}\ntype WorkflowOutput {\n  correlation: String\n  result: String\n}"
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "seed_input",
      "seed": {
        "collection": "WorkflowInput",
        "document": {
          "correlation": "val-seed-006",
          "message": "process this"
        }
      },
      "settle": true,
      "capture": [
        {
          "kind": "documents",
          "name": "outputs",
          "collection": "WorkflowOutput",
          "filter": {
            "correlation": {
              "_eq": "val-seed-006"
            }
          }
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "outputs",
                "min": 1,
                "max": 1
              }
            ],
            "rows": [
              {
                "capture": "outputs",
                "key": "correlation",
                "id": "val-seed-006",
                "expect": [
                  {
                    "field": "result",
                    "equals": "processed"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}