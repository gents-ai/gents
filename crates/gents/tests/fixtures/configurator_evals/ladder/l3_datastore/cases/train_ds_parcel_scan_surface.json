{
  "case_id": "train-ds-parcel-scan-surface",
  "split": "train",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "configure",
      "prompt": "I want to keep depot scans as ParcelScan records with a tracking number and a depot, in fields named tracking and depot. Set that up so you can add scans and look them up by tracking number.",
      "capture": [
        {
          "kind": "schema",
          "name": "storage",
          "collections": [
            "ParcelScan"
          ]
        }
      ],
      "checks": [
        {
          "check": "schema_matches",
          "params": {
            "name": "storage",
            "sdl": "type ParcelScan {\n  tracking: String\n  depot: String\n}"
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "exercise",
      "prompt": "Save a scan for tracking PX-4410 at depot Leith, then look it up by tracking and tell me what is stored.",
      "settle": true,
      "capture": [
        {
          "kind": "documents",
          "name": "scans",
          "collection": "ParcelScan",
          "filter": {
            "tracking": {
              "_eq": "PX-4410"
            }
          },
          "fields": [
            "tracking",
            "depot"
          ]
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "scans",
                "min": 1,
                "max": 1
              }
            ],
            "rows": [
              {
                "capture": "scans",
                "key": "tracking",
                "id": "PX-4410",
                "expect": [
                  {
                    "field": "tracking",
                    "equals": "PX-4410"
                  },
                  {
                    "field": "depot",
                    "equals": "Leith"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              "PX-4410",
              "Leith"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "continuation": {
        "prompt": "OK, go ahead.",
        "max": 1,
        "until": "scans"
      }
    }
  ]
}