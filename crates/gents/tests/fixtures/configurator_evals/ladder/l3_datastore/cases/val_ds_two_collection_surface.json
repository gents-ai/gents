{
  "case_id": "val-ds-two-collection-surface",
  "split": "validation",
  "reducer": "all",
  "fixtures": {
    "schemas": [
      "type WorkflowInput {\n  correlation: String\n  message: String\n}",
      "type WorkflowOutput {\n  correlation: String\n  result: String\n}"
    ]
  },
  "stages": [
    {
      "stage_id": "configure",
      "prompt": "We already store WorkflowInput (correlation, message) and WorkflowOutput (correlation, result) records. Create an assistant called Flow Clerk with its own tools to add each kind and look either up by correlation, and no other database access. I will hand it work through you.",
      "capture": [
        {
          "kind": "documents",
          "name": "agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_did",
            "display_name",
            "context_id",
            "enabled",
            "inference_profile_id",
            "tags"
          ]
        },
        {
          "kind": "documents",
          "name": "contexts",
          "collection": "AgentContext",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "context_id",
            "system_prompt",
            "tools_id"
          ]
        },
        {
          "kind": "documents",
          "name": "tools",
          "collection": "Tools",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "tools_id",
            "host",
            "datastore",
            "self_config",
            "agents",
            "remote",
            "built_ins",
            "integrations"
          ]
        },
        {
          "kind": "documents",
          "name": "surfaces",
          "collection": "DatastoreToolSurface",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "surface_id",
            "node_did",
            "display_name",
            "enabled",
            "entries"
          ]
        },
        {
          "kind": "documents",
          "name": "helper_targets",
          "collection": "AgentTarget",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^flow[ -]?clerk$"
                  },
                  "field": "agent_did"
                }
              }
            }
          },
          "fields": [
            "target_id",
            "node_did",
            "name",
            "target_node_did",
            "agent_did"
          ]
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "agents": {
              "agents": "agents",
              "contexts": "contexts",
              "tools": "tools",
              "expect": [
                {
                  "agent_did": "flow-clerk",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^flow[ -]?clerk$"
                  },
                  "agent": [
                    {
                      "field": "enabled",
                      "equals": true
                    }
                  ],
                  "datastore": {
                    "surfaces": "surfaces",
                    "create": [
                      "WorkflowInput",
                      "WorkflowOutput"
                    ],
                    "query": [
                      "WorkflowInput",
                      "WorkflowOutput"
                    ],
                    "lookup_by": "correlation",
                    "caller_fields": {
                      "WorkflowInput": [
                        "correlation",
                        "message"
                      ],
                      "WorkflowOutput": [
                        "correlation",
                        "result"
                      ]
                    }
                  },
                  "tools": [
                    {
                      "field": "datastore.enable_defra_query",
                      "matches": "^(null|false)$"
                    }
                  ]
                }
              ]
            },
            "present": [
              {
                "capture": "helper_targets",
                "min": 1
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "exercise",
      "prompt": "Have Flow Clerk save an output with result done and an input with message kickoff, both for correlation val-charlie-004. Tell me when both are saved.",
      "settle": true,
      "capture": [
        {
          "kind": "documents",
          "name": "role_agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_did",
            "display_name"
          ]
        },
        {
          "kind": "documents",
          "name": "helper_requests",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "role_agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^flow[ -]?clerk$"
                  },
                  "field": "agent_did"
                }
              }
            },
            "purpose": {
              "_eq": "normal"
            },
            "lifecycle_state": {
              "_eq": "completed"
            }
          },
          "fields": [
            "request_id",
            "agent_did",
            "lifecycle_state",
            "content"
          ]
        },
        {
          "kind": "documents",
          "name": "outputs",
          "collection": "WorkflowOutput",
          "filter": {
            "correlation": {
              "_eq": "val-charlie-004"
            }
          },
          "fields": [
            "correlation",
            "result"
          ]
        },
        {
          "kind": "documents",
          "name": "inputs",
          "collection": "WorkflowInput",
          "filter": {
            "correlation": {
              "_eq": "val-charlie-004"
            }
          },
          "fields": [
            "correlation",
            "message"
          ]
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "helper_requests",
                "min": 1
              },
              {
                "capture": "outputs",
                "min": 1,
                "max": 1
              },
              {
                "capture": "inputs",
                "min": 1,
                "max": 1
              }
            ],
            "rows": [
              {
                "capture": "outputs",
                "key": "correlation",
                "id": "val-charlie-004",
                "expect": [
                  {
                    "field": "result",
                    "equals": "done"
                  }
                ]
              },
              {
                "capture": "inputs",
                "key": "correlation",
                "id": "val-charlie-004",
                "expect": [
                  {
                    "field": "message",
                    "equals": "kickoff"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "confirm_input_row",
      "prompt": "Ask Flow Clerk what input is stored for correlation val-charlie-004, and tell me its answer.",
      "settle": true,
      "capture": [
        {
          "kind": "documents",
          "name": "role_agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_did",
            "display_name"
          ]
        },
        {
          "kind": "documents",
          "name": "helper_requests",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "role_agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^flow[ -]?clerk$"
                  },
                  "field": "agent_did"
                }
              }
            },
            "purpose": {
              "_eq": "normal"
            },
            "lifecycle_state": {
              "_eq": "completed"
            }
          },
          "fields": [
            "request_id",
            "agent_did",
            "lifecycle_state",
            "content"
          ]
        },
        {
          "kind": "documents",
          "name": "inputs",
          "collection": "WorkflowInput",
          "filter": {
            "correlation": {
              "_eq": "val-charlie-004"
            }
          },
          "fields": [
            "correlation",
            "message"
          ]
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "helper_requests",
                "min": 1
              },
              {
                "capture": "inputs",
                "min": 1,
                "max": 1
              }
            ],
            "rows": [
              {
                "capture": "inputs",
                "key": "correlation",
                "id": "val-charlie-004",
                "expect": [
                  {
                    "field": "message",
                    "equals": "kickoff"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              "kickoff"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}