            "agents",
            "self_config"
          ]
        },
        {
          "kind": "documents",
          "name": "surfaces",
          "collection": "DatastoreToolSurface",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "surface_id",
            "node_did",
            "display_name",
            "enabled",
            "entries"
          ]
        }
      ]
    }
  ]
}
