{
  "case_id": "val-ds-two-collection-surface",
  "split": "validation",
  "reducer": "all",
  "fixtures": {
    "schemas": [
      "type EvalAutomationInput {\n  correlation: String\n  message: String\n}",
      "type EvalAutomationOutput {\n  correlation: String\n  result: String\n}"
    ]
  },
  "stages": [
    {
      "stage_id": "configure",
      "prompt": "I need you to keep results for my workflow. The records are EvalAutomationInput { correlation: string, message: string } and EvalAutomationOutput { correlation: string, result: string }. The correlation is a caller-supplied business key: preserve it exactly, and find records using that key alone. The record types already exist. Give yourself tools to add and find both input and output records, limited to those records.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ],
            "forbidden": [
              "bash"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "agents": {
              "agents": "agents",
              "contexts": "contexts",
              "tools": "tools",
              "expect": [
                {
                  "agent_id": "engineer",
                  "datastore": {
                    "surfaces": "surfaces",
                    "create": [
                      "EvalAutomationInput",
                      "EvalAutomationOutput"
                    ],
                    "query": [
                      "EvalAutomationInput",
                      "EvalAutomationOutput"
                    ],
                    "lookup_by": "correlation",
                    "caller_fields": {
                      "EvalAutomationInput": [
                        "correlation",
                        "message"
                      ],
                      "EvalAutomationOutput": [
                        "correlation",
                        "result"
                      ]
                    }
                  },
                  "tools": [
                    {
                      "field": "datastore.enable_defra_query",
                      "matches": "^(null|false)$"
                    }
                  ]
                }
              ]
            },
            "present": [
              {
                "capture": "surfaces"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "surfaces",
            "min": 1
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_id",
            "display_name",
            "context_id",
            "enabled",
            "inference_profile_id"
          ]
        },
        {
          "kind": "documents",
          "name": "contexts",
          "collection": "AgentContext",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "context_id",
            "tools_id",
            "system_prompt"
          ]
        },
        {
          "kind": "documents",
          "name": "tools",
          "collection": "Tools",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "tools_id",
            "host",
            "datastore",
            "agents",
            "self_config"
          ]
        },
        {
          "kind": "documents",
          "name": "surfaces",
          "collection": "DatastoreToolSurface",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "surface_id",
            "node_did",
            "display_name",
            "enabled",
            "entries"
          ]
        }
      ]
    },
    {
      "stage_id": "exercise",
      "prompt": "Save one output for correlation \"val-charlie-004\" with result \"done\". Also save an input with the same correlation and message \"kickoff\". Use your recordkeeping tools; leave configuration alone.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "captured_rows_count",
          "params": {
            "name": "outputs",
            "min": 1,
            "max": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "outputs",
            "expect": [
              {
                "field": "correlation",
                "equals": "val-charlie-004"
              },
              {
                "field": "result",
                "equals": "done"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "tool_calls_expected",
          "params": {
            "forbidden": [
              "config",
              "bash"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "agents": {
              "agents": "agents",
              "contexts": "contexts",
              "tools": "tools",
              "expect": [
                {
                  "agent_id": "engineer",
                  "datastore": {
                    "surfaces": "surfaces",
                    "create": [
                      "EvalAutomationInput",
                      "EvalAutomationOutput"
                    ],
                    "query": [
                      "EvalAutomationInput",
                      "EvalAutomationOutput"
                    ],
                    "lookup_by": "correlation",
                    "caller_fields": {
                      "EvalAutomationInput": [
                        "correlation",
                        "message"
                      ],
                      "EvalAutomationOutput": [
                        "correlation",
                        "result"
                      ]
                    },
                    "called_create": [
                      "EvalAutomationInput",
                      "EvalAutomationOutput"
                    ],
                    "called_query": []
                  },
                  "tools": [
                    {
                      "field": "datastore.enable_defra_query",
                      "matches": "^(null|false)$"
                    }
                  ]
                }
              ]
            }
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "outputs",
          "collection": "EvalAutomationOutput",
          "filter": {
            "correlation": {
              "_eq": "val-charlie-004"
            }
          },
          "fields": [
            "correlation",
            "result"
          ]
        },
        {
          "kind": "documents",
          "name": "agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_id",
            "display_name",
            "context_id",
            "enabled",
            "inference_profile_id"
          ]
        },
        {
          "kind": "documents",
          "name": "contexts",
          "collection": "AgentContext",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "context_id",
            "tools_id",
            "system_prompt"
          ]
        },
        {
          "kind": "documents",
          "name": "tools",
          "collection": "Tools",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "tools_id",
            "host",
            "datastore",
            "agents",
            "self_config"
          ]
        },
        {
          "kind": "documents",
          "name": "surfaces",
          "collection": "DatastoreToolSurface",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "surface_id",
            "node_did",
            "display_name",
            "enabled",
            "entries"
          ]
        }
      ]
    },
    {
      "stage_id": "confirm_input_row",
      "prompt": "Look up EvalAutomationInput for correlation \"val-charlie-004\" and tell me what is stored. Do not write anything.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "captured_fields_match",
          "params": {
            "name": "inputs",
            "expect": [
              {
                "field": "correlation",
                "equals": "val-charlie-004"
              },
              {
                "field": "message",
                "equals": "kickoff"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "tool_calls_expected",
          "params": {
            "forbidden": [
              "config",
              "bash"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              "val-charlie-004",
              "kickoff"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "agents": {
              "agents": "agents",
              "contexts": "contexts",
              "tools": "tools",
              "expect": [
                {
                  "agent_id": "engineer",
                  "datastore": {
                    "surfaces": "surfaces",
                    "create": [
                      "EvalAutomationInput",
                      "EvalAutomationOutput"
                    ],
                    "query": [
                      "EvalAutomationInput",
                      "EvalAutomationOutput"
                    ],
                    "lookup_by": "correlation",
                    "caller_fields": {
                      "EvalAutomationInput": [
                        "correlation",
                        "message"
                      ],
                      "EvalAutomationOutput": [
                        "correlation",
                        "result"
                      ]
                    },
                    "called_query": [
                      "EvalAutomationInput"
                    ]
                  },
                  "tools": [
                    {
                      "field": "datastore.enable_defra_query",
                      "matches": "^(null|false)$"
                    }
                  ]
                }
              ]
            }
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "inputs",
          "collection": "EvalAutomationInput",
          "filter": {
            "correlation": {
              "_eq": "val-charlie-004"
            }
          },
          "fields": [
            "correlation",
            "message"
          ]
        },
        {
          "kind": "documents",
          "name": "agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_id",
            "display_name",
            "context_id",
            "enabled",
            "inference_profile_id"
          ]
        },
        {
          "kind": "documents",
          "name": "contexts",
          "collection": "AgentContext",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "context_id",
            "tools_id",
            "system_prompt"
          ]
        },
        {
          "kind": "documents",
          "name": "tools",
          "collection": "Tools",
          "filter": {
