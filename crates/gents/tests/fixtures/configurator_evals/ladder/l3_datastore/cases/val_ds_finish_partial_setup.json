{
  "case_id": "val-ds-finish-partial-setup",
  "split": "validation",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "setup_partial",
      "prompt": "Prepare a recordkeeping tool for adding WorkflowOutput records, each with a correlation and a result, and looking one up by correlation. Set up the storage too, but do not give the tool to any assistant yet.",
      "capture": [
        {
          "kind": "schema",
          "name": "storage",
          "collections": [
            "WorkflowOutput"
          ]
        },
        {
          "kind": "documents",
          "name": "prepared",
          "collection": "DatastoreToolSurface",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "surface_id": {
              "_nlike": "%engineer-mailbox"
            }
          },
          "fields": [
            "surface_id",
            "node_did",
            "display_name",
            "enabled",
            "entries"
          ]
        }
      ],
      "checks": [
        {
          "check": "schema_matches",
          "params": {
            "name": "storage",
            "sdl": "type WorkflowOutput {\n  correlation: String\n  result: String\n}"
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "prepared",
            "max_rows": 1,
            "expect": [
              {
                "field": "entries",
                "contains": "WorkflowOutput"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "finish_wiring",
      "prompt": "Create an assistant called Ledger Clerk and give it the tool you prepared; reuse it rather than making another. It needs no other database access. I will hand it work through you.",
      "capture": [
        {
          "kind": "documents",
          "name": "agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_did",
            "display_name",
            "context_id",
            "enabled",
            "inference_profile_id",
            "tags"
          ]
        },
        {
          "kind": "documents",
          "name": "contexts",
          "collection": "AgentContext",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "context_id",
            "system_prompt",
            "tools_id"
          ]
        },
        {
          "kind": "documents",
          "name": "tools",
          "collection": "Tools",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "tools_id",
            "host",
            "datastore",
            "self_config",
            "agents",
            "remote",
            "built_ins",
            "integrations"
          ]
        },
        {
          "kind": "documents",
          "name": "surfaces",
          "collection": "DatastoreToolSurface",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "surface_id",
            "node_did",
            "display_name",
            "enabled",
            "entries"
          ]
        },
        {
          "kind": "documents",
          "name": "helper_targets",
          "collection": "AgentTarget",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^ledger[ -]?clerk$"
                  },
                  "field": "agent_did"
                }
              }
            }
          },
          "fields": [
            "target_id",
            "node_did",
            "name",
            "target_node_did",
            "agent_did"
          ]
        },
        {
          "kind": "documents",
          "name": "prepared",
          "collection": "DatastoreToolSurface",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "surface_id": {
              "_nlike": "%engineer-mailbox"
            }
          },
          "fields": [
            "surface_id",
            "node_did",
            "display_name",
            "enabled",
            "entries"
          ]
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "agents": {
              "agents": "agents",
              "contexts": "contexts",
              "tools": "tools",
              "expect": [
                {
                  "agent_did": "ledger-clerk",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^ledger[ -]?clerk$"
                  },
                  "agent": [
                    {
                      "field": "enabled",
                      "equals": true
                    }
                  ],
                  "datastore": {
                    "surfaces": "surfaces",
                    "create": [
                      "WorkflowOutput"
                    ],
                    "query": [
                      "WorkflowOutput"
                    ],
                    "lookup_by": "correlation",
                    "caller_fields": {
                      "WorkflowOutput": [
                        "correlation",
                        "result"
                      ]
                    }
                  },
                  "tools": [
                    {
                      "field": "datastore.enable_defra_query",
                      "matches": "^(null|false)$"
                    }
                  ]
                }
              ]
            },
            "present": [
              {
                "capture": "helper_targets",
                "min": 1
              },
              {
                "capture": "prepared",
                "min": 1,
                "max": 1
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "exercise",
      "prompt": "Have Ledger Clerk save result resumed for correlation val-delta-005, then look it up by correlation, and tell me what it found.",
      "settle": true,
      "capture": [
        {
          "kind": "documents",
          "name": "role_agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_did",
            "display_name"
          ]
        },
        {
          "kind": "documents",
          "name": "helper_requests",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "role_agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)^ledger[ -]?clerk$"
                  },
                  "field": "agent_did"
                }
              }
            },
            "purpose": {
              "_eq": "normal"
            },
            "lifecycle_state": {
              "_eq": "completed"
            }
          },
          "fields": [
            "request_id",
            "agent_did",
            "lifecycle_state",
            "content"
          ]
        },
        {
          "kind": "documents",
          "name": "outputs",
          "collection": "WorkflowOutput",
          "filter": {
            "correlation": {
              "_eq": "val-delta-005"
            }
          },
          "fields": [
            "correlation",
            "result"
          ]
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "helper_requests",
                "min": 1
              },
              {
                "capture": "outputs",
                "min": 1,
                "max": 1
              }
            ],
            "rows": [
              {
                "capture": "outputs",
                "key": "correlation",
                "id": "val-delta-005",
                "expect": [
                  {
                    "field": "result",
                    "equals": "resumed"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              "val-delta-005",
              "resumed"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}