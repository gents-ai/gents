{
  "case_id": "val-ds-row-persists-across-stages",
  "split": "validation",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "configure",
      "prompt": "Keep workflow results as WorkflowOutput records with a correlation and a result. Set up the storage so you can add results and look them up by correlation.",
      "capture": [
        {
          "kind": "schema",
          "name": "storage",
          "collections": [
            "WorkflowOutput"
          ]
        }
      ],
      "checks": [
        {
          "check": "schema_matches",
          "params": {
            "name": "storage",
            "sdl": "type WorkflowOutput {\n  correlation: String\n  result: String\n}"
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "exercise",
      "prompt": "Save an output with result once for correlation val-foxtrot-007, and tell me when it is stored.",
      "settle": true,
      "capture": [
        {
          "kind": "documents",
          "name": "outputs",
          "collection": "WorkflowOutput",
          "filter": {
            "correlation": {
              "_eq": "val-foxtrot-007"
            }
          },
          "fields": [
            "correlation",
            "result"
          ]
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "outputs",
                "min": 1,
                "max": 1
              }
            ],
            "rows": [
              {
                "capture": "outputs",
                "key": "correlation",
                "id": "val-foxtrot-007",
                "expect": [
                  {
                    "field": "correlation",
                    "equals": "val-foxtrot-007"
                  },
                  {
                    "field": "result",
                    "equals": "once"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              "val-foxtrot-007"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "continuation": {
        "prompt": "OK, go ahead.",
        "max": 1,
        "until": "outputs"
      }
    },
    {
      "stage_id": "verify_persistence",
      "prompt": "What result is stored for correlation val-foxtrot-007? Do not write anything.",
      "settle": true,
      "capture": [
        {
          "kind": "documents",
          "name": "outputs_after",
          "collection": "WorkflowOutput",
          "filter": {
            "correlation": {
              "_eq": "val-foxtrot-007"
            }
          },
          "fields": [
            "correlation",
            "result"
          ]
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "outputs_after",
                "min": 1,
                "max": 1
              }
            ],
            "rows": [
              {
                "capture": "outputs_after",
                "key": "correlation",
                "id": "val-foxtrot-007",
                "expect": [
                  {
                    "field": "correlation",
                    "equals": "val-foxtrot-007"
                  },
                  {
                    "field": "result",
                    "equals": "once"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              {
                "matches": "(?i)\\bonce\\b"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}