{
  "case_id": "emit-outcome-false",
  "split": "validation",
  "reducer": "all",
  "fixtures": {
    "schemas": [
      "type QuietNote { message: String handoff_id: String }"
    ]
  },
  "stages": [
    {
      "stage_id": "configure",
      "prompt": "Whenever a new QuietNote record arrives, handle its message yourself and acknowledge it. Let separate records run independently. Do not retain an extra completion record. The QuietNote records already have a message field. Set this up now; I will send records later.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ],
            "forbidden": [
              "bash"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "trigger_config",
            "min_rows": 1,
            "max_rows": 1,
            "expect": [
              {
                "field": "task_id",
                "matches": ".+"
              },
              {
                "field": "source",
                "matches": ".+"
              },
              {
                "field": "concurrency",
                "matches": "^(parallel|null)$"
              },
              {
                "field": "enabled",
                "equals": true
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "links": [
              {
                "capture": "trigger_config",
                "field": "task_id",
                "target_capture": "task_config",
                "target_key": "task_id",
                "expect": [
                  {
                    "field": "agent_id",
                    "matches": "(^|:)engineer$"
                  },
                  {
                    "field": "emit_outcome",
                    "matches": "^(false|null)$"
                  },
                  {
                    "field": "enabled",
                    "equals": true
                  }
                ],
                "source_match": {
                  "field": "concurrency",
                  "matches": "^(parallel|null)$"
                }
              },
              {
                "capture": "trigger_config",
                "field": "source.event_source_id",
                "target_capture": "eventsource_config",
                "target_key": "event_source_id",
                "expect": [
                  {
                    "field": "source_collection",
                    "equals": "QuietNote"
                  },
                  {
                    "field": "event_kind",
                    "matches": "^(created|null)$"
                  }
                ],
                "source_match": {
                  "field": "concurrency",
                  "matches": "^(parallel|null)$"
                }
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "eventsource_config",
            "min": 1,
            "max": 1
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "trigger_config",
          "collection": "Trigger",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "trigger_id",
            "task_id",
            "source",
            "concurrency",
            "session_id_template",
            "enabled"
          ]
        },
        {
          "kind": "documents",
          "name": "eventsource_config",
          "collection": "EventSource",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "event_source_id",
            "source_collection",
            "event_kind"
          ]
        },
        {
          "kind": "documents",
          "name": "task_config",
          "collection": "Task",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "task_id",
            "agent_id",
            "prompt_template",
            "emit_outcome",
            "enabled"
          ]
        }
      ]
    },
    {
      "stage_id": "seed_run",
      "seed": {
        "collection": "QuietNote",
        "document": {
          "message": "quiet-echo-43",
          "handoff_id": "emit-outcome-false-1"
        }
      },
      "deadline_secs": 600,
      "checks": [
        {
          "check": "captured_fields_match",
          "params": {
            "name": "rendered_request",
            "min_rows": 1,
            "max_rows": 1,
            "expect": [
              {
                "field": "content",
                "contains": "quiet-echo-43"
              },
              {
                "field": "lifecycle_state",
                "equals": "completed"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "fire_outcomes",
            "min": 0,
            "max": 0
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "links": [
              {
                "capture": "fires",
                "key": "source_collection",
                "id": "QuietNote",
                "field": "request_id",
                "target_capture": "completed_requests",
                "target_key": "request_id",
                "expect": [
                  {
                    "field": "lifecycle_state",
                    "equals": "completed"
                  }
                ]
              }
            ],
            "rows": []
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "fires",
          "collection": "TriggerFire",
          "filter": {
            "owner_did": {
              "_eq": "$trial"
            },
            "source_collection": {
              "_eq": "QuietNote"
            }
          },
          "fields": [
            "fire_key",
            "request_id",
            "session_id",
            "source_collection",
            "source_doc_id"
          ]
        },
        {
          "kind": "documents",
          "name": "fire_outcomes",
          "collection": "FireOutcome",
          "filter": {
            "owner_did": {
              "_eq": "$trial"
            },
            "source_collection": {
              "_eq": "QuietNote"
            }
          },
          "fields": [
            "fire_key",
            "request_id",
            "session_id",
            "source_collection",
            "source_doc_id",
            "terminal_state"
          ]
        },
        {
          "kind": "documents",
          "name": "completed_requests",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "caused_by_trigger_id": {
              "_ne": null
            },
            "lifecycle_state": {
              "_eq": "completed"
            },
            "purpose": {
              "_eq": "normal"
            }
          },
          "fields": [
            "request_id",
            "session_id",
            "lifecycle_state",
            "content",
            "caused_by_source_doc_id"
          ]
        },
        {
          "kind": "documents",
          "name": "rendered_request",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "caused_by_trigger_id": {
              "_ne": null
            },
            "content": {
              "_like": "%quiet-echo-43%"
            },
            "purpose": {
              "_eq": "normal"
            }
          },
          "fields": [
            "content",
            "lifecycle_state",
            "session_id"
          ]
        }
      ],
      "settle": true
    }
  ]
}
