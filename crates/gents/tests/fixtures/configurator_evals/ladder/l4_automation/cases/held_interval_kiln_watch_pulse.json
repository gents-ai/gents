{
  "case_id": "held-interval-kiln-watch-pulse",
  "split": "held_out",
  "reducer": "all",
  "fixtures": {
    "documents": [
      {
        "collection": "AgentSession",
        "document": {
          "session_id": "eval-kiln-watch",
          "node_did": "$trial",
          "agent_did": "gents:agent-slot:engineer",
          "created_at": "2026-01-01T00:00:00Z",
          "requester_did": "$evaluator"
        }
      }
    ]
  },
  "stages": [
    {
      "stage_id": "configure",
      "prompt": "The kiln crew wants a pulse twice a minute in the conversation we already keep for them, eval-kiln-watch. Each pulse should just say the temperature log check is due. You can answer the pulses yourself. Start it now; it should keep going until I say otherwise.",
      "deadline_secs": 540,
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ],
            "forbidden": [
              "bash"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "schedule_config",
            "min": 1,
            "max": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "fires",
            "min_rows": 2,
            "expect": [
              {
                "field": "session_id",
                "equals": "eval-kiln-watch"
              },
              {
                "field": "trigger_id",
                "matches": ".+"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "links": [
              {
                "capture": "trigger_config",
                "source_match": {
                  "field": "source.kind",
                  "equals": "schedule"
                },
                "field": "source.schedule_id",
                "target_capture": "schedule_config",
                "target_key": "schedule_id",
                "expect": [
                  {
                    "field": "cadence.kind",
                    "equals": "interval"
                  },
                  {
                    "field": "cadence.interval_secs",
                    "equals": 30
                  }
                ]
              },
              {
                "capture": "trigger_config",
                "source_match": {
                  "field": "source.kind",
                  "equals": "schedule"
                },
                "field": "task_id",
                "target_capture": "task_config",
                "target_key": "task_id",
                "expect": [
                  {
                    "field": "agent_did",
                    "equals": "gents:agent-slot:engineer"
                  },
                  {
                    "field": "enabled",
                    "equals": true
                  },
                  {
                    "field": "emit_outcome",
                    "matches": "^(false|null)$"
                  }
                ]
              },
              {
                "capture": "trigger_config",
                "source_match": {
                  "field": "source.kind",
                  "equals": "schedule"
                },
                "field": "trigger_id",
                "target_capture": "trigger_config",
                "target_key": "trigger_id",
                "expect": [
                  {
                    "field": "session_id_template",
                    "equals": "eval-kiln-watch"
                  },
                  {
                    "field": "enabled",
                    "equals": true
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "schedule_config",
          "collection": "Schedule",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "schedule_id",
            "display_name",
            "cadence"
          ]
        },
        {
          "kind": "documents",
          "name": "trigger_config",
          "collection": "Trigger",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "trigger_id",
            "task_id",
            "source",
            "concurrency",
            "session_id_template",
            "enabled"
          ]
        },
        {
          "kind": "documents",
          "name": "task_config",
          "collection": "Task",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "task_id",
            "agent_did",
            "prompt_template",
            "emit_outcome",
            "enabled"
          ]
        },
        {
          "kind": "documents",
          "name": "fires",
          "collection": "TriggerFire",
          "filter": {
            "owner_did": {
              "_eq": "$trial"
            },
            "source_collection": {
              "_eq": "Schedule"
            }
          },
          "fields": [
            "fire_key",
            "trigger_id",
            "request_id",
            "session_id",
            "source_collection"
          ]
        }
      ],
      "settle": true
    }
  ]
}
