{
  "case_id": "completion-record-write-contract",
  "split": "validation",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "configure",
      "prompt": "Set up a small inbox for notices. A ReceiptNote has batch and text, both strings supplied by the caller. Give yourself only a tool to add a note using those two inputs. Whenever a note arrives, handle it yourself: acknowledge its text and keep the app\u2019s standard record of whether that handling succeeded or failed. Independent notes may run independently. Handle internal bookkeeping in the configuration; callers should provide only batch and text. Set up the storage and automation now, but do not add a note yet.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ],
            "forbidden": [
              "bash"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "trigger_config",
            "min_rows": 1,
            "max_rows": 1,
            "expect": [
              {
                "field": "task_id",
                "matches": ".+"
              },
              {
                "field": "source",
                "matches": ".+"
              },
              {
                "field": "concurrency",
                "matches": "^(parallel|null)$"
              },
              {
                "field": "enabled",
                "equals": true
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "links": [
              {
                "capture": "trigger_config",
                "field": "task_id",
                "target_capture": "task_config",
                "target_key": "task_id",
                "expect": [
                  {
                    "field": "agent_id",
                    "matches": "(^|:)engineer$"
                  },
                  {
                    "field": "emit_outcome",
                    "equals": true
                  },
                  {
                    "field": "enabled",
                    "equals": true
                  }
                ],
                "source_match": {
                  "field": "concurrency",
                  "matches": "^(parallel|null)$"
                }
              },
              {
                "capture": "trigger_config",
                "field": "source.event_source_id",
                "target_capture": "eventsource_config",
                "target_key": "event_source_id",
                "expect": [
                  {
                    "field": "source_collection",
                    "equals": "ReceiptNote"
                  },
                  {
                    "field": "event_kind",
                    "matches": "^(created|null)$"
                  }
                ],
                "source_match": {
                  "field": "concurrency",
                  "matches": "^(parallel|null)$"
                }
              }
            ],
            "agents": {
              "agents": "agents",
              "contexts": "contexts",
              "tools": "tools",
              "expect": [
                {
                  "agent_id": "engineer",
                  "datastore": {
                    "surfaces": "surfaces",
                    "create": [
                      "ReceiptNote"
                    ],
                    "query": [],
                    "caller_fields": {
                      "ReceiptNote": [
                        "batch",
                        "text"
                      ]
                    },
                    "required_fields": {
                      "ReceiptNote": [
                        "handoff_id"
                      ]
                    }
                  },
                  "tools": [
                    {
                      "field": "datastore.enable_defra_query",
                      "matches": "^(null|false)$"
                    }
                  ]
                }
              ]
            },
            "present": [
              {
                "capture": "notes",
                "min": 0,
                "max": 0
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "eventsource_config",
            "min": 1,
            "max": 1
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "trigger_config",
          "collection": "Trigger",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "trigger_id",
            "task_id",
            "source",
            "concurrency",
            "session_id_template",
            "enabled"
          ]
        },
        {
          "kind": "documents",
          "name": "eventsource_config",
          "collection": "EventSource",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "event_source_id",
            "source_collection",
            "event_kind"
          ]
        },
        {
          "kind": "documents",
          "name": "task_config",
          "collection": "Task",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "task_id",
            "agent_id",
            "prompt_template",
            "emit_outcome",
            "enabled"
          ]
        },
        {
          "kind": "documents",
          "name": "agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_id",
            "display_name",
            "context_id",
            "enabled",
            "inference_profile_id"
          ]
        },
        {
          "kind": "documents",
          "name": "contexts",
          "collection": "AgentContext",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "context_id",
            "tools_id",
            "system_prompt"
          ]
        },
        {
          "kind": "documents",
          "name": "tools",
          "collection": "Tools",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "tools_id",
            "host",
            "datastore",
            "agents",
            "self_config"
          ]
        },
        {
          "kind": "documents",
          "name": "surfaces",
          "collection": "DatastoreToolSurface",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "surface_id",
            "node_did",
            "display_name",
            "enabled",
            "entries"
          ]
        },
        {
          "kind": "documents",
          "name": "notes",
          "collection": "ReceiptNote",
          "filter": {
            "batch": {
              "_eq": "contract-check-1"
            }
          },
          "fields": [
            "batch",
            "text",
            "handoff_id"
          ]
        }
      ]
    },
    {
      "stage_id": "write_and_handle",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "captured_rows_count",
          "params": {
            "name": "fire_outcomes",
            "min": 1,
            "max": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "links": [
              {
                "capture": "fires",
                "key": "source_collection",
                "id": "ReceiptNote",
                "field": "request_id",
                "target_capture": "completed_requests",
                "target_key": "request_id",
                "expect": [
                  {
                    "field": "lifecycle_state",
                    "equals": "completed"
                  }
                ]
              }
            ],
            "rows": [
              {
                "capture": "fire_outcomes",
                "key": "source_collection",
                "id": "ReceiptNote",
                "expect": [
                  {
                    "field": "terminal_state",
                    "matches": "^(complete|completed)$"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "notes",
            "min_rows": 1,
            "max_rows": 1,
            "expect": [
              {
                "field": "text",
                "equals": "please acknowledge this notice"
              }
            ]
          },
          "tier": "acceptance"
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "fires",
          "collection": "TriggerFire",
          "filter": {
            "owner_did": {
              "_eq": "$trial"
            },
            "source_collection": {
              "_eq": "ReceiptNote"
            }
          },
          "fields": [
            "fire_key",
            "request_id",
            "session_id",
            "source_collection",
            "source_doc_id"
          ]
        },
        {
          "kind": "documents",
          "name": "fire_outcomes",
          "collection": "FireOutcome",
          "filter": {
            "owner_did": {
              "_eq": "$trial"
            },
            "source_collection": {
              "_eq": "ReceiptNote"
            }
          },
          "fields": [
            "fire_key",
            "request_id",
            "session_id",
            "source_collection",
            "source_doc_id",
            "terminal_state"
          ]
        },
        {
          "kind": "documents",
          "name": "completed_requests",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "caused_by_trigger_id": {
              "_ne": null
            },
            "lifecycle_state": {
              "_eq": "completed"
            },
            "purpose": {
              "_eq": "normal"
            }
          },
          "fields": [
            "request_id",
            "session_id",
            "lifecycle_state",
            "content",
            "caused_by_source_doc_id"
          ]
        },
        {
          "kind": "documents",
          "name": "rendered_request",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "caused_by_trigger_id": {
              "_ne": null
            },
            "content": {
              "_like": "%please acknowledge this notice%"
            },
            "purpose": {
              "_eq": "normal"
            }
          },
          "fields": [
            "content",
            "lifecycle_state",
            "session_id"
          ]
        },
        {
          "kind": "documents",
          "name": "notes",
          "collection": "ReceiptNote",
          "filter": {
            "batch": {
              "_eq": "contract-check-1"
            }
          },
          "fields": [
            "batch",
            "text",
            "handoff_id"
          ]
        }
      ],
      "settle": true,
      "prompt": "Use your new note tool to add one ReceiptNote with batch \"contract-check-1\" and text \"please acknowledge this notice\". Let the configured automation handle it. Do not change the configuration."
    }
  ]
}
