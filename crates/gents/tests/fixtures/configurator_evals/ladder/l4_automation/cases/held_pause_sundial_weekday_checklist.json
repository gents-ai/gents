{
  "case_id": "held-pause-sundial-weekday-checklist",
  "split": "held_out",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "setup",
      "prompt": "On weekdays at 06:45 UTC, I want you to post the sundial gallery opening checklist for the morning staff. Make it a recurring automation that you handle yourself, and keep the checklist task available for us to start manually too. Don't run it now.",
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ],
            "forbidden": [
              "bash"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "schedule_config",
            "min": 1,
            "max": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "trigger_config",
            "min_rows": 1,
            "expect": [
              {
                "field": "enabled",
                "equals": true
              }
            ],
            "max_rows": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "links": [
              {
                "capture": "trigger_config",
                "source_match": {
                  "field": "source.kind",
                  "equals": "schedule"
                },
                "field": "source.schedule_id",
                "target_capture": "schedule_config",
                "target_key": "schedule_id",
                "expect": [
                  {
                    "field": "cadence.kind",
                    "equals": "cron"
                  },
                  {
                    "field": "cadence.expression",
                    "matches": "^\\s*45\\s+0?6\\s+(\\*|\\*/1|1-31)\\s+(\\*|\\*/1|1-12)\\s+(1-5|MON-FRI|mon-fri|Mon-Fri|1,2,3,4,5)\\s*$"
                  },
                  {
                    "field": "cadence.timezone",
                    "equals": "UTC"
                  }
                ]
              },
              {
                "capture": "trigger_config",
                "source_match": {
                  "field": "source.kind",
                  "equals": "schedule"
                },
                "field": "task_id",
                "target_capture": "task_config",
                "target_key": "task_id",
                "expect": [
                  {
                    "field": "agent_did",
                    "equals": "gents:agent-slot:engineer"
                  },
                  {
                    "field": "enabled",
                    "equals": true
                  },
                  {
                    "field": "emit_outcome",
                    "matches": "^(false|null)$"
                  },
                  {
                    "field": "prompt_template",
                    "matches": "(?i)sundial|checklist"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "schedule_config",
          "collection": "Schedule",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "schedule_id",
            "display_name",
            "cadence"
          ]
        },
        {
          "kind": "documents",
          "name": "trigger_config",
          "collection": "Trigger",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "trigger_id",
            "task_id",
            "source",
            "concurrency",
            "session_id_template",
            "enabled"
          ]
        },
        {
          "kind": "documents",
          "name": "task_config",
          "collection": "Task",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "task_id",
            "agent_did",
            "prompt_template",
            "emit_outcome",
            "enabled"
          ]
        }
      ]
    },
    {
      "stage_id": "pause",
      "prompt": "The gallery is closed for renovation. Stop the automatic weekday run of the sundial checklist, but leave the checklist task itself switched on for manual use and keep the timing exactly as it is so we can turn the automatic run back on later. Nothing should run today.",
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ],
            "forbidden": [
              "bash"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "runs",
            "min": 0,
            "max": 0
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "trigger_config",
            "min_rows": 1,
            "expect": [
              {
                "field": "enabled",
                "equals": false
              }
            ],
            "max_rows": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "schedule_config",
                "min": 1,
                "max": 1
              },
              {
                "capture": "task_config",
                "min": 1,
                "max": 1
              }
            ],
            "links": [
              {
                "capture": "trigger_config",
                "source_match": {
                  "field": "source.kind",
                  "equals": "schedule"
                },
                "field": "source.schedule_id",
                "target_capture": "schedule_config",
                "target_key": "schedule_id",
                "expect": [
                  {
                    "field": "cadence.kind",
                    "equals": "cron"
                  },
                  {
                    "field": "cadence.expression",
                    "matches": "^\\s*45\\s+0?6\\s+(\\*|\\*/1|1-31)\\s+(\\*|\\*/1|1-12)\\s+(1-5|MON-FRI|mon-fri|Mon-Fri|1,2,3,4,5)\\s*$"
                  },
                  {
                    "field": "cadence.timezone",
                    "equals": "UTC"
                  }
                ]
              },
              {
                "capture": "trigger_config",
                "source_match": {
                  "field": "source.kind",
                  "equals": "schedule"
                },
                "field": "task_id",
                "target_capture": "task_config",
                "target_key": "task_id",
                "expect": [
                  {
                    "field": "agent_did",
                    "equals": "gents:agent-slot:engineer"
                  },
                  {
                    "field": "enabled",
                    "equals": true
                  },
                  {
                    "field": "emit_outcome",
                    "matches": "^(false|null)$"
                  },
                  {
                    "field": "prompt_template",
                    "matches": "(?i)sundial|checklist"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "schedule_config",
          "collection": "Schedule",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "schedule_id",
            "display_name",
            "cadence"
          ]
        },
        {
          "kind": "documents",
          "name": "trigger_config",
          "collection": "Trigger",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "trigger_id",
            "task_id",
            "source",
            "concurrency",
            "session_id_template",
            "enabled"
          ]
        },
        {
          "kind": "documents",
          "name": "task_config",
          "collection": "Task",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "task_id",
            "agent_did",
            "prompt_template",
            "emit_outcome",
            "enabled"
          ]
        },
        {
          "kind": "documents",
          "name": "runs",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "caused_by_trigger_kind": {
              "_eq": "manual"
            },
            "purpose": {
              "_eq": "normal"
            }
          },
          "fields": [
            "request_id",
            "caused_by_trigger_id",
            "caused_by_trigger_kind",
            "lifecycle_state"
          ]
        }
      ]
    }
  ]
}
