{
  "case_id": "val-stop-fern-receipt-outcomes",
  "split": "validation",
  "reducer": "all",
  "fixtures": {
    "schemas": [
      "type FernReceipt { message: String handoff_id: String }"
    ]
  },
  "stages": [
    {
      "stage_id": "configure",
      "prompt": "Whenever a new FernReceipt record arrives, handle its message yourself and acknowledge it. Let separate records run independently. Keep the app's standard run record so I can see whether each run succeeded or failed. The FernReceipt records already have a message field. Set this up now; I will send records later.",
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ],
            "forbidden": [
              "bash"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "eventsource_config",
            "min": 1,
            "max": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "trigger_config",
            "min_rows": 1,
            "expect": [
              {
                "field": "enabled",
                "equals": true
              }
            ],
            "max_rows": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "links": [
              {
                "capture": "trigger_config",
                "field": "task_id",
                "target_capture": "task_config",
                "target_key": "task_id",
                "source_match": {
                  "field": "concurrency",
                  "matches": "^(parallel|null)$"
                },
                "expect": [
                  {
                    "field": "agent_did",
                    "equals": "gents:agent-slot:engineer"
                  },
                  {
                    "field": "emit_outcome",
                    "equals": true
                  },
                  {
                    "field": "enabled",
                    "equals": true
                  }
                ]
              },
              {
                "capture": "trigger_config",
                "field": "source.event_source_id",
                "target_capture": "eventsource_config",
                "target_key": "event_source_id",
                "source_match": {
                  "field": "concurrency",
                  "matches": "^(parallel|null)$"
                },
                "expect": [
                  {
                    "field": "source_collection",
                    "equals": "FernReceipt"
                  },
                  {
                    "field": "event_kind",
                    "matches": "^(created|null)$"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "trigger_config",
          "collection": "Trigger",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "trigger_id",
            "task_id",
            "source",
            "concurrency",
            "session_id_template",
            "enabled"
          ]
        },
        {
          "kind": "documents",
          "name": "eventsource_config",
          "collection": "EventSource",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "event_source_id",
            "source_collection",
            "event_kind"
          ]
        },
        {
          "kind": "documents",
          "name": "task_config",
          "collection": "Task",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "task_id",
            "agent_did",
            "prompt_template",
            "emit_outcome",
            "enabled"
          ]
        }
      ]
    },
    {
      "stage_id": "stop_outcomes",
      "prompt": "Stop recording terminal outcomes for the FernReceipt automation. Keep its instructions, its trigger and whether it is enabled exactly as they are. Do not fire a test run.",
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ],
            "forbidden": [
              "bash"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "task_config",
            "min": 1,
            "max": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "trigger_config",
            "min_rows": 1,
            "expect": [
              {
                "field": "enabled",
                "equals": true
              }
            ],
            "max_rows": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "links": [
              {
                "capture": "trigger_config",
                "field": "task_id",
                "target_capture": "task_config",
                "target_key": "task_id",
                "source_match": {
                  "field": "concurrency",
                  "matches": "^(parallel|null)$"
                },
                "expect": [
                  {
                    "field": "agent_did",
                    "equals": "gents:agent-slot:engineer"
                  },
                  {
                    "field": "emit_outcome",
                    "matches": "^(false|null)$"
                  },
                  {
                    "field": "enabled",
                    "equals": true
                  }
                ]
              },
              {
                "capture": "trigger_config",
                "field": "source.event_source_id",
                "target_capture": "eventsource_config",
                "target_key": "event_source_id",
                "source_match": {
                  "field": "concurrency",
                  "matches": "^(parallel|null)$"
                },
                "expect": [
                  {
                    "field": "source_collection",
                    "equals": "FernReceipt"
                  },
                  {
                    "field": "event_kind",
                    "matches": "^(created|null)$"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "trigger_config",
          "collection": "Trigger",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "trigger_id",
            "task_id",
            "source",
            "concurrency",
            "session_id_template",
            "enabled"
          ]
        },
        {
          "kind": "documents",
          "name": "eventsource_config",
          "collection": "EventSource",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "event_source_id",
            "source_collection",
            "event_kind"
          ]
        },
        {
          "kind": "documents",
          "name": "task_config",
          "collection": "Task",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "task_id",
            "agent_did",
            "prompt_template",
            "emit_outcome",
            "enabled"
          ]
        }
      ]
    },
    {
      "stage_id": "seed_run",
      "seed": {
        "collection": "FernReceipt",
        "document": {
          "message": "fern-echo-52",
          "handoff_id": "val-stop-fern-receipt-outcomes-1"
        }
      },
      "checks": [
        {
          "check": "captured_fields_match",
          "params": {
            "name": "rendered_request",
            "min_rows": 1,
            "expect": [
              {
                "field": "content",
                "contains": "fern-echo-52"
              },
              {
                "field": "lifecycle_state",
                "equals": "completed"
              }
            ],
            "max_rows": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "fire_outcomes",
            "min": 0,
            "max": 0
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "fire_outcomes",
          "collection": "FireOutcome",
          "filter": {
            "owner_did": {
              "_eq": "$trial"
            },
            "source_collection": {
              "_eq": "FernReceipt"
            }
          },
          "fields": [
            "fire_key",
            "request_id",
            "session_id",
            "source_collection",
            "source_doc_id",
            "terminal_state"
          ]
        },
        {
          "kind": "documents",
          "name": "rendered_request",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "caused_by_trigger_id": {
              "_ne": null
            },
            "content": {
              "_like": "%fern-echo-52%"
            },
            "purpose": {
              "_eq": "normal"
            }
          },
          "fields": [
            "content",
            "lifecycle_state",
            "session_id"
          ]
        }
      ],
      "settle": true
    }
  ]
}
