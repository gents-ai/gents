{
  "case_id": "train-suspend-kiln-shift-task",
  "split": "train",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "setup",
      "prompt": "Create two manual tasks that you run yourself, with no schedules or triggers. Task kiln-shift-6 says \"Acknowledge the kiln shift handoff.\" Task kiln-spare-3 says \"Check the spare kiln log.\" Keep both enabled and do not run either.",
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ],
            "forbidden": [
              "bash"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "task_config",
            "min": 2,
            "max": 2
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "rows": [
              {
                "capture": "task_config",
                "key": "task_id",
                "id": "kiln-shift-6",
                "expect": [
                  {
                    "field": "enabled",
                    "equals": true
                  },
                  {
                    "field": "agent_did",
                    "equals": "gents:agent-slot:engineer"
                  },
                  {
                    "field": "prompt_template",
                    "matches": "(?i)kiln shift handoff"
                  }
                ]
              },
              {
                "capture": "task_config",
                "key": "task_id",
                "id": "kiln-spare-3",
                "expect": [
                  {
                    "field": "enabled",
                    "equals": true
                  },
                  {
                    "field": "agent_did",
                    "equals": "gents:agent-slot:engineer"
                  },
                  {
                    "field": "prompt_template",
                    "matches": "(?i)spare kiln log"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "task_config",
          "collection": "Task",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "task_id",
            "agent_did",
            "prompt_template",
            "emit_outcome",
            "enabled"
          ]
        },
        {
          "kind": "documents",
          "name": "trigger_config",
          "collection": "Trigger",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "trigger_id",
            "task_id",
            "source",
            "concurrency",
            "session_id_template",
            "enabled"
          ]
        }
      ]
    },
    {
      "stage_id": "change",
      "prompt": "Suspend the existing kiln-shift-6 task. Keep kiln-spare-3 and both tasks' instructions as they are. Do not run anything.",
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ],
            "forbidden": [
              "bash"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "runs",
            "min": 0,
            "max": 0
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "task_config",
                "min": 2,
                "max": 2
              },
              {
                "capture": "trigger_config",
                "min": 0,
                "max": 0
              }
            ],
            "rows": [
              {
                "capture": "task_config",
                "key": "task_id",
                "id": "kiln-shift-6",
                "expect": [
                  {
                    "field": "enabled",
                    "equals": false
                  },
                  {
                    "field": "agent_did",
                    "equals": "gents:agent-slot:engineer"
                  },
                  {
                    "field": "prompt_template",
                    "matches": "(?i)kiln shift handoff"
                  }
                ]
              },
              {
                "capture": "task_config",
                "key": "task_id",
                "id": "kiln-spare-3",
                "expect": [
                  {
                    "field": "enabled",
                    "equals": true
                  },
                  {
                    "field": "agent_did",
                    "equals": "gents:agent-slot:engineer"
                  },
                  {
                    "field": "prompt_template",
                    "matches": "(?i)spare kiln log"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "task_config",
          "collection": "Task",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "task_id",
            "agent_did",
            "prompt_template",
            "emit_outcome",
            "enabled"
          ]
        },
        {
          "kind": "documents",
          "name": "trigger_config",
          "collection": "Trigger",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "trigger_id",
            "task_id",
            "source",
            "concurrency",
            "session_id_template",
            "enabled"
          ]
        },
        {
          "kind": "documents",
          "name": "runs",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "caused_by_trigger_kind": {
              "_eq": "manual"
            },
            "purpose": {
              "_eq": "normal"
            }
          },
          "fields": [
            "request_id",
            "caused_by_trigger_id",
            "caused_by_trigger_kind",
            "lifecycle_state"
          ]
        }
      ]
    }
  ]
}
