{
  "case_id": "serial-session-combo",
  "split": "held_out",
  "reducer": "all",
  "fixtures": {
    "schemas": [
      "type ComboNote { message: String handoff_id: String }"
    ],
    "documents": [
      {
        "collection": "AgentSession",
        "document": {
          "session_id": "eval-serial-session-combo-destination",
          "node_did": "$trial",
          "agent_id": "engineer",
          "created_at": "2026-01-01T00:00:00Z",
          "requester_did": "$trial"
        }
      }
    ]
  },
  "stages": [
    {
      "stage_id": "configure",
      "prompt": "Whenever a new ComboNote record arrives, handle its message yourself and acknowledge it. Process one at a time and keep the rest queued. Keep the app's standard run record so I can see whether each run succeeded or failed. Continue the work in our existing conversation eval-serial-session-combo-destination. The ComboNote records already have a message field. Set this up now; I will send records later.",
      "deadline_secs": 600,
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ],
            "forbidden": [
              "bash"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "trigger_config",
            "min_rows": 1,
            "max_rows": 1,
            "expect": [
              {
                "field": "task_id",
                "matches": ".+"
              },
              {
                "field": "source",
                "matches": ".+"
              },
              {
                "field": "concurrency",
                "equals": "queued_serial"
              },
              {
                "field": "session_id_template",
                "equals": "eval-serial-session-combo-destination"
              },
              {
                "field": "enabled",
                "equals": true
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "links": [
              {
                "capture": "trigger_config",
                "key": "concurrency",
                "id": "queued_serial",
                "field": "task_id",
                "target_capture": "task_config",
                "target_key": "task_id",
                "expect": [
                  {
                    "field": "agent_id",
                    "matches": "(^|:)engineer$"
                  },
                  {
                    "field": "emit_outcome",
                    "equals": true
                  },
                  {
                    "field": "enabled",
                    "equals": true
                  }
                ]
              },
              {
                "capture": "trigger_config",
                "key": "concurrency",
                "id": "queued_serial",
                "field": "source.event_source_id",
                "target_capture": "eventsource_config",
                "target_key": "event_source_id",
                "expect": [
                  {
                    "field": "source_collection",
                    "equals": "ComboNote"
                  },
                  {
                    "field": "event_kind",
                    "matches": "^(created|null)$"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "eventsource_config",
            "min": 1,
            "max": 1
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "trigger_config",
          "collection": "Trigger",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "trigger_id",
            "task_id",
            "source",
            "concurrency",
            "session_id_template",
            "enabled"
          ]
        },
        {
          "kind": "documents",
          "name": "eventsource_config",
          "collection": "EventSource",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "event_source_id",
            "source_collection",
            "event_kind"
          ]
        },
        {
          "kind": "documents",
          "name": "task_config",
          "collection": "Task",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "task_id",
            "agent_id",
            "prompt_template",
            "emit_outcome",
            "enabled"
          ]
        }
      ]
    },
    {
      "stage_id": "seed_run",
      "seed": {
        "collection": "ComboNote",
        "document": {
          "message": "combo-echo-71",
          "handoff_id": "serial-session-combo-1"
        }
      },
      "deadline_secs": 600,
      "checks": [
        {
          "check": "captured_fields_match",
          "params": {
            "name": "rendered_request",
            "min_rows": 1,
            "max_rows": 1,
            "expect": [
              {
                "field": "content",
                "contains": "combo-echo-71"
              },
              {
                "field": "lifecycle_state",
                "equals": "completed"
              },
              {
                "field": "session_id",
                "equals": "eval-serial-session-combo-destination"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "fire_outcomes",
            "min": 1,
            "max": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "links": [
              {
                "capture": "fires",
                "key": "source_collection",
                "id": "ComboNote",
                "field": "request_id",
                "target_capture": "completed_requests",
                "target_key": "request_id",
                "expect": [
                  {
                    "field": "lifecycle_state",
                    "equals": "completed"
                  },
                  {
                    "field": "session_id",
                    "equals": "eval-serial-session-combo-destination"
                  }
                ]
              }
            ],
            "rows": [
              {
                "capture": "fire_outcomes",
                "key": "source_collection",
                "id": "ComboNote",
                "expect": [
                  {
                    "field": "terminal_state",
                    "matches": "^(complete|completed)$"
                  },
                  {
                    "field": "session_id",
                    "equals": "eval-serial-session-combo-destination"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "fires",
          "collection": "TriggerFire",
          "filter": {
            "owner_did": {
              "_eq": "$trial"
            },
            "source_collection": {
              "_eq": "ComboNote"
            }
          },
          "fields": [
            "fire_key",
            "request_id",
            "session_id",
            "source_collection",
            "source_doc_id"
          ]
        },
        {
          "kind": "documents",
          "name": "fire_outcomes",
          "collection": "FireOutcome",
          "filter": {
            "owner_did": {
              "_eq": "$trial"
            },
            "source_collection": {
              "_eq": "ComboNote"
            }
          },
          "fields": [
            "fire_key",
            "request_id",
            "session_id",
            "source_collection",
            "source_doc_id",
            "terminal_state"
          ]
        },
        {
          "kind": "documents",
          "name": "completed_requests",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "caused_by_trigger_id": {
              "_ne": null
            },
            "lifecycle_state": {
              "_eq": "completed"
            },
            "purpose": {
              "_eq": "normal"
            }
          },
          "fields": [
            "request_id",
            "session_id",
            "lifecycle_state",
            "content",
            "caused_by_source_doc_id"
          ]
        },
        {
          "kind": "documents",
          "name": "rendered_request",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "caused_by_trigger_id": {
              "_ne": null
            },
            "content": {
              "_like": "%combo-echo-71%"
            },
            "purpose": {
              "_eq": "normal"
            }
          },
          "fields": [
            "content",
            "lifecycle_state",
            "session_id"
          ]
        }
      ],
      "settle": true
    }
  ]
}
