{
  "case_id": "val-retime-luthier-schedule-in-place",
  "split": "validation",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "setup",
      "prompt": "Every Monday at 09:00 Chicago time (America/Chicago), have yourself prepare the luthier workshop's parts reorder list. Set it up as a recurring automation now; do not run it.",
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ],
            "forbidden": [
              "bash"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "schedule_config",
            "min": 1,
            "max": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "trigger_config",
            "min_rows": 1,
            "expect": [
              {
                "field": "enabled",
                "equals": true
              }
            ],
            "max_rows": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "links": [
              {
                "capture": "trigger_config",
                "source_match": {
                  "field": "source.kind",
                  "equals": "schedule"
                },
                "field": "source.schedule_id",
                "target_capture": "schedule_config",
                "target_key": "schedule_id",
                "expect": [
                  {
                    "field": "cadence.kind",
                    "equals": "cron"
                  },
                  {
                    "field": "cadence.expression",
                    "matches": "^\\s*0?0\\s+0?9\\s+(\\*|\\*/1|1-31)\\s+(\\*|\\*/1|1-12)\\s+(1|MON|mon|Mon)\\s*$"
                  },
                  {
                    "field": "cadence.timezone",
                    "equals": "America/Chicago"
                  }
                ]
              },
              {
                "capture": "trigger_config",
                "source_match": {
                  "field": "source.kind",
                  "equals": "schedule"
                },
                "field": "task_id",
                "target_capture": "task_config",
                "target_key": "task_id",
                "expect": [
                  {
                    "field": "agent_did",
                    "equals": "gents:agent-slot:engineer"
                  },
                  {
                    "field": "enabled",
                    "equals": true
                  },
                  {
                    "field": "emit_outcome",
                    "matches": "^(false|null)$"
                  },
                  {
                    "field": "prompt_template",
                    "matches": "(?i)reorder|luthier|parts"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "schedule_config",
          "collection": "Schedule",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "schedule_id",
            "display_name",
            "cadence"
          ]
        },
        {
          "kind": "documents",
          "name": "trigger_config",
          "collection": "Trigger",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "trigger_id",
            "task_id",
            "source",
            "concurrency",
            "session_id_template",
            "enabled"
          ]
        },
        {
          "kind": "documents",
          "name": "task_config",
          "collection": "Task",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "task_id",
            "agent_did",
            "prompt_template",
            "emit_outcome",
            "enabled"
          ]
        }
      ]
    },
    {
      "stage_id": "retime",
      "prompt": "Move the luthier reorder automation to Thursdays at 14:15, same timezone. Change the existing schedule rather than adding another one, and keep its task and trigger.",
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ],
            "forbidden": [
              "bash"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "schedule_config",
            "min": 1,
            "max": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "trigger_config",
            "min_rows": 1,
            "expect": [
              {
                "field": "enabled",
                "equals": true
              }
            ],
            "max_rows": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "links": [
              {
                "capture": "trigger_config",
                "source_match": {
                  "field": "source.kind",
                  "equals": "schedule"
                },
                "field": "source.schedule_id",
                "target_capture": "schedule_config",
                "target_key": "schedule_id",
                "expect": [
                  {
                    "field": "cadence.kind",
                    "equals": "cron"
                  },
                  {
                    "field": "cadence.expression",
                    "matches": "^\\s*15\\s+14\\s+(\\*|\\*/1|1-31)\\s+(\\*|\\*/1|1-12)\\s+(4|THU|thu|Thu)\\s*$"
                  },
                  {
                    "field": "cadence.timezone",
                    "equals": "America/Chicago"
                  }
                ]
              },
              {
                "capture": "trigger_config",
                "source_match": {
                  "field": "source.kind",
                  "equals": "schedule"
                },
                "field": "task_id",
                "target_capture": "task_config",
                "target_key": "task_id",
                "expect": [
                  {
                    "field": "agent_did",
                    "equals": "gents:agent-slot:engineer"
                  },
                  {
                    "field": "enabled",
                    "equals": true
                  },
                  {
                    "field": "emit_outcome",
                    "matches": "^(false|null)$"
                  },
                  {
                    "field": "prompt_template",
                    "matches": "(?i)reorder|luthier|parts"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "schedule_config",
          "collection": "Schedule",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "schedule_id",
            "display_name",
            "cadence"
          ]
        },
        {
          "kind": "documents",
          "name": "trigger_config",
          "collection": "Trigger",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "trigger_id",
            "task_id",
            "source",
            "concurrency",
            "session_id_template",
            "enabled"
          ]
        },
        {
          "kind": "documents",
          "name": "task_config",
          "collection": "Task",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "task_id",
            "agent_did",
            "prompt_template",
            "emit_outcome",
            "enabled"
          ]
        }
      ]
    }
  ]
}
