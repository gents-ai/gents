{
  "case_id": "val-minimal-limits",
  "split": "validation",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "discover",
      "prompt": "For quick questions I want to keep costs down. Check our current model and limits and suggest the smallest change that would help. Explain first; do not change anything yet.",
      "deadline_secs": 600,
      "capture": [
        {
          "kind": "documents",
          "name": "agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_id",
            "display_name",
            "context_id",
            "inference_profile_id"
          ]
        },
        {
          "kind": "documents",
          "name": "profiles",
          "collection": "InferenceProfile",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "profile_id",
            "display_name",
            "backend_id",
            "execution_id",
            "model_name",
            "reasoning_effort"
          ]
        },
        {
          "kind": "documents",
          "name": "executions",
          "collection": "InferenceExecution",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "execution_id",
            "max_turns",
            "max_total_tokens",
            "deadline_duration_secs",
            "stream_batch_ms",
            "stream_liveness_timeout_secs",
            "provider_idle_timeout_secs"
          ]
        },
        {
          "kind": "documents",
          "name": "backends",
          "collection": "InferenceBackend",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "backend_id",
            "endpoint",
            "enabled"
          ]
        }
      ],
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ],
            "forbidden": [
              "bash"
            ],
            "config_read_only": true
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "links": [
              {
                "capture": "agents",
                "key": "agent_id",
                "id": "engineer",
                "field": "inference_profile_id",
                "target_capture": "profiles",
                "target_key": "profile_id",
                "expect": [],
                "reported_fields": [
                  "model_name"
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              {
                "matches": "(?i)(limit|budget|allowance|cap|turn|token|reasoning)"
              },
              {
                "matches": "(?i)(suggest|recommend|could|would|propos|can|change|lower|rais|set|keep)"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "configure",
      "prompt": "Set your allowance to 8 turns and 60,000 total tokens per request. Leave the other settings alone and keep using the same model and connection.",
      "deadline_secs": 600,
      "capture": [
        {
          "kind": "documents",
          "name": "agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_id",
            "display_name",
            "context_id",
            "inference_profile_id"
          ]
        },
        {
          "kind": "documents",
          "name": "profiles",
          "collection": "InferenceProfile",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "profile_id",
            "display_name",
            "backend_id",
            "execution_id",
            "model_name",
            "reasoning_effort"
          ]
        },
        {
          "kind": "documents",
          "name": "executions",
          "collection": "InferenceExecution",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "execution_id",
            "max_turns",
            "max_total_tokens",
            "deadline_duration_secs",
            "stream_batch_ms",
            "stream_liveness_timeout_secs",
            "provider_idle_timeout_secs"
          ]
        },
        {
          "kind": "documents",
          "name": "backends",
          "collection": "InferenceBackend",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "backend_id",
            "endpoint",
            "enabled"
          ]
        }
      ],
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ],
            "forbidden": [
              "bash"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "links": [
              {
                "capture": "agents",
                "key": "agent_id",
                "id": "engineer",
                "field": "inference_profile_id",
                "target_capture": "profiles",
                "target_key": "profile_id",
                "expect": []
              },
              {
                "capture": "agents",
                "key": "agent_id",
                "id": "engineer",
                "field": "inference_profile_id",
                "target_capture": "profiles",
                "target_key": "profile_id",
                "expect": [
                  {
                    "field": "max_turns",
                    "equals": 8
                  },
                  {
                    "field": "max_total_tokens",
                    "equals": 60000
                  }
                ],
                "via": [
                  {
                    "field": "execution_id",
                    "target_capture": "executions",
                    "target_key": "execution_id"
                  }
                ]
              },
              {
                "capture": "agents",
                "key": "agent_id",
                "id": "engineer",
                "field": "inference_profile_id",
                "target_capture": "profiles",
                "target_key": "profile_id",
                "expect": [],
                "via": [
                  {
                    "field": "backend_id",
                    "target_capture": "backends",
                    "target_key": "backend_id"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "backends",
            "min": 1,
            "max": 1
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}
