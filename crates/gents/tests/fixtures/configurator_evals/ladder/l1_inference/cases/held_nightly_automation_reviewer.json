{
  "case_id": "held-nightly-automation-reviewer",
  "split": "held_out",
  "reducer": "all",
  "fixtures": {
    "schemas": [
      "type NightlyJob { job: String }"
    ]
  },
  "stages": [
    {
      "stage_id": "discover",
      "prompt": "I want a reviewer to handle overnight review jobs, without changing your settings. Check our model and limits and explain how you would arrange that. The job records are already available; do not start work or change anything yet.",
      "deadline_secs": 600,
      "capture": [
        {
          "kind": "documents",
          "name": "agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_id",
            "display_name",
            "context_id",
            "inference_profile_id"
          ]
        },
        {
          "kind": "documents",
          "name": "profiles",
          "collection": "InferenceProfile",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "profile_id",
            "display_name",
            "backend_id",
            "execution_id",
            "model_name",
            "reasoning_effort"
          ]
        },
        {
          "kind": "documents",
          "name": "executions",
          "collection": "InferenceExecution",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "execution_id",
            "max_turns",
            "max_total_tokens",
            "deadline_duration_secs",
            "stream_batch_ms",
            "stream_liveness_timeout_secs",
            "provider_idle_timeout_secs"
          ]
        },
        {
          "kind": "documents",
          "name": "backends",
          "collection": "InferenceBackend",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "backend_id",
            "endpoint",
            "enabled"
          ]
        }
      ],
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ],
            "forbidden": [
              "bash"
            ],
            "config_read_only": true
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "links": [
              {
                "capture": "agents",
                "key": "agent_id",
                "id": "engineer",
                "field": "inference_profile_id",
                "target_capture": "profiles",
                "target_key": "profile_id",
                "expect": [],
                "reported_fields": [
                  "model_name"
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              {
                "matches": "(?i)(limit|budget|allowance|cap|turn|token|reasoning)"
              },
              {
                "matches": "(?i)(suggest|recommend|could|would|propos|can|change|lower|rais|set|keep)"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "configure",
      "prompt": "Create Nightly Reviewer using the current model, with medium thinking effort, 25 turns, 120,000 total tokens, and 20 minutes per request. Whenever a new NightlyJob record arrives, have it review the job text. Leave your own settings alone; I will supply jobs later.",
      "deadline_secs": 600,
      "capture": [
        {
          "kind": "documents",
          "name": "agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_id",
            "display_name",
            "context_id",
            "inference_profile_id"
          ]
        },
        {
          "kind": "documents",
          "name": "profiles",
          "collection": "InferenceProfile",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "profile_id",
            "display_name",
            "backend_id",
            "execution_id",
            "model_name",
            "reasoning_effort"
          ]
        },
        {
          "kind": "documents",
          "name": "executions",
          "collection": "InferenceExecution",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "execution_id",
            "max_turns",
            "max_total_tokens",
            "deadline_duration_secs",
            "stream_batch_ms",
            "stream_liveness_timeout_secs",
            "provider_idle_timeout_secs"
          ]
        },
        {
          "kind": "documents",
          "name": "backends",
          "collection": "InferenceBackend",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "backend_id",
            "endpoint",
            "enabled"
          ]
        }
      ],
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "config"
            ],
            "forbidden": [
              "bash"
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "links": [
              {
                "capture": "agents",
                "key": "agent_id",
                "id": "nightly-reviewer",
                "field": "inference_profile_id",
                "target_capture": "profiles",
                "target_key": "profile_id",
                "expect": [
                  {
                    "field": "reasoning_effort",
                    "equals": "medium"
                  }
                ]
              },
              {
                "capture": "agents",
                "key": "agent_id",
                "id": "nightly-reviewer",
                "field": "inference_profile_id",
                "target_capture": "profiles",
                "target_key": "profile_id",
                "expect": [
                  {
                    "field": "max_turns",
                    "equals": 25
                  },
                  {
                    "field": "max_total_tokens",
                    "equals": 120000
                  },
                  {
                    "field": "deadline_duration_secs",
                    "equals": 1200
                  }
                ],
                "via": [
                  {
                    "field": "execution_id",
                    "target_capture": "executions",
                    "target_key": "execution_id"
                  }
                ]
              },
              {
                "capture": "agents",
                "key": "agent_id",
                "id": "nightly-reviewer",
                "field": "inference_profile_id",
                "target_capture": "profiles",
                "target_key": "profile_id",
                "expect": [],
                "via": [
                  {
                    "field": "backend_id",
                    "target_capture": "backends",
                    "target_key": "backend_id"
                  }
                ]
              }
            ],
            "present": [
              {
                "capture": "profiles",
                "min": 2
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_rows_count",
          "params": {
            "name": "backends",
            "min": 1,
            "max": 1
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "fire",
      "seed": {
        "collection": "NightlyJob",
        "document": {
          "job": "nightly-digest"
        }
      },
      "deadline_secs": 600,
      "checks": [
        {
          "check": "captured_rows_count",
          "params": {
            "name": "completed_review",
            "min": 1,
            "max": 1
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "completed_review",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_id": {
              "_like": "%:nightly-reviewer"
            },
            "content": {
              "_like": "%nightly-digest%"
            },
            "lifecycle_state": {
              "_eq": "completed"
            },
            "purpose": {
              "_eq": "normal"
            }
          },
          "fields": [
            "request_id",
            "agent_id",
            "content",
            "lifecycle_state"
          ]
        }
      ]
    }
  ]
}
