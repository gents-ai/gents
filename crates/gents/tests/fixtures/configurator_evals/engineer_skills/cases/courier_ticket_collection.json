{
  "case_id": "courier-ticket-collection",
  "split": "train",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "design",
      "prompt": "Create a collection CourierTicket for the depot's courier tickets, with the fields ticket_number, depot and arrived_at. Tickets come from the courier company's system, which often sends the same ticket twice, and a page will list each depot's tickets newest first. Just the collection for now.",
      "capture": [
        {
          "kind": "documents",
          "name": "loaded",
          "collection": "AgentOutputSegment",
          "filter": {
            "session_id": {
              "_eq": "$session"
            },
            "payload": {
              "_like": "Skill: design-data%"
            }
          },
          "fields": [
            "ordinal"
          ]
        },
        {
          "kind": "schema",
          "name": "schema",
          "collections": [
            "CourierTicket"
          ]
        }
      ],
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "required": [
              "load_skill",
              "schema"
            ],
            "forbidden": [
              "bash",
              "bash_unrestricted"
            ],
            "config_read_only": true
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "loaded",
                "min": 1
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "schema_matches",
          "params": {
            "name": "schema",
            "sdl": "type CourierTicket { ticket_number: String @index(unique: true) depot: String arrived_at: DateTime }"
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}
