{
  "case_id": "courier-window-tickets",
  "split": "train",
  "reducer": "all",
  "fixtures": {
    "files": [
      {
        "path": "tickets/T-41.json",
        "contents": "{\n  \"ticket\": \"T-41\",\n  \"item\": \"envelope\",\n  \"grams\": 120,\n  \"arrival_hour\": 18,\n  \"seal\": \"intact\",\n  \"priority\": false\n}\n"
      },
      {
        "path": "tickets/T-42.json",
        "contents": "{\n  \"ticket\": \"T-42\",\n  \"item\": \"envelope\",\n  \"grams\": 80,\n  \"arrival_hour\": 9,\n  \"seal\": \"resealed\",\n  \"priority\": true\n}\n"
      },
      {
        "path": "tickets/T-43.json",
        "contents": "{\n  \"ticket\": \"T-43\",\n  \"item\": \"parcel\",\n  \"grams\": 2300,\n  \"arrival_hour\": 20,\n  \"seal\": \"broken\",\n  \"priority\": false\n}\n"
      },
      {
        "path": "tickets/T-44.json",
        "contents": "{\n  \"ticket\": \"T-44\",\n  \"item\": \"envelope\",\n  \"grams\": 650,\n  \"arrival_hour\": 11,\n  \"seal\": \"intact\",\n  \"priority\": true\n}\n"
      },
      {
        "path": "tickets/T-45.json",
        "contents": "{\n  \"ticket\": \"T-45\",\n  \"item\": \"envelope\",\n  \"grams\": 95,\n  \"arrival_hour\": 10,\n  \"seal\": \"intact\",\n  \"priority\": true\n}\n"
      },
      {
        "path": "tickets/T-46.json",
        "contents": "{\n  \"ticket\": \"T-46\",\n  \"item\": \"envelope\",\n  \"grams\": 140,\n  \"arrival_hour\": 17,\n  \"seal\": \"intact\",\n  \"priority\": false\n}\n"
      }
    ]
  },
  "stages": [
    {
      "stage_id": "route",
      "prompt": "Six courier arrivals came in at the depot, and their tickets are in tickets/. Which queue does each one go to?",
      "capture": [
        {
          "kind": "file",
          "name": "tickets",
          "glob": "tickets/*.json"
        }
      ],
      "checks": [
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              {
                "matches": "T-41\\b(?:[^-]|-\\D){0,80}?Blue Annex"
              },
              {
                "matches": "T-42\\b(?:[^-]|-\\D){0,80}?Red Desk"
              },
              {
                "matches": "T-43\\b(?:[^-]|-\\D){0,80}?Loading Bay 2"
              },
              {
                "matches": "T-44\\b(?:[^-]|-\\D){0,80}?Loading Bay 2"
              },
              {
                "matches": "T-45\\b(?:[^-]|-\\D){0,80}?Blue Annex"
              },
              {
                "matches": "T-46\\b(?:[^-]|-\\D){0,80}?Green Gate"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_files_match",
          "params": {
            "name": "tickets",
            "expect": [
              {
                "path": "tickets/T-41.json",
                "equals": "{\n  \"ticket\": \"T-41\",\n  \"item\": \"envelope\",\n  \"grams\": 120,\n  \"arrival_hour\": 18,\n  \"seal\": \"intact\",\n  \"priority\": false\n}\n"
              },
              {
                "path": "tickets/T-42.json",
                "equals": "{\n  \"ticket\": \"T-42\",\n  \"item\": \"envelope\",\n  \"grams\": 80,\n  \"arrival_hour\": 9,\n  \"seal\": \"resealed\",\n  \"priority\": true\n}\n"
              },
              {
                "path": "tickets/T-43.json",
                "equals": "{\n  \"ticket\": \"T-43\",\n  \"item\": \"parcel\",\n  \"grams\": 2300,\n  \"arrival_hour\": 20,\n  \"seal\": \"broken\",\n  \"priority\": false\n}\n"
              },
              {
                "path": "tickets/T-44.json",
                "equals": "{\n  \"ticket\": \"T-44\",\n  \"item\": \"envelope\",\n  \"grams\": 650,\n  \"arrival_hour\": 11,\n  \"seal\": \"intact\",\n  \"priority\": true\n}\n"
              },
              {
                "path": "tickets/T-45.json",
                "equals": "{\n  \"ticket\": \"T-45\",\n  \"item\": \"envelope\",\n  \"grams\": 95,\n  \"arrival_hour\": 10,\n  \"seal\": \"intact\",\n  \"priority\": true\n}\n"
              },
              {
                "path": "tickets/T-46.json",
                "equals": "{\n  \"ticket\": \"T-46\",\n  \"item\": \"envelope\",\n  \"grams\": 140,\n  \"arrival_hour\": 17,\n  \"seal\": \"intact\",\n  \"priority\": false\n}\n"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}
