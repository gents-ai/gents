{
  "case_id": "urgent-count-once",
  "split": "validation",
  "reducer": "all",
  "fixtures": {
    "schemas": [
      "type PickupSlip { slip: String depot: String urgent: Boolean }"
    ],
    "documents": [
      {
        "collection": "PickupSlip",
        "document": {
          "slip": "PS-301",
          "depot": "North",
          "urgent": true
        }
      },
      {
        "collection": "PickupSlip",
        "document": {
          "slip": "PS-302",
          "depot": "Harbor",
          "urgent": false
        }
      },
      {
        "collection": "PickupSlip",
        "document": {
          "slip": "PS-303",
          "depot": "Harbor",
          "urgent": true
        }
      },
      {
        "collection": "PickupSlip",
        "document": {
          "slip": "PS-304",
          "depot": "East",
          "urgent": false
        }
      },
      {
        "collection": "PickupSlip",
        "document": {
          "slip": "PS-305",
          "depot": "North",
          "urgent": true
        }
      }
    ]
  },
  "stages": [
    {
      "stage_id": "answer",
      "prompt": "I just need to know, this once, how many PickupSlip records are urgent. Do we need an app for that?",
      "checks": [
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              {
                "matches": "(?i)\\b(3|three)\\b[^.\\n]{0,40}urgent|urgent[^.\\n]{0,40}\\b(3|three)\\b"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "pages",
                "min": 0,
                "max": 0
              },
              {
                "capture": "triggers",
                "min": 0,
                "max": 0
              },
              {
                "capture": "schedules",
                "min": 0,
                "max": 0
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ],
      "capture": [
        {
          "kind": "documents",
          "name": "pages",
          "collection": "Page",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "page_id"
          ]
        },
        {
          "kind": "documents",
          "name": "triggers",
          "collection": "Trigger",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "trigger_id"
          ]
        },
        {
          "kind": "documents",
          "name": "schedules",
          "collection": "Schedule",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "schedule_id"
          ]
        }
      ]
    }
  ]
}
