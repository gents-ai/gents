{
  "case_id": "trigger-never-fires",
  "split": "train",
  "reducer": "all",
  "fixtures": {
    "schemas": [
      "type PickupSlip { slip: String depot: String urgent: Boolean }"
    ],
    "documents": [
      {
        "collection": "PickupSlip",
        "document": {
          "slip": "PS-201",
          "depot": "North",
          "urgent": true
        }
      },
      {
        "collection": "PickupSlip",
        "document": {
          "slip": "PS-202",
          "depot": "Harbor",
          "urgent": false
        }
      }
    ]
  },
  "stages": [
    {
      "stage_id": "diagnose",
      "prompt": "I added two PickupSlip records this morning, but the automation I expected to handle each new pickup slip never ran. Don't change anything yet; just tell me where it breaks.",
      "checks": [
        {
          "check": "tool_calls_expected",
          "params": {
            "config_read_only": true
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              {
                "matches": "(?i)\\b(no|none|nothing|missing|isn't any|aren't any|doesn't exist|don't exist|does not exist|do not exist|never (been )?(set up|created|configured|built))\\b[^.\\n]{0,60}(event ?source|trigger|automation|task|watcher)|(event ?source|trigger|automation|task|watcher)[^.\\n]{0,60}\\b(no|none|nothing|missing|isn't any|aren't any|doesn't exist|don't exist|does not exist|do not exist|never (been )?(set up|created|configured|built))\\b"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "set_up",
      "prompt": "OK, please set it up now: whenever a new pickup slip marked urgent comes in, put a note in my inbox with its slip number. Non-urgent slips need nothing.",
      "settle": true,
      "checks": []
    },
    {
      "stage_id": "add_slip",
      "prompt": "A new urgent pickup slip just came in for the North depot: PS-207. Please add it to our pickup slips.",
      "settle": true,
      "continuation": {
        "prompt": "OK, go ahead.",
        "max": 1,
        "until": "note"
      },
      "capture": [
        {
          "kind": "documents",
          "name": "slip",
          "collection": "PickupSlip",
          "filter": {
            "slip": {
              "_eq": "PS-207"
            }
          },
          "fields": [
            "_docID",
            "slip",
            "urgent"
          ]
        },
        {
          "kind": "documents",
          "name": "fires",
          "collection": "TriggerFire",
          "filter": {
            "owner_did": {
              "_eq": "$trial"
            },
            "source_collection": {
              "_eq": "PickupSlip"
            }
          },
          "fields": [
            "fire_key",
            "source_doc_id",
            "request_id"
          ]
        },
        {
          "kind": "documents",
          "name": "runs",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "caused_by_trigger_id": {
              "_ne": null
            }
          },
          "fields": [
            "request_id",
            "lifecycle_state"
          ]
        },
        {
          "kind": "documents",
          "name": "note",
          "collection": "MailboxItem",
          "filter": {
            "_or": [
              {
                "title": {
                  "_like": "%PS-207%"
                }
              },
              {
                "summary": {
                  "_like": "%PS-207%"
                }
              },
              {
                "payload": {
                  "_like": "%PS-207%"
                }
              }
            ]
          },
          "fields": [
            "title",
            "summary",
            "payload",
            "status"
          ]
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "note",
                "min": 1
              }
            ],
            "links": [
              {
                "capture": "slip",
                "key": "slip",
                "id": "PS-207",
                "field": "_docID",
                "target_capture": "fires",
                "target_key": "source_doc_id",
                "exact": true,
                "via": [
                  {
                    "field": "request_id",
                    "target_capture": "runs",
                    "target_key": "request_id"
                  }
                ],
                "expect": [
                  {
                    "field": "lifecycle_state",
                    "equals": "completed"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}
