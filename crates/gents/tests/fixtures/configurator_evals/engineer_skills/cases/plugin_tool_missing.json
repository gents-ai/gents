{
  "case_id": "plugin-tool-missing",
  "split": "train",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "diagnose",
      "prompt": "Tomorrow we're installing a label-printer plugin pack on another node, and its clerk agent needs the pack's print tool. Once the pack is installed, what do we still have to change for the clerk to get the tool, and from when will the clerk see it?",
      "checks": [
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              {
                "matches": "(?i)\\b(clerk|agent)('?s)?\\b[^.\\n]{0,40}\\btools\\b|\\btools\\b[^.\\n]{0,40}\\b(clerk|agent)\\b|integrations"
              },
              {
                "matches": "(?i)\\b(next|new|fresh|later|subsequent|following)\\b[^.\\n]{0,40}\\b(request|turn|message|conversation|session|chat|run)"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}
