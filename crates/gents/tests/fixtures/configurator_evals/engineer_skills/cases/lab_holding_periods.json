{
  "case_id": "lab-holding-periods",
  "split": "held_out",
  "reducer": "all",
  "fixtures": {
    "files": [
      {
        "path": "lab/BS-77.json",
        "contents": "{\n  \"id\": \"BS-77\",\n  \"kind\": \"bench sheet\",\n  \"failed_control\": true\n}\n"
      },
      {
        "path": "lab/SL-12.json",
        "contents": "{\n  \"id\": \"SL-12\",\n  \"kind\": \"specimen log\",\n  \"sent_out_for_testing\": false\n}\n"
      },
      {
        "path": "lab/IP-5.json",
        "contents": "{\n  \"id\": \"IP-5\",\n  \"kind\": \"instrument printout\"\n}\n"
      }
    ]
  },
  "stages": [
    {
      "stage_id": "hold",
      "prompt": "The lab manager wants to know how long we have to hold each item in lab/ before it can be destroyed. Just each item and its months.",
      "capture": [
        {
          "kind": "file",
          "name": "lab",
          "glob": "lab/*.json"
        }
      ],
      "checks": [
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              {
                "matches": "BS-77\\b(?:[^-]|-\\D){0,200}?\\b18\\b"
              },
              {
                "matches": "SL-12\\b(?:[^-]|-\\D){0,200}?\\b30\\b"
              },
              {
                "matches": "IP-5\\b(?:[^-]|-\\D){0,200}?\\b3\\b"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_files_match",
          "params": {
            "name": "lab",
            "expect": [
              {
                "path": "lab/BS-77.json",
                "equals": "{\n  \"id\": \"BS-77\",\n  \"kind\": \"bench sheet\",\n  \"failed_control\": true\n}\n"
              },
              {
                "path": "lab/SL-12.json",
                "equals": "{\n  \"id\": \"SL-12\",\n  \"kind\": \"specimen log\",\n  \"sent_out_for_testing\": false\n}\n"
              },
              {
                "path": "lab/IP-5.json",
                "equals": "{\n  \"id\": \"IP-5\",\n  \"kind\": \"instrument printout\"\n}\n"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}
