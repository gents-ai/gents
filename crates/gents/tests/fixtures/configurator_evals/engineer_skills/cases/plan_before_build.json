{
  "case_id": "plan-before-build",
  "split": "train",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "plan",
      "prompt": "I want a front-desk loaner laptop tracker (who has each laptop and when it's due back). Only front-desk staff use it; students must never see who has a laptop. Before building anything, write the acceptance criteria in ACCEPTANCE.md and share your plan. Don't build yet.",
      "capture": [
        {
          "kind": "file",
          "name": "workspace",
          "glob": "*"
        },
        {
          "kind": "documents",
          "name": "pages",
          "collection": "Page",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "page_id"
          ]
        },
        {
          "kind": "documents",
          "name": "triggers",
          "collection": "Trigger",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "trigger_id"
          ]
        },
        {
          "kind": "documents",
          "name": "schedules",
          "collection": "Schedule",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "schedule_id"
          ]
        },
        {
          "kind": "documents",
          "name": "surfaces",
          "collection": "DatastoreToolSurface",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "surface_id": {
              "_ne": "engineer-mailbox"
            }
          },
          "fields": [
            "surface_id"
          ]
        }
      ],
      "checks": [
        {
          "check": "captured_files_match",
          "params": {
            "name": "workspace",
            "expect": [
              {
                "path": "ACCEPTANCE.md",
                "matches": "(?m)^\\s*(?:[-*+]|\\d+[.)]|- \\[[ x]\\])\\s+\\S"
              },
              {
                "path": "ACCEPTANCE.md",
                "matches": "(?i)student"
              },
              {
                "path": "ACCEPTANCE.md",
                "matches": "(?i)must not|mustn't|never|cannot|can't|not (?:be )?(?:able|allowed|possible|visible)"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "pages",
                "min": 0,
                "max": 0
              },
              {
                "capture": "triggers",
                "min": 0,
                "max": 0
              },
              {
                "capture": "schedules",
                "min": 0,
                "max": 0
              },
              {
                "capture": "surfaces",
                "min": 0,
                "max": 0
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}
