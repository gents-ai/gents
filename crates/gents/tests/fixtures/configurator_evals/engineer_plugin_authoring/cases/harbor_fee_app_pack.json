{
  "case_id": "harbor-fee-app-pack",
  "split": "train",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "build_and_pack",
      "prompt": "Create BerthLog(berth, hours: Int, fee: Int), build and test JavaScript plugin calc_berth (fee = hours * 15, inserts BerthLog), add and lint page \"Harbor Fees\" listing BerthLog, and export + build pack harbor/fees 1.0.0 in directory harbor_fees.",
      "capture": [
        {
          "kind": "schema",
          "name": "schema",
          "collections": [
            "BerthLog"
          ]
        },
        {
          "kind": "documents",
          "name": "plugin_source",
          "collection": "PluginSource",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "plugin_id": {
              "_eq": "calc_berth"
            }
          },
          "fields": [
            "plugin_id",
            "language",
            "source",
            "input_schema",
            "data",
            "tests"
          ]
        },
        {
          "kind": "documents",
          "name": "install",
          "collection": "PackInstallation",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "coordinate": {
              "_eq": "node/calc_berth"
            }
          },
          "fields": [
            "coordinate",
            "version",
            "digest",
            "plugins"
          ]
        },
        {
          "kind": "documents",
          "name": "pages",
          "collection": "Page",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "page_id",
            "display_name",
            "module",
            "css",
            "data",
            "enabled"
          ]
        },
        {
          "kind": "file",
          "name": "pack_files",
          "glob": "**/*"
        }
      ],
      "checks": [
        {
          "check": "schema_matches",
          "params": {
            "name": "schema",
            "sdl": "type BerthLog { berth: String hours: Int fee: Int }"
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "plugin_source",
                "min": 1,
                "max": 1
              },
              {
                "capture": "install",
                "min": 1,
                "max": 1
              },
              {
                "capture": "pages",
                "min": 1,
                "max": 1
              }
            ],
            "rows": [
              {
                "capture": "plugin_source",
                "key": "plugin_id",
                "id": "calc_berth",
                "expect": [
                  {
                    "field": "language",
                    "matches": "(?i)^(?:js|javascript)$"
                  },
                  {
                    "field": "source",
                    "matches": "module\\.exports"
                  },
                  {
                    "field": "tests",
                    "matches": "\"input\""
                  },
                  {
                    "field": "data",
                    "matches": "\"BerthLog\""
                  },
                  {
                    "field": "data",
                    "matches": "\"insert\""
                  }
                ]
              },
              {
                "capture": "install",
                "key": "coordinate",
                "id": "node/calc_berth",
                "expect": [
                  {
                    "field": "digest",
                    "matches": "^sha256:[0-9a-f]{64}$"
                  },
                  {
                    "field": "version",
                    "matches": "^\\d+\\.\\d+\\.\\d+$"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "pages",
            "min_rows": 1,
            "expect": [
              {
                "field": "enabled",
                "equals": true
              },
              {
                "field": "display_name",
                "fallback_field": "page_id",
                "matches": "(?i)harbor[- ]?fees?"
              },
              {
                "field": "module",
                "matches": "\\b(?:jsx|jsxs|createElement)\\("
              },
              {
                "field": "module",
                "matches": "\\bPLUGIN_PAGE_AREA\\b|['\"]plugin\\.pages['\"]"
              },
              {
                "field": "module",
                "matches": "\\buseQuery\\("
              },
              {
                "field": "module",
                "matches": "\\b(?:berth|fee)\\b"
              },
              {
                "field": "data",
                "matches": "\"surface\"\\s*:\\s*\"[^\"]+\""
              }
            ],
            "max_rows": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "tool_result_matches",
          "params": {
            "expect": [
              {
                "field": "admitted",
                "equals": true
              },
              {
                "field": "findings",
                "equals": []
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_files_match",
          "params": {
            "name": "pack_files",
            "expect": [
              {
                "path": "harbor_fees/manifest.json",
                "matches": "(?s)\"name\"\\s*:\\s*\"fees\".*\"namespace\"\\s*:\\s*\"harbor\"|\"namespace\"\\s*:\\s*\"harbor\".*\"name\"\\s*:\\s*\"fees\""
              },
              {
                "path": "harbor_fees/pack_config.json",
                "matches": "\"pages\""
              },
              {
                "path": "harbor.fees-1.0.0.pack",
                "exists": true
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "exercise",
      "prompt": "Run calc_berth for berth B4 and hours 4, and report the recorded fee.",
      "capture": [
        {
          "kind": "documents",
          "name": "rows",
          "collection": "BerthLog",
          "filter": {},
          "fields": [
            "berth",
            "hours",
            "fee"
          ]
        },
        {
          "kind": "documents",
          "name": "install",
          "collection": "PackInstallation",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "coordinate": {
              "_eq": "node/calc_berth"
            }
          },
          "fields": [
            "coordinate",
            "version",
            "digest",
            "plugins"
          ]
        }
      ],
      "checks": [
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "rows",
                "min": 1
              }
            ],
            "rows": [
              {
                "capture": "rows",
                "key": "berth",
                "id": "B4",
                "expect": [
                  {
                    "field": "hours",
                    "equals": 4
                  },
                  {
                    "field": "fee",
                    "equals": 60
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              {
                "matches": "\\b60\\b"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}
