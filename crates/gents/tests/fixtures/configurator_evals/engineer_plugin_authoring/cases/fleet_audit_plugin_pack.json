{
  "case_id": "fleet-audit-plugin-pack",
  "split": "held_out",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "build_and_pack",
      "prompt": "Create FuelLog(truck, liters: Int, cost: Int), build and test JS plugin log_fuel (cost = liters * 4, inserts FuelLog), add and lint page \"Fuel Audit\" listing FuelLog, and export + build pack depot/fuel_audit 1.0.0 in directory fuel_audit.",
      "capture": [
        {
          "kind": "schema",
          "name": "schema",
          "collections": [
            "FuelLog"
          ]
        },
        {
          "kind": "documents",
          "name": "plugin_source",
          "collection": "PluginSource",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "plugin_id": {
              "_eq": "log_fuel"
            }
          },
          "fields": [
            "plugin_id",
            "language",
            "source",
            "input_schema",
            "data",
            "tests"
          ]
        },
        {
          "kind": "documents",
          "name": "install",
          "collection": "PackInstallation",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "coordinate": {
              "_eq": "node/log_fuel"
            }
          },
          "fields": [
            "coordinate",
            "version",
            "digest",
            "plugins"
          ]
        },
        {
          "kind": "documents",
          "name": "pages",
          "collection": "Page",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "page_id",
            "display_name",
            "module",
            "css",
            "data",
            "enabled"
          ]
        },
        {
          "kind": "file",
          "name": "pack_files",
          "glob": "**/*"
        }
      ],
      "checks": [
        {
          "check": "schema_matches",
          "params": {
            "name": "schema",
            "sdl": "type FuelLog { truck: String liters: Int cost: Int }"
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "plugin_source",
                "min": 1,
                "max": 1
              },
              {
                "capture": "install",
                "min": 1,
                "max": 1
              },
              {
                "capture": "pages",
                "min": 1,
                "max": 1
              }
            ],
            "rows": [
              {
                "capture": "plugin_source",
                "key": "plugin_id",
                "id": "log_fuel",
                "expect": [
                  {
                    "field": "language",
                    "matches": "(?i)^(?:js|javascript)$"
                  },
                  {
                    "field": "source",
                    "matches": "module\\.exports"
                  },
                  {
                    "field": "tests",
                    "matches": "\"input\""
                  },
                  {
                    "field": "data",
                    "matches": "\"FuelLog\""
                  },
                  {
                    "field": "data",
                    "matches": "\"insert\""
                  }
                ]
              },
              {
                "capture": "install",
                "key": "coordinate",
                "id": "node/log_fuel",
                "expect": [
                  {
                    "field": "digest",
                    "matches": "^sha256:[0-9a-f]{64}$"
                  },
                  {
                    "field": "version",
                    "equals": "0.1.0"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "pages",
            "min_rows": 1,
            "expect": [
              {
                "field": "enabled",
                "equals": true
              },
              {
                "field": "display_name",
                "fallback_field": "page_id",
                "matches": "(?i)fuel[- ]?audit"
              },
              {
                "field": "module",
                "matches": "\\b(?:jsx|jsxs|createElement)\\("
              },
              {
                "field": "module",
                "matches": "\\bPLUGIN_PAGE_AREA\\b|['\"]plugin\\.pages['\"]"
              },
              {
                "field": "module",
                "matches": "\\buseQuery\\("
              },
              {
                "field": "module",
                "matches": "\\b(?:truck|cost)\\b"
              },
              {
                "field": "data",
                "matches": "\"surface\"\\s*:\\s*\"[^\"]+\""
              }
            ],
            "max_rows": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "tool_result_matches",
          "params": {
            "expect": [
              {
                "field": "admitted",
                "equals": true
              },
              {
                "field": "findings",
                "equals": []
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_files_match",
          "params": {
            "name": "pack_files",
            "expect": [
              {
                "path": "fuel_audit/manifest.json",
                "matches": "(?s)\"name\"\\s*:\\s*\"fuel_audit\".*\"namespace\"\\s*:\\s*\"depot\"|\"namespace\"\\s*:\\s*\"depot\".*\"name\"\\s*:\\s*\"fuel_audit\""
              },
              {
                "path": "fuel_audit/manifest.json",
                "matches": "\"log_fuel\""
              },
              {
                "path": "depot.fuel_audit-1.0.0.pack",
                "exists": true
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "exercise",
      "prompt": "Run log_fuel for truck T7 and liters 30, and report the recorded cost.",
      "capture": [
        {
          "kind": "documents",
          "name": "rows",
          "collection": "FuelLog",
          "filter": {},
          "fields": [
            "truck",
            "liters",
            "cost"
          ]
        },
        {
          "kind": "documents",
          "name": "install",
          "collection": "PackInstallation",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "coordinate": {
              "_eq": "node/log_fuel"
            }
          },
          "fields": [
            "coordinate",
            "version",
            "digest",
            "plugins"
          ]
        }
      ],
      "checks": [
        {
          "check": "captured_fields_match",
          "params": {
            "name": "rows",
            "min_rows": 1,
            "expect": [
              {
                "field": "truck",
                "equals": "T7"
              },
              {
                "field": "liters",
                "equals": 30
              },
              {
                "field": "cost",
                "equals": 120
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              {
                "matches": "\\b120\\b"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}
