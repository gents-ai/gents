{
  "case_id": "clerk-plugin-delegation",
  "split": "train",
  "reducer": "all",
  "stages": [
    {
      "stage_id": "setup",
      "prompt": "Create QuotaSlot(slotId, capacity: Int, booked: Int) and add slot s1 with capacity 5 and booked 4. Build a JavaScript plugin named reserve_slot that reads QuotaSlot, increments booked by 1 if booked < capacity or refuses FULL. Create agent booking-clerk with only reserve_slot.",
      "capture": [
        {
          "kind": "schema",
          "name": "schema",
          "collections": [
            "QuotaSlot"
          ]
        },
        {
          "kind": "documents",
          "name": "plugin_source",
          "collection": "PluginSource",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "plugin_id": {
              "_eq": "reserve_slot"
            }
          },
          "fields": [
            "plugin_id",
            "language",
            "source",
            "input_schema",
            "data",
            "tests"
          ]
        },
        {
          "kind": "documents",
          "name": "install",
          "collection": "PackInstallation",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "coordinate": {
              "_eq": "node/reserve_slot"
            }
          },
          "fields": [
            "coordinate",
            "version",
            "digest",
            "plugins"
          ]
        },
        {
          "kind": "documents",
          "name": "agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_did",
            "display_name",
            "context_id",
            "enabled"
          ]
        },
        {
          "kind": "documents",
          "name": "contexts",
          "collection": "AgentContext",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "context_id",
            "system_prompt",
            "tools_id"
          ]
        },
        {
          "kind": "documents",
          "name": "tools",
          "collection": "Tools",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "tools_id",
            "datastore",
            "integrations",
            "self_config"
          ]
        },
        {
          "kind": "documents",
          "name": "rows",
          "collection": "QuotaSlot",
          "filter": {},
          "fields": [
            "slotId",
            "capacity",
            "booked"
          ]
        }
      ],
      "checks": [
        {
          "check": "schema_matches",
          "params": {
            "name": "schema",
            "sdl": "type QuotaSlot { slotId: String capacity: Int booked: Int }"
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "crew_spec_match",
          "params": {
            "present": [
              {
                "capture": "plugin_source",
                "min": 1,
                "max": 1
              },
              {
                "capture": "install",
                "min": 1,
                "max": 1
              },
              {
                "capture": "rows",
                "min": 1,
                "max": 1
              }
            ],
            "rows": [
              {
                "capture": "plugin_source",
                "key": "plugin_id",
                "id": "reserve_slot",
                "expect": [
                  {
                    "field": "language",
                    "matches": "(?i)^(?:js|javascript)$"
                  },
                  {
                    "field": "source",
                    "matches": "module\\.exports"
                  },
                  {
                    "field": "tests",
                    "matches": "\"input\""
                  },
                  {
                    "field": "data",
                    "matches": "\"QuotaSlot\""
                  },
                  {
                    "field": "data",
                    "matches": "\"query\""
                  },
                  {
                    "field": "data",
                    "matches": "\"update\""
                  }
                ]
              },
              {
                "capture": "install",
                "key": "coordinate",
                "id": "node/reserve_slot",
                "expect": [
                  {
                    "field": "digest",
                    "matches": "^sha256:[0-9a-f]{64}$"
                  },
                  {
                    "field": "version",
                    "equals": "0.1.0"
                  }
                ]
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "tools",
            "min_rows": 1,
            "expect": [
              {
                "field": "integrations",
                "matches": "node/reserve_slot"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    },
    {
      "stage_id": "exercise",
      "prompt": "Ask booking-clerk to reserve a seat in slot s1 twice in a row and report both results.",
      "settle": true,
      "capture": [
        {
          "kind": "documents",
          "name": "rows",
          "collection": "QuotaSlot",
          "filter": {},
          "fields": [
            "slotId",
            "capacity",
            "booked"
          ]
        },
        {
          "kind": "documents",
          "name": "role_agents",
          "collection": "Agent",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            }
          },
          "fields": [
            "agent_did",
            "display_name"
          ]
        },
        {
          "kind": "documents",
          "name": "agent_runs",
          "collection": "AgentRequest",
          "filter": {
            "node_did": {
              "_eq": "$trial"
            },
            "agent_did": {
              "_eq": {
                "$capture": {
                  "capture": "role_agents",
                  "source_match": {
                    "field": "display_name",
                    "matches": "(?i)booking[- ]?clerk"
                  },
                  "field": "agent_did"
                }
              }
            },
            "purpose": {
              "_eq": "normal"
            },
            "lifecycle_state": {
              "_eq": "completed"
            }
          },
          "fields": [
            "request_id",
            "agent_did",
            "lifecycle_state"
          ]
        }
      ],
      "checks": [
        {
          "check": "captured_rows_count",
          "params": {
            "name": "agent_runs",
            "min": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "captured_fields_match",
          "params": {
            "name": "rows",
            "min_rows": 1,
            "expect": [
              {
                "field": "slotId",
                "equals": "s1"
              },
              {
                "field": "booked",
                "equals": 5
              }
            ],
            "max_rows": 1
          },
          "tier": "acceptance",
          "weight": 1
        },
        {
          "check": "final_message_matches",
          "params": {
            "all": [
              {
                "matches": "FULL"
              }
            ]
          },
          "tier": "acceptance",
          "weight": 1
        }
      ]
    }
  ]
}
