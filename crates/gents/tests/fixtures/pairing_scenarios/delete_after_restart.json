{
  "name": "delete_after_restart",
  "actions": [
    {
      "op": "OperatorWrite",
      "node": "A",
      "peer": "B",
      "collections": ["AgentRequest"],
      "replicator_addresses": ["/ip4/127.0.0.1/tcp/4105/p2p/peer-b"]
    },
    { "op": "Reconcile", "node": "A" },
    { "op": "OperatorDelete", "node": "A", "peer": "B" },
    { "op": "Crash", "node": "A" },
    { "op": "Reconcile", "node": "A" },
    { "op": "WaitForConvergence" }
  ]
}
