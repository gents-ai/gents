{
  "$id": "https://schemas.defra.ai/gents/adapter-projection/openai_codex_run_trace/v1-jsonl-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "projection_id": {
      "const": "openai_codex_run_trace"
    },
    "projection_version": {
      "const": "v1"
    },
    "record_id": {
      "type": "string"
    },
    "record_index": {
      "minimum": 0,
      "type": "integer"
    },
    "record_kind": {
      "enum": [
        "openai_codex_trace_item"
      ]
    },
    "redaction_mode": {
      "enum": [
        "full",
        "training_safe",
        "public"
      ]
    },
    "source_request_id": {
      "type": "string"
    },
    "source_session_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "value": {
      "type": "object"
    }
  },
  "required": [
    "projection_id",
    "projection_version",
    "source_request_id",
    "redaction_mode",
    "record_kind",
    "record_index",
    "record_id",
    "value"
  ],
  "title": "OpenAI/Codex Run Trace Projection JSONL Record",
  "type": "object"
}