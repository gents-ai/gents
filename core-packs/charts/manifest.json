{
  "assets": [
    "README.md",
    "agent_behaviors/chart_maker/system_prompt.md",
    "notice.md",
    "pack_config.json",
    "plugins/charts.afb",
    "plugins/charts/TOOL.md",
    "schemas/chart_request.graphql",
    "schemas/chart_result.graphql",
    "tests/content.json",
    "tests/graph_error.json",
    "tests/graph_inline.json",
    "tests/graph_read_only.json",
    "tests/graph_render.json",
    "tests/graph_save.json",
    "tests/install.json"
  ],
  "authors": [
    "gents contributors"
  ],
  "config": "pack_config.json",
  "dependencies": [],
  "description": "Draws line, area, bar, scatter, bubble, histogram, box, pie, donut, heatmap and combined charts from rows or CSV and JSON files as SVG and PNG images, as a Chart maker agent and a plugin.",
  "inference_slots": [
    {
      "agents": [
        "chart-maker"
      ],
      "description": "Turns the user's data and request into a chart with the charts tool. Any capable profile; one that accepts images also checks the picture.",
      "name": "chart_maker"
    }
  ],
  "kind": "documents",
  "manifest_version": 1,
  "name": "charts",
  "namespace": "gents",
  "plugins": [
    {
      "artifact": "plugins/charts.afb",
      "bind_dir": {
        "access": "read_write",
        "description": "The data file to chart, or the folder holding it; written only by a call that sets save",
        "input_field": "path",
        "original_field": "path_original",
        "write_fields": [
          "save"
        ]
      },
      "description": "Draws a chart (line, area, stacked area, bar, scatter, bubble, histogram, box, pie, donut, heatmap, combo) from rows or a CSV or JSON file and returns it as an image with a text description, or saves it as SVG and PNG files.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "agg": {
            "description": "How rows with the same x combine; default sum, mean for heatmaps.",
            "enum": [
              "sum",
              "mean",
              "count",
              "min",
              "max",
              "median"
            ],
            "type": "string"
          },
          "bins": {
            "anyOf": [
              {
                "maximum": 200,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "description": "Histograms: 1 to 200 bins, or auto (default)."
          },
          "center": {
            "description": "Heatmaps: the value drawn as the neutral colour of a diverging scale.",
            "type": "number"
          },
          "chart": {
            "description": "The chart type; {\"help\": \"types\"} explains each. Required unless help is set.",
            "enum": [
              "line",
              "area",
              "stacked_area",
              "bar",
              "stacked_bar",
              "horizontal_bar",
              "scatter",
              "bubble",
              "histogram",
              "box",
              "pie",
              "donut",
              "heatmap",
              "combo"
            ],
            "type": "string"
          },
          "colors": {
            "description": "Series colours as hex strings like \"#1f77b4\"; only when asked.",
            "items": {
              "type": "string"
            },
            "maxItems": 64,
            "type": "array"
          },
          "data": {
            "description": "Inline data: {\"columns\": [...], \"rows\": [[...]]} (a data_tables result), a list of objects, or CSV text. Use this or path."
          },
          "file": {
            "description": "The data file inside the folder named in path.",
            "type": "string"
          },
          "format": {
            "description": "Number format of values and the y axis, like \",.0f\" or \".1%\"; see {\"help\": \"formats\"}.",
            "type": "string"
          },
          "height": {
            "description": "Image height in pixels (default 480).",
            "maximum": 4096,
            "minimum": 150,
            "type": "integer"
          },
          "help": {
            "description": "Return this help topic instead of drawing; topics lists them all. Needs no other field.",
            "enum": [
              "topics",
              "inputs",
              "types",
              "options",
              "formats",
              "output",
              "saving"
            ],
            "type": "string"
          },
          "horizontal": {
            "description": "Bar charts: draw the bars horizontally.",
            "type": "boolean"
          },
          "legend": {
            "description": "Legend placement (default auto).",
            "enum": [
              "auto",
              "right",
              "bottom",
              "top",
              "left",
              "none"
            ],
            "type": "string"
          },
          "line": {
            "description": "Combo charts: the columns drawn as lines.",
            "items": {
              "type": "string"
            },
            "maxItems": 24,
            "type": "array"
          },
          "line_axis": {
            "description": "Combo charts: the axis of the lines (default right).",
            "enum": [
              "right",
              "left"
            ],
            "type": "string"
          },
          "output": {
            "description": "both (default), svg or png; svg returns the SVG text instead of the picture.",
            "enum": [
              "both",
              "svg",
              "png"
            ],
            "type": "string"
          },
          "path": {
            "description": "The CSV or JSON data file, or the folder holding it; a relative path starts at the working folder. Use this or data.",
            "type": "string"
          },
          "path_original": {
            "description": "Set by the host to the real path named in path; leave it out.",
            "type": "string"
          },
          "save": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "png": {
                    "type": "string"
                  },
                  "svg": {
                    "type": "string"
                  }
                },
                "type": "object"
              }
            ],
            "description": "Write the chart into the folder named in path: a base name like \"chart\", or {\"svg\": \"a.svg\", \"png\": \"a.png\"}; see {\"help\": \"saving\"}."
          },
          "scale": {
            "description": "PNG pixel density (default 1).",
            "maximum": 4,
            "minimum": 0.5,
            "type": "number"
          },
          "series": {
            "description": "Column whose values split the rows into one series each (long-format data); then y is one column.",
            "type": "string"
          },
          "size": {
            "description": "Bubble charts: the column that sets each bubble's size.",
            "type": "string"
          },
          "sort": {
            "description": "Category order (default none: the data order).",
            "enum": [
              "none",
              "x",
              "x_desc",
              "value",
              "value_desc"
            ],
            "type": "string"
          },
          "stack": {
            "description": "Bar charts: grouped (default) or stacked.",
            "enum": [
              "grouped",
              "stacked"
            ],
            "type": "string"
          },
          "subtitle": {
            "description": "Line under the title.",
            "type": "string"
          },
          "theme": {
            "description": "light (default) or dark.",
            "enum": [
              "light",
              "dark"
            ],
            "type": "string"
          },
          "title": {
            "description": "Chart title.",
            "type": "string"
          },
          "value": {
            "description": "Heatmaps: the column that sets each cell's colour.",
            "type": "string"
          },
          "width": {
            "description": "Image width in pixels (default 800).",
            "maximum": 4096,
            "minimum": 200,
            "type": "integer"
          },
          "x": {
            "description": "Column for the x axis, the categories or the pie labels (default the first column).",
            "type": "string"
          },
          "x_format": {
            "description": "Format of the x axis labels: a number format, or a date pattern like \"%b %Y\" on a time axis.",
            "type": "string"
          },
          "x_label": {
            "description": "X axis title; the column name by default, an empty string for none.",
            "type": "string"
          },
          "x_max": {
            "description": "Highest x shown.",
            "type": "number"
          },
          "x_min": {
            "description": "Lowest x shown.",
            "type": "number"
          },
          "x_scale": {
            "description": "X axis scale (default auto).",
            "enum": [
              "auto",
              "linear",
              "log",
              "time",
              "category"
            ],
            "type": "string"
          },
          "y": {
            "description": "Value columns, one series each (default every numeric column); for a heatmap, the column on the other axis.",
            "items": {
              "type": "string"
            },
            "maxItems": 24,
            "type": "array"
          },
          "y2_format": {
            "description": "Number format of the right axis.",
            "type": "string"
          },
          "y2_label": {
            "description": "Combo charts: title of the right axis.",
            "type": "string"
          },
          "y2_scale": {
            "description": "Combo charts: right axis scale (default linear).",
            "enum": [
              "auto",
              "linear",
              "log"
            ],
            "type": "string"
          },
          "y_format": {
            "description": "Number format of the y axis; overrides format.",
            "type": "string"
          },
          "y_label": {
            "description": "Y axis title; the column name by default for one series, an empty string for none.",
            "type": "string"
          },
          "y_max": {
            "description": "Highest y shown.",
            "type": "number"
          },
          "y_min": {
            "description": "Lowest y shown.",
            "type": "number"
          },
          "y_scale": {
            "description": "Y axis scale (default linear); log needs values above zero.",
            "enum": [
              "auto",
              "linear",
              "log"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "instructions": "plugins/charts/TOOL.md",
      "language": "rust",
      "limits": {
        "max_output_mib": 4,
        "memory_mib": 1024,
        "wall_clock_secs": 300
      },
      "name": "charts",
      "source": "plugins/charts"
    }
  ],
  "schemas": [
    "schemas/chart_request.graphql",
    "schemas/chart_result.graphql"
  ],
  "tags": [
    "charts",
    "svg",
    "png",
    "visualization",
    "plugin"
  ],
  "version": "1.0.0-rc2"
}
