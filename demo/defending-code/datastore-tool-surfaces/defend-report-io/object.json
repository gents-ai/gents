{
  "surface_id": "defend-report-io",
  "agent_did": "did:key:zDefendingCodeAgentPlaceholder0000000000000000000000",
  "display_name": "Closed-ledger report reads and write",
  "enabled": true,
  "entries": [
    {
      "kind": "read",
      "tool_name": "read_defense_threat_model",
      "collection": "DefenseThreatModel",
      "description": "Load the threat model for this run.",
      "fields": ["system_context", "assets", "entry_points", "threats", "deprioritized", "open_questions", "mitigations", "provenance"],
      "filter_fields": [{"name": "run_id", "required": false, "fill": "correlation"}]
    },
    {
      "kind": "read",
      "tool_name": "read_defense_triage_summary",
      "collection": "DefenseTriageSummary",
      "description": "Load the count-balanced triage summary for this run.",
      "fields": ["candidate_count", "confirmed_count", "refuted_count", "duplicate_count", "patch_assignment_count", "summary"],
      "filter_fields": [{"name": "run_id", "required": false, "fill": "correlation"}]
    },
    {
      "kind": "read",
      "tool_name": "read_defense_verdict",
      "collection": "DefenseFindingVerdict",
      "description": "Load the exact candidate verdict ledger for this run.",
      "fields": ["finding_id", "area_id", "verdict", "category", "severity", "confidence", "path", "line", "title", "evidence", "verification", "duplicate_of", "preconditions", "access_level", "owner_hint", "threat_ids"],
      "filter_fields": [{"name": "run_id", "required": false, "fill": "correlation"}]
    },
    {
      "kind": "read",
      "tool_name": "read_defending_finding",
      "collection": "DefendingFinding",
      "description": "Load every confirmed operator-facing finding for this run.",
      "fields": ["finding_id", "category", "severity", "confidence", "path", "line", "title", "description", "exploit_scenario", "recommendation", "evidence", "verification", "preconditions", "access_level", "owner_hint", "threat_ids", "verdict"],
      "filter_fields": [{"name": "run_id", "required": false, "fill": "correlation"}]
    },
    {
      "kind": "read",
      "tool_name": "read_defense_patch_candidate",
      "collection": "DefensePatchCandidate",
      "description": "Load every patch proposal or no-patch sentinel for this run.",
      "fields": ["patch_id", "finding_id", "status", "path", "line", "category", "diff", "rationale", "variants_checked", "bypass_considered", "test_note", "expected_total"],
      "filter_fields": [{"name": "run_id", "required": false, "fill": "correlation"}]
    },
    {
      "kind": "read",
      "tool_name": "read_defense_patch_review",
      "collection": "DefensePatchReview",
      "description": "Load every isolated patch review for this run.",
      "fields": ["patch_id", "finding_id", "verdict", "style_score", "out_of_scope_hunks", "new_surface", "reason", "expected_total"],
      "filter_fields": [{"name": "run_id", "required": false, "fill": "correlation"}]
    },
    {
      "tool_name": "write_defense_report",
      "collection": "DefenseReport",
      "description": "Publish the single final report over the closed threat, verdict, patch, and review ledgers.",
      "output_obligation": {"scope": "trigger", "minimum_writes": 1},
      "fields": [
        {"name": "run_id", "required": false, "fill": "correlation"},
        {"name": "candidate_count", "required": true},
        {"name": "confirmed_count", "required": true},
        {"name": "refuted_count", "required": true},
        {"name": "patch_count", "required": true},
        {"name": "accepted_patch_count", "required": true},
        {"name": "rejected_patch_count", "required": true},
        {"name": "severity_counts", "required": true},
        {"name": "top_risks", "required": true},
        {"name": "summary", "required": true},
        {"name": "human_actions", "required": true}
      ]
    }
  ]
}
