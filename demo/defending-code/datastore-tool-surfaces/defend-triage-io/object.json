{
  "surface_id": "defend-triage-io",
  "agent_did": "did:key:zDefendingCodeAgentPlaceholder0000000000000000000000",
  "display_name": "Adversarial triage reads and writes",
  "enabled": true,
  "entries": [
    {
      "kind": "read",
      "tool_name": "read_defense_threat_model",
      "collection": "DefenseThreatModel",
      "description": "Load the threat model for this run; run_id is runtime-filled.",
      "fields": ["repository_path", "focus", "system_context", "assets", "entry_points", "threats", "deprioritized", "open_questions", "mitigations", "provenance"],
      "filter_fields": [{"name": "run_id", "required": false, "fill": "correlation"}]
    },
    {
      "kind": "read",
      "tool_name": "read_defense_candidate",
      "collection": "DefenseCandidateFinding",
      "description": "Load every static vulnerability candidate for this run.",
      "fields": ["finding_id", "area_id", "category", "claimed_severity", "confidence", "path", "line", "title", "description", "exploit_scenario", "recommendation", "evidence", "threat_ids"],
      "filter_fields": [{"name": "run_id", "required": false, "fill": "correlation"}]
    },
    {
      "kind": "read",
      "tool_name": "read_defense_verdict",
      "collection": "DefenseFindingVerdict",
      "description": "Load the completed independent verifier ledger for this run.",
      "fields": ["finding_id", "area_id", "repository_path", "verdict", "category", "severity", "confidence", "path", "line", "title", "description", "exploit_scenario", "recommendation", "evidence", "verification", "duplicate_of", "preconditions", "access_level", "owner_hint", "threat_ids", "expected_total"],
      "filter_fields": [{"name": "run_id", "required": false, "fill": "correlation"}]
    },
    {
      "kind": "read",
      "tool_name": "read_defense_triage_summary",
      "collection": "DefenseTriageSummary",
      "description": "Check whether another durable continuation already closed this run.",
      "fields": ["candidate_count", "confirmed_count", "refuted_count", "duplicate_count", "patch_assignment_count", "summary"],
      "filter_fields": [{"name": "run_id", "required": false, "fill": "correlation"}]
    },
    {
      "tool_name": "write_defending_finding",
      "collection": "DefendingFinding",
      "description": "Promote one confirmed verdict into the durable operator-facing finding ledger.",
      "fields": [
        {"name": "run_id", "required": false, "fill": "correlation"},
        {"name": "finding_id", "required": true},
        {"name": "area_id", "required": true},
        {"name": "category", "required": true},
        {"name": "severity", "required": true},
        {"name": "confidence", "required": true},
        {"name": "path", "required": true},
        {"name": "line", "required": true},
        {"name": "title", "required": true},
        {"name": "description", "required": true},
        {"name": "exploit_scenario", "required": true},
        {"name": "recommendation", "required": true},
        {"name": "evidence", "required": true},
        {"name": "verification", "required": true},
        {"name": "preconditions", "required": true},
        {"name": "access_level", "required": true},
        {"name": "owner_hint", "required": true},
        {"name": "threat_ids", "required": true},
        {"name": "verdict", "required": true}
      ]
    },
    {
      "tool_name": "write_defense_patch_assignment",
      "collection": "DefensePatchAssignment",
      "description": "Create one member of the closed patch-work set, including the no-findings sentinel.",
      "fields": [
        {"name": "run_id", "required": false, "fill": "correlation"},
        {"name": "assignment_id", "required": true},
        {"name": "finding_id", "required": true},
        {"name": "repository_path", "required": false, "fill": {"source_field": "repository_path"}},
        {"name": "status", "required": true},
        {"name": "expected_total", "required": true}
      ]
    },
    {
      "tool_name": "write_defense_triage_summary",
      "collection": "DefenseTriageSummary",
      "description": "Close the exact candidate/verdict ledger after patch assignments are written.",
      "output_obligation": {"scope": "trigger", "minimum_writes": 1},
      "fields": [
        {"name": "run_id", "required": false, "fill": "correlation"},
        {"name": "candidate_count", "required": true},
        {"name": "confirmed_count", "required": true},
        {"name": "refuted_count", "required": true},
        {"name": "duplicate_count", "required": true},
        {"name": "patch_assignment_count", "required": true},
        {"name": "summary", "required": true}
      ]
    }
  ]
}
