{
  "name": "code-review",
  "description": "Four-stage Gents PR review: pre-scan -> lens swarm -> adversarial verification -> merge report",
  "init": {
    "inference_url": "${GENTS_REVIEW_COORDINATOR_ENDPOINT:-http://100.87.27.25:8000/v1}",
    "model_name": "${GENTS_REVIEW_COORDINATOR_MODEL:-GLM-5.2}",
    "tool_package": "write",
    "tool_root": "${GENTS_REVIEW_ROOT:-.}",
    "tool_root_env_var": "GENTS_REVIEW_ROOT",
    "tool_root_markers": ["Cargo.toml", "crates/gents"],
    "backend_preset": "vllm",
    "openai_wire_api": "chat-completions"
  },
  "seed": {
    "collection": "ReviewJob",
    "job_id_field": "run_id",
    "prompt_field": "focus",
    "fields": {
      "repository_path": "${GENTS_REVIEW_ROOT:-.}",
      "base_ref": "${GENTS_REVIEW_BASE_REF:-origin/main}",
      "head_ref": "${GENTS_REVIEW_HEAD_REF:-HEAD}",
      "lens_count": "${GENTS_REVIEW_LENS_COUNT:-auto}",
      "lens_min": "${GENTS_REVIEW_MIN_LENSES:-4}",
      "lens_max": "${GENTS_REVIEW_MAX_LENSES:-12}",
      "pr_number": "${GENTS_REVIEW_PR_NUMBER:-}"
    }
  },
  "default_prompt": "${GENTS_REVIEW_PROMPT:-Review the PR diff for merge-blocking correctness, durability, authorization, concurrency, and provider-boundary defects.}",
  "expect": {
    "trigger_ids": ["review-recon", "review-scan", "review-verify", "review-triage"],
    "trigger_request_count_sources": {
      "review-scan": {
        "collection": "ReviewArea",
        "correlation_field": "run_id",
        "expected_count_field": "expected_total"
      }
    },
    "signed_provenance": true,
    "required_tool_call_trigger_ids": ["review-recon", "review-scan", "review-verify", "review-triage"],
    "prompt_tool_contracts": [
      {
        "task_id": "review-recon-task",
        "required_tool_names": ["write_review_area"]
      },
      {
        "task_id": "review-scan-task",
        "required_tool_names": ["write_candidate_finding", "write_scan_result"]
      },
      {
        "task_id": "review-verify-task",
        "required_tool_names": ["read_candidate_finding", "write_finding_verdict", "write_finding", "write_verification_summary"]
      },
      {
        "task_id": "review-triage-task",
        "required_tool_names": ["write_triage_report"]
      }
    ],
    "source_edges": [],
    "projections": ["atif", "openai-codex", "langgraph", "multi-agent"],
    "collection_counts": {"ReviewArea": 1, "ScanResult": 1, "VerificationSummary": 1, "TriageReport": 1},
    "result_documents": [
      {
        "collection": "TriageReport",
        "correlation_field": "run_id",
        "fields": ["high_priority_count", "confirmed_count", "refuted_count", "summary"]
      },
      {
        "collection": "Finding",
        "correlation_field": "run_id",
        "fields": ["finding_id", "area_id", "severity", "confidence", "path", "line", "title", "detail", "verdict", "evidence", "verification"]
      }
    ],
    "fan_in": {
      "member_collection": "ReviewArea",
      "result_collection": "ScanResult",
      "report_collection": "TriageReport",
      "correlation_field": "run_id",
      "expected_count_field": "expected_total",
      "min_expected_count": ${GENTS_REVIEW_MIN_LENSES:-4},
      "max_expected_count": ${GENTS_REVIEW_MAX_LENSES:-12},
      "consumer_trigger_id": "review-verify",
      "member_required_fields": ["area_id", "repository_path", "lens", "baseline", "instructions"],
      "verification": {
        "candidate_collection": "CandidateFinding",
        "decision_collection": "FindingVerdict",
        "summary_collection": "VerificationSummary",
        "confirmed_collection": "Finding",
        "final_consumer_trigger_id": "review-triage",
        "finding_id_field": "finding_id",
        "verdict_field": "verdict",
        "evidence_field": "evidence",
        "confirmed_count_field": "confirmed_count",
        "refuted_count_field": "refuted_count"
      }
    }
  },
  "await_timeout_secs": ${GENTS_REVIEW_AWAIT_TIMEOUT_SECS:-86400}
}
