{
  "name": "@source-inc/gents-desktop-client",
  "version": "0.13.0",
  "license": "Apache-2.0",
  "description": "Transport, shared store, and view-model contract for Gents desktop packages",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./generated/*": {
      "types": "./dist/generated/*.d.ts",
      "import": "./dist/generated/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/generated",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../scripts/clean-desktop-package-dist.mjs && tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  },
  "devDependencies": {
    "typescript": "~5.8.3",
    "vitest": "^3.2.4"
  }
}
