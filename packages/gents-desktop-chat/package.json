{
  "name": "@source-inc/gents-desktop-chat",
  "version": "0.15.0",
  "license": "Apache-2.0",
  "description": "Headless chat projection and workflow helpers for Gents desktop",
  "type": "module",
  "sideEffects": [
    "./styles.css",
    "./styles/**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "styles",
    "styles.css",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../scripts/clean-desktop-package-dist.mjs && tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react-markdown": "^10.0.0",
    "rehype-highlight": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@source-inc/gents-desktop-client": "0.15.0",
    "@source-inc/gents-desktop-tokens": "0.15.0",
    "@source-inc/gents-desktop-ui": "0.15.0"
  },
  "devDependencies": {
    "@source-inc/gents-desktop-client": "0.15.0",
    "@source-inc/gents-desktop-tokens": "0.15.0",
    "@source-inc/gents-desktop-ui": "0.15.0",
    "@types/node": "^24.0.14",
    "@types/react": "^19.1.8",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "typescript": "~5.8.3",
    "vitest": "^3.2.4"
