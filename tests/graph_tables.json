{
  "runtime": {
    "repository": {
      "files": {
        "data/sales.csv": "region,units,price\nnorth,10,2.5\nsouth,7,3\nnorth,5,4\n",
        "data/regions.csv": "region,boss\nnorth,Ann\nsouth,Bo\n"
      }
    },
    "seed": {
      "collection": "DataJob",
      "fields": {
        "run_id": "run-${ATTEMPT}",
