      "fields": {
        "mode": "tables"
      }
    },
    "expect": [
      {
        "collection": "DataResult",
        "fields": {
          "mode": "tables",
          "complete": true
        }
      },
      {
        "collection": "DataTable",
        "fields": {
          "table": "regions",
          "source": "regions.csv",
          "format": "csv",
          "row_count": 2
        }
      },
      {
        "collection": "DataTable",
        "fields": {
          "table": "sales",
          "source": "sales.csv",
          "format": "csv",
          "row_count": 3
        }
      }
    ]
  }
}
