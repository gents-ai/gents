{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for Gents views \u2014 full desktop production surface",
  "windows": ["main", "gents-view-*"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-set-title",
    "core:window:allow-set-theme",
    "core:webview:allow-set-webview-zoom",
    "opener:default",
    "dialog:allow-open",
    "dialog:allow-message",
    "notification:default",
    "gents-desktop-bridge:default",
    "gents-desktop-bridge:full",
    "native-swipe",
    "open-plugin-window",
    "plugin-prompt-to-main",
    "native-browser",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "x-apple.systempreferences:com.apple.Notifications-Settings.extension"
        }
      ]
    }
  ]
}
