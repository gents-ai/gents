{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Paired-remote host profile: no runtime-admin, no config-write",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "gents-desktop-bridge:default",
    "gents-desktop-bridge:session-read",
    "gents-desktop-bridge:chat-write",
    "gents-desktop-bridge:resend-control",
    "gents-desktop-bridge:interrupt-read",
    "gents-desktop-bridge:interrupt-control",
    "gents-desktop-bridge:fleet-read",
    "gents-desktop-bridge:fleet-admin",
    "fixture-domain:default"
  ]
}
